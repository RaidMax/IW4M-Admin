@page "/radar/{ServerId?}"
@rendermode RenderMode.InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using SharedLibraryCore
@using WebCommon.Components.UI.Layout

@* No <HeadContent> here: the host links every bundle's CSS globally, and liveradar.js is
   module-imported on demand by the code-behind before first interop (see OnAfterRenderAsync). *@
<PageTitle>Live Radar</PageTitle>

<PluginPageShell Menu="BuildNav()">

    <!-- Header -->
    <div class="flex items-center gap-3">
        <div class="flex items-center justify-center p-2.5 rounded-lg bg-surface-alt/50 border border-line shadow-sm">
            <i class="ph ph-crosshair text-xl text-primary"></i>
        </div>
        <div>
            <h2 class="text-2xl font-bold text-gradient-title">@Utilities.CurrentLocalization.LocalizationIndex["WEBFRONT_LIVE_RADAR_TITLE"]</h2>
            <div class="text-sm text-subtle"><span>@SelectedServerName.StripColors()</span></div>
        </div>
    </div>

    <!-- Map (hero) -->
    <div class="mx-auto w-full max-w-[600px]">
        <div id="map_name" class="bg-surface-alt text-center py-3 px-4 rounded-t-lg border border-line text-foreground font-medium tracking-wide">&mdash;</div>
        <div id="map_list" class="relative rounded-b-lg border border-t-0 border-line bg-surface bg-cover w-full shadow-lg" style="padding-bottom: 100% !important;">
            <canvas id="map_canvas" class="absolute inset-0 w-full h-full"></canvas>
        </div>
    </div>

    <!-- Roster (two teams, full width) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-surface rounded-lg border border-line shadow-sm overflow-hidden">
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-line bg-surface-alt/40">
                <span class="inline-block w-2.5 h-2.5 rounded-full" style="background:rgb(0,122,204)"></span>
                <h5 class="text-xs font-semibold text-muted uppercase tracking-wider">Team 1</h5>
            </div>
            <div class="player-data-left p-3 space-y-2 min-h-[88px]"></div>
        </div>
        <div class="bg-surface rounded-lg border border-line shadow-sm overflow-hidden">
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-line bg-surface-alt/40">
                <span class="inline-block w-2.5 h-2.5 rounded-full" style="background:rgb(255,69,69)"></span>
                <h5 class="text-xs font-semibold text-muted uppercase tracking-wider">Team 2</h5>
            </div>
            <div class="player-data-right p-3 space-y-2 min-h-[88px]"></div>
        </div>
    </div>

    <img class="hidden" id="hud_death" src="/_content/liveradar/images/death.png"/>

</PluginPageShell>
