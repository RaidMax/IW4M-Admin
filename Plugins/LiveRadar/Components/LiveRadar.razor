@page "/radar/{ServerId?}"
@using Microsoft.AspNetCore.Components.Web
@rendermode RenderMode.InteractiveServer

@using SharedLibraryCore
@using SharedLibraryCore.Interfaces
@using Microsoft.JSInterop
@inject IManager Manager
@inject IJSRuntime JS

@{
    var localization = Utilities.CurrentLocalization.LocalizationIndex;

    string LocOr(string key, string fallback)
    {
        var value = localization[key];
        return string.IsNullOrEmpty(value) || value == key ? fallback : value;
    }
}

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">

    <!-- Heading + server tabs -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@(localization["WEBFRONT_LIVE_RADAR_TITLE"])</h1>
            <p class="text-sm text-muted mt-0.5">@SelectedServerName.StripColors()</p>
        </div>

        @if (Servers.Count > 1)
        {
            <nav class="ml-auto max-w-full overflow-x-auto" aria-label="@(localization["WEBFRONT_CONTEXT_MENU_GLOBAL_GAME"])">
                <div class="inline-flex gap-1 p-1 rounded-lg bg-surface border border-line">
                    @foreach (var server in Servers)
                    {
                        <a href="/radar/@server"
                           class="px-3 py-1.5 rounded-md text-sm font-medium whitespace-nowrap transition-colors @(IsSelected(server) ? "bg-surface-alt text-foreground shadow-sm" : "text-subtle hover:text-foreground hover:bg-surface-hover")">
                            @server.Hostname.StripColors()
                        </a>
                    }
                </div>
            </nav>
        }
    </div>

    <!-- 3-column layout: left players | map | right players -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr_1fr] gap-4 items-start">

        <!-- Left team (player cards are injected by liveradar.js) -->
        <div class="hidden lg:block min-w-0">
            <div class="flex items-center gap-3 px-1 pb-2">
                <h2 class="player-team-left-title flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@LocOr("WEBFRONT_LIVE_RADAR_TEAM_1", "Team 1")</h2>
            </div>
            <div class="player-data-left max-h-[70vh] overflow-y-auto"></div>
        </div>

        <!-- Map card -->
        <section class="min-w-0 rounded-xl bg-surface border border-line overflow-hidden">
            <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@LocOr("WEBFRONT_LIVE_RADAR_MAP", "Map")</h2>
                <span id="map_name" class="text-sm font-semibold text-foreground truncate">&mdash;</span>
            </div>
            <div id="map_list" class="relative w-full bg-surface-alt bg-cover bg-center" style="padding-bottom: 100% !important;">
                <canvas id="map_canvas" class="absolute inset-0 w-full h-full"></canvas>
                <div id="map_controls" class="hidden absolute bottom-3 left-3 z-10 rounded-md bg-black/65 px-2 py-1 text-[11px] text-white/80 pointer-events-none">
                    @LocOr("WEBFRONT_LIVE_RADAR_CONTROLS", "Drag to move · Scroll to zoom")
                </div>
            </div>
        </section>

        <!-- Right team (player cards are injected by liveradar.js) -->
        <div class="hidden lg:block min-w-0">
            <div class="flex items-center gap-3 px-1 pb-2">
                <h2 class="player-team-right-title flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@LocOr("WEBFRONT_LIVE_RADAR_TEAM_2", "Team 2")</h2>
            </div>
            <div class="player-data-right max-h-[70vh] overflow-y-auto"></div>
        </div>
    </div>

    <!-- Mobile player lists (shown below lg) -->
    <div class="lg:hidden grid grid-cols-2 gap-4">
        <div class="min-w-0">
            <div class="flex items-center gap-3 px-1 pb-2">
                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@LocOr("WEBFRONT_LIVE_RADAR_TEAM_1", "Team 1")</h2>
            </div>
            <div class="player-data-left-mobile max-h-[50vh] overflow-y-auto"></div>
        </div>
        <div class="min-w-0">
            <div class="flex items-center gap-3 px-1 pb-2">
                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@LocOr("WEBFRONT_LIVE_RADAR_TEAM_2", "Team 2")</h2>
            </div>
            <div class="player-data-right-mobile max-h-[50vh] overflow-y-auto"></div>
        </div>
    </div>

    <img class="hidden" id="hud_death" src="/images/radar/death.png"/>
</div>
