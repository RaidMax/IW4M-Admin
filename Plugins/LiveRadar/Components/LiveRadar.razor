@page "/radar/{ServerId?}"
@using Microsoft.AspNetCore.Components.Web
@rendermode RenderMode.InteractiveServer

@using SharedLibraryCore
@using SharedLibraryCore.Interfaces
@using Microsoft.JSInterop
@inject IManager Manager
@inject IJSRuntime JS

<div class="max-w-7xl mx-auto p-4 md:p-8">
    <div class="flex flex-col lg:flex-row gap-6">
        <!-- Main Radar Content -->
        <div class="flex-1">
            <div class="flex items-center gap-3 mb-6">
                <div class="flex items-center justify-center p-2.5 rounded-lg bg-surface-alt/50 border border-line shadow-sm">
                    <i class="ph ph-crosshair text-xl text-primary"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gradient-title">@Utilities.CurrentLocalization.LocalizationIndex["WEBFRONT_LIVE_RADAR_TITLE"]</h2>
                    <div class="text-sm text-subtle">
                        <span>@SelectedServerName.StripColors()</span>
                    </div>
                </div>
            </div>
            
            <div class="flex flex-col md:flex-row gap-4">
                <div class="player-data-left w-full md:w-1/4 opacity-0">
                </div>
                <div class="flex-1">
                    <div id="map_name" class="bg-surface-alt text-center py-3 px-4 rounded-t-lg border border-line text-foreground font-medium">&mdash;</div>
                    <div id="map_list" class="relative rounded-b-lg border border-t-0 border-line bg-surface bg-cover" style="padding-bottom: 100% !important;">
                        <canvas id="map_canvas" class="absolute inset-0 w-full h-full"></canvas>
                    </div>
                </div>
                <div class="player-data-right w-full md:w-1/4 opacity-0">
                </div>
            </div>
        </div>

        <!-- Server Selection Sidebar -->
        <div class="w-full lg:w-72 shrink-0">
            <div class="bg-surface rounded-lg border border-line shadow-sm overflow-hidden">
                <div class="px-4 py-3 border-b border-line bg-surface-alt/50">
                    <h5 class="font-semibold text-foreground">@Utilities.CurrentLocalization.LocalizationIndex["WEBFRONT_CONTEXT_MENU_GLOBAL_GAME"]</h5>
                </div>
                <div class="divide-y divide-line">
                    @foreach (var server in Servers)
                    {
                        <a href="/radar/@server.Id"
                           class="block px-4 py-3 transition-colors @(IsSelected(server) ? "bg-primary text-white" : "text-foreground hover:bg-surface-hover")">
                            <div class="flex justify-between items-center gap-2">
                                <span class="text-sm font-medium truncate">@server.Hostname.StripColors()</span>
                                <span class="px-2 py-0.5 rounded text-xs font-mono shrink-0 @(IsSelected(server) ? "bg-white/20 text-white" : "bg-surface-alt text-muted border border-line")">@server.GameName</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <img class="hidden" id="hud_death" src="/images/radar/death.png"/>
</div>
