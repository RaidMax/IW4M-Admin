@implements IDisposable

@*
    Toast notification — one item in the top-right stack. Slides in from the right and
    fades on dismiss. A depleting accent bar tracks the remaining auto-dismiss time and
    pauses on hover (the dismiss timer pauses with it, so a toast you're reading won't
    vanish). Type drives the accent rail, the tinted icon chip, and the bar colour.

    Host-token driven (bg-surface / text-foreground / semantic colours) so plugin-fired
    toasts render correctly inside the host shell. The depleting bar uses the
    `toast-progress` keyframe defined in the host stylesheet (WebfrontCore app.css).
*@
<div class="toast-item group pointer-events-auto relative flex w-full max-w-sm overflow-hidden rounded-xl bg-surface shadow-lg ring-1 ring-black/5 dark:ring-white/10 transition-all duration-300 ease-out @(_isClosing || !_isVisible ? "translate-x-6 opacity-0" : "translate-x-0 opacity-100") motion-reduce:transition-none motion-reduce:translate-x-0"
     role="alert"
     aria-live="@AriaLive"
     @onmouseenter="Pause"
     @onmouseleave="Resume">

    @* Accent rail — full-height colour edge. *@
    <div class="w-1 flex-shrink-0 @RailClass"></div>

    <div class="flex flex-1 items-start gap-3 p-4 min-w-0">
        @* Tinted icon chip. *@
        <div class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg @ChipClass">
            <i class="@GetIcon() text-lg"></i>
        </div>

        @* Body. *@
        <div class="min-w-0 flex-1 pt-0.5">
            @if (!string.IsNullOrEmpty(Message.Title))
            {
                <p class="text-sm font-semibold leading-snug text-foreground">@Message.Title</p>
            }
            <p class="break-words text-sm leading-snug text-subtle @(string.IsNullOrEmpty(Message.Title) ? "" : "mt-0.5")">@Message.Message</p>
        </div>

        @* Close. *@
        <button type="button"
                aria-label="Close"
                class="-mr-1 -mt-1 flex-shrink-0 rounded-md p-1 text-muted transition-colors hover:bg-surface-alt hover:text-foreground focus:outline-none focus:ring-2 focus:ring-primary/40"
                @onclick="Close">
            <i class="ph ph-x text-base"></i>
        </button>
    </div>

    @* Depleting countdown bar — decorative; hidden under reduced-motion, paused on hover. *@
    <div class="absolute bottom-0 left-0 h-0.5 w-full origin-left @BarClass motion-reduce:hidden group-hover:[animation-play-state:paused]"
         style="animation: toast-progress @(Message.Duration)ms linear forwards;"></div>
</div>

@code {
    [Parameter] public required ToastMessage Message { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private System.Threading.Timer? _timer;
    private readonly System.Diagnostics.Stopwatch _elapsed = new();
    private int _remainingMs;
    private bool _isClosing;
    private bool _isVisible;

    protected override void OnInitialized()
    {
        _remainingMs = Message.Duration;
        StartTimer();
    }

    private void StartTimer()
    {
        _elapsed.Restart();
        _timer = new System.Threading.Timer(_ => _ = Close(), null, _remainingMs, Timeout.Infinite);
    }

    // Hover pauses the auto-dismiss: stop the timer and bank the time already burned, so
    // Resume can start a fresh timer for only what's left — keeping it roughly in step with
    // the CSS bar, which pauses in place via group-hover.
    private void Pause()
    {
        if (_isClosing) return;
        _timer?.Dispose();
        _timer = null;
        _remainingMs = Math.Max(0, _remainingMs - (int)_elapsed.ElapsedMilliseconds);
        _elapsed.Stop();
    }

    private void Resume()
    {
        if (_isClosing || _timer is not null) return;
        StartTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Defer the visible state one beat so the entrance transition has a frame to animate from.
            await Task.Delay(10);
            _isVisible = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Close()
    {
        if (_isClosing) return;
        _isClosing = true;

        // Play the exit transition (duration-300) before the container drops the toast.
        await InvokeAsync(StateHasChanged);
        await Task.Delay(300);
        await InvokeAsync(async () => await OnClose.InvokeAsync());
    }

    public void Dispose() => _timer?.Dispose();

    // Errors/warnings interrupt; success/info wait their turn in the screen-reader queue.
    private string AriaLive => Message.Type is ToastType.Error or ToastType.Warning ? "assertive" : "polite";

    private string RailClass => Message.Type switch
    {
        ToastType.Success => "bg-success",
        ToastType.Error => "bg-error",
        ToastType.Warning => "bg-warning",
        _ => "bg-primary"
    };

    private string ChipClass => Message.Type switch
    {
        ToastType.Success => "bg-success/10 text-success",
        ToastType.Error => "bg-error/10 text-error",
        ToastType.Warning => "bg-warning/10 text-warning",
        _ => "bg-primary/10 text-primary"
    };

    private string BarClass => Message.Type switch
    {
        ToastType.Success => "bg-success/60",
        ToastType.Error => "bg-error/60",
        ToastType.Warning => "bg-warning/60",
        _ => "bg-primary/60"
    };

    private string GetIcon() => Message.Type switch
    {
        ToastType.Success => "ph ph-check-circle",
        ToastType.Error => "ph ph-x-circle",
        ToastType.Warning => "ph ph-warning",
        ToastType.Info => "ph ph-info",
        _ => "ph ph-info"
    };
}
