@using Microsoft.JSInterop
@inject IJSRuntime JS

@* Tooltip component — uses fixed positioning via JS to escape overflow
   containers. The tooltipFixed.* JS lives in the host (loaded on every page),
   so this works for plugin pages rendered inside the host shell. Two content modes:
     • Text: plain string, escaped + \n converted to <br> by JS.
     • BodyContent: RenderFragment, rendered to a hidden source div inside
       the wrapper; JS reads its innerHTML on show so consumers get full
       markup control (lists, icons, multiple lines, structured rows). *@
@if (!string.IsNullOrEmpty(Text) || BodyContent is not null)
{
    <div class="tooltip-wrapper @WrapperClass"
         style="@WrapperStyle"
         @ref="_triggerRef"
         @onmouseenter="ShowTooltip"
         @onmouseleave="HideTooltip"
         @onfocus="ShowTooltip"
         @onblur="HideTooltip"
         @onclick="ToggleTooltip"
         @onclick:stopPropagation>
        @ChildContent
        @if (BodyContent is not null)
        {
            @* Source for the rich body; hidden in layout but present in the DOM
               so the tooltip JS can read its innerHTML when showing. Aria-hidden
               so screen readers don't double-announce alongside the trigger. *@
            <div class="hidden" data-tooltip-body aria-hidden="true">@BodyContent</div>
        }
    </div>
}
else
{
    @ChildContent
}

@code {

    public enum TooltipDirection
    {
        Up,
        Down,
        Left,
        Right
    }

    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? BodyContent { get; set; }
    [Parameter] public TooltipDirection Direction { get; set; } = TooltipDirection.Up;
    [Parameter] public string? WrapperClass { get; set; }
    [Parameter] public string? WrapperStyle { get; set; }

    private ElementReference _triggerRef;
    private bool _showMobile;

    private string DirectionString => Direction switch
    {
        TooltipDirection.Down => "down",
        TooltipDirection.Left => "left",
        TooltipDirection.Right => "right",
        _ => "up"
    };

    private async Task ShowTooltip()
    {
        if (string.IsNullOrEmpty(Text) && BodyContent is null) return;
        try
        {
            // BodyContent wins when both are set — rich body is the more
            // specific intent; Text becomes a no-op in that case.
            if (BodyContent is not null)
            {
                await JS.InvokeVoidAsync("tooltipFixed.showRich", _triggerRef, DirectionString);
            }
            else
            {
                await JS.InvokeVoidAsync("tooltipFixed.show", _triggerRef, Text, DirectionString);
            }
        }
        catch
        {
            // Component may have been disposed
        }
    }

    private async Task HideTooltip()
    {
        try
        {
            await JS.InvokeVoidAsync("tooltipFixed.hide");
        }
        catch
        {
            // Component may have been disposed
        }
    }

    private async Task ToggleTooltip()
    {
        _showMobile = !_showMobile;
        if (_showMobile)
        {
            await ShowTooltip();
        }
        else
        {
            await HideTooltip();
        }
    }
}
