<!DOCTYPE html>
<html lang="en" class="h-full antialiased">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    @* ReSharper disable once Razor.UnresolvedComponent *@
    <Environment include="Development">
        <link rel="stylesheet" href="/lib/phosphor-icons/src/regular/style.css" />
        <link rel="stylesheet" href="/lib/phosphor-icons/src/bold/style.css" />
        <link rel="stylesheet" href="/lib/phosphor-icons/src/fill/style.css" />
        <link rel="stylesheet" href="/css/tailwind.css"/>
    </Environment>
    @* ReSharper disable once Razor.UnresolvedComponent *@
    <Environment include="Production">
        <link rel="stylesheet" href="~/css/global.min.css"/>
    </Environment>
    <link rel="icon" type="image/png" href="images/icon.png"/>
    <ImportMap/>
    <HeadOutlet/>
</head>
<body class="h-full bg-slate-900 text-slate-100 dark-mode with-custom-webkit-scrollbars with-custom-css-scrollbars">

<Routes/>
<ReconnectModal/>
@* ReSharper disable once Razor.UnresolvedComponent *@
<Environment include="Development">
    <script src="/lib/jquery/dist/jquery.js"></script>
    <script src="/lib/halfmoon/js/halfmoon.js"></script>
    <script src="/lib/chart.js/dist/Chart.bundle.min.js"></script>
    <script src="/lib/moment.js/min/moment-with-locales.js"></script>
    <script src="/js/blazor_lib.js"></script>
    <script src="/js/stats.js"></script>
    <script src="/js/advanced_stats.js"></script>
    <script src="/js/liveradar.js"></script>
</Environment>
@* ReSharper disable once Razor.UnresolvedComponent *@
<Environment include="Production">
    <script type="text/javascript" src="~/js/global.min.js"></script>
</Environment>
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
