<div class="space-y-5">
    @if (!_adminsList.Any())
    {
        <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
            <i class="ph ph-user-circle text-3xl text-secondary"></i>
            <span>@AppState.Loc("WEBFRONT_DASHBOARD_NO_ADMINS")</span>
        </div>
    }

    @foreach (var server in _adminsList)
    {
        <div>
            <div class="flex items-center gap-2 px-1 pb-2">
                <i class="ph ph-hard-drives text-muted"></i>
                <span class="flex-1 min-w-0 truncate text-[11px] font-semibold uppercase tracking-wider text-muted"><ColorCode Value="@server.Name"/></span>
                <span class="font-mono text-[10px] tracking-[0.12em] uppercase px-1.5 py-0.5 rounded border border-line bg-surface-alt text-subtle shrink-0">
                    @(AppState.Loc($"GAME_{server.Game}"))
                </span>
            </div>
            <div class="rounded-lg border border-line divide-y divide-line overflow-hidden">
                @foreach (var admin in server.Admins)
                {
                    var levelClass = AppState.GetLevelColorClass((EFClient.Permission)admin.LevelInt);
                    <div class="flex items-center gap-3 px-3 py-2 text-sm hover:bg-surface-hover transition-colors">
                        <a href="/client/@admin.ClientId" class="flex-1 min-w-0 truncate font-semibold hover:underline @levelClass">
                            <ColorCode Value="@admin.Name"/>
                        </a>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border border-current bg-transparent shrink-0 @levelClass">
                            @admin.Level
                        </span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject] public required IWebfrontDataService DataService { get; set; }
    [Inject] public required AppState AppState { get; set; }
    private List<ServerAdminsInfo> _adminsList = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAdmins();
    }

    private async Task LoadAdmins()
    {
        try
        {
            _adminsList = (await DataService.GetOnlineAdminsAsync()).ToList();
        }
        catch
        {
            _adminsList = [];
        }
    }

    private static string GetLevelClass(int levelInt) => (EFClient.Permission)levelInt switch
    {
        EFClient.Permission.Console => "bg-level-console/40 text-level-console border border-level-console/60",
        EFClient.Permission.Owner => "bg-level-owner/40 text-level-owner border border-level-owner/60",
        EFClient.Permission.Creator => "bg-level-owner/40 text-level-owner border border-level-owner/60",
        EFClient.Permission.SeniorAdmin => "bg-level-senioradmin/40 text-level-senioradmin border border-level-senioradmin/60",
        EFClient.Permission.Administrator => "bg-level-administrator/40 text-level-administrator border border-level-administrator/60",
        EFClient.Permission.Moderator => "bg-level-moderator/40 text-level-moderator border border-level-moderator/60",
        EFClient.Permission.Trusted => "bg-level-trusted/40 text-level-trusted border border-level-trusted/60",
        _ => "bg-success/10 text-success border border-success/20"
    };

}
