<div class="space-y-5">
    @if (!FlaggedList.Any())
    {
        <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
            <i class="ph ph-check-circle text-3xl text-secondary"></i>
            <span>@AppState.Loc("WEBFRONT_DASHBOARD_NO_FLAGGED")</span>
        </div>
    }

    @foreach (var server in FlaggedList)
    {
        <div>
            <div class="flex items-center gap-2 px-1 pb-2">
                <i class="ph ph-hard-drives text-muted"></i>
                <span class="flex-1 min-w-0 truncate text-[11px] font-semibold uppercase tracking-wider text-muted"><ColorCode Value="@server.Name"/></span>
                <span class="font-mono text-[10px] tracking-[0.12em] uppercase px-1.5 py-0.5 rounded border border-line bg-surface-alt text-subtle shrink-0">
                    @(AppState.Loc($"GAME_{server.Game}"))
                </span>
            </div>
            <div class="rounded-lg border border-line divide-y divide-line overflow-hidden">
                @foreach (var client in server.FlaggedClients)
                {
                    <div class="px-3 py-2.5 text-sm hover:bg-surface-hover transition-colors">
                        <div class="flex items-center gap-3">
                            <a href="/client/@client.ClientId" class="flex-1 min-w-0 truncate font-semibold text-level-flagged hover:underline">
                                <ColorCode Value="@client.Name"/>
                            </a>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-level-flagged/15 text-level-flagged shrink-0">
                                @AppState.Loc("WEBFRONT_STATUS_FLAGGED")
                            </span>
                            <span class="font-mono text-[11px] text-muted whitespace-nowrap shrink-0" title="@client.FlaggedOn.ToLocalTime().ToString("f")">
                                @client.FlaggedOn.HumanizeForCurrentCulture()
                            </span>
                        </div>
                        <div class="mt-1 text-xs text-subtle break-words">@client.Reason</div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject] public required IWebfrontDataService DataService { get; set; }
    [Inject] public required AppState AppState { get; set; }
    private List<ServerFlaggedInfo> FlaggedList = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadFlagged();
    }

    private async Task LoadFlagged()
    {
        try
        {
            FlaggedList = (await DataService.GetOnlineFlaggedAsync()).ToList();
        }
        catch
        {
            FlaggedList = [];
        }
    }
}
