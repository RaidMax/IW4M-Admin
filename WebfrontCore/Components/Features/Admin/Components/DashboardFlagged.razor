<div class="space-y-4">
    @if (!FlaggedList.Any())
    {
        <div class="flex flex-col items-center justify-center py-12 text-center bg-surface-alt/30 rounded-lg border border-line border-dashed">
             <i class="ph ph-check-circle text-4xl text-success mb-3 opacity-80"></i>
             <span class="text-muted font-medium">@AppState.Loc("WEBFRONT_DASHBOARD_NO_FLAGGED")</span>
        </div>
    }

    @foreach (var server in FlaggedList)
    {
        <div class="bg-surface rounded-lg shadow-sm border border-line overflow-hidden mb-4">
            <div class="px-4 py-3 bg-surface-alt/30 border-b border-line font-bold text-foreground flex items-center gap-2">
                 <i class="ph ph-hard-drives text-primary"></i>
                 <span class="truncate"><ColorCode Value="@server.Name"/></span>
                 <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-primary/10 text-primary border border-primary/20 ml-auto">
                     @(AppState.Loc($"GAME_{server.Game}"))
                 </span>
            </div>
            <div class="divide-y divide-line">
                @foreach (var client in server.FlaggedClients)
                {
                    <div class="p-4 hover:bg-surface-hover/30 transition-colors">
                        <div class="flex items-center justify-between mb-2">
                             <div class="flex items-center gap-1.5 text-xs text-muted">
                                 <i class="ph ph-clock"></i>
                                 <span>@client.FlaggedOn.HumanizeForCurrentCulture()</span>
                             </div>
                             <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-level-flagged/10 text-level-flagged border border-level-flagged/20 uppercase tracking-wider">@AppState.Loc("WEBFRONT_STATUS_FLAGGED")</span>
                        </div>
                        
                        <div class="mb-2 text-sm leading-snug">
                             <a href="/client/@client.ClientId" class="font-bold text-foreground hover:text-primary transition-colors">
                                <ColorCode Value="@client.Name"/>
                            </a>
                        </div>
                        
                        <div class="text-xs font-mono bg-surface-alt/50 p-2.5 rounded border border-line text-subtle break-words">
                            @client.Reason
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject] public required IWebfrontDataService DataService { get; set; }
    [Inject] public required AppState AppState { get; set; }
    private List<ServerFlaggedInfo> FlaggedList = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadFlagged();
    }

    private async Task LoadFlagged()
    {
        try
        {
            FlaggedList = (await DataService.GetOnlineFlaggedAsync()).ToList();
        }
        catch
        {
            FlaggedList = [];
        }
    }
}
