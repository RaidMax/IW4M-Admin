@page "/Admin/AuditLog"
@page "/audit"
@attribute [Authorize(Policy = "Permissions.AuditPage.Read")]
@rendermode InteractiveServer

<PageTitle>Audit Log | IW4MAdmin</PageTitle>

<div class="max-w-7xl mx-auto p-4 md:p-8">
    <!-- Header -->
    <div class="mb-8">
        <h2 class="text-3xl font-bold text-slate-100 mb-2">@AppState.Loc("WEBFRONT_NAV_AUDIT_LOG")</h2>
        <p class="text-slate-400">View recent administrative actions and events.</p>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="p-4 mb-4 text-sm text-red-200 rounded-lg bg-red-900/50 border border-red-800" role="alert">
            <div class="flex items-center gap-2">
                <i class="ph ph-warning-circle text-lg"></i>
                <span class="font-medium">Error:</span>
                <span>@_error</span>
            </div>
        </div>
    }
    else if (Results == null)
    {
        <!-- Loading State -->
        <div class="flex flex-col items-center justify-center py-20 text-slate-500 animate-pulse">
            <i class="ph ph-spinner animate-spin text-4xl mb-4 text-blue-500"></i>
            <span class="text-sm">Loading audit logs...</span>
        </div>
    }
    else
    {
        <!-- Desktop Table -->
        <div class="bg-slate-800 rounded-lg overflow-hidden shadow hidden md:block ring-1 ring-slate-700/50">
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-slate-400">
                    <thead class="text-xs text-slate-400 uppercase bg-slate-900/30 border-b border-slate-700">
                        <tr>
                            <th scope="col" class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_TYPE")</th>
                            <th scope="col" class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_ADMIN")</th>
                            <th scope="col" class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_NAME")</th>
                            <th scope="col" class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_INFO")</th>
                            <AuthorizeView Policy="@DataDetailsPolicy">
                                <th scope="col" class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_CURRENT")</th>
                            </AuthorizeView>
                            <th scope="col" class="px-6 py-3 font-medium text-right">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_TIME")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        @foreach (var info in Results)
                        {
                            <tr class="hover:bg-slate-700/30 transition-colors">
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border @GetBadgeClass(info.Action)">
                                        @info.Action
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <a href="/client/@info.OriginId" class="text-blue-400 hover:text-blue-300 font-medium transition-colors">
                                        <ColorCode Value="@info.OriginName"/>
                                    </a>
                                </td>
                                <td class="px-6 py-4">
                                    @if (info.TargetId != null)
                                    {
                                        <a href="/client/@info.TargetId" class="text-blue-400 hover:text-blue-300 font-medium transition-colors">
                                            <ColorCode Value="@info.TargetName"/>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-slate-600">&ndash;</span>
                                    }
                                </td>
                                <td class="px-6 py-4 font-mono text-xs text-slate-300 truncate max-w-xs" title="@info.Data">
                                    @info.Data
                                </td>
                                <AuthorizeView Policy="@DataDetailsPolicy">
                                    <td class="px-6 py-4 font-mono text-xs text-slate-500 truncate max-w-xs" title="@info.NewValue">
                                        @info.NewValue
                                    </td>
                                </AuthorizeView>
                                <td class="px-6 py-4 text-right whitespace-nowrap text-slate-400 text-xs">
                                    @info.When.ToLocalTime().ToString("g")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Mobile Cards -->
        <div class="space-y-4 md:hidden">
            @foreach (var info in Results)
            {
                <div class="bg-slate-800 rounded-lg p-4 shadow ring-1 ring-slate-700/50">
                    <div class="flex items-center justify-between mb-3 border-b border-slate-700 pb-3">
                         <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border @GetBadgeClass(info.Action)">
                            @info.Action
                        </span>
                        <span class="text-xs text-slate-500">@info.When.ToLocalTime().ToString("g")</span>
                    </div>
                    
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-slate-500">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_ADMIN"):</span>
                            <a href="/client/@info.OriginId" class="text-blue-400 hover:text-blue-300 transition-colors text-right">
                                <ColorCode Value="@info.OriginName"/>
                            </a>
                        </div>
                        
                        <div class="flex justify-between">
                             <span class="text-slate-500">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_NAME"):</span>
                            @if (info.TargetId != null)
                            {
                                <a href="/client/@info.TargetId" class="text-blue-400 hover:text-blue-300 transition-colors text-right">
                                    <ColorCode Value="@info.TargetName"/>
                                </a>
                            }
                            else
                            {
                                <span class="text-slate-600">&ndash;</span>
                            }
                        </div>

                        <div class="pt-2 border-t border-slate-700">
                             <span class="block text-xs text-slate-500 mb-1">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_INFO"):</span>
                             <div class="text-slate-300 font-mono text-xs bg-slate-900/50 p-2 rounded break-words border border-slate-700/50">@info.Data</div>
                        </div>
                        
                        <AuthorizeView Policy="@DataDetailsPolicy">
                             <div class="pt-2">
                                 <span class="block text-xs text-slate-500 mb-1">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_CURRENT"):</span>
                                 <div class="text-slate-300 font-mono text-xs bg-slate-900/50 p-2 rounded break-words border border-slate-700/50">@info.NewValue</div>
                            </div>
                        </AuthorizeView>
                    </div>
                </div>
            }
        </div>

        <!-- Infinite scroll trigger element -->
        <div id="loadMoreAuditTrigger" class="w-full text-center mt-8 pb-8">
            @if (IsLoading)
            {
                <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500"></div>
            }
            else if (HasMoreResults)
            {
                 <div class="h-10"></div> <!-- Sentinel spacer -->
            }
        </div>
    }
</div>

