@page "/Admin/AuditLog"
@page "/audit"
@attribute [Authorize(Policy = "Permissions.AuditPage.Read")]
@rendermode InteractiveServer

<PageTitle>Audit Log | IW4MAdmin</PageTitle>

<div class="max-w-7xl mx-auto p-4 md:p-8">
    <!-- Header -->
    <!-- Header -->
    <div class="flex items-center gap-3 mb-8">
        <div class="flex items-center justify-center p-2.5 rounded-lg bg-surface-alt/50 border border-line shadow-sm">
            <i class="ph ph-books text-xl text-primary"></i>
        </div>
        <div>
            <h2 class="text-2xl font-bold text-gradient-title">@AppState.Loc("WEBFRONT_NAV_AUDIT_LOG")</h2>
            <div class="text-sm text-subtle font-medium mt-0.5">View recent administrative actions and events</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="p-4 mb-4 text-sm text-error rounded-lg bg-error/10 border border-error/20" role="alert">
            <div class="flex items-center gap-2">
                <i class="ph ph-warning-circle text-lg"></i>
                <span class="font-medium">Error:</span>
                <span>@_error</span>
            </div>
        </div>
    }
    else if (Results == null)
    {
        <!-- Loading State -->
        <div class="flex flex-col items-center justify-center py-20 text-muted animate-pulse">
            <i class="ph ph-spinner animate-spin text-4xl mb-4 text-primary"></i>
            <span class="text-sm">Loading audit logs...</span>
        </div>
    }
    else
    {
        <!-- Desktop Table -->
        <div class="bg-surface rounded-lg overflow-hidden hidden shadow md:block ring-1 ring-line">
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-muted">
                    <thead class="text-xs text-muted uppercase bg-surface-alt/30 border-b border-line">
                    <tr>
                        <th scope="col"
                            class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_TYPE")</th>
                        <th scope="col"
                            class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_ADMIN")</th>
                        <th scope="col"
                            class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_NAME")</th>
                        <th scope="col"
                            class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_INFO")</th>
                        <AuthorizeView Policy="@DataDetailsPolicy">
                            <th scope="col"
                                class="px-6 py-3 font-medium">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_CURRENT")</th>
                        </AuthorizeView>
                        <th scope="col"
                            class="px-6 py-3 font-medium text-right">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_TIME")</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                    @foreach (var info in Results)
                    {
                        <tr class="hover:bg-surface-hover/30 transition-colors">
                            <td class="px-6 py-4">
                                    <span
                                        class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium border @GetBadgeClass(info.Action)">
                                        @info.Action
                                    </span>
                            </td>
                            <td class="px-6 py-4">
                                <a href="/client/@info.OriginId"
                                   class="text-foreground hover:text-primary font-medium transition-colors">
                                    <ColorCode Value="@info.OriginName"/>
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                @if (info.TargetId != null)
                                {
                                    <a href="/client/@info.TargetId"
                                       class="text-foreground hover:text-primary font-medium transition-colors">
                                        <ColorCode Value="@info.TargetName"/>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-subtle">&ndash;</span>
                                }
                            </td>
                            <td class="px-6 py-4 font-mono text-xs text-subtle truncate max-w-xs" title="@info.Data">
                                @info.Data
                            </td>
                            <AuthorizeView Policy="@DataDetailsPolicy">
                                <td class="px-6 py-4 font-mono text-xs text-muted truncate max-w-xs"
                                    title="@info.NewValue">
                                    @info.NewValue
                                </td>
                            </AuthorizeView>
                            <td class="px-6 py-4 text-right whitespace-nowrap text-muted text-xs">
                                @info.When.ToLocalTime().ToString("g")
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Mobile Cards -->
        <div class="space-y-4 md:hidden">
            @foreach (var info in Results)
            {
                <div class="bg-surface border border-line rounded-lg p-4 shadow-sm">
                    <!-- Header: Actors (Left) & Meta (Right) -->
                    <div class="flex justify-between items-start mb-3">
                        <div class="text-sm flex flex-wrap items-center gap-1 leading-snug font-bold pr-2">
                            <a href="/client/@info.OriginId" class="text-foreground hover:text-primary transition-colors">
                                <ColorCode Value="@info.OriginName"/>
                            </a>
                            
                            @if (info.TargetId != null)
                            {
                                <span class="text-muted text-xs"><i class="ph ph-caret-right"></i></span>
                                <a href="/client/@info.TargetId" class="text-foreground hover:text-primary transition-colors">
                                    <ColorCode Value="@info.TargetName"/>
                                </a>
                            }
                        </div>

                        <div class="flex flex-col items-end gap-1 shrink-0">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border uppercase tracking-wider @GetBadgeClass(info.Action)">
                                @info.Action
                            </span>
                            <span class="text-[10px] text-muted">@info.When.ToLocalTime().ToString("g")</span>
                        </div>
                    </div>

                    <!-- Data Content -->
                    <div class="text-xs font-mono bg-surface-alt/50 p-2.5 rounded border border-line break-words text-subtle">
                        @info.Data
                    </div>

                    <!-- New Value (Optional) -->
                    <AuthorizeView Policy="@DataDetailsPolicy">
                        @if (!string.IsNullOrWhiteSpace(info.NewValue))
                        {
                            <div class="mt-2 text-xs font-mono bg-surface-alt/50 p-2.5 rounded border border-line break-words text-subtle">
                                <span class="block text-[10px] text-muted uppercase tracking-wider mb-1">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_CURRENT")</span>
                                @info.NewValue
                            </div>
                        }
                    </AuthorizeView>
                </div>
            }
        </div>

        <!-- Infinite scroll trigger element -->
        <div id="loadMoreAuditTrigger" class="w-full text-center mt-8 pb-8">
            @if (IsLoading)
            {
                <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div>
            }
            else if (HasMoreResults)
            {
                <div class="h-10"></div>
                <!-- Sentinel spacer -->
            }
        </div>
    }
</div>
