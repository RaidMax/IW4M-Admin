@page "/Admin/AuditLog"
@page "/audit"
@attribute [Authorize(Policy = "Permissions.AuditPage.Read")]
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_NAV_AUDIT_LOG") | @AppState.WebfrontBranding</PageTitle>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
    <!-- Heading -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@AppState.Loc("WEBFRONT_NAV_AUDIT_LOG")</h1>
            <p class="text-sm text-muted mt-0.5">@AppState.Loc("WEBFRONT_AUDIT_SUBTITLE")</p>
        </div>
        <div class="ml-auto flex items-center gap-2">
            <ToggleSwitch Id="groupByActionToggle"
                          Label="@AppState.Loc("WEBFRONT_AUDIT_GROUP_BY_ACTION")"
                          Value="@_groupByAction"
                          ValueChanged="OnGroupByChanged" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="flex items-center gap-2 p-4 rounded-xl bg-error/10 border border-error/20 text-sm text-error" role="alert">
            <i class="ph ph-warning-circle text-lg"></i>
            <span class="font-semibold">@AppState.Loc("WEBFRONT_AUDIT_ERROR")</span>
            <span>@_error</span>
        </div>
    }
    else
    {
        <!-- Stat tiles -->
        @if (Statistics != null)
        {
            <div class="grid grid-cols-2 xl:grid-cols-4 gap-3">
                <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                    <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_AUDIT_STAT_TOTAL")</div>
                    <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none">@Statistics.TotalCount.ToString("N0")</div>
                    <div class="mt-1.5 text-xs text-muted"><i class="ph ph-list-checks mr-1"></i>@AppState.LocOr("WEBFRONT_AUDIT_STAT_TOTAL_DESC", "matching current filters")</div>
                </div>
                <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                    <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_AUDIT_STAT_PERMISSION")</div>
                    <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none">
                        @(Statistics.CountByActionType.GetValueOrDefault(Data.Models.EFChangeHistory.ChangeType.Permission, 0).ToString("N0"))
                    </div>
                    <div class="mt-1.5 text-xs text-muted"><i class="ph ph-shield-check mr-1"></i>@AppState.LocOr("WEBFRONT_AUDIT_STAT_PERMISSION_DESC", "level changes")</div>
                </div>
                <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                    <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_AUDIT_STAT_COMMANDS")</div>
                    <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none">
                        @(Statistics.CountByActionType.GetValueOrDefault(Data.Models.EFChangeHistory.ChangeType.Command, 0).ToString("N0"))
                    </div>
                    <div class="mt-1.5 text-xs text-muted"><i class="ph ph-terminal mr-1"></i>@AppState.LocOr("WEBFRONT_AUDIT_STAT_COMMANDS_DESC", "commands executed")</div>
                </div>
                <div class="rounded-xl bg-surface border border-line px-4 py-3.5 min-w-0">
                    <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_AUDIT_STAT_MOST_ACTIVE")</div>
                    @if (Statistics.MostActiveAdmins.Count > 0)
                    {
                        var topAdmin = Statistics.MostActiveAdmins.First();
                        <a href="/client/@topAdmin.ClientId" class="mt-1 block text-xl font-extrabold tracking-tight leading-none truncate text-foreground hover:text-primary transition-colors">
                            <ColorCode Value="@topAdmin.Name"/>
                        </a>
                        <div class="mt-1.5 text-xs text-muted font-mono tabular-nums"><i class="ph ph-crown mr-1"></i>#@topAdmin.ClientId</div>
                    }
                    else
                    {
                        <div class="mt-1 text-2xl font-extrabold tracking-tight leading-none text-muted">&ndash;</div>
                        <div class="mt-1.5 text-xs text-muted"><i class="ph ph-crown mr-1"></i>@AppState.LocOr("WEBFRONT_AUDIT_STAT_MOST_ACTIVE_NONE", "no activity yet")</div>
                    }
                </div>
            </div>
        }

        <!-- Filters -->
        <section class="rounded-xl bg-surface border border-line overflow-hidden">
            <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.LocOr("WEBFRONT_AUDIT_FILTERS", "Filters")</h2>
            </div>
            <div class="p-4 space-y-4">
                <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-6">
                    <!-- Search -->
                    <div class="xl:col-span-2">
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_AUDIT_FILTER_SEARCH")</label>
                        <div class="relative">
                            <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none"></i>
                            <input type="text"
                                   @bind="_searchQuery"
                                   @bind:event="oninput"
                                   @onkeydown="HandleSearchKeyDown"
                                   placeholder="@AppState.Loc("WEBFRONT_AUDIT_SEARCH_PLACEHOLDER")"
                                   class="block w-full h-10 pl-9 pr-3 rounded-lg bg-background border border-line text-sm text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"/>
                        </div>
                    </div>

                    <!-- Admin ID -->
                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_AUDIT_FILTER_ADMIN_ID")</label>
                        <input type="number"
                               @bind="_originId"
                               placeholder="ID"
                               class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm font-mono tabular-nums text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"/>
                    </div>

                    <!-- Target ID -->
                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_AUDIT_FILTER_TARGET_ID")</label>
                        <input type="number"
                               @bind="_targetId"
                               placeholder="ID"
                               class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm font-mono tabular-nums text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"/>
                    </div>

                    <!-- Date From -->
                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_AUDIT_FILTER_FROM")</label>
                        <input type="date"
                               @bind="_dateFrom"
                               class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm text-foreground focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"/>
                    </div>

                    <!-- Date To -->
                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_AUDIT_FILTER_TO")</label>
                        <input type="date"
                               @bind="_dateTo"
                               class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm text-foreground focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"/>
                    </div>
                </div>

                <div class="flex flex-wrap items-end gap-4">
                    <!-- Action Types -->
                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_AUDIT_FILTER_ACTION_TYPE")</label>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var actionType in AvailableActionTypes)
                            {
                                var isSelected = _selectedActionTypes.Contains(actionType);
                                <button type="button"
                                        @onclick="() => ToggleActionType(actionType)"
                                        class="px-3 py-1.5 rounded-full border text-xs font-semibold transition-colors @(isSelected ? "border-primary text-primary bg-primary/10" : "border-line bg-surface text-subtle hover:text-foreground")">
                                    @actionType.ToString()
                                    @if (Statistics != null)
                                    {
                                        <span class="font-mono text-muted ml-1">@Statistics.CountByActionType.GetValueOrDefault(actionType, 0).ToString("N0")</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Apply / Clear -->
                    <div class="ml-auto flex items-center gap-2">
                        <button type="button" @onclick="ClearFilters"
                                class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-line bg-surface-alt text-sm font-semibold text-foreground hover:bg-surface-hover transition-colors">
                            <i class="ph ph-x text-base"></i>
                            @AppState.Loc("WEBFRONT_FILTER_CLEAR")
                        </button>
                        <button type="button" @onclick="ApplyFilters"
                                class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg bg-primary text-sm font-semibold text-white hover:brightness-110 transition">
                            <i class="ph ph-funnel text-base"></i>
                            @AppState.Loc("WEBFRONT_AUDIT_FILTER_APPLY")
                        </button>
                    </div>
                </div>
            </div>
        </section>

        @if (Results.Count == 0 && !_isLoading)
        {
            <!-- Empty state -->
            <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
                <i class="ph ph-tray text-3xl text-secondary"></i>
                <span>@AppState.Loc("WEBFRONT_AUDIT_NO_RESULTS")</span>
            </div>
        }
        else if (_groupByAction && Results.Count > 0)
        {
            <!-- Grouped view -->
            <div class="space-y-3">
                @foreach (var group in Results.GroupBy(r => r.Action))
                {
                    var isCollapsed = IsGroupCollapsed(group.Key);
                    <section class="rounded-xl bg-surface border border-line overflow-hidden">
                        <button type="button"
                                @onclick="() => ToggleGroupCollapsed(group.Key)"
                                @onclick:stopPropagation="true"
                                class="w-full flex items-center gap-3 px-4 py-2.5 text-left hover:bg-surface-hover transition-colors @(isCollapsed ? "" : "border-b border-line")">
                            <i class="ph-bold @(isCollapsed ? "ph-caret-right" : "ph-caret-down") text-muted"></i>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border @GetBadgeClass(group.Key)">
                                @HighlightSearchTerm(group.Key)
                            </span>
                            <span class="text-xs text-muted">@(AppState.Loc("WEBFRONT_AUDIT_ENTRIES").FormatExt(group.Count()))</span>
                        </button>
                        @if (!isCollapsed)
                        {
                            @RenderAuditTable(group.ToList())
                        }
                    </section>
                }
            </div>
        }
        else if (Results.Count > 0)
        {
            <!-- Table view -->
            <section class="rounded-xl bg-surface border border-line overflow-hidden">
                @RenderAuditTable(Results)
            </section>
        }

        <!-- Infinite scroll trigger -->
        <div id="loadMoreAuditTrigger" class="w-full flex items-center justify-center py-6">
            @if (_isLoading)
            {
                <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div>
            }
            else if (HasMoreResults)
            {
                <div class="h-10"></div>
            }
        </div>
    }
</div>

@code {
    private RenderFragment RenderAuditTable(List<AuditInfo> items) => __builder =>
    {
        <div class="overflow-x-auto hidden md:block">
            <table class="w-full text-sm">
                <thead>
                <tr class="text-[10px] font-semibold uppercase tracking-wider text-muted">
                    <th scope="col" class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_TYPE")</th>
                    <th scope="col" class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_ORIGIN_IP")</th>
                    <th scope="col" class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_ADMIN")</th>
                    <th scope="col" class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_NAME")</th>
                    <th scope="col" class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_INFO")</th>
                    <AuthorizeView Policy="@DataDetailsPolicy">
                        <th scope="col" class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_CURRENT")</th>
                    </AuthorizeView>
                    <th scope="col" class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADMIN_AUDIT_LOG_TIME")</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-line">
                @foreach (var info in items)
                {
                    <tr class="hover:bg-surface-hover transition-colors">
                        <td class="px-4 py-2.5 align-middle">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border @GetBadgeClass(info.Action)">
                                @HighlightSearchTerm(info.Action)
                            </span>
                        </td>
                        <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-xs text-muted whitespace-nowrap">
                            @(string.IsNullOrEmpty(info.OriginIPAddress) ? "–" : info.OriginIPAddress)
                        </td>
                        <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                            <a href="/client/@info.OriginId" class="font-semibold text-foreground hover:text-primary transition-colors">
                                <ColorCode Value="@info.OriginName"/>
                            </a>
                            <span class="ml-1 font-mono tabular-nums text-xs text-muted">#@info.OriginId</span>
                        </td>
                        <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                            @if (info.TargetId != null)
                            {
                                <a href="/client/@info.TargetId" class="font-semibold text-foreground hover:text-primary transition-colors">
                                    <ColorCode Value="@info.TargetName"/>
                                </a>
                                <span class="ml-1 font-mono tabular-nums text-xs text-muted">#@info.TargetId</span>
                            }
                            else
                            {
                                <span class="text-muted">&ndash;</span>
                            }
                        </td>
                        <td class="px-4 py-2.5 align-middle font-mono text-xs text-subtle max-w-xs">
                            <div class="truncate" title="@info.Data">@HighlightSearchTerm(info.Data)</div>
                        </td>
                        <AuthorizeView Policy="@DataDetailsPolicy">
                            <td class="px-4 py-2.5 align-middle font-mono text-xs max-w-32">
                                @if (!string.IsNullOrWhiteSpace(info.NewValue) && info.NewValue != "--")
                                {
                                    <div class="truncate text-success" title="@info.NewValue">@HighlightSearchTerm(info.NewValue)</div>
                                }
                                else
                                {
                                    <span class="text-muted">&ndash;</span>
                                }
                            </td>
                        </AuthorizeView>
                        <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums text-xs text-muted whitespace-nowrap">
                            @info.When.ToLocalTime().ToString("g")
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="md:hidden divide-y divide-line">
            @foreach (var info in items)
            {
                <div class="px-4 py-3 space-y-2 text-sm">
                    <div class="flex items-center justify-between gap-2">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border @GetBadgeClass(info.Action)">
                            @HighlightSearchTerm(info.Action)
                        </span>
                        <span class="font-mono tabular-nums text-[11px] text-muted whitespace-nowrap">@info.When.ToLocalTime().ToString("g")</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-muted w-14 shrink-0">@AppState.Loc("WEBFRONT_AUDIT_ADMIN")</span>
                        <a href="/client/@info.OriginId" class="font-semibold text-foreground hover:text-primary transition-colors truncate">
                            <ColorCode Value="@info.OriginName"/> <span class="font-mono text-xs text-muted font-normal">#@info.OriginId</span>
                        </a>
                    </div>

                    @if (!string.IsNullOrEmpty(info.OriginIPAddress))
                    {
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-semibold uppercase tracking-wider text-muted w-14 shrink-0">@AppState.Loc("WEBFRONT_AUDIT_IP")</span>
                            <span class="font-mono tabular-nums text-xs text-muted">@info.OriginIPAddress</span>
                        </div>
                    }

                    @if (info.TargetId != null)
                    {
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-semibold uppercase tracking-wider text-muted w-14 shrink-0">@AppState.Loc("WEBFRONT_AUDIT_TARGET")</span>
                            <a href="/client/@info.TargetId" class="font-semibold text-foreground hover:text-primary transition-colors truncate">
                                <ColorCode Value="@info.TargetName"/> <span class="font-mono text-xs text-muted font-normal">#@info.TargetId</span>
                            </a>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(info.Data))
                    {
                        <div class="font-mono text-xs text-subtle break-words">
                            @HighlightSearchTerm(info.Data)
                        </div>
                    }

                    <AuthorizeView Policy="@DataDetailsPolicy">
                        @if (!string.IsNullOrWhiteSpace(info.NewValue) && info.NewValue != "--")
                        {
                            <div class="flex gap-2 pt-2 border-t border-line">
                                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted w-14 shrink-0 pt-0.5">@AppState.Loc("WEBFRONT_AUDIT_CURRENT")</span>
                                <span class="font-mono text-xs text-success break-all">@HighlightSearchTerm(info.NewValue)</span>
                            </div>
                        }
                    </AuthorizeView>
                </div>
            }
        </div>
    };
}
