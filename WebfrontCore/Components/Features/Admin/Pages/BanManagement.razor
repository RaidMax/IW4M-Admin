@page "/Admin/BanManagement"
@page "/manage-bans"
@implements IAsyncDisposable
@attribute [Authorize(Policy = "Permissions.BanManagementPage.Read")]
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_NAV_TITLE_BAN_MANAGEMENT") | @AppState.WebfrontBranding</PageTitle>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
    <!-- Heading -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@AppState.Loc("WEBFRONT_NAV_TITLE_BAN_MANAGEMENT")</h1>
            <p class="text-sm text-muted mt-0.5">
                @if (HasSearched && TotalCount > 0)
                {
                    <span>@(AppState.Loc("WEBFRONT_BAN_MGMT_BANS_FOUND").FormatExt(TotalCount.ToString("#,##0")))</span>
                }
                else
                {
                    <span>@AppState.Loc("WEBFRONT_BAN_MGMT_SEARCH_HINT")</span>
                }
            </p>
        </div>
    </div>

    <!-- Unban Modal -->
    @if (_showUnbanModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4" role="dialog" aria-modal="true">
            <div class="fixed inset-0 bg-black/50 backdrop-blur-sm"></div>
            <div class="relative w-full max-w-md rounded-xl bg-surface border border-line shadow-xl overflow-hidden">
                <div class="flex items-center gap-3 px-4 py-3 border-b border-line">
                    <h2 class="flex-1 text-base font-bold text-foreground">@AppState.Loc("WEBFRONT_ACTION_UNBAN_NAME")</h2>
                    <button type="button" class="w-9 h-9 rounded-lg flex items-center justify-center text-muted hover:text-foreground hover:bg-surface-hover transition-colors" @onclick="CloseUnbanModal" title="@AppState.Loc("WEBFRONT_MODAL_BUTTON_CANCEL")">
                        <i class="ph ph-x text-base"></i>
                    </button>
                </div>

                <div class="p-4">
                    <label for="unbanReason" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                        @AppState.Loc("WEBFRONT_ACTION_LABEL_REASON")
                    </label>
                    <input type="text" id="unbanReason" @bind="_unbanReason"
                           class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                           placeholder="@AppState.Loc("WEBFRONT_PENALTY_LIST_BAN_REVOKED_REASON")" />
                </div>

                <div class="flex items-center justify-end gap-2 px-4 py-3 border-t border-line">
                    <button type="button"
                            class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-line bg-surface-alt text-sm font-semibold text-foreground hover:bg-surface-hover transition-colors"
                            @onclick="CloseUnbanModal">
                        @AppState.Loc("WEBFRONT_MODAL_BUTTON_CANCEL")
                    </button>
                    <button type="button"
                            class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-error/40 bg-surface-alt text-sm font-semibold text-error hover:bg-error/10 transition-colors"
                            @onclick="ConfirmUnban">
                        <i class="ph ph-arrow-u-up-left text-base"></i>
                        @AppState.Loc("WEBFRONT_ACTION_UNBAN_NAME")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Search -->
    <section class="rounded-xl bg-surface border border-line overflow-hidden">
        <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
            <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_BAN_MGMT_START_SEARCH")</h2>
        </div>
        <EditForm Model="Request" OnValidSubmit="Search" class="p-4">
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                <!-- Client Name -->
                <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_NAME")</label>
                    <div class="relative">
                        <i class="ph ph-user absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none"></i>
                        <InputText @bind-Value="Request.ClientName"
                                   class="block w-full h-10 pl-9 pr-3 rounded-lg bg-background border border-line text-sm text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                                   placeholder="@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_NAME")" />
                    </div>
                </div>

                <!-- Client GUID -->
                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientGuid}.{WebfrontPermission.Read}")" Context="guidContext">
                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_GUID")</label>
                        <div class="relative">
                            <i class="ph ph-fingerprint absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none"></i>
                            <InputText @bind-Value="Request.ClientGuid"
                                       class="block w-full h-10 pl-9 pr-3 rounded-lg bg-background border border-line text-sm font-mono text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                                       placeholder="@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_GUID")" />
                        </div>
                    </div>
                </AuthorizeView>

                <!-- Client IP -->
                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")" Context="IpContext">
                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_IP")</label>
                        <div class="relative">
                            <i class="ph ph-globe absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none"></i>
                            <InputText @bind-Value="Request.ClientIP"
                                       class="block w-full h-10 pl-9 pr-3 rounded-lg bg-background border border-line text-sm font-mono text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                                       placeholder="@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_IP")" />
                        </div>
                    </div>
                </AuthorizeView>

                <!-- Client ID -->
                <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_ID")</label>
                    <div class="relative">
                        <i class="ph ph-identification-card absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none"></i>
                        <InputNumber @bind-Value="Request.ClientId"
                                     class="block w-full h-10 pl-9 pr-3 rounded-lg bg-background border border-line text-sm font-mono tabular-nums text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                                     placeholder="@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_ID")" />
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end mt-4">
                <button type="submit"
                        class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg bg-primary text-sm font-semibold text-white hover:brightness-110 transition">
                    <i class="ph ph-magnifying-glass text-base"></i>
                    @AppState.LocOr("WEBFRONT_BAN_MGMT_ACTION_SEARCH", "Search")
                </button>
            </div>
        </EditForm>
    </section>

    @if (!string.IsNullOrEmpty(ValidationError))
    {
        <div class="flex items-center gap-2 p-4 rounded-xl bg-error/10 border border-error/20 text-sm text-error" role="alert">
            <i class="ph ph-warning-circle text-lg"></i>
            <span>@ValidationError</span>
        </div>
    }

    <!-- Results -->
    <div id="ban_entry_list">
        @if (!HasSearched)
        {
            <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
                <i class="ph ph-magnifying-glass text-3xl text-secondary"></i>
                <span class="font-semibold text-foreground">@AppState.Loc("WEBFRONT_BAN_MGMT_START_SEARCH")</span>
                <span class="max-w-xs text-center">@AppState.Loc("WEBFRONT_BAN_MGMT_SEARCH_HINT")</span>
            </div>
        }
        else if (Results == null)
        {
            <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
        }
        else if (!Results.Any())
        {
            <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
                <i class="ph ph-tray text-3xl text-secondary"></i>
                <span class="font-semibold text-foreground">@AppState.Loc("WEBFRONT_BAN_MGMT_NO_RESULTS")</span>
                <span class="max-w-xs text-center">@AppState.Loc("WEBFRONT_BAN_MGMT_NO_RESULTS_HINT")</span>
            </div>
        }
        else
        {
            <section class="rounded-xl bg-surface border border-line overflow-hidden">
                <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                    <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.LocOr("WEBFRONT_BAN_MGMT_RESULTS", "Results")</h2>
                    <span class="text-xs text-muted font-mono tabular-nums">@Results.Count.ToString("#,##0") / @TotalCount.ToString("#,##0")</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                        <tr class="text-[10px] font-semibold uppercase tracking-wider text-muted">
                            <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_NAME")</th>
                            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientGuid}.{WebfrontPermission.Read}")" Context="guidHeaderContext">
                                <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_GUID")</th>
                            </AuthorizeView>
                            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")" Context="ipHeaderContext">
                                <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_BAN_MGMT_FORM_IP")</th>
                            </AuthorizeView>
                            <th class="text-left px-4 py-2.5 border-b border-line">@AppState.LocOr("WEBFRONT_BAN_MGMT_COLUMN_OFFENSE", "Offense")</th>
                            <th class="text-left px-4 py-2.5 border-b border-line">@AppState.LocOr("WEBFRONT_BAN_MGMT_COLUMN_DATE", "Date")</th>
                            <th class="text-right px-4 py-2.5 border-b border-line"></th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-line">
                        @foreach (var ban in Results)
                        {
                            <tr class="hover:bg-surface-hover transition-colors">
                                <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <a href="/client/@ban.ClientId" class="font-semibold text-foreground hover:text-primary transition-colors">
                                            <ColorCode Value="@ban.ClientName" />
                                        </a>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-alt text-subtle" title="@AppState.Loc($"GAME_{ban.Game}")">
                                            @Utilities.MakeAbbreviation(AppState.Loc($"GAME_{ban.Game}"))
                                        </span>
                                    </div>
                                </td>
                                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientGuid}.{WebfrontPermission.Read}")" Context="guidCellContext">
                                    <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-xs text-muted whitespace-nowrap">@ban.NetworkId.ToString("X")</td>
                                </AuthorizeView>
                                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")" Context="ipCellContext">
                                    <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-xs text-muted whitespace-nowrap">@ban.IPAddress.ConvertIPtoString()</td>
                                </AuthorizeView>
                                <td class="px-4 py-2.5 align-middle">
                                    @if (ban.AttachedPenalty is not null)
                                    {
                                        <div class="flex items-center gap-2">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-error/15 text-error">@AppState.LocOr("WEBFRONT_PENALTY_BAN", "Ban")</span>
                                            <span class="text-foreground"><ColorCode Value="@ban.AttachedPenalty.Offense" /></span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-warning/15 text-warning">
                                            <i class="ph ph-warning"></i>
                                            @AppState.Loc("WEBFRONT_BAN_MGMT_LINK_ONLY")
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-xs text-muted whitespace-nowrap">
                                    @if (ban.AttachedPenalty is not null)
                                    {
                                        <span>@(ban.AttachedPenalty.DateTime.HasValue ? ban.AttachedPenalty.DateTime.Value.ToLocalTime().ToString("g") : AppState.Loc("WEBFRONT_SELECTION_PERMANENT"))</span>
                                    }
                                    else
                                    {
                                        <span>&ndash;</span>
                                    }
                                </td>
                                <td class="px-4 py-2.5 align-middle text-right whitespace-nowrap">
                                    @if (ban.AttachedPenalty is not null)
                                    {
                                        <button type="button" @onclick="() => OpenUnbanModal(ban.ClientId)"
                                                class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-error/40 bg-surface-alt text-sm font-semibold text-error hover:bg-error/10 transition-colors">
                                            <i class="ph ph-arrow-u-up-left text-base"></i>
                                            @AppState.Loc("WEBFRONT_BAN_MGMT_ACTION_UNBAN")
                                        </button>
                                    }
                                </td>
                            </tr>

                            foreach (var associatedEntity in ban.AssociatedPenalties)
                            {
                                <tr class="bg-surface-alt/40 hover:bg-surface-hover transition-colors">
                                    <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                        <div class="flex items-center gap-2 pl-4">
                                            <i class="ph ph-link text-muted" title="@AppState.Loc("WEBFRONT_BAN_MGMT_LINKED_ACCOUNTS")"></i>
                                            <a href="/client/@associatedEntity.OffenderInfo.ClientId" class="font-semibold text-foreground hover:text-primary transition-colors">
                                                <ColorCode Value="@associatedEntity.OffenderInfo.ClientName" />
                                            </a>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-alt text-subtle" title="@AppState.Loc($"GAME_{ban.Game}")">
                                                @Utilities.MakeAbbreviation(AppState.Loc($"GAME_{ban.Game}"))
                                            </span>
                                        </div>
                                    </td>
                                    <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientGuid}.{WebfrontPermission.Read}")" Context="guidLinkedContext">
                                        <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-xs text-muted whitespace-nowrap">@associatedEntity.OffenderInfo.NetworkId?.ToString("X")</td>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")" Context="ipLinkedContext">
                                        <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-xs text-muted whitespace-nowrap">@associatedEntity.OffenderInfo.IPAddress.ConvertIPtoString()</td>
                                    </AuthorizeView>
                                    <td class="px-4 py-2.5 align-middle">
                                        <div class="flex items-center gap-2">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-alt text-subtle">@AppState.Loc("WEBFRONT_BAN_MGMT_LINKED_ACCOUNTS")</span>
                                            <span class="text-foreground"><ColorCode Value="@associatedEntity.Offense" /></span>
                                        </div>
                                    </td>
                                    <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-xs text-muted whitespace-nowrap">
                                        @(associatedEntity.DateTime.HasValue ? associatedEntity.DateTime.Value.ToLocalTime().ToString("d") : "")
                                    </td>
                                    <td class="px-4 py-2.5 align-middle text-right whitespace-nowrap">
                                        <button type="button" @onclick="() => OpenUnbanModal(associatedEntity.OffenderInfo.ClientId ?? 0)"
                                                class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-error/40 bg-surface-alt text-sm font-semibold text-error hover:bg-error/10 transition-colors">
                                            <i class="ph ph-arrow-u-up-left text-base"></i>
                                            @AppState.Loc("WEBFRONT_BAN_MGMT_ACTION_UNBAN")
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>

    <!-- Infinite Scroll Trigger -->
    <div class="w-full flex flex-col items-center justify-center gap-2 py-6">
        @if (HasMoreResults && Results != null && Results.Any())
        {
            <div id="loadMoreBansTrigger" class="flex items-center justify-center py-4">
                @if (IsLoading)
                {
                    <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div>
                }
            </div>
        }
        @if (!HasMoreResults && Results != null && Results.Any())
        {
            <div class="text-xs text-muted font-mono tabular-nums">
                <i class="ph ph-check-circle text-success mr-1"></i>
                @Results.Count.ToString("#,##0") / @TotalCount.ToString("#,##0")
            </div>
        }
    </div>
</div>
