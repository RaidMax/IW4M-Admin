@page "/Configuration/Files"
@page "/configuration"
@attribute [Authorize(Roles = "Owner")]
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_CONFIGURATION_TITLE") | @AppState.WebfrontBranding</PageTitle>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
    <!-- Heading -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@AppState.Loc("WEBFRONT_CONFIGURATION_TITLE")</h1>
            <p class="text-sm text-muted mt-0.5">@AppState.Loc("WEBFRONT_CONFIGURATION_SAVING_CHANGES")</p>
        </div>
    </div>

    @if (ConfigurationFiles == null)
    {
        <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
    }
    else if (!ConfigurationFiles.Any())
    {
        <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
            <i class="ph ph-tray text-3xl text-secondary"></i>
            <span>@AppState.LocOr("WEBFRONT_CONFIGURATION_NO_FILES", "No configuration files found")</span>
        </div>
    }
    else
    {
        <!-- File selector -->
        <div class="inline-flex gap-1 p-1 rounded-lg bg-surface border border-line max-w-full overflow-x-auto">
            @foreach (var file in ConfigurationFiles.OrderByDescending(f => f.FileName.Contains("IW4MAdmin")))
            {
                var isActive = ExpandedFiles.Contains(file.FileName);
                <button type="button"
                        @onclick="@(() => ToggleFile(file))"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium whitespace-nowrap transition-colors @(isActive ? "bg-surface-alt text-foreground shadow-sm" : "text-subtle hover:text-foreground hover:bg-surface-hover")">
                    <i class="ph ph-file-code text-base"></i>
                    <span class="font-mono">@file.FileName</span>
                </button>
            }
        </div>

        @if (!ExpandedFiles.Any())
        {
            <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
                <i class="ph ph-file-code text-3xl text-secondary"></i>
                <span>@AppState.LocOr("WEBFRONT_CONFIGURATION_SELECT_FILE", "Select a file to edit")</span>
            </div>
        }

        @foreach (var file in ConfigurationFiles.OrderByDescending(f => f.FileName.Contains("IW4MAdmin")))
        {
            var isExpanded = ExpandedFiles.Contains(file.FileName);

            if (isExpanded)
            {
                <section class="rounded-xl bg-surface border border-line overflow-hidden">
                    <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                        <h2 class="flex-1 min-w-0 truncate text-[11px] font-semibold uppercase tracking-wider text-muted">
                            <span class="font-mono normal-case tracking-normal text-foreground text-sm">@file.FileName</span>
                        </h2>
                        @if (!string.IsNullOrEmpty(SaveStatus[file.FileName]))
                        {
                            <span class="text-xs font-medium @(SaveStatus[file.FileName].Contains("Error") ? "text-error" : "text-success")">
                                @SaveStatus[file.FileName]
                            </span>
                        }
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-alt text-subtle">
                            <i class="ph ph-brackets-curly"></i>
                            @AppState.Loc("WEBFRONT_CONFIG_JSON")
                        </span>
                    </div>

                    <div class="p-4">
                        <textarea @bind="file.FileContent"
                                  spellcheck="false"
                                  class="block w-full min-h-[28rem] p-3 rounded-lg bg-background border border-line text-sm font-mono leading-relaxed text-foreground resize-y focus:outline-none focus:border-primary"></textarea>
                    </div>

                    <div class="flex items-center justify-end gap-2 px-4 py-3 border-t border-line">
                        <button type="button"
                                @onclick="@(() => ToggleFile(file))"
                                class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-line bg-surface-alt text-sm font-semibold text-foreground hover:bg-surface-hover transition-colors">
                            @AppState.Loc("WEBFRONT_ACTION_MODAL_BUTTON_CLOSE")
                        </button>
                        <button type="button"
                                @onclick="() => SaveFile(file)"
                                class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg bg-primary text-sm font-semibold text-white hover:brightness-110 transition">
                            <i class="ph ph-floppy-disk text-base"></i>
                            @AppState.Loc("WEBFRONT_CONFIGURATION_BUTTON_SAVE")
                        </button>
                    </div>
                </section>
            }
        }
    }
</div>
