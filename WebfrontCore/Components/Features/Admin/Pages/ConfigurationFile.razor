@page "/Configuration/Files"
@attribute [Authorize(Policy = "Permissions.ConfigurationPage.Read")]
@rendermode InteractiveServer

<div class="content mt-0">
    <h4 class="content-title mt-20 mb-0">@AppState.Loc("WEBFRONT_CONFIGURATION_TITLE")</h4>
    <span class="text-muted">@AppState.Loc("WEBFRONT_CONFIGURATION_SAVING_CHANGES")</span>

    @if (ConfigurationFiles == null)
    {
         <div class="text-center mt-20">
            <div class="spinner-border text-primary" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    }
    else
    {
        foreach (var file in ConfigurationFiles.OrderByDescending(f => f.FileName.Contains("IW4MAdmin")))
        {
             <div class="card m-0 p-0 mt-20 mb-20">
                <div class="bg-primary p-10 rounded-top text-light d-flex justify-content-between align-items-center" @onclick="@(() => ToggleFile(file))" style="cursor: pointer;">
                    <div>
                        <i class="oi oi-expand-down mr-5" ></i>
                        <span>@file.FileName</span>
                    </div>
                </div>
                @if (ExpandedFiles.Contains(file.FileName))
                {
                    <div class="edit-file d-flex flex-column p-0">
                        <textarea class="form-control bg-dark-dm bg-light-lm border-0 font-size-12" style="font-family: monospace; min-height: 300px;" @bind="file.FileContent"></textarea>
                        <div class="d-flex justify-content-between p-15">
                             <button type="button" class="btn btn-primary" @onclick="() => SaveFile(file)">@AppState.Loc("WEBFRONT_CONFIGURATION_BUTTON_SAVE")</button>
                             @if (!string.IsNullOrEmpty(SaveStatus[file.FileName]))
                             {
                                 <span class="text-success align-self-center">@SaveStatus[file.FileName]</span>
                             }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
