@page "/Console"
@attribute [Authorize(Policy = "Permissions.ConsolePage.Read")]
@namespace WebfrontCore.Components.Features.Admin.Pages
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_CONSOLE_TITLE") | IW4MAdmin</PageTitle>

<div class="h-[calc(100vh-10rem)] max-w-7xl mx-auto p-4 md:p-8 flex flex-col">
    <!-- Terminal Window -->
    <div class="flex-1 flex flex-col bg-slate-950 rounded-lg shadow-2xl ring-1 ring-white/10 overflow-hidden font-mono">
        <!-- Terminal Header -->
        <div class="flex items-center px-4 py-2 bg-slate-900 border-b border-white/10">
            <div class="text-xs text-slate-400 font-medium">IW4MAdmin Console</div>
        </div>

        <!-- Terminal Output -->
        <div id="console_scroll_container" class="flex-1 overflow-y-auto p-4 space-y-1 scrollbar-thin scrollbar-thumb-slate-700 scrollbar-track-transparent">
            @if (!CommandOutput.Any())
            {
                <div class="flex h-full items-center justify-center opacity-10 select-none pointer-events-none">
                    <pre class="text-[0.6rem] leading-none text-green-500 text-center font-bold">
                                /(((((((*                           
                      ./((((((((((((((((,                            
            .*/(((((((((((((((((((((((((.                            
    *((((((((((((((((((((((((((((((((((                              
 ./(((((((((((((((((((((((((((((((((((/ ,**,                         
    ./(((((((((((((((((((((((((((((((/  ,******,                     
       ,(((((((((((((((((((((((((((((* ********//**.                 
         */(((((((((((((((((((((((((* ***************                
      ,***  ,(((((((((((((((((((((((,  ,***************.             
     ,****/**,*/(((((((((((((((((((.       *************,            
    ************,,((((((((((((((((*.         ,************           
  .***********,     *(((((((((((((            .*//*********          
 .,**********,        ,(((((((((/               ***********          
 ,**********,           *(((((((/               ,**********          
 ,/*********,             .*(((*                 **********,         
 ,/*********,                .*.                 ***********.        
 ,**********,                                   ***********          
  .***********                                  ***********          
  .************                               .***********           
    ************.                           .************,           
     ,*************                      .**************,            
      .*****************              *****************.             
         *******************************************,                
           .*//***********************************.                  
              ********************************,.                     
                 .************************,                          
                            ,.**,           
                    </pre>
                </div>
            }
            else
            {
                @foreach (var line in CommandOutput)
                {
                    <div class="text-sm">
                        @if (line.StartsWith(">"))
                        {
                            <span class="text-yellow-400 font-bold mr-2">➜</span><span class="text-slate-300">@line.Substring(1).Trim()</span>
                        }
                        else if (line.StartsWith("Error:", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="text-red-400">@line</span>
                        }
                        else
                        {
                            <span class="text-green-400">@line</span>
                        }
                    </div>
                }
            }
            <div @ref="ScrollAnchor" tabindex="-1"></div>
        </div>

        <!-- Input Area -->
        <div class="p-2 bg-slate-900 border-t border-white/10">
            <div class="flex items-center space-x-2 bg-slate-950 rounded border border-slate-700 px-3 py-2 focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500 transition-colors">
                <!-- Server Selector -->
                <div class="relative flex-shrink-0">
                    <select @bind="SelectedServerId" class="appearance-none bg-transparent text-slate-300 text-sm font-medium focus:outline-none pr-6 cursor-pointer border-r border-slate-800 mr-2 max-w-[150px] truncate">
                        @foreach (var server in Servers)
                        {
                            <option value="@server.Id" class="bg-slate-900">[@server.Game] @server.Name</option>
                        }
                    </select>
                    <div class="absolute inset-y-0 right-2 flex items-center pointer-events-none text-slate-500">
                        <i class="ph ph-caret-down text-xs"></i>
                    </div>
                </div>

                <!-- Command Input & Form -->
                <form @onsubmit="ExecuteCommand" class="flex-1 flex items-center">
                    <span class="text-green-500 mr-2 font-bold">$</span>
                    <input @bind="Command" 
                           @ref="InputElement"
                           @onkeydown="OnKeyDown"
                           type="text" 
                           class="w-full bg-transparent border-none text-slate-200 placeholder-slate-600 focus:ring-0 p-0 text-sm font-mono"
                           placeholder="@AppState.Loc("WEBFRONT_CONSOLE_FORM_PLACEHOLDER_COMMAND")" 
                           autocomplete="off" />
                    
                    <!-- Execute Button (Hidden submit or visible) -->
                    <button type="submit" 
                            disabled="@IsExecuting"
                            class="ml-2 p-1.5 rounded text-white bg-blue-600 hover:bg-blue-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors flex items-center justify-center">
                        @if (IsExecuting)
                        {
                            <i class="ph ph-spinner animate-spin"></i>
                        }
                        else
                        {
                            <i class="ph ph-arrow-return-left"></i>
                        }
                    </button>
                </form>
            </div>
            
            <div class="mt-1 flex justify-between px-1">
                <div class="text-[0.65rem] text-slate-500">
                    <span class="font-bold">Enter</span> to submit • <span class="font-bold">↑/↓</span> for history
                </div>
            </div>
        </div>
    </div>
</div>
