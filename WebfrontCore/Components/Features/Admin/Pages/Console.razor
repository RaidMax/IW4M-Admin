@page "/Console"
@attribute [Authorize(Policy = "Permissions.ConsolePage.Read")]
@namespace WebfrontCore.Components.Features.Admin.Pages
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_CONSOLE_TITLE") | @AppState.WebfrontBranding</PageTitle>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
    <!-- Heading -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@AppState.Loc("WEBFRONT_CONSOLE_TITLE")</h1>
            <p class="text-sm text-muted mt-0.5">@AppState.LocOr("WEBFRONT_CONSOLE_SUBTITLE", "Run RCON commands against a server")</p>
        </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-[300px_minmax(0,1fr)] items-start">
        <!-- Server list -->
        <section class="rounded-xl bg-surface border border-line overflow-hidden">
            <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.LocOr("WEBFRONT_CONSOLE_SERVERS", "Servers")</h2>
                <span class="text-xs text-muted font-mono tabular-nums">@Servers.Count</span>
            </div>

            <!-- Compact selector (small screens) -->
            <div class="p-3 lg:hidden">
                <select @bind="SelectedServerId"
                        class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm text-foreground focus:outline-none focus:border-primary">
                    @foreach (var server in Servers)
                    {
                        <option value="@server.Id">@server.Name.StripColors() (@server.Game)</option>
                    }
                </select>
            </div>

            <!-- Selectable list (large screens) -->
            <div class="hidden lg:block divide-y divide-line max-h-[60vh] overflow-y-auto">
                @if (!Servers.Any())
                {
                    <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
                        <i class="ph ph-hard-drives text-3xl text-secondary"></i>
                        <span>@AppState.LocOr("WEBFRONT_CONSOLE_NO_SERVERS", "No servers available")</span>
                    </div>
                }
                @foreach (var server in Servers)
                {
                    var isSelected = server.Id == SelectedServerId;
                    <button type="button"
                            @onclick="() => SelectedServerId = server.Id"
                            class="w-full text-left flex items-center gap-3 px-4 py-2.5 transition-colors @(isSelected ? "bg-primary/10" : "hover:bg-surface-hover")">
                        @if (server.Online)
                        {
                            <i class="shrink-0 w-1.5 h-1.5 rounded-full bg-success shadow-[0_0_0_3px_color-mix(in_srgb,var(--color-success)_25%,transparent)]" title="@AppState.LocOr("WEBFRONT_SERVER_STATUS_ONLINE", "Live")"></i>
                        }
                        else
                        {
                            <i class="shrink-0 w-1.5 h-1.5 rounded-full bg-muted" title="@AppState.LocOr("WEBFRONT_SERVER_STATUS_OFFLINE", "Offline")"></i>
                        }
                        <span class="flex-1 min-w-0">
                            <span class="block text-sm font-semibold truncate @(isSelected ? "text-primary" : "text-foreground")">
                                <ColorCode Value="@server.Name"/>
                            </span>
                            <span class="block font-mono text-[10px] tracking-[0.12em] uppercase text-muted">@server.Game</span>
                        </span>
                        <span class="shrink-0 font-mono text-xs tabular-nums text-subtle whitespace-nowrap">
                            @server.ClientCount<span class="text-muted"> / @server.MaxClients</span>
                        </span>
                    </button>
                }
            </div>
        </section>

        <!-- Console -->
        <div class="min-w-0 space-y-3">
            <div class="flex items-center gap-3 px-1">
                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.LocOr("WEBFRONT_CONSOLE_OUTPUT", "Console output")</h2>
                @{
                    var selectedServer = Servers.FirstOrDefault(s => s.Id == SelectedServerId);
                }
                @if (selectedServer != null)
                {
                    <span class="text-xs text-muted truncate">
                        <i class="ph ph-hard-drives mr-1"></i><ColorCode Value="@selectedServer.Name"/>
                    </span>
                }
            </div>

            <div id="console_scroll_container"
                 class="bg-black/40 font-mono text-[13px] leading-relaxed p-4 rounded-lg border border-line h-[60vh] overflow-y-auto">
                @if (!CommandOutput.Any())
                {
                    <div class="flex flex-col items-center justify-center gap-2 h-full text-muted text-sm select-none">
                        <i class="ph ph-terminal text-3xl text-secondary"></i>
                        <span>@AppState.LocOr("WEBFRONT_CONSOLE_EMPTY", "Select a server and run a command")</span>
                    </div>
                }
                else
                {
                    @foreach (var line in CommandOutput)
                    {
                        <div class="whitespace-pre-wrap break-words">
                            @if (line.StartsWith(">"))
                            {
                                <span class="text-primary"><span class="text-muted mr-2 select-none">$</span>@line.Substring(1).Trim()</span>
                            }
                            else if (line.StartsWith("Error:", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="text-error">@line</span>
                            }
                            else
                            {
                                <span class="text-success">@line</span>
                            }
                        </div>
                    }
                }
                <div @ref="ScrollAnchor" tabindex="-1"></div>
            </div>

            <!-- Command input -->
            <form @onsubmit="ExecuteCommand" class="flex items-center gap-2">
                <div class="relative flex-1 min-w-0">
                    <span class="absolute inset-y-0 left-3 flex items-center font-mono text-sm text-muted select-none pointer-events-none">$</span>
                    <input @bind="Command"
                           @bind:event="oninput"
                           @ref="InputElement"
                           @onkeydown="OnKeyDown"
                           type="text"
                           class="block w-full h-10 pl-8 pr-3 rounded-lg bg-background border border-line text-sm font-mono text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                           placeholder="@AppState.Loc("WEBFRONT_CONSOLE_FORM_PLACEHOLDER_COMMAND")"
                           autocomplete="off" />
                </div>
                <button type="submit"
                        disabled="@(IsExecuting || string.IsNullOrWhiteSpace(Command))"
                        class="inline-flex items-center gap-1.5 h-10 px-4 rounded-lg bg-primary text-sm font-semibold text-white hover:brightness-110 transition disabled:opacity-40 disabled:hover:brightness-100">
                    @if (IsExecuting)
                    {
                        <i class="ph ph-spinner animate-spin text-base"></i>
                    }
                    else
                    {
                        <i class="ph-bold ph-play text-base"></i>
                    }
                    <span>@AppState.LocOr("WEBFRONT_CONSOLE_RUN", "Run")</span>
                </button>
            </form>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-1 text-xs text-muted">
                <span>
                    <kbd class="font-mono text-[11px] px-1.5 py-0.5 rounded border border-line bg-surface text-subtle">Enter</kbd>
                    <span class="ml-1">@AppState.Loc("WEBFRONT_CONSOLE_SUBMIT_HINT")</span>
                </span>
                <span>
                    <kbd class="font-mono text-[11px] px-1.5 py-0.5 rounded border border-line bg-surface text-subtle">&uarr;</kbd>
                    <kbd class="font-mono text-[11px] px-1.5 py-0.5 rounded border border-line bg-surface text-subtle">&darr;</kbd>
                    <span class="ml-1">@AppState.Loc("WEBFRONT_CONSOLE_HISTORY_HINT")</span>
                </span>
            </div>
        </div>
    </div>
</div>
