<div class="space-y-6">
    @if (IsLoading)
    {
         <div class="flex justify-center p-8">
             <div class="loading-spinner w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
         </div>
    }
    else if (!HasTwoFactor)
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="bg-error/10 border border-error/20 text-error p-3 rounded-lg text-sm text-center font-medium flex items-center justify-center gap-2 mb-6">
                <i class="ph ph-warning-circle"></i>
                @ErrorMessage
            </div>
        }
        @if (SetupInfo == null)
        {
            <div class="text-center space-y-6">
                <div class="p-4 bg-primary/10 rounded-full w-fit mx-auto text-primary">
                    <i class="ph ph-shield-check text-4xl"></i>
                </div>
                <div class="space-y-2">
                    <h3 class="text-lg font-bold">@AppState.Loc("WEBFRONT_2FA_ENABLE_TITLE")</h3>
                    <p class="text-muted">@AppState.Loc("WEBFRONT_2FA_ENABLE_DESC")</p>
                </div>
                <button class="w-full py-3 rounded-xl bg-primary hover:bg-primary-hover text-on-primary font-bold transition-colors shadow-lg shadow-primary/20" 
                        @onclick="StartSetup">
                    @AppState.Loc("WEBFRONT_2FA_ENABLE_BTN")
                </button>
            </div>
        }
        else
        {
            <div class="space-y-6">
                <div class="text-center space-y-2">
                    <h3 class="text-lg font-bold">@AppState.Loc("WEBFRONT_2FA_SETUP_TITLE")</h3>
                    <p class="text-sm text-muted">@AppState.Loc("WEBFRONT_2FA_SCAN_QR")</p>
                </div>
                
                <div class="flex justify-center bg-white p-4 rounded-xl shadow-inner mx-auto w-fit">
                    <img src="@SetupInfo.QrCodeUrl" alt="2FA QR Code" class="max-w-[200px]" />
                </div>

                <div class="text-center bg-surface-alt p-4 rounded-xl border border-line">
                    <p class="text-xs text-muted uppercase tracking-wider mb-2 font-bold">@AppState.Loc("WEBFRONT_2FA_MANUAL_KEY")</p>
                    <code class="font-mono text-lg select-all text-primary block break-all">@SetupInfo.ManualEntryKey</code>
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-bold text-muted uppercase tracking-wider">@AppState.Loc("WEBFRONT_2FA_VERIFY_CODE")</label>
                    <input type="text" class="w-full bg-surface-alt border border-line focus:border-primary rounded-xl px-4 py-3 text-center tracking-[0.5em] font-mono text-xl outline-none transition-colors" 
                           maxlength="6" placeholder="000000"
                           @bind="VerifyCode" @bind:event="oninput" />
                </div>
                
                <button class="w-full py-3 rounded-xl bg-primary hover:bg-primary-hover text-on-primary font-bold transition-colors shadow-lg shadow-primary/20 disabled:opacity-50 disabled:cursor-not-allowed" 
                        @onclick="ConfirmSetup" disabled="@(string.IsNullOrWhiteSpace(VerifyCode) || VerifyCode.Length < 6)">
                    @AppState.Loc("WEBFRONT_ACTION_CONFIRM")
                </button>
            </div>
        }
    }
    else
    {
         <div class="text-center space-y-6">
             <div class="p-4 bg-success/10 rounded-full w-fit mx-auto text-success">
                 <i class="ph ph-check-circle text-5xl"></i>
             </div>
             <div class="space-y-2">
                 <h3 class="text-lg font-bold">@AppState.Loc("WEBFRONT_2FA_ENABLED_TITLE")</h3>
                 <p class="text-muted">@AppState.Loc("WEBFRONT_2FA_ENABLED")</p>
             </div>
             <button class="w-full py-3 rounded-xl bg-error/10 hover:bg-error/20 text-error border border-error/20 font-bold transition-colors" 
                     @onclick="Disable2FA">
                 @AppState.Loc("WEBFRONT_2FA_DISABLE")
             </button>
         </div>
    }
</div>
