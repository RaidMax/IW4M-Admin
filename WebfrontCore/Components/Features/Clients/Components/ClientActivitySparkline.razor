@* Activity Sparkline - Compact visual of playtime over last 30 days *@
<div class="flex items-center gap-3 p-3 bg-surface-alt rounded-lg border border-line">
    <div class="flex items-center gap-2 text-muted">
        <i class="ph ph-activity text-lg text-secondary"></i>
        <div class="flex flex-col leading-none">
            <span class="text-xs font-bold uppercase tracking-wider">Playtime</span>
            <span class="text-[10px] font-medium opacity-70">@FormatPlaytime(_totalPlaytime)</span>
        </div>
    </div>

    <div class="flex-1 flex items-end gap-px h-8">
        @for (var i = 0; i < _activityData.Length; i++)
        {
            var value = _activityData[i];
            var date = DateTime.UtcNow.Date.AddDays(-29 + i);
            var height = value > 0 ? Math.Max(4, (int)(value / _maxValue * 32)) : 2;
            var colorClass = value > 0 ? "bg-success" : "bg-line";
            var playTime = TimeSpan.FromMinutes(value);
            var tooltipText = value > 0
                ? $"{date:MMM d}: {FormatPlaytime(playTime)}"
                : $"{date:MMM d}: No activity";

            <Tooltip Text="@tooltipText" WrapperClass="flex-1 flex items-end">
                <div class="w-full rounded-t transition-all hover:opacity-80 @colorClass"
                     style="height: @(height)px;">
                </div>
            </Tooltip>
        }
    </div>
</div>
