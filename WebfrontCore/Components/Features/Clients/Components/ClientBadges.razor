@if (IconOnly)
{
    @if (_navData?.TotalReportCount > 0)
    {
        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.AdminMenu}.{WebfrontPermission.Read}")">
            <button class="relative text-subtle hover:text-foreground transition-colors p-2 rounded-lg hover:bg-surface-hover"
                    type="button" @onclick="ShowReports" title="@AppState.Loc("WEBFRONT_LAYOUT_REPORTS")">
                <i class="ph ph-warning-circle text-2xl text-error"></i>
                <span class="absolute top-0 right-0 -mt-1 -mr-1 px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-error text-white border border-background shadow-sm">
                    @_navData.TotalReportCount
                </span>
            </button>
        </AuthorizeView>
    }
}
else
{
    <div>
        @if (_navData != null)
        {
            <div class="inline-flex items-center gap-2">
                 <!-- Online Clients -->
                <div class="flex items-center border border-line rounded-lg overflow-hidden">
                    <span class="px-3 py-1 text-xs font-bold text-primary bg-primary/10 border-r border-line">@(_navData.TotalClientCount)</span>
                    <span class="px-3 py-1 text-xs font-medium text-muted bg-surface-alt/50">@AppState.Loc("WEBFRONT_LAYOUT_CLIENTS_ONLINE").ToUpper()</span>
                </div>
    
                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.PrivilegedClientsPage}.{WebfrontPermission.Read}")">
                     <!-- Admins -->
                    <div class="flex items-center border border-line rounded-lg overflow-hidden">
                        <span class="px-3 py-1 text-xs font-bold text-success bg-success/10 border-r border-line">@(_navData.TotalAdminCount)</span>
                        <span class="px-3 py-1 text-xs font-medium text-muted bg-surface-alt/50">@AppState.Loc("WEBFRONT_LAYOUT_ADMINS_ONLINE").ToUpper()</span>
                    </div>
                </AuthorizeView>
    
                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.AdminMenu}.{WebfrontPermission.Read}")">
                     <!-- Reports -->
                    <button type="button" class="flex items-center border border-line rounded-lg overflow-hidden cursor-pointer hover:border-line-hover transition-colors group" @onclick="ShowReports">
                        <span class="px-3 py-1 text-xs font-bold text-error bg-error/10 border-r border-line group-hover:bg-error/20 transition-colors">@(_navData.TotalReportCount)</span>
                        <span class="px-3 py-1 text-xs font-medium text-muted bg-surface-alt/50 group-hover:text-subtle transition-colors">@AppState.Loc("WEBFRONT_LAYOUT_REPORTS").ToUpper()</span>
                    </button>
                </AuthorizeView>
            </div>
        }
    </div>
}
