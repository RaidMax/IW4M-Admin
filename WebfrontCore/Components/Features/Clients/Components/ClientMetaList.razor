@if (Loading && !MetaItems.Any())
{
    <div class="p-4 space-y-2">
        <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
        <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
    </div>
}
else if (!MetaItems.Any())
{
    <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
        <i class="ph ph-tray text-3xl text-secondary"></i>
        <span>@AppState.LocOr("WEBFRONT_PROFILE_NO_ACTIVITY", "No activity to show")</span>
    </div>
}
else
{
    string? lastHeader = null;

    <div class="divide-y divide-line">
        @foreach (var item in MetaItems)
        {
            var currentHeader = item.When.HumanizeForCurrentCulture();

            @* Skip Information type items - handled by separate component *@
            if (item.Type == MetaType.Information)
            {
                continue;
            }

            @* Time header *@
            if (currentHeader != lastHeader)
            {
                <div class="px-4 py-1.5 bg-surface-alt/50 text-[11px] font-semibold uppercase tracking-wider text-muted">
                    @currentHeader
                </div>
                lastHeader = currentHeader;
            }

            @* Feed row *@
            <div class="grid grid-cols-[18px_1fr_auto] gap-2 items-baseline px-4 py-1.5 text-sm hover:bg-surface-hover/50 transition-colors">
                @{
                    var (iconColor, icon) = GetItemStyle(item);
                    var utcTime = item.When.ToStandardFormat();
                    var tooltipText = $"{item.Type.ToTranslatedName()} • {utcTime}";
                }
                <Tooltip Text="@tooltipText" Direction="@Tooltip.TooltipDirection.Right" WrapperClass="flex items-center justify-center">
                    <i class="ph @icon text-sm @iconColor"></i>
                </Tooltip>

                @* Content *@
                <div class="min-w-0 break-words">
                    @switch (item)
                    {
                        case AdministeredPenaltyResponse penalized:
                            @AdministeredPenaltyTemplate(penalized)
                            break;
                        case ReceivedPenaltyResponse received:
                            @ReceivedPenaltyTemplate(received)
                            break;
                        case MessageResponse message:
                            @MessageTemplate(message)
                            break;
                        case UpdatedAliasResponse alias:
                            @UpdatedAliasTemplate(alias)
                            break;
                        case ConnectionHistoryResponse connection:
                            @ConnectionHistoryTemplate(connection)
                            break;
                        case PermissionLevelChangedResponse permission:
                            @PermissionLevelChangedTemplate(permission)
                            break;
                        case ClientNoteMetaResponse note:
                            @ClientNoteTemplate(note)
                            break;
                        default:
                            <div class="rounded-lg border border-warning/30 bg-warning/10 text-warning px-3 py-1.5 text-xs">
                                Unknown Meta Type: @item.GetType().Name (@item.Type)
                            </div>
                            break;
                    }
                </div>

                @* Timestamp *@
                <span class="font-mono text-[11px] text-muted whitespace-nowrap" title="@utcTime">@item.When.ToString("HH:mm")</span>
            </div>
        }
    </div>

    @if (HasMore)
    {
        <div id="loadMoreMetaTrigger" class="h-px w-full"></div>
    }
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="m-4 rounded-xl border border-error/30 bg-error/10 text-error px-4 py-3 flex items-center gap-2 text-sm">
        <i class="ph ph-warning-circle"></i>
        <span>@_errorMessage</span>
    </div>
}

@code {

    private string GetPenaltyColor(string type) => type?.ToLower() switch
    {
        "ban" => "text-error",
        "tempban" => "text-warning",
        "kick" => "text-orange-400",
        "warning" => "text-yellow-300",
        "unban" => "text-success",
        _ => "text-muted"
    };

    private (string IconColor, string Icon) GetItemStyle(IClientMeta item)
    {
        return item switch
        {
            AdministeredPenaltyResponse p => p.PenaltyType switch
            {
                EFPenalty.PenaltyType.Ban => ("text-error", "ph-prohibit"),
                EFPenalty.PenaltyType.TempBan => ("text-warning", "ph-clock"),
                EFPenalty.PenaltyType.Kick => ("text-orange-400", "ph-x"),
                EFPenalty.PenaltyType.Unban => ("text-success", "ph-check"),
                _ => ("text-muted", "ph-gavel")
            },
            ReceivedPenaltyResponse r => r.PenaltyType switch
            {
                EFPenalty.PenaltyType.Ban => ("text-error", "ph-prohibit"),
                EFPenalty.PenaltyType.TempBan => ("text-warning", "ph-clock"),
                EFPenalty.PenaltyType.Kick => ("text-orange-400", "ph-x"),
                _ => ("text-muted", "ph-gavel")
            },
            MessageResponse => ("text-primary", "ph-chat"),
            UpdatedAliasResponse => ("text-subtle", "ph-user"),
            ConnectionHistoryResponse c => c.ConnectionType == Reference.ConnectionType.Connect
                ? ("text-success", "ph-sign-in")
                : ("text-muted", "ph-sign-out"),
            PermissionLevelChangedResponse => ("text-primary", "ph-shield"),
            ClientNoteMetaResponse => ("text-warning", "ph-note"),
            _ => ("text-muted", "ph-circle")
        };
    }

    // Shared fragment for anticheat detection display with expandable details
    RenderFragment<(ReceivedPenaltyResponse Meta, MetaItemState State)> AnticheatDetailsFragment => (ctx) => @<text>
        <span class="mr-1">@AppState.Loc("WEBFRONT_PROFILE_ANTICHEAT_DETECTION").FormatExt(ctx.Meta.AutomatedOffense)</span>
        <button class="inline-flex items-center justify-center w-6 h-6 rounded-md border border-line bg-surface-alt text-xs text-muted hover:text-foreground hover:bg-surface-hover transition-colors align-middle"
                type="button"
                title="@AppState.Loc("WEBFRONT_CLIENT_META_AC_METRIC")"
                @onclick="@(() => TogglePenaltyDetails(ctx.Meta))">
            <i class="ph ph-list-magnifying-glass"></i>
        </button>

        @if (ctx.State.IsOpen)
        {
            if (ctx.State.IsLoading)
            {
                <i class="ph ph-spinner animate-spin text-primary ml-2"></i>
            }
            else if (ctx.State.SnapshotInfo != null)
            {
                <div class="mt-2 mb-1 rounded-lg border border-line bg-surface-alt p-3 font-mono text-xs block">
                    @foreach (var snapshot in ctx.State.SnapshotInfo)
                    {
                        <div class="space-y-1">
                            @foreach (var kvp in snapshot)
                            {
                                <div class="flex gap-2">
                                    <span class="text-muted">@kvp.Key:</span>
                                    <span class="text-subtle"><ColorCode Value="@kvp.Value"/></span>
                                </div>
                            }
                        </div>
                        @if (snapshot != ctx.State.SnapshotInfo.Last())
                        {
                            <div class="my-3 border-t border-line"></div>
                        }
                    }
                </div>
            }
        }
    </text>;

    // --- RenderFragments ---
    // @formatter:off
    RenderFragment<AdministeredPenaltyResponse> AdministeredPenaltyTemplate => (Meta) => @<text>
        @{
            var localizationKey = $"WEBFRONT_CLIENT_META_PENALIZED_{Meta.PenaltyType.ToString().ToUpper()}_V2";
            var state = GetState(Meta);
        }

        <div class="text-subtle text-sm leading-relaxed">
            <div class="inline">
                @foreach (var match in Utilities.SplitTranslationTokens(AppState.Loc(localizationKey)))
                {
                    if (match.IsInterpolation)
                    {
                        if (match.MatchValue == "action")
                        {
                            <span class="@GetPenaltyColor(Meta.PenaltyType.ToString()) font-semibold">@match.TranslationValue</span>
                        }
                        else if (match.MatchValue == "offender")
                        {
                            <a class="text-foreground font-medium hover:text-primary transition-colors" href="/client/@Meta.OffenderClientId">
                                <ColorCode Value="@Meta.OffenderName"/>
                            </a>
                        }
                        else if (match.MatchValue == "reason")
                        {
                            <span class="text-foreground">
                                @if (AppState.User != null && !string.IsNullOrEmpty(Meta.AutomatedOffense) && Meta.PenaltyType != EFPenalty.PenaltyType.Warning)
                                {
                                    @AnticheatDetailsFragment((Meta, state))
                                }
                                else
                                {
                                    <ColorCode Value="@Meta.Offense"/>
                                }
                            </span>
                        }
                        else if (match.MatchValue == "time")
                        {
                            <span class="text-muted">@Meta.LengthText</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">@match.MatchValue</span>
                    }
                    <span>&nbsp;</span>
                }
            </div>
        </div>
    </text>;

    RenderFragment<ReceivedPenaltyResponse> ReceivedPenaltyTemplate => (Meta) => @<text>
        @{
            var localizationKey = $"WEBFRONT_CLIENT_META_WAS_PENALIZED_{Meta.PenaltyType.ToString().ToUpper()}_V2";
            var state = GetState(Meta);
        }

        <div class="text-subtle text-sm leading-relaxed">
            <div class="inline">
                @foreach (var match in Utilities.SplitTranslationTokens(AppState.Loc(localizationKey)))
                {
                    if (match.IsInterpolation)
                    {
                        if (match.MatchValue == "action")
                        {
                            <span class="@GetPenaltyColor(Meta.PenaltyType.ToString()) font-semibold">@match.TranslationValue</span>
                        }
                        else if (match.MatchValue == "punisher")
                        {
                            <a class="text-foreground font-medium hover:text-primary transition-colors" href="/client/@Meta.PunisherClientId">
                                <ColorCode Value="@Meta.PunisherName"/>
                            </a>
                        }
                        else if (match.MatchValue == "reason")
                        {
                            <span class="text-foreground">
                                @if (AppState.User != null && !string.IsNullOrEmpty(Meta.AutomatedOffense) && Meta.PenaltyType != EFPenalty.PenaltyType.Warning && Meta.PenaltyType != EFPenalty.PenaltyType.Kick)
                                {
                                    @AnticheatDetailsFragment((Meta, state))
                                }
                                else
                                {
                                    <ColorCode Value="@Meta.Offense"/>
                                }
                            </span>
                        }
                        else if (match.MatchValue == "time")
                        {
                            <span class="text-muted">@Meta.LengthText</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">@match.MatchValue</span>
                    }
                    <span>&nbsp;</span>
                }

                @if (Meta.ClientId != Meta.OffenderClientId)
                {
                    <span class="text-muted mx-1">&mdash;</span>
                    @foreach (var helperResult in Utilities.SplitTranslationTokens("WEBFRONT_PROFILE_LINKED_ACCOUNT"))
                    {
                        if (!helperResult.IsInterpolation)
                        {
                            <span class="text-muted">@helperResult.MatchValue</span>
                        }
                        else
                        {
                            <a class="text-foreground font-medium hover:text-primary transition-colors" href="/client/@Meta.OffenderClientId">
                                <ColorCode Value="@Meta.OffenderName"/>
                            </a>
                        }
                        <span>&nbsp;</span>
                    }
                }
            </div>
        </div>
    </text>;

    RenderFragment<MessageResponse> MessageTemplate => (Meta) => @<text>
        @{
            var state = GetState(Meta);
        }
        <div @onclick="@(() => ToggleMessageContext(Meta))" class="cursor-pointer group/msg text-sm">
            <div class="flex items-start gap-2">
                <div class="mt-0.5 text-muted group-hover/msg:text-primary transition-colors">
                    <i class="ph-bold @(state.IsOpen ? "ph-caret-down" : "ph-caret-right") text-xs"></i>
                </div>
                <div class="flex-1 min-w-0">
                    @if (!Meta.SentIngame)
                    {
                        <Tooltip Text="@AppState.Loc("WEBFRONT_META_MESSAGE_REMOTE_TOOLTIP")" WrapperClass="inline-flex items-center">
                            <i class="ph ph-globe text-muted text-xs mr-1"></i>
                        </Tooltip>
                    }
                    <span class="text-foreground break-words">
                        <ColorCode Value="@Meta.Message"/>
                    </span>
                    <span class="ml-2 text-muted text-xs">@Meta.ServerName</span>
                </div>
            </div>
        </div>

        @if (state.IsOpen)
        {
            if (state.IsLoading)
            {
                <div class="flex justify-center py-2 ml-6">
                    <i class="ph ph-spinner animate-spin text-primary"></i>
                </div>
            }
            else if (state.ContextMessages != null)
            {
                <div class="mt-2 mb-1 rounded-lg border border-line bg-surface-alt overflow-hidden">
                    <div class="px-3 py-1.5 border-b border-line font-mono text-[11px] text-muted">
                        @Meta.When.HumanizeForCurrentCulture()
                    </div>
                    <div class="divide-y divide-line/60">
                        @foreach (var message in state.ContextMessages)
                        {
                            var isOriginalMessage = message.When == Meta.When && message.Message == Meta.Message && message.ClientId == Meta.ClientId;
                            <div class="text-xs flex flex-col md:flex-row md:items-baseline gap-0.5 md:gap-2 px-3 py-1.5 @(isOriginalMessage ? "bg-primary/10 shadow-[inset_2px_0_0_0_var(--color-primary)]" : "hover:bg-surface-hover/50") transition-colors">
                                @* Timestamp + Name row *@
                                <div class="flex items-baseline gap-1 shrink-0">
                                    <span class="text-muted font-mono text-[10px] tabular-nums">@message.When.ToString("HH:mm:ss")</span>
                                    @if (!message.SentIngame)
                                    {
                                        <Tooltip Text="@AppState.Loc("WEBFRONT_META_MESSAGE_REMOTE_TOOLTIP")" Direction="@Tooltip.TooltipDirection.Right" WrapperClass="inline-flex items-center relative">
                                            <i class="ph ph-globe text-muted text-[10px] mr-0.5"></i>
                                        </Tooltip>
                                    }
                                    <span class="font-semibold text-foreground text-xs whitespace-nowrap">
                                        <ColorCode Value="@message.ClientName"/>
                                    </span>
                                </div>
                                @* Message *@
                                <span class="@(message.IsQuickMessage ? "italic text-muted" : "text-subtle") break-words text-xs">
                                    <ColorCode Value="@message.Message"/>
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </text>;

    RenderFragment<UpdatedAliasResponse> UpdatedAliasTemplate => (Meta) => @<text>
        <div class="text-sm text-muted">
        @foreach (var token in Utilities.SplitTranslationTokens(AppState.Loc("WEBFRONT_PROFILE_META_CONNECT_ALIAS")))
        {
            if (token.IsInterpolation)
            {
                switch (token.MatchValue)
                {
                    case "action":
                        <span class="text-muted">@token.TranslationValue</span>
                        break;
                    case "alias":
                        <span class="text-foreground font-medium">
                            <ColorCode Value="@Meta.Name" />
                             <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")">
                                  <span class="font-mono text-xs tabular-nums text-muted ml-1">[@Meta.IPAddress]</span>
                             </AuthorizeView>
                        </span>
                        break;
                }
            }
            else
            {
                <span>@token.MatchValue</span>
            }
            <span>&nbsp;</span>
        }
        </div>
    </text>;

    RenderFragment<ConnectionHistoryResponse> ConnectionHistoryTemplate => (Meta) => @<text>
        @{
            var localizationKey = $"WEBFRONT_CLIENT_META_CONNECTION_{Meta.ConnectionType.ToString().ToUpper()}";
        }
        <div class="text-sm text-muted">
        @foreach (var token in Utilities.SplitTranslationTokens(AppState.Loc(localizationKey)))
            {
                if (token.IsInterpolation)
                {
                    switch (token.MatchValue)
                    {
                        case "action":
                            <span class="@(Meta.ConnectionType == Reference.ConnectionType.Connect ? "text-success" : "text-muted") font-semibold">
                                @token.TranslationValue
                            </span>
                            break;
                        case "server":
                            <span class="text-subtle">
                                <ColorCode Value="@Meta.ServerName"/>
                            </span>
                            break;
                    }
                }
                else
                {
                    <span>@token.MatchValue</span>
                }
                <span>&nbsp;</span>
            }
        </div>
    </text>;

    RenderFragment<PermissionLevelChangedResponse> PermissionLevelChangedTemplate => (Meta) => @<text>
        <div class="text-sm text-muted">
        @foreach (var token in Utilities.SplitTranslationTokens(AppState.Loc("WEBFRONT_CLIENT_META_PERMISSION_CHANGED")))
        {
            if (token.IsInterpolation)
            {
                switch (token.MatchValue)
                {
                    case "permission":
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border border-current bg-transparent @AppState.GetLevelColorClass(Meta.CurrentPermissionLevel)">
                            @Meta.CurrentPermissionLevel.ToLocalizedLevelName()
                        </span>
                        break;
                    case "originClient":
                        <a class="text-foreground font-medium hover:text-primary transition-colors" href="/client/@Meta.ChangedById">
                            <ColorCode Value="@Meta.ChangedByName" />
                        </a>
                        break;
                    case "type":
                         <span class="text-muted italic">@token.TranslationValue</span>
                        break;
                }
            }
            else
            {
                <span>@token.MatchValue</span>
            }
            <span>&nbsp;</span>
        }
        </div>
    </text>;

    RenderFragment<ClientNoteMetaResponse> ClientNoteTemplate => (Meta) => @<text>
        <div class="text-sm flex flex-wrap gap-x-2 gap-y-0.5 items-baseline">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-warning/15 text-warning">@AppState.Loc("WEBFRONT_CLIENT_META_NOTE")</span>
            <span class="text-foreground italic break-words">@Meta.Note</span>
            <span class="text-muted">&mdash;</span>
            <a class="text-subtle text-xs font-medium hover:text-primary transition-colors" href="/client/@Meta.OriginEntityId">
                <ColorCode Value="@Meta.OriginEntityName" />
            </a>
        </div>
    </text>;
    // @formatter:on
}
