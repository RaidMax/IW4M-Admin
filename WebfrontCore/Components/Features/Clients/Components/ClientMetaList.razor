@if (Loading && !MetaItems.Any())
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
}
else
{
    string lastHeader = null;

    foreach (var item in MetaItems)
    {
        var currentHeader = item.When.HumanizeForCurrentCulture();

        if (currentHeader != lastHeader)
        {
            <div class="text-muted font-size-16 font-weight-medium mt-20 mb-10">@currentHeader</div>
            lastHeader = currentHeader;
        }

        <div class="mb-5">
            @switch (item)
            {
                case AdministeredPenaltyResponse penalized:
                    @AdministeredPenaltyTemplate(penalized)
                    break;
                case ReceivedPenaltyResponse received:
                    @ReceivedPenaltyTemplate(received)
                    break;
                case MessageResponse message:
                    @MessageTemplate(message)
                    break;
                case UpdatedAliasResponse alias:
                    @UpdatedAliasTemplate(alias)
                    break;
                case ConnectionHistoryResponse connection:
                    @ConnectionHistoryTemplate(connection)
                    break;
                case PermissionLevelChangedResponse permission:
                    @PermissionLevelChangedTemplate(permission)
                    break;
                case InformationResponse info:
                    @InformationTemplate(info)
                    break;
                case ClientNoteMetaResponse note:
                    @ClientNoteTemplate(note)
                    break;
                default:
                    <div class="alert alert-warning">
                        Unknown Meta Type: @item.GetType().Name (@item.Type)
                    </div>
                    break;
            }
        </div>
    }

    @if (HasMore)
    {
        <div @ref="_loadMoreTrigger" style="height: 1px;"></div>
    }
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-10">
        @_errorMessage
    </div>
}

@code {

    // --- RenderFragments ---
    // @formatter:off
    RenderFragment<AdministeredPenaltyResponse> AdministeredPenaltyTemplate => (Meta) => @<text>
        @{
            var tooltipText = string.Format(AppState.Loc("WEBFRONT_META_TOOLTIP_TIME"), Meta.When.ToString("G"));
            var localizationKey = $"WEBFRONT_CLIENT_META_PENALIZED_{Meta.PenaltyType.ToString().ToUpper()}_V2";
            var state = GetState(Meta);
        }

        <span data-toggle="tooltip" data-title="@tooltipText" data-placement="top">
            <div class="d-inline">
                @foreach (var match in Utilities.SplitTranslationTokens(AppState.Loc(localizationKey)))
                {
                    if (match.IsInterpolation)
                    {
                        if (match.MatchValue == "action")
                        {
                            <span class="penalties-color-@Meta.PenaltyType.ToString().ToLower()">@match.TranslationValue</span>
                        }
                        else if (match.MatchValue == "offender")
                        {
                            <span class="text-highlight">
                                <a class="link-inverse" href="/client/@Meta.OffenderClientId">
                                    <ColorCode Value="@Meta.OffenderName"/>
                                </a>
                            </span>
                        }
                        else if (match.MatchValue == "reason")
                        {
                            <span class="text-light-dm text-dark-lm">
                                @if (AppState.User != null && !string.IsNullOrEmpty(Meta.AutomatedOffense) && Meta.PenaltyType != EFPenalty.PenaltyType.Warning)
                                {
                                    <span>@string.Format(AppState.Loc("WEBFRONT_PROFILE_ANTICHEAT_DETECTION"), Meta.AutomatedOffense)&nbsp;</span>
                                    <span class="oi oi-list-rich align-top text-primary automated-penalty-info-detailed cursor-pointer"
                                          title="@AppState.Loc("WEBFRONT_CLIENT_META_AC_METRIC")"
                                          @onclick="@(() => TogglePenaltyDetails(Meta))"></span>

                                    @if (state.IsOpen)
                                    {
                                        if (state.IsLoading)
                                        {
                                            <div class="spinner-border spinner-border-sm text-primary ml-5" role="status"></div>
                                        }
                                        else if (state.SnapshotInfo != null)
                                        {
                                            <div class="penalty-info-context bg-very-dark-dm bg-light-lm p-20 mt-10 mb-10 rounded border-top border-bottom">
                                                @foreach (var snapshot in state.SnapshotInfo)
                                                {
                                                    foreach (var kvp in snapshot)
                                                    {
                                                        <span class="text-light-dm text-dark-lm font-weight-bold">@kvp.Key</span>
                                                        <span>&mdash; <ColorCode Value="@kvp.Value"/></span>
                                                        <br/>
                                                    }
                                                    <hr class="mt-10 mb-10 border-secondary"/>
                                                }
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <ColorCode Value="@Meta.Offense"/>
                                }
                            </span>
                        }
                        else if (match.MatchValue == "time")
                        {
                            <span class="text-light-dm text-dark-lm">@Meta.LengthText&nbsp;</span>
                        }
                    }
                    else
                    {
                        <span>@match.MatchValue&nbsp;</span>
                    }
                }
            </div>
        </span>
    </text>;

    RenderFragment<ReceivedPenaltyResponse> ReceivedPenaltyTemplate => (Meta) => @<text>
        @{
            var tooltipText = string.Format(AppState.Loc("WEBFRONT_META_TOOLTIP_TIME"), Meta.When.ToString("G"));
            var localizationKey = $"WEBFRONT_CLIENT_META_WAS_PENALIZED_{Meta.PenaltyType.ToString().ToUpper()}_V2";
        }

        <span data-toggle="tooltip" data-title="@tooltipText" data-placement="top">
            <div class="d-inline">
                @foreach (var match in Utilities.SplitTranslationTokens(AppState.Loc(localizationKey)))
                {
                    if (match.IsInterpolation)
                    {
                        if (match.MatchValue == "action")
                        {
                            <span class="penalties-color-@Meta.PenaltyType.ToString().ToLower()">@match.TranslationValue&nbsp;</span>
                        }
                        else if (match.MatchValue == "punisher")
                        {
                            <span class="text-highlight">
                                <a href="/client/@Meta.PunisherClientId">
                                    <ColorCode Value="@Meta.PunisherName"/>
                                </a>
                                &nbsp;
                            </span>
                        }
                        else if (match.MatchValue == "reason")
                        {
                            <span class="text-white-dm text-black-lm">
                                @if (AppState.User != null && !string.IsNullOrEmpty(Meta.AutomatedOffense) && Meta.PenaltyType != EFPenalty.PenaltyType.Warning && Meta.PenaltyType != EFPenalty.PenaltyType.Kick)
                                {
                                    <span>@string.Format(AppState.Loc("WEBFRONT_PROFILE_ANTICHEAT_DETECTION"), Meta.AutomatedOffense)&nbsp;</span>
                                    <span class="oi oi-list-rich align-top text-primary automated-penalty-info-detailed"
                                          title="@AppState.Loc("WEBFRONT_CLIENT_META_AC_METRIC")">&nbsp;</span>
                                }
                                else
                                {
                                    <ColorCode Value="@Meta.Offense"/>
                                }
                            </span>
                        }
                        else if (match.MatchValue == "time")
                        {
                            <span class="text-light-dm text-dark-lm">@Meta.LengthText&nbsp;</span>
                        }
                    }
                    else
                    {
                        <span>@match.MatchValue&nbsp;</span>
                    }
                }

                @if (Meta.ClientId != Meta.OffenderClientId)
                {
                    <span>&mdash;</span>
                    @foreach (var helperResult in Utilities.SplitTranslationTokens("WEBFRONT_PROFILE_LINKED_ACCOUNT"))
                    {
                        if (!helperResult.IsInterpolation)
                        {
                            <span>@helperResult.MatchValue&nbsp;</span>
                        }
                        else
                        {
                            <a class="link-inverse" href="/client/@Meta.OffenderClientId">
                                <ColorCode Value="@Meta.OffenderName"/>
                                &nbsp;
                            </a>
                        }
                    }
                }
            </div>
        </span>
    </text>;

    RenderFragment<MessageResponse> MessageTemplate => (Meta) => @<text>
        @{
            var state = GetState(Meta);
        }
        <div @onclick="@(() => ToggleMessageContext(Meta))" style="cursor: pointer" class="d-inline">
            <span class="oi oi-chevron-@(state.IsOpen ? "bottom" : "right") font-size-12 mr-5"></span>

            <span class="text-white-dm text-black-lm text-break">
                <ColorCode Value="@Meta.Message"/>&nbsp;
            </span>
            <span class="text-muted font-size-12 align-top">@Meta.ServerName</span>&nbsp;
        </div>

        @if (state.IsOpen)
        {
            if (state.IsLoading)
            {
                <div class="text-center mt-5 mb-5">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                </div>
            }
            else if (state.ContextMessages != null)
            {
                <div class="client-message-context mt-10 mb-10 pl-20">
                    <div class="rounded-top bg-primary text-light mb-0 p-10 pt-5 pb-5 font-size-12">
                        @Meta.When.HumanizeForCurrentCulture()
                    </div>
                    <div class="bg-very-dark-dm bg-light-lm p-10 pr-20 rounded-bottom">
                        @foreach (var message in state.ContextMessages)
                        {
                            var isOriginalMessage = message.When == Meta.When && message.Message == Meta.Message && message.ClientId == Meta.ClientId;
                            <div class="font-size-14 mb-2 @(isOriginalMessage ? "rounded p-2" : "")"
                                 style="@(isOriginalMessage ? "background-color: rgba(0, 123, 255, 0.25); border-left: 3px solid #007bff;" : "")">
                                 <span class="font-weight-bold">
                                     <ColorCode Value="@message.ClientName"/>
                                 </span>
                                &mdash;
                                <span class="@(message.IsQuickMessage ? "font-italic" : "") text-light-dm text-dark-lm">
                                     <ColorCode Value="@message.Message"/>
                                 </span>
                                <span class="text-muted font-size-12 ml-5">@message.When.ToString("T")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </text>;

    RenderFragment<UpdatedAliasResponse> UpdatedAliasTemplate => (Meta) => @<text>
        @{
            var tooltipText = string.Format(AppState.Loc("WEBFRONT_META_TOOLTIP_TIME"), Meta.When.ToString("G"));
        }
        <span data-toggle="tooltip" data-title="@tooltipText" data-placement="top">
        @foreach (var token in Utilities.SplitTranslationTokens(AppState.Loc("WEBFRONT_PROFILE_META_CONNECT_ALIAS")))
        {
            if (token.IsInterpolation)
            {
                switch (token.MatchValue)
                {
                    case "action":
                        <span class="text-secondary">@token.TranslationValue</span>
                        break;
                    case "alias":
                        <span class="text-light-dm text-dark-lm">
                            <ColorCode Value="@Meta.Name" />
                             <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")">
                                  [@Meta.IPAddress]
                             </AuthorizeView>
                             &nbsp;
                        </span>
                        break;
                }
            }
            else
            {
                <span class="text-muted">@token.MatchValue&nbsp;</span>
            }
        }
        </span>
    </text>;

    RenderFragment<ConnectionHistoryResponse> ConnectionHistoryTemplate => (Meta) => @<text>
        @{
            var localizationKey = $"WEBFRONT_CLIENT_META_CONNECTION_{Meta.ConnectionType.ToString().ToUpper()}";
            var tooltipText = string.Format(AppState.Loc("WEBFRONT_META_TOOLTIP_TIME"), Meta.When.ToString("G"));
        }
        <span data-toggle="tooltip" data-title="@tooltipText" data-placement="top">
        @foreach (var token in Utilities.SplitTranslationTokens(AppState.Loc(localizationKey)))
            {
                if (token.IsInterpolation)
                {
                    switch (token.MatchValue)
                    {
                        case "action":
                            <span
                                class="@(Meta.ConnectionType == Reference.ConnectionType.Connect ? "text-light-green" : "text-secondary")">@token.TranslationValue&nbsp;</span>
                            break;
                        case "server":
                            <span class="text-light-dm text-dark-lm">
                            <ColorCode Value="@Meta.ServerName"/>
                            &nbsp;
                        </span>
                            break;
                    }
                }
                else
                {
                    <span class="text-muted">@token.MatchValue&nbsp;</span>
                }
            }
        </span>
    </text>;

    RenderFragment<PermissionLevelChangedResponse> PermissionLevelChangedTemplate => (Meta) => @<text>
        @{
            var tooltipText = string.Format(AppState.Loc("WEBFRONT_META_TOOLTIP_TIME"), Meta.When.ToString("G"));
        }
        <span data-toggle="tooltip" data-title="@tooltipText" data-placement="top">
        @foreach (var token in Utilities.SplitTranslationTokens(AppState.Loc("WEBFRONT_CLIENT_META_PERMISSION_CHANGED")))
        {
            if (token.IsInterpolation)
            {
                switch (token.MatchValue)
                {
                    case "permission":
                        <span class="level-color-@((int)Meta.CurrentPermissionLevel)">@Meta.CurrentPermissionLevel.ToLocalizedLevelName()</span>
                        break;
                    case "originClient":
                        <span class="text-highlight">
                            <a href="/client/@Meta.ChangedById">
                                <ColorCode Value="@Meta.ChangedByName" />
                            </a>
                        </span>
                        break;
                    case "type":
                         <span class="text-white-50">@token.TranslationValue</span>
                        break;
                }
            }
            else
            {
                <span class="text-muted">@token.MatchValue</span>
            }
        }
        </span>
    </text>;

    RenderFragment<InformationResponse> InformationTemplate => (Meta) => @<text>
         <div class="mb-5 p-15 rounded bg-very-dark-dm bg-light-ex-lm profile-meta-entry">
             <div class="profile-meta-value text-primary font-size-14"><ColorCode Value="@Meta.Value" /></div>
             <div class="profile-meta-title text-muted font-size-12">@Meta.Key.Titleize()</div>
         </div>
    </text>;

    RenderFragment<ClientNoteMetaResponse> ClientNoteTemplate => (Meta) => @<text>
        <span data-toggle="tooltip" data-title="@string.Format(AppState.Loc("WEBFRONT_META_TOOLTIP_TIME"), Meta.When.ToString("G"))" data-placement="top">
            <span class="text-muted">@AppState.Loc("WEBFRONT_CLIENT_META_NOTE")</span>
            <span class="text-white-dm text-black-lm">@Meta.Note</span>
            <span class="text-muted">&mdash;</span>
            <a class="link-inverse" href="/client/@Meta.OriginEntityId">
                <ColorCode Value="@Meta.OriginEntityName" />
            </a>
        </span>
    </text>;
    // @formatter:on
}
