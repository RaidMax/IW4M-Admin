@page "/Client/AdvancedFind"
@page "/find-client"
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_SEARCH_RESULTS_TITLE") | @AppState.WebfrontBranding</PageTitle>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
    <!-- Heading + edit search -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_TITLE"))</h1>
            <p class="text-sm text-muted mt-0.5">
                @(AppState.Loc("WEBFRONT_SEARCH_RESOURCES_FOUND").FormatExt(_totalCount.ToString("#,##0")))
            </p>
        </div>

        <div class="ml-auto flex items-center gap-2">
            <button type="button"
                    @onclick="() => AppState.IsAdvancedSearchOpen = true"
                    class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-line bg-surface-alt text-sm font-semibold text-foreground hover:bg-surface-hover transition-colors">
                <i class="ph ph-sliders-horizontal text-base"></i>
                @AppState.LocOr("WEBFRONT_SEARCH_EDIT", "Edit search")
            </button>
        </div>
    </div>

    <!-- Active filter summary -->
    @if (!string.IsNullOrEmpty(ClientName) || !string.IsNullOrEmpty(ClientIp) || !string.IsNullOrEmpty(ClientGuid)
         || !string.IsNullOrEmpty(ClientLevel) || !string.IsNullOrEmpty(GameName) || ClientConnected.HasValue
         || Direction == (int)SortDirection.Ascending)
    {
        <div class="flex flex-wrap items-center gap-2">
            @if (!string.IsNullOrEmpty(ClientName))
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-alt text-subtle border border-line">
                    <span class="text-muted">@AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_NAME")</span>
                    <span class="text-foreground">@ClientName</span>
                    @if (IsExactClientName)
                    {
                        <span class="font-mono text-[10px] uppercase text-primary">@AppState.Loc("WEBFRONT_SEARCH_EXACT")</span>
                    }
                </span>
            }
            @if (!string.IsNullOrEmpty(ClientIp))
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-alt text-subtle border border-line">
                    <span class="text-muted">@AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_IP")</span>
                    <span class="font-mono text-foreground">@ClientIp</span>
                    @if (IsExactClientIp)
                    {
                        <span class="font-mono text-[10px] uppercase text-primary">@AppState.Loc("WEBFRONT_SEARCH_EXACT")</span>
                    }
                </span>
            }
            @if (!string.IsNullOrEmpty(ClientGuid))
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-alt text-subtle border border-line">
                    <span class="text-muted">@AppState.Loc("WEBFRONT_SEARCH_GUID_LABEL")</span>
                    <span class="font-mono text-foreground">@ClientGuid</span>
                </span>
            }
            @if (!string.IsNullOrEmpty(ClientLevel))
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-alt text-subtle border border-line">
                    <span class="text-muted">@AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_PERMISSION")</span>
                    <span class="text-foreground">@ClientLevel</span>
                </span>
            }
            @if (!string.IsNullOrEmpty(GameName))
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-alt text-subtle border border-line">
                    <span class="text-muted">@AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_GAME")</span>
                    <span class="text-foreground">@AppState.Loc($"GAME_{GameName}")</span>
                </span>
            }
            @if (ClientConnected.HasValue)
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-alt text-subtle border border-line">
                    <span class="text-muted">@AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_CONNECTED_SINCE")</span>
                    <span class="font-mono text-foreground">@ClientConnected.Value.ToString("g")</span>
                </span>
            }
            @if (Direction == (int)SortDirection.Ascending)
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-alt text-subtle border border-line">
                    <i class="ph ph-sort-ascending text-sm"></i>
                    <span class="text-foreground">@AppState.Loc("WEBFRONT_SEARCH_OLDEST_FIRST")</span>
                </span>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_validationError))
    {
        <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-error/10 border border-error/20 text-error text-sm font-medium">
            <i class="ph ph-warning-circle text-base"></i>
            <span>@_validationError</span>
        </div>
    }

    <!-- Results table -->
    <section class="rounded-xl bg-surface border border-line overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-[10px] font-semibold uppercase tracking-wider text-muted">
                        <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADVANCED_SEARCH_CONTENT_TABLE_NAME_FULL")</th>
                        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")">
                            <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADVANCED_SEARCH_CONTENT_TABLE_IP")</th>
                            <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADVANCED_SEARCH_CONTENT_TABLE_COUNTRY")</th>
                        </AuthorizeView>
                        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                            <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PROFILE_LEVEL")</th>
                        </AuthorizeView>
                        <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_GAME")</th>
                        <th class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PROFILE_META_FIRST_SEEN").Replace("{{time}} ", "")</th>
                        <th class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_SEARCH_LAST_CONNECTED")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                @if (_isLoading && Results.Count == 0)
                {
                    for (var i = 0; i < 6; i++)
                    {
                        <tr>
                            <td colspan="7" class="px-4 py-3">
                                <div class="h-4 rounded bg-surface-alt animate-pulse"></div>
                            </td>
                        </tr>
                    }
                }
                else if (Results.Count == 0)
                {
                    <tr>
                        <td colspan="7">
                            <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
                                <i class="ph ph-magnifying-glass text-3xl text-secondary"></i>
                                <span>@AppState.Loc("WEBFRONT_SEARCH_NO_RESULTS")</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var client in Results)
                    {
                        <tr class="hover:bg-surface-hover transition-colors">
                            <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                <a href="/client/@client.ClientId" class="font-semibold hover:underline @AppState.GetLevelColorClass(client.ClientLevelValue)">
                                    <ColorCode Value="@client.CurrentClientName"/>
                                    @if (client.CurrentClientName != client.MatchedClientName)
                                    {
                                        <span class="ml-2 text-xs font-normal text-muted">[<ColorCode Value="@client.MatchedClientName"/>]</span>
                                    }
                                </a>
                            </td>
                            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")">
                                <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-subtle whitespace-nowrap">@(client.CurrentClientIp.HasValue ? global::SharedLibraryCore.Utilities.ConvertIPtoString(client.CurrentClientIp.Value) : "-")</td>
                                <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                    <span class="inline-flex items-center gap-2">
                                        @if (string.IsNullOrEmpty(client.ClientCountryCode))
                                        {
                                            <i class="ph ph-question text-muted"></i>
                                            <span class="text-muted">@AppState.Loc("WEBFRONT_UNKNOWN")</span>
                                        }
                                        else
                                        {
                                            <img src="https://flagcdn.com/24x18/@(client.ClientCountryCode.ToLower()).png" class="rounded-sm" alt="@client.ClientCountryDisplayName"/>
                                            <span class="text-subtle">@client.ClientCountryDisplayName</span>
                                        }
                                    </span>
                                </td>
                            </AuthorizeView>
                            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                                <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border border-current bg-transparent @AppState.GetLevelColorClass(client.ClientLevelValue)">@client.ClientLevel</span>
                                </td>
                            </AuthorizeView>
                            <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-alt text-subtle" title="@AppState.Loc("GAME_" + client.Game)">
                                    @(global::SharedLibraryCore.Utilities.MakeAbbreviation(AppState.Loc("GAME_" + client.Game)))
                                </span>
                            </td>
                            <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-muted text-right whitespace-nowrap" title="@client.FirstConnection.ToString("f")">@client.FirstConnection.HumanizeForCurrentCulture()</td>
                            <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-muted text-right whitespace-nowrap" title="@client.LastConnection.ToString("f")">@client.LastConnection.HumanizeForCurrentCulture()</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Infinite scroll trigger element (id is observed by wwwroot/js/infinite-scroll.js) -->
    <div id="loadMoreTrigger" class="w-full flex justify-center py-4">
        @if (_isLoading && Results.Count > 0)
        {
            <span class="inline-flex items-center gap-2 text-sm text-muted">
                <i class="ph ph-spinner animate-spin text-base"></i>
                @AppState.Loc("WEBFRONT_LOADING")
            </span>
        }
        else if (_hasMore)
        {
            <div class="h-10"></div>
            <!-- Sentinel spacer -->
        }
        else if (Results.Count > 0)
        {
            <span class="text-muted text-sm">@AppState.Loc("WEBFRONT_SEARCH_NO_MORE_RESULTS")</span>
        }
    </div>
</div>

@code {}
