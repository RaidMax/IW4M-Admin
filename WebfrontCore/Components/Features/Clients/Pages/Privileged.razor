@page "/Client/Privileged"
@page "/privileged-clients"
@attribute [Authorize(Policy = "Permissions.PrivilegedClientsPage.Read")]

<PageTitle>@AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE") | IW4MAdmin</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE") | IW4MAdmin" />
    <meta property="og:description" content="@AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />
    <meta name="theme-color" content="#dc3545">
</HeadContent>



<div class="content mt-0">
    <h4 class="content-title mt-20">@(AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE"))</h4>
    @if (PrivilegedClients != null)
    {
        @foreach (var key in PrivilegedClients.Keys)
        {
            <table class="table mb-20" style="table-layout:fixed;">
                <thead>
                <tr class="level-bgcolor-@((int)key)">
                    <th colspan="50%" class="text-light">@(key.ToLocalizedLevelName())</th>
                    <th colspan="20%">@(AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_GAME"))</th>
                    <th colspan="30%"
                        class="text-right font-weight-bold text-force-break">@(AppState.Loc("WEBFRONT_SEARCH_LAST_CONNECTED"))</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var client in PrivilegedClients[key].OrderByDescending(c => c.LastConnection))
                {
                    @if (client.IsMasked)
                    {
                        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                            <tr class="bg-dark-dm bg-light-lm">
                                <td colspan="50%">
                                    <span data-toggle="tooltip" data-title="@(AppState.Loc("WEBFRONT_PRIVILEGED_TOOLTIP_MASKED"))">
                                        <span class="oi oi-shield mr-5 font-size-12"></span>
                                    </span>

                                    <a href="/client/@client.ClientId" class="text-force-break">
                                        <ColorCode Value="@client.Name"/>
                                    </a>
                                </td>
                                <td colspan="20%" class="d-none d-md-table-cell">
                                    <div class="badge">@(AppState.Loc($"GAME_{client.Game}"))</div>
                                </td>
                                <td colspan="20%" class="d-table-cell d-md-none">
                                    <div
                                        class="badge">@(SharedLibraryCore.Utilities.MakeAbbreviation(AppState.Loc($"GAME_{client.Game}")))</div>
                                </td>
                                <td colspan="30%" class="text-right">
                                    @client.LastConnection.Humanize()
                                </td>
                            </tr>
                        </AuthorizeView>
                    }
                    else
                    {
                        <tr class="bg-dark-dm bg-light-lm">
                            <td colspan="50%">
                                <a href="/client/@client.ClientId" class="text-force-break">
                                    <ColorCode Value="@client.Name"/>
                                </a>
                            </td>
                            <td colspan="20%" class="d-none d-md-table-cell">
                                <div class="badge">@(AppState.Loc($"GAME_{client.Game}"))</div>
                            </td>
                            <td colspan="20%" class="d-table-cell d-md-none">
                                <div
                                    class="badge">@(SharedLibraryCore.Utilities.MakeAbbreviation(AppState.Loc($"GAME_{client.Game}")))</div>
                            </td>
                            <td colspan="30%" class="text-right">
                                @client.LastConnection.Humanize()
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        }
    }
    else
    {
        <div class="text-center p-20">
            <span class="oi oi-loop-circular rotating font-size-24 text-primary"></span>
        </div>
    }
</div>
