@page "/Client/Privileged"
@page "/privileged-clients"
@attribute [Authorize(Policy = "Permissions.PrivilegedClientsPage.Read")]

<PageTitle>@AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE") | IW4MAdmin</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE") | IW4MAdmin"/>
    <meta property="og:description" content="@AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE")"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="@NavManager.Uri"/>
    <meta name="theme-color" content="#dc3545">
</HeadContent>



<div class="mt-4 md:mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-foreground">@(AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE"))</h1>
            @if (PrivilegedClients != null)
            {
                 <div class="text-sm text-muted font-medium mt-1">
                     @PrivilegedClients.Sum(x => x.Value.Count).ToString("#,##0") total
                 </div>
            }
        </div>

    @if (PrivilegedClients != null)
    {
        @foreach (var key in PrivilegedClients.Keys.OrderByDescending(key => key))
        {
            <div class="mb-8 overflow-hidden bg-surface rounded-lg shadow ring-1 ring-line">
                <div class="px-4 py-3 border-b border-line font-semibold text-foreground @GetHeaderClass(key)">
                    @(key.ToLocalizedLevelName())
                </div>

                <!-- Desktop Table -->
                <table class="hidden md:table w-full text-left border-collapse">
                    <thead>
                    <tr class="text-xs uppercase text-muted bg-surface-alt/50 border-b border-line">
                        <th class="px-4 py-3 font-medium">@(AppState.Loc("WEBFRONT_CLIENT_NAME"))</th>
                        <th class="px-4 py-3 font-medium w-1/4">@(AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_GAME"))</th>
                        <th class="px-4 py-3 font-medium text-right w-1/4">@(AppState.Loc("WEBFRONT_SEARCH_LAST_CONNECTED"))</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                    @foreach (var client in PrivilegedClients[key].OrderByDescending(c => c.LastConnection))
                    {
                        if (client.IsMasked)
                        {
                            <tr class="hover:bg-surface-hover/30 transition-colors">
                                <td class="px-4 py-3">
                                    <div class="flex items-center">
                                                <span class="mr-2 text-warning"
                                                      title="@(AppState.Loc("WEBFRONT_PRIVILEGED_TOOLTIP_MASKED"))">
                                                    <i class="ph ph-mask-happy text-lg"></i>
                                                    @* Optional: Use ph-spy or ph-shield-check if preferred *@
                                                </span>
                                        <a href="/client/@client.ClientId"
                                           class="font-medium text-primary hover:text-primary/25 transition-colors">
                                            <ColorCode Value="@client.Name"/>
                                        </a>
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                            <span
                                                class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-primary/10 text-primary border border-primary/20">
                                                @(AppState.Loc($"GAME_{client.Game}"))
                                            </span>
                                </td>
                                <td class="px-4 py-3 text-right text-muted text-sm">
                                    @client.LastConnection.Humanize()
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="hover:bg-surface-hover/30 transition-colors">
                                <td class="px-4 py-3">
                                    <div class="flex items-center">
                                        <a href="/client/@client.ClientId"
                                           class="font-medium text-primary hover:text-primary/25 transition-colors">
                                            <ColorCode Value="@client.Name"/>
                                        </a>
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                        <span
                                            class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-primary/10 text-primary border border-primary/20">
                                            @(AppState.Loc($"GAME_{client.Game}"))
                                        </span>
                                </td>
                                <td class="px-4 py-3 text-right text-muted text-sm">
                                    @client.LastConnection.Humanize()
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>

                <!-- Mobile Stack -->
                <div class="md:hidden divide-y divide-line">
                    @foreach (var client in PrivilegedClients[key].OrderByDescending(c => c.LastConnection))
                    {
                        if (client.IsMasked)
                        {
                            <div class="p-4 space-y-2">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-2">
                                            <span class="text-warning"
                                                  title="@(AppState.Loc("WEBFRONT_PRIVILEGED_TOOLTIP_MASKED"))">
                                                <i class="ph ph-mask-happy text-lg"></i>
                                            </span>
                                        <a href="/client/@client.ClientId"
                                           class="font-medium text-primary hover:text-primary/25">
                                            <ColorCode Value="@client.Name"/>
                                        </a>
                                    </div>
                                    <span class="text-xs text-muted">@client.LastConnection.Humanize()</span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                        <span
                                            class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-primary/10 text-primary border border-primary/20">
                                            @(SharedLibraryCore.Utilities.MakeAbbreviation(AppState.Loc($"GAME_{client.Game}")))
                                        </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 space-y-2">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-2">
                                        <a href="/client/@client.ClientId"
                                           class="font-medium text-primary hover:text-primary/25">
                                            <ColorCode Value="@client.Name"/>
                                        </a>
                                    </div>
                                    <span class="text-xs text-muted">@client.LastConnection.Humanize()</span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span
                                        class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-primary/10 text-primary border border-primary/20">
                                        @(SharedLibraryCore.Utilities.MakeAbbreviation(AppState.Loc($"GAME_{client.Game}")))
                                    </span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="flex justify-center items-center py-20">
            <i class="ph ph-spinner animate-spin text-4xl text-primary"></i>
        </div>
    }
</div>
