@page "/Client/Privileged"
@page "/privileged-clients"
@attribute [Authorize(Policy = "Permissions.PrivilegedClientsPage.Read")]
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE") | @AppState.WebfrontBranding</PageTitle>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
    <!-- Heading + game filter tabs -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@(AppState.Loc("WEBFRONT_CLIENT_PRIVILEGED_TITLE"))</h1>
            @if (FilteredPrivilegedClients != null)
            {
                <p class="text-sm text-muted mt-0.5">
                    @(AppState.Loc("WEBFRONT_PRIVILEGED_COUNT").FormatExt(FilteredPrivilegedClients.Sum(x => x.Value.Count).ToString("#,##0")))
                    <span class="text-muted/60">&middot;</span>
                    @(SelectedGame.HasValue ? AppState.Loc($"GAME_{SelectedGame}") : AppState.Loc("GAME_ALL"))
                </p>
            }
        </div>

        @if (FilteredPrivilegedClients != null && ActiveGames.Any())
        {
            <nav class="ml-auto max-w-full overflow-x-auto" aria-label="@AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_GAME")">
                <div class="inline-flex gap-1 p-1 rounded-lg bg-surface border border-line">
                    <a href="/privileged-clients"
                       class="px-3 py-1.5 rounded-md text-sm font-medium whitespace-nowrap transition-colors @(!SelectedGame.HasValue ? "bg-surface-alt text-foreground shadow-sm" : "text-subtle hover:text-foreground hover:bg-surface-hover")">
                        @AppState.Loc("GAME_ALL")
                    </a>
                    @foreach (var game in ActiveGames)
                    {
                        <a href="/privileged-clients?game=@game"
                           class="px-3 py-1.5 rounded-md text-sm font-medium whitespace-nowrap transition-colors @(game == SelectedGame ? "bg-surface-alt text-foreground shadow-sm" : "text-subtle hover:text-foreground hover:bg-surface-hover")">
                            @AppState.Loc($"GAME_{game}")
                        </a>
                    }
                </div>
            </nav>
        }
    </div>

    @if (FilteredPrivilegedClients != null)
    {
        @if (FilteredPrivilegedClients.Count == 0)
        {
            <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
                <i class="ph ph-users text-3xl text-secondary"></i>
                <span>@AppState.Loc("WEBFRONT_SEARCH_NO_RESULTS")</span>
            </div>
        }
        else
        {
            <!-- One card per permission level -->
            <div class="grid gap-4 lg:grid-cols-2 items-start">
                @foreach (var key in FilteredPrivilegedClients.Keys.OrderByDescending(k => k))
                {
                    <section class="rounded-xl bg-surface border border-line overflow-hidden">
                        <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border border-current bg-transparent @AppState.GetLevelColorClass(key)">
                                @(key.ToLocalizedLevelName())
                            </span>
                            <span class="ml-auto text-xs text-muted font-mono tabular-nums">@FilteredPrivilegedClients[key].Count</span>
                        </div>

                        <div class="divide-y divide-line">
                            @foreach (var client in FilteredPrivilegedClients[key].OrderByDescending(c => c.LastConnection))
                            {
                                <div class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-surface-hover transition-colors">
                                    <div class="flex-1 min-w-0 flex items-center gap-2">
                                        @if (client.IsMasked)
                                        {
                                            <i class="ph ph-mask-happy text-base text-warning shrink-0"
                                               title="@(AppState.Loc("WEBFRONT_PRIVILEGED_TOOLTIP_MASKED"))"></i>
                                        }
                                        @if (client.HasTwoFactor)
                                        {
                                            <i class="ph ph-shield-check text-base text-success shrink-0"
                                               title="@(AppState.Loc("WEBFRONT_PROFILE_CONTEXT_MENU_2FA"))"></i>
                                        }
                                        <a href="/client/@client.ClientId"
                                           class="font-semibold text-foreground hover:underline truncate">
                                            <ColorCode Value="@client.Name"/>
                                        </a>
                                    </div>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-surface-alt text-subtle shrink-0"
                                          title="@(AppState.Loc($"GAME_{client.Game}"))">
                                        @(SharedLibraryCore.Utilities.MakeAbbreviation(AppState.Loc($"GAME_{client.Game}")))
                                    </span>
                                    <span class="font-mono text-[11px] text-muted whitespace-nowrap shrink-0"
                                          title="@client.LastConnection.ToString("f")">
                                        @client.LastConnection.HumanizeForCurrentCulture()
                                    </span>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-2">
            <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
            <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
        </div>
    }
</div>
