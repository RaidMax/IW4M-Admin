@page "/Client/Profile/{Id:int}"
@page "/client/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permissions.ProfilePage.Read")]

@* ================================================================ *@
@* OpenGraph / Meta Tags *@
@* ================================================================ *@
<PageTitle>@(Client?.Name.StripColors() ?? AppState.Loc("WEBFRONT_CLIENT_PROFILE_TITLE")) | @AppState.WebfrontBranding</PageTitle>

<HeadContent>
    <meta property="og:title"
          content="@(Client?.Name.StripColors() ?? AppState.Loc("WEBFRONT_PROFILE_OG_TITLE")) | @AppState.WebfrontBranding"/>
    <meta property="og:site_name" content="IW4MAdmin"/>
    <meta property="og:description" content="@GetOpenGraphDescription()"/>
    <meta property="og:type" content="profile"/>
    <meta property="og:url" content="@NavManager.Uri"/>
    <meta property="og:image" content="@(GetGravatarUrl() ?? $"{NavManager.BaseUri}images/icon.png")"/>
</HeadContent>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto">
        <div class="rounded-xl border border-error/30 bg-error/10 text-error px-4 py-3 flex items-center gap-3" role="alert">
            <i class="ph ph-warning-circle text-2xl shrink-0"></i>
            <div class="min-w-0">
                <h1 class="text-sm font-semibold">@AppState.Loc("WEBFRONT_PROFILE_ERROR_TITLE")</h1>
                <p class="text-sm opacity-90 break-words">@_error</p>
            </div>
        </div>
    </div>
}
else if (Client == null)
{
    <div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto">
        <div class="rounded-xl border border-warning/30 bg-warning/10 text-warning px-4 py-3 flex items-center gap-3" role="alert">
            <i class="ph ph-warning text-2xl shrink-0"></i>
            <h1 class="text-sm font-semibold">@(AppState.Loc("WEBFRONT_PROFILE_NOT_FOUND").FormatExt(Id))</h1>
        </div>
    </div>
}
else
{
    var gravatarUrl = Client.Meta?.FirstOrDefault(m => m.Key == "GravatarEmail")?.Value;
    var isTempBanned = Client.ActivePenalty?.Type == EFPenalty.PenaltyType.TempBan;
    var isPermBanned = Client.LevelInt == (int)EFClient.Permission.Banned;
    var isFlagged = Client.LevelInt == (int)EFClient.Permission.Flagged;
    var shortCode = GetShortCode(Client.Name);
    var levelClass = HasPermission(WebfrontEntity.ClientLevel, WebfrontPermission.Read)
        ? AppState.GetLevelColorClass((EFClient.Permission)Client.LevelInt)
        : "text-subtle";
    var currentIp = Client.IPAddress;
    var guidTitle = $"{AppState.Loc("WEBFRONT_PROFILE_DECIMAL")}: {(ulong)Client.NetworkId}";
    var geoTitle = Client.GeoLocationInfo == null
        ? string.Empty
        : string.IsNullOrEmpty(Client.GeoLocationInfo.Region)
            ? Client.GeoLocationInfo.Country
            : $"{Client.GeoLocationInfo.Country} - {Client.GeoLocationInfo.Region}";

    var actionDefaultClass = "inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-line bg-surface-alt text-sm font-semibold text-foreground hover:bg-surface-hover transition-colors";
    var actionPrimaryClass = "inline-flex items-center gap-1.5 h-9 px-3 rounded-lg bg-primary text-sm font-semibold text-white hover:brightness-110 transition";
    var actionDestructiveClass = "inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-error/40 bg-surface-alt text-sm font-semibold text-error hover:bg-error/10 transition-colors";

    <div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">

        @* ================================================================ *@
        @* ACTIVE PENALTY BANNER *@
        @* ================================================================ *@
        @if (Client.ActivePenalty != null)
        {
            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                @{
                    var penaltyColors = Client.ActivePenalty.Type switch
                    {
                        EFPenalty.PenaltyType.Ban => "bg-error/10 border-error/30 text-error",
                        EFPenalty.PenaltyType.TempBan => "bg-warning/10 border-warning/30 text-warning",
                        EFPenalty.PenaltyType.Warning => "bg-warning/10 border-warning/30 text-warning",
                        _ => "bg-surface border-line text-subtle"
                    };
                    var penaltyIcon = Client.ActivePenalty.Type switch
                    {
                        EFPenalty.PenaltyType.Ban => "ph-prohibit",
                        EFPenalty.PenaltyType.TempBan => "ph-clock-countdown",
                        _ => "ph-warning"
                    };
                }
                <div class="rounded-xl border px-4 py-3 flex flex-col md:flex-row md:items-center gap-3 @penaltyColors" role="alert">
                    <i class="ph @penaltyIcon text-2xl shrink-0"></i>
                    <div class="min-w-0 flex-1">
                        <div class="text-[11px] font-bold uppercase tracking-wider opacity-80">
                            @(Client.ActivePenalty.Type == EFPenalty.PenaltyType.Ban
                                ? AppState.Loc("WEBFRONT_PROFILE_PERMANENTLY_BANNED")
                                : Client.ActivePenalty.Type == EFPenalty.PenaltyType.TempBan
                                    ? AppState.Loc("WEBFRONT_PROFILE_TEMPORARILY_BANNED")
                                    : AppState.Loc("WEBFRONT_PROFILE_WARNING_STATUS"))
                        </div>
                        <div class="text-sm font-medium text-foreground break-words">
                            @if (IsAuthorized && !string.IsNullOrEmpty(Client.ActivePenalty.AutomatedOffense) && Client.ActivePenalty.Type != EFPenalty.PenaltyType.Warning)
                            {
                                @(AppState.Loc("WEBFRONT_PROFILE_ANTICHEAT_DETECTION").FormatExt(Client.ActivePenalty.AutomatedOffense))
                            }
                            else
                            {
                                @(Client.ActivePenalty.Offense)
                            }
                        </div>
                        <div class="mt-1 flex flex-wrap items-center gap-x-2 text-xs opacity-80">
                            <a href="/client/@Client.ActivePenaltyPunisherId" class="font-medium hover:underline">
                                <ColorCode Value="@Client.ActivePenaltyPunisherName"/>
                            </a>
                            <span>&middot;</span>
                            <span class="font-mono tabular-nums" title="@Client.ActivePenalty.When.ToStandardFormat()">@Client.ActivePenalty.When.HumanizeForCurrentCulture()</span>
                        </div>
                    </div>

                    @if (Client.ActivePenalty.Expires.HasValue && isTempBanned)
                    {
                        <span class="inline-flex items-center gap-1.5 self-start md:self-center px-2.5 py-1 rounded-full bg-surface border border-current/20 text-xs font-semibold whitespace-nowrap">
                            <i class="ph ph-clock"></i>
                            <span>@(AppState.Loc("WEBFRONT_PROFILE_EXPIRES").FormatExt((Client.ActivePenalty.Expires.Value - DateTime.UtcNow).HumanizeForCurrentCulture()))</span>
                        </span>
                    }
                </div>
            </AuthorizeView>
        }

        @* ================================================================ *@
        @* HERO - Player identity + actions *@
        @* ================================================================ *@
        <section class="relative overflow-hidden rounded-xl border border-line bg-surface-alt p-5 grid gap-4 md:grid-cols-[auto_1fr_auto] items-center">

            @* Avatar *@
            <div class="relative shrink-0 justify-self-center md:justify-self-start">
                <div class="w-16 h-16 rounded-2xl bg-surface border-2 border-current flex items-center justify-center text-2xl font-extrabold bg-cover bg-center select-none @levelClass"
                     style="background-image:url('@($"https://gravatar.com/avatar/{gravatarUrl}?size=168&default=blank&rating=pg")')">
                    @if (string.IsNullOrEmpty(gravatarUrl))
                    {
                        <span>@shortCode</span>
                    }
                </div>
                @if (Client.Online)
                {
                    <span class="absolute -top-1 -right-1 w-3.5 h-3.5 rounded-full bg-success border-2 border-surface-alt"
                          title="@AppState.LocOr("WEBFRONT_PROFILE_ONLINE", "Online")"></span>
                }
            </div>

            @* Identity *@
            <div class="min-w-0 text-center md:text-left">
                <div class="flex flex-wrap items-center justify-center md:justify-start gap-x-3 gap-y-1.5">
                    <h1 class="text-2xl font-extrabold tracking-tight text-foreground break-all">
                        <ColorCode Value="@Client.Name"/>
                    </h1>
                    @if (Client.HasTwoFactor)
                    {
                        <i class="ph-fill ph-shield-check text-lg text-success"
                           title="@AppState.Loc("WEBFRONT_PROFILE_CONTEXT_MENU_2FA")"></i>
                    }
                    @if (Client.GeoLocationInfo != null && !string.IsNullOrEmpty(Client.GeoLocationInfo.CountryCode))
                    {
                        <span class="inline-flex items-center gap-1.5 text-xs text-subtle"
                              title="@geoTitle">
                            <img src="https://flagcdn.com/w80/@(Client.GeoLocationInfo.CountryCode.ToLower()).png"
                                 class="h-3.5 w-auto rounded-sm"
                                 alt="@Client.GeoLocationInfo.Country"/>
                            <span>@Client.GeoLocationInfo.Country</span>
                        </span>
                    }
                </div>

                @* Level / state pills *@
                <div class="mt-2 flex flex-wrap items-center justify-center md:justify-start gap-1.5">
                    <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border border-current bg-transparent @levelClass">
                            @if (isPermBanned)
                            {
                                <i class="ph-bold ph-prohibit"></i>
                            }
                            else if (isFlagged)
                            {
                                <i class="ph-bold ph-flag"></i>
                            }
                            <ColorCode Value="@Client.Level"/>
                        </span>
                        @if (isTempBanned)
                        {
                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-warning/15 text-warning">
                                <i class="ph-bold ph-clock-countdown"></i>
                                @AppState.Loc("WEBFRONT_PROFILE_TEMPORARILY_BANNED")
                            </span>
                        }
                    </AuthorizeView>
                    @if (Client.Online)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-success/15 text-success">
                            <i class="w-1.5 h-1.5 rounded-full bg-success"></i>
                            @AppState.LocOr("WEBFRONT_PROFILE_ONLINE", "Online")
                        </span>
                    }
                </div>

                @* Meta row *@
                <div class="mt-3 flex flex-wrap justify-center md:justify-start gap-x-4 gap-y-1 text-sm text-subtle">
                    <span class="inline-flex items-center gap-1.5">
                        <i class="ph ph-game-controller text-muted"></i>
                        <span>@AppState.Loc($"GAME_{Client.Game}")</span>
                    </span>
                    <span class="inline-flex items-center gap-1.5" title="@Client.FirstConnection.ToStandardFormat()">
                        <i class="ph ph-calendar-blank text-muted"></i>
                        <span class="text-muted">@AppState.LocOr("WEBFRONT_PROFILE_FIRST_SEEN", "First seen")</span>
                        <span>@Client.FirstConnection.HumanizeForCurrentCulture()</span>
                    </span>
                    <span class="inline-flex items-center gap-1.5" title="@Client.LastConnection.ToStandardFormat()">
                        <i class="ph ph-clock text-muted"></i>
                        <span class="text-muted">@AppState.LocOr("WEBFRONT_PROFILE_LAST_SEEN", "Last seen")</span>
                        <span>@Client.LastConnection.HumanizeForCurrentCulture()</span>
                    </span>
                    @if (Client.Online && !string.IsNullOrEmpty(Client.CurrentServerName))
                    {
                        <span class="inline-flex items-center gap-1.5 min-w-0">
                            <i class="ph ph-hard-drives text-muted"></i>
                            <span class="truncate"><ColorCode Value="@Client.CurrentServerName"/></span>
                        </span>
                    }
                    <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientGuid}.{WebfrontPermission.Read}")">
                        <span class="inline-flex items-center gap-1.5 font-mono text-xs tabular-nums select-all"
                              title="@guidTitle">
                            <i class="ph ph-fingerprint text-muted"></i>
                            <span>@Client.NetworkId.ToString("X")</span>
                        </span>
                    </AuthorizeView>
                    <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")">
                        <button type="button"
                                class="inline-flex items-center gap-1.5 font-mono text-xs tabular-nums hover:text-primary transition-colors"
                                @onclick="() => OpenIpContextModal(currentIp)">
                            <i class="ph ph-globe text-muted"></i>
                            <span>@currentIp</span>
                        </button>
                    </AuthorizeView>
                </div>
            </div>

            @* Actions *@
            @if (ContextItems?.Items?.Any() == true)
            {
                <div class="flex flex-wrap gap-1.5 justify-center md:justify-end md:max-w-xs self-center">
                    @foreach (var item in ContextItems.Items)
                    {
                        var isExternal = item.IsLink && item.Reference?.StartsWith("http") == true;
                        var isJoin = item.IsLink && !string.IsNullOrEmpty(Client.ConnectProtocolUrl) && item.Reference == Client.ConnectProtocolUrl;
                        var isDestructive = item.Reference is "ban" or "kick";
                        var buttonClass = isJoin ? actionPrimaryClass : isDestructive ? actionDestructiveClass : actionDefaultClass;

                        if (item.IsLink)
                        {
                            <a href="@item.Reference"
                               target="@(isExternal ? "_blank" : null)"
                               rel="@(isExternal ? "noopener noreferrer" : null)"
                               class="@buttonClass"
                               title="@item.Tooltip">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    <i class="ph @item.Icon text-base"></i>
                                }
                                <span>@item.Title</span>
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="@buttonClass"
                                    title="@item.Tooltip"
                                    @onclick="() => OnProfileContextAction(item)">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    <i class="ph @item.Icon text-base"></i>
                                }
                                <span>@item.Title</span>
                            </button>
                        }
                    }
                </div>
            }
        </section>

        @* ================================================================ *@
        @* ACTIVITY SPARKLINE *@
        @* ================================================================ *@
        <ClientActivitySparkline ClientId="@Client.ClientId"/>

        @* ================================================================ *@
        @* INFORMATION TILES *@
        @* ================================================================ *@
        <ClientInformationTags ClientId="@Client.ClientId"/>

        @* ================================================================ *@
        @* BODY - activity feed + side cards *@
        @* ================================================================ *@
        <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_320px] items-start">

            @* Activity feed *@
            <section class="rounded-xl bg-surface border border-line overflow-hidden min-w-0">
                <div class="flex flex-wrap items-center gap-3 px-4 py-2.5 border-b border-line">
                    <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_PROFILE_ACTIVITY")</h2>
                    <div class="inline-flex gap-1 p-1 rounded-lg bg-surface border border-line max-w-full overflow-x-auto">
                        @foreach (var type in GetFilterableMetaTypes())
                        {
                            var isActive = (!_selectedMetaFilter.HasValue && type == MetaType.All) ||
                                           (_selectedMetaFilter == type);

                            <button type="button"
                                    class="px-3 py-1.5 rounded-md text-xs font-medium whitespace-nowrap transition-colors @(isActive ? "bg-surface-alt text-foreground shadow-sm" : "text-subtle hover:text-foreground hover:bg-surface-hover")"
                                    @onclick="() => SetMetaFilter(type)">
                                @type.ToTranslatedName()
                            </button>
                        }
                    </div>
                </div>
                <div class="min-h-[300px]">
                    <ClientMetaList ClientId="@Client.ClientId" MetaFilterType="@_selectedMetaFilter"/>
                </div>
            </section>

            @* Side cards *@
            <div class="space-y-5 min-w-0">

                @* Admin note *@
                @if (Client.NoteMeta != null && !string.IsNullOrWhiteSpace(Client.NoteMeta.Note))
                {
                    <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientNote}.{WebfrontPermission.Read}")">
                        <section class="rounded-xl bg-surface border border-line overflow-hidden">
                            <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                                <i class="ph ph-note text-warning"></i>
                                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_ACTION_NOTE_FORM_NOTE")</h2>
                                <span class="font-mono text-[11px] text-muted whitespace-nowrap"
                                      title="@Client.NoteMeta.ModifiedDate.ToStandardFormat()">@Client.NoteMeta.ModifiedDate.HumanizeForCurrentCulture()</span>
                            </div>
                            <div class="p-4 text-sm text-foreground leading-relaxed space-y-1">
                                @foreach (var line in Client.NoteMeta.Note.Split("\n"))
                                {
                                    <p class="break-words">@line.TrimEnd('\r')</p>
                                }
                            </div>
                            <div class="px-4 py-2 border-t border-line text-xs text-muted flex items-center gap-1.5">
                                <span>@AppState.Loc("WEBFRONT_PENALTY_BY")</span>
                                <a href="/client/@Client.NoteMeta.OriginEntityId" class="font-medium text-subtle hover:text-primary transition-colors">
                                    <ColorCode Value="@Client.NoteMeta.OriginEntityName"/>
                                </a>
                            </div>
                        </section>
                    </AuthorizeView>
                }

                @* Previous names *@
                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.MetaAliasUpdate}.{WebfrontPermission.Read}")">
                    @if (Client.Aliases?.Any() == true)
                    {
                        <section class="rounded-xl bg-surface border border-line overflow-hidden">
                            <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_PROFILE_PREVIOUS_NAMES")</h2>
                                <span class="font-mono text-xs text-muted tabular-nums">@Client.Aliases.Count</span>
                            </div>
                            <div class="divide-y divide-line max-h-[22rem] overflow-y-auto">
                                @foreach (var alias in Client.Aliases.OrderByDescending(a => a.Date).Take(12))
                                {
                                    <a href="/find-client?clientName=@Uri.EscapeDataString(alias.Value?.StripColors() ?? "")"
                                       class="grid grid-cols-[1fr_auto] gap-2 items-baseline px-4 py-1.5 text-sm hover:bg-surface-hover transition-colors">
                                        <span class="truncate text-foreground"><ColorCode Value="@alias.Value"/></span>
                                        <span class="font-mono text-[11px] text-muted whitespace-nowrap"
                                              title="@alias.Date.ToStandardFormat()">@alias.Date.HumanizeForCurrentCulture()</span>
                                    </a>
                                }
                            </div>
                            @if (Client.Aliases.Count > 12)
                            {
                                <div class="px-4 py-2 text-xs text-center text-muted border-t border-line">
                                    @(AppState.Loc("WEBFRONT_PROFILE_MORE_ALIASES").FormatExt(Client.Aliases.Count - 12))
                                </div>
                            }
                        </section>
                    }
                </AuthorizeView>

                @* IP history *@
                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientIPAddress}.{WebfrontPermission.Read}")">
                    @if (Client.IPs?.Any(ip => !string.IsNullOrEmpty(ip.Value)) == true)
                    {
                        <section class="rounded-xl bg-surface border border-line overflow-hidden">
                            <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_PROFILE_IP_HISTORY")</h2>
                                <span class="font-mono text-xs text-muted tabular-nums">@(Client.IPs.Count(i => !string.IsNullOrEmpty(i.Value)))</span>
                            </div>
                            <div class="divide-y divide-line max-h-[22rem] overflow-y-auto">
                                @foreach (var ip in Client.IPs.Where(i => !string.IsNullOrEmpty(i.Value)).OrderByDescending(i => i.Date).Take(10))
                                {
                                    <div class="grid grid-cols-[1fr_auto_auto] gap-2 items-center px-4 py-1 text-sm hover:bg-surface-hover transition-colors">
                                        <button type="button"
                                                class="text-left font-mono text-xs tabular-nums text-subtle hover:text-primary transition-colors truncate"
                                                @onclick="() => OpenIpContextModal(ip.Value)">
                                            @ip.Value
                                        </button>
                                        <span class="font-mono text-[11px] text-muted whitespace-nowrap"
                                              title="@ip.Date.ToStandardFormat()">@ip.Date.HumanizeForCurrentCulture()</span>
                                        <a href="/find-client?clientIP=@ip.Value"
                                           class="w-7 h-7 rounded-md flex items-center justify-center text-muted hover:text-foreground hover:bg-surface-hover transition-colors"
                                           title="@AppState.Loc("WEBFRONT_PROFILE_SEARCH_IP")"
                                           @onclick:stopPropagation="true">
                                            <i class="ph ph-magnifying-glass"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </AuthorizeView>

                @* Linked accounts *@
                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientGuid}.{WebfrontPermission.Read}")">
                    @if (Client.LinkedAccounts?.Any(linked => linked.Key != Client.ClientId) == true)
                    {
                        <section class="rounded-xl bg-surface border border-line overflow-hidden">
                            <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                                <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.LocOr("WEBFRONT_PROFILE_LINKED_ACCOUNTS", "Linked accounts")</h2>
                                <span class="font-mono text-xs text-muted tabular-nums">@(Client.LinkedAccounts.Count(l => l.Key != Client.ClientId))</span>
                            </div>
                            <div class="divide-y divide-line max-h-[22rem] overflow-y-auto">
                                @foreach (var linked in Client.LinkedAccounts.Where(l => l.Key != Client.ClientId))
                                {
                                    <a href="/client/@linked.Key"
                                       class="grid grid-cols-[auto_1fr] gap-2 items-baseline px-4 py-1.5 text-sm hover:bg-surface-hover transition-colors">
                                        <span class="font-mono text-xs text-muted tabular-nums">#@linked.Key</span>
                                        <span class="font-mono text-xs tabular-nums text-subtle truncate">@linked.Value.ToString("X")</span>
                                    </a>
                                }
                            </div>
                        </section>
                    }
                </AuthorizeView>
            </div>
        </div>
    </div>
}
