@page "/Client/Statistics/{ClientId:int}/Advanced"
@page "/client/{ClientId:int}/stats"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permissions.ProfilePage.Read")]

@* ================================================================ *@
@* OpenGraph / Meta Tags - Always render for crawlers *@
@* ================================================================ *@
<PageTitle>@(Stats?.ClientName.StripColors() ?? AppState.Loc("WEBFRONT_ADV_STATS_TITLE")) | @AppState.WebfrontBranding</PageTitle>

<HeadContent>
    <meta property="og:title"
          content="@(Stats?.ClientName.StripColors() ?? "Player") - @AppState.Loc("WEBFRONT_ADV_STATS_TITLE")"/>
    <meta property="og:description"
          content="@GetOpenGraphDescription()"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="@NavManager.Uri"/>
    <meta property="og:image" content="@GetOpenGraphImage()"/>
</HeadContent>

<div class="flex flex-col xl:flex-row h-full">
    @if (Stats != null)
    {
        var serverName = Stats.Servers.FirstOrDefault(server => server.Endpoint == Stats.ServerEndpoint)?.Name
                         ?? AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS");

        @* Main Content Area - Scrollable *@
        <div class="flex-1 min-w-0 overflow-y-auto">
            <div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">

                <!-- Heading -->
                <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
                    <div class="min-w-0">
                        <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@(AppState.Loc("WEBFRONT_ADV_STATS_TITLE"))</h1>
                        <p class="text-sm text-muted mt-0.5 flex flex-wrap items-center gap-x-1.5">
                            <a href="/client/@Stats.ClientId" class="font-semibold text-subtle hover:text-primary transition-colors">
                                <ColorCode Value="@Stats.ClientName"/>
                            </a>
                            <span class="text-muted/60">&middot;</span>
                            <span><ColorCode Value="@serverName"/></span>
                        </p>
                    </div>
                </div>

                <!-- Hero: rank, ranking and performance history -->
                <section class="relative overflow-hidden rounded-xl border border-line bg-surface-alt p-5 grid gap-4 md:grid-cols-[auto_1fr] xl:grid-cols-[auto_minmax(0,1fr)_minmax(0,1.4fr)] items-center">
                    <div class="justify-self-center md:justify-self-start">
                        <img class="w-20 h-20 md:w-24 md:h-24 object-contain"
                             id="rank_icon"
                             src="/images/stats/ranks/rank_@(GetRankIconIndex(Stats.ZScore)).png"
                             alt="@Stats.Performance"/>
                    </div>

                    <div class="min-w-0 text-center md:text-left">
                        <a href="/client/@Stats.ClientId"
                           class="text-2xl font-extrabold tracking-tight text-foreground hover:text-primary transition-colors break-all">
                            <ColorCode Value="@Stats.ClientName"/>
                        </a>

                        <div class="mt-2 flex flex-wrap items-center justify-center md:justify-start gap-x-4 gap-y-1.5 text-sm text-subtle">
                            @if (Stats.Level == EFClient.Permission.Banned)
                            {
                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide bg-error/15 text-error">
                                    <i class="ph-bold ph-prohibit"></i>
                                    @AppState.Loc("GLOBAL_PERMISSION_BANNED")
                                </span>
                            }
                            else if (Stats.ZScore != null)
                            {
                                if (Stats.Ranking > 0)
                                {
                                    <span class="inline-flex items-center gap-1.5">
                                        <i class="ph ph-trophy text-muted"></i>
                                        <span>@(AppState.Loc("WEBFRONT_ADV_STATS_RANKED_V2").FormatExt(Stats.Ranking?.ToString("#,##0"), Stats.TotalRankedClients.ToString("#,##0")))</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 text-accent">
                                        <i class="ph ph-hourglass"></i>
                                        <span>@AppState.Loc("WEBFRONT_ADV_STATS_EXPIRED")</span>
                                    </span>
                                }

                                if (Stats.ServerId != null)
                                {
                                    <span class="inline-flex items-center gap-1.5">
                                        <i class="ph ph-lightning text-muted"></i>
                                        <span>@((MarkupString)AppState.Loc("WEBFRONT_ADV_STATS_PERFORMANCE").FormatExt($"<span class=\"font-mono font-bold tabular-nums text-foreground\">{Stats.Performance?.ToNumericalString() ?? AppState.Loc("WEBFRONT_ADV_STATS_NO_PERFORMANCE")}</span>"))</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5">
                                        <i class="ph ph-lightning text-muted"></i>
                                        <span>@((MarkupString)AppState.Loc("WEBFRONT_ADV_STATS_RATING").FormatExt($"<span class=\"font-mono font-bold tabular-nums text-foreground\">{Stats.Rating?.ToNumericalString() ?? AppState.Loc("WEBFRONT_ADV_STATS_UNRATED")}</span>"))</span>
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted italic">@AppState.Loc("WEBFRONT_STATS_INDEX_UNRANKED")</span>
                            }
                        </div>
                    </div>

                    <!-- Performance history (canvas id is used by advanced_stats.js) -->
                    <div class="relative w-full h-40 min-w-0 md:col-span-2 xl:col-span-1"
                         id="client_performance_history_container">
                        @if (Stats.PerformanceHistory.Count > 5)
                        {
                            <canvas id="client_performance_history" class="w-full h-full"></canvas>
                        }
                        else
                        {
                            <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-line text-muted text-sm">
                                <i class="ph ph-chart-line text-2xl text-secondary"></i>
                                <span>@AppState.Loc("WEBFRONT_ADV_STATS_NO_GRAPH_DATA")</span>
                            </div>
                        }
                    </div>
                </section>

                <!-- Stat tiles -->
                <div class="grid grid-cols-2 md:grid-cols-4 2xl:grid-cols-8 gap-3">
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_TEXT_KILLS").Titleize(), Stats.Kills.ToNumericalString())
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_TEXT_DEATHS").Titleize(), Stats.Deaths.ToNumericalString())
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_TEXT_KDR").Titleize(), Stats.Kdr, Stats.Kdr != null && double.TryParse(Stats.Kdr, out var k) && k >= 2.0 ? "text-success" : null)
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_SCORE").Titleize(), Stats.Score?.ToString("N0") ?? "-")
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_ZSCORE"), Stats.ZScore.ToNumericalString(2))
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_TEXT_SKILL").ToLower().Titleize(), Stats.Skill)
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_ELO").Titleize(), Stats.Elo)
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_META_SPM").Titleize(), Stats.Spm)
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_TOTAL_DAMAGE"), Stats.TotalDamage.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_SUICIDES"), Stats.Suicides.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_HEADSHOTS"), Stats.Headshots.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_MELEES"), Stats.MeleeKills.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_FAV_WEAP"), Stats.TopWeapons.FirstOrDefault()?.Name)
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_FAV_ATTACHMENTS"), Stats.TopWeapons.FirstOrDefault()?.AttachmentName)
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_TOTAL_WEAPONS_USED"), Stats.UniqueWeapons.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_TOTAL_ACTIVE_TIME"), Stats.ActiveTime?.HumanizeForCurrentCulture())
                </div>

                <!-- Hit locations + weapons -->
                <div class="grid grid-cols-1 2xl:grid-cols-2 gap-5 items-start">

                    <!-- Hit Locations -->
                    <section class="rounded-xl bg-surface border border-line overflow-hidden flex flex-col">
                        <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                            <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_ADV_STATS_HIT_LOCATIONS")</h2>
                            <span class="font-mono text-xs text-muted tabular-nums">@Stats.TopHitLocations.Count</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                <tr class="text-[10px] font-semibold uppercase tracking-wider text-muted">
                                    <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADV_STATS_LOCATION")</th>
                                    <th class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADV_STATS_HITS")</th>
                                    <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADV_STATS_PERCENTAGE")</th>
                                    <th class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADV_STATS_DAMAGE")</th>
                                </tr>
                                </thead>
                                <tbody class="divide-y divide-line">
                                @{
                                    var displayedHitLocations = _showAllHitLocations
                                        ? Stats.TopHitLocations
                                        : Stats.TopHitLocations.Take(5);
                                }
                                @foreach (var hit in displayedHitLocations)
                                {
                                    <tr class="hover:bg-surface-hover transition-colors">
                                        <td class="px-4 py-2.5 align-middle font-medium text-foreground">@hit.Name</td>
                                        <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums">@hit.Hits</td>
                                        <td class="px-4 py-2.5 align-middle">
                                            <div class="flex items-center gap-2">
                                                <div class="w-16 h-1 rounded-full bg-surface-alt overflow-hidden">
                                                    <div class="h-full rounded-full bg-primary"
                                                         style="width: @(Math.Round(hit.Percentage * 100.0))%"></div>
                                                </div>
                                                <span class="font-mono text-xs tabular-nums text-muted">@(Math.Round(hit.Percentage * 100.0).ToString("N0"))%</span>
                                            </div>
                                        </td>
                                        <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums text-muted">@hit.Damage.ToNumericalString()</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        @if (Stats.TopHitLocations.Count > DefaultTableRowCount)
                        {
                            <button type="button" @onclick="() => _showAllHitLocations = !_showAllHitLocations"
                                    class="w-full py-2.5 text-xs font-semibold text-muted hover:text-foreground hover:bg-surface-hover transition-colors border-t border-line flex items-center justify-center gap-1.5">
                                <i class="ph-bold @(_showAllHitLocations ? "ph-caret-up" : "ph-caret-down")"></i>
                                @if (_showAllHitLocations)
                                {
                                    <span>@AppState.Loc("WEBFRONT_ADV_STATS_SHOW_LESS")</span>
                                }
                                else
                                {
                                    <span>@(AppState.Loc("WEBFRONT_ADV_STATS_SHOW_ALL").FormatExt(Stats.TopHitLocations.Count))</span>
                                }
                            </button>
                        }

                        <!-- Hit location model canvas (ids are used by advanced_stats.js) -->
                        <div class="relative h-64 flex items-center justify-center p-4 border-t border-line bg-surface-alt/40"
                             id="hitlocation_container">
                            <canvas id="hitlocation_model" class="w-full h-full object-contain"></canvas>
                        </div>
                    </section>

                    <!-- Weapons Used -->
                    <section class="rounded-xl bg-surface border border-line overflow-hidden flex flex-col">
                        <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                            <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_ADV_STATS_WEAP_USAGE")</h2>
                            <span class="font-mono text-xs text-muted tabular-nums">@Stats.TopWeapons.Count</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                <tr class="text-[10px] font-semibold uppercase tracking-wider text-muted">
                                    <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADV_STATS_WEAPON")</th>
                                    <th class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADV_STATS_KILLS")</th>
                                    <th class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADV_STATS_HITS")</th>
                                    <th class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADV_STATS_DAMAGE")</th>
                                    <th class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_ADV_STATS_USAGE")</th>
                                </tr>
                                </thead>
                                <tbody class="divide-y divide-line">
                                @{
                                    var displayedWeapons = _showAllWeapons
                                        ? Stats.TopWeapons
                                        : Stats.TopWeapons.Take(DefaultTableRowCount);
                                }
                                @foreach (var weapon in displayedWeapons)
                                {
                                    <tr class="hover:bg-surface-hover transition-colors">
                                        <td class="px-4 py-2.5 align-middle">
                                            <div class="flex flex-col min-w-0">
                                                <span class="font-medium text-foreground truncate">@weapon.Name</span>
                                                <span class="text-xs text-muted truncate">@(weapon.AttachmentName ?? "--")</span>
                                            </div>
                                        </td>
                                        <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums">@weapon.Kills.ToNumericalString()</td>
                                        <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums">@weapon.Hits.ToNumericalString()</td>
                                        <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums text-muted">@weapon.Damage.ToNumericalString()</td>
                                        <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums text-muted whitespace-nowrap">@(weapon.UsageSeconds.HasValue ? TimeSpan.FromSeconds(weapon.UsageSeconds.Value).ToString(@"h\:mm\:ss") : "--")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        @if (Stats.TopWeapons.Count > DefaultTableRowCount)
                        {
                            <button type="button" @onclick="() => _showAllWeapons = !_showAllWeapons"
                                    class="w-full py-2.5 text-xs font-semibold text-muted hover:text-foreground hover:bg-surface-hover transition-colors border-t border-line flex items-center justify-center gap-1.5">
                                <i class="ph-bold @(_showAllWeapons ? "ph-caret-up" : "ph-caret-down")"></i>
                                @if (_showAllWeapons)
                                {
                                    <span>@AppState.Loc("WEBFRONT_ADV_STATS_SHOW_LESS")</span>
                                }
                                else
                                {
                                    <span>@(AppState.Loc("WEBFRONT_ADV_STATS_SHOW_ALL").FormatExt(Stats.TopWeapons.Count))</span>
                                }
                            </button>
                        }
                    </section>
                </div>

            </div>
        </div>

        @* ================================================================ *@
        @* SIDEBAR - server selector *@
        @* ================================================================ *@
        <div class="xl:w-80 xl:shrink-0 xl:py-6 xl:pr-0 pl-0">
            <div class="sticky top-6">
                <SideContextMenu Model="MenuItems"/>
            </div>
        </div>
    }
</div>

@code {

    private RenderFragment RenderStatCard(string name, string? value, string? valueColor = null) => __builder =>
    {
        <div class="rounded-xl bg-surface border border-line px-4 py-3.5 min-w-0">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-muted truncate" title="@name">@name</div>
            <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none truncate @(valueColor ?? "text-foreground")" title="@value">
                @if (string.IsNullOrWhiteSpace(value))
                {
                    <span class="text-muted">&mdash;</span>
                }
                else
                {
                    @value
                }
            </div>
        </div>
    };

}
