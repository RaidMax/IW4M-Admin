@page "/Client/Statistics/{ClientId:int}/Advanced"

@if (Stats == null)
{
    <div class="text-center p-20">
        <span class="oi oi-loop-circular rotating font-size-24 text-primary"></span>
    </div>
}
else
{
    var config = DefaultConfig.GameStrings;
    // Helper Variables and logic ported from View
    var weapons = Stats.ByWeapon
        .Where(hit => hit.DamageInflicted > 0 || (hit.DamageInflicted == 0 && hit.HitCount > 0))
        .GroupBy(hit => new { hit.WeaponId })
        .Select(group =>
        {
            var withoutAttachments = group.FirstOrDefault(hit => hit.WeaponAttachmentComboId == null);
            var mostUsedAttachment = group.Except(new[] { withoutAttachments })
                .OrderByDescending(g => g.DamageInflicted)
                .GroupBy(g => g.WeaponAttachmentComboId)
                .FirstOrDefault()
                ?.FirstOrDefault();

            if (withoutAttachments == null || mostUsedAttachment == null)
            {
                return withoutAttachments;
            }

            withoutAttachments.WeaponAttachmentComboId = mostUsedAttachment.WeaponAttachmentComboId;
            withoutAttachments.WeaponAttachmentCombo = mostUsedAttachment.WeaponAttachmentCombo;

            return withoutAttachments;
        })
        .Where(hit => hit != null)
        .OrderByDescending(hit => hit.KillCount)
        .ToList();

    var allPerServer = Stats.All.Where(hit => hit.ServerId == Stats.ServerId).ToList();
    var aggregate = Stats.ServerId == null
        ? Stats.Aggregate
        : allPerServer.Where(hit => hit.WeaponId == null)
            .Where(hit => hit.HitLocation == null)
            .Where(hit => hit.ServerId == Stats.ServerId)
            .Where(hit => hit.WeaponAttachmentComboId == null)
            .FirstOrDefault(hit => hit.MeansOfDeathId == null);

    var filteredHitLocations = Stats.ByHitLocation
        .Where(hit => hit.HitCount > 0)
        .Where(hit => hit.HitLocation.Name != "none")
        .Where(hit => hit.HitLocation.Name != "neck")
        .Where(hit => hit.ServerId == Stats.ServerId)
        .OrderByDescending(hit => hit.HitCount)
        .ThenBy(hit => hit.HitLocationId)
        .ToList();

    var uniqueWeapons = allPerServer.Any()
        ? Stats.ByWeapon.Where(hit => hit.ServerId == Stats.ServerId)
            .Where(weapon => weapon.DamageInflicted > 0)
            .GroupBy(weapon => weapon.WeaponId)
            .Count()
        : (int?)null;

    var activeTime = weapons.Any()
        ? TimeSpan.FromSeconds(weapons.Sum(weapon => weapon.UsageSeconds ?? 0))
        : (TimeSpan?)null;

    var kdr = aggregate == null
        ? null
        : Math.Round(aggregate.KillCount / (float)aggregate.DeathCount, 2).ToString(SharedLibraryCore.Utilities.CurrentLocalization.Culture);

    var serverLegacyStat = Stats.LegacyStats.FirstOrDefault(stat => stat.ServerId == Stats.ServerId);

    var performance = Stats.Performance;
    var skill = Stats.ServerId != null ? serverLegacyStat?.Skill.ToNumericalString() : Stats.LegacyStats.WeightValueByPlaytime("Skill", 0).ToNumericalString();
    var elo = Stats.ServerId != null ? serverLegacyStat?.EloRating.ToNumericalString() : Stats.LegacyStats.WeightValueByPlaytime("EloRating", 0).ToNumericalString();
    var spm = Stats.ServerId != null ? serverLegacyStat?.SPM.ToNumericalString() : Stats.LegacyStats.WeightValueByPlaytime("SPM", 0).ToNumericalString();

    // Performance History
    var performanceHistory = Stats.Ratings
        .OrderBy(rating => rating.CreatedDateTime)
        .Select(rating => new PerformanceHistory { Performance = rating.PerformanceMetric, OccurredAt = rating.CreatedDateTime });

    var historyList = performanceHistory.ToList(); // Convert to list to append
    if (performance != null && performance != Stats.Ratings.FirstOrDefault()?.PerformanceMetric)
    {
        historyList.Add(new PerformanceHistory { Performance = performance.Value, OccurredAt = Stats.Ratings.FirstOrDefault()?.CreatedDateTime ?? DateTime.UtcNow });
    }

    var score = allPerServer.Any() ? allPerServer.Sum(stat => stat.Score) : (long?)null;

    // keys
    const string headshotKey = "MOD_HEAD_SHOT";
    const string headshotKey2 = "headshot";
    const string meleeKey = "MOD_MELEE";
    var suicideKeys = new[] { "MOD_SUICIDE", "MOD_FALLING" };

    var headShots = allPerServer.Any()
        ? allPerServer.Where(hit => hit.MeansOfDeath?.Name == headshotKey || hit.HitLocation?.Name == headshotKey2).Sum(hit => hit.HitCount)
        : (int?)null;

    var meleeKills = allPerServer.Any()
        ? allPerServer.Where(hit => hit.MeansOfDeath?.Name == meleeKey).Sum(hit => hit.KillCount)
        : (int?)null;

    var suicides = allPerServer.Any()
        ? allPerServer.Where(hit => suicideKeys.Contains(hit.MeansOfDeath?.Name ?? "")).Sum(hit => hit.KillCount)
        : (int?)null;

    var hitLocationProjection = filteredHitLocations.Select(loc => new
    {
        name = loc.HitLocation.Name,
        percentage = (loc.HitLocation.Name == "head"
            ? (filteredHitLocations.FirstOrDefault(c => c.HitLocation.Name == "neck")?.HitCount ?? 0) + loc.HitCount
            : loc.HitCount) / (float)(filteredHitLocations.Sum(h => h.HitCount) > 0 ? filteredHitLocations.Sum(h => h.HitCount) : 1)
    }).ToList();

    var maxPercentage = hitLocationProjection.Any() ? hitLocationProjection.Max(p => p.percentage) : 0;

    // Prepare data for JS
    HitLocationData = hitLocationProjection;
    MaxPercentage = maxPercentage;
    HistoryData = historyList;

    <div class="content row mt-20">
        <!-- main content -->
        <div class="col-12 col-lg-9 mt-0">
            <h2 class="content-title mb-0">@(AppState.Loc("WEBFRONT_ADV_STATS_TITLE"))</h2>
            <span class="text-muted">
                <ColorCode
                    Value="@(Stats.Servers.FirstOrDefault(server => server.Endpoint == Stats.ServerEndpoint)?.Name ?? AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS"))"/>
            </span>

            <!-- top card -->
            <div class="card p-20 m-0 mt-15 mb-15">
                <div class="align-self-center d-flex flex-column flex-lg-row flex-fill mb-15">
                    <!-- rank icon via generic helper? Model.ZScore.RankIconIndexForZScore() extension -->
                    <!-- Assuming IW4MAdmin.Plugins.Stats.Helpers is available/used -->
                    <!-- I'll use a hardcoded helper or try to use the extension if namespace is imported -->
                    <!-- Namespace: IW4MAdmin.Plugins.Stats.Helpers -->

                    <img class="img-fluid align-self-center w-75" id="rank_icon"
                         src="/images/stats/ranks/rank_@(GetRankIconIndex(Stats.ZScore)).png" alt="@performance"/>

                    <div class="d-flex flex-column align-self-center m-10 text-center text-lg-left" id="client_stats_summary">
                        <div class="font-size-20 mb-0 font-weight-bold">
                            <a href="/Client/Profile/@Stats.ClientId" class="no-decoration">
                                <ColorCode Value="@Stats.ClientName"/>
                            </a>
                        </div>
                        @if (Stats.Level == EFClient.Permission.Banned)
                        {
                            <div class="h5 mb-0 text-danger">@AppState.Loc("GLOBAL_PERMISSION_BANNED")</div>
                        }
                        else if (Stats.ZScore != null)
                        {
                            if (Stats.Ranking > 0)
                            {
                                <div
                                    class="h5 mb-0">@(AppState.Loc("WEBFRONT_ADV_STATS_RANKED_V2").FormatExt(Stats.Ranking?.ToString("#,##0"), Stats.TotalRankedClients.ToString("#,##0")))</div>
                            }
                            else
                            {
                                <div class="h5 mb-0">@AppState.Loc("WEBFRONT_ADV_STATS_EXPIRED")</div>
                            }

                            if (Stats.ServerId != null)
                            {
                                <div
                                    class="h5 mb-0">@((MarkupString)AppState.Loc("WEBFRONT_ADV_STATS_PERFORMANCE").FormatExt($"<span class=\"text-primary\">{performance.ToNumericalString()}</span>"))</div>
                            }
                            else
                            {
                                <div
                                    class="h5 mb-0">@((MarkupString)AppState.Loc("WEBFRONT_ADV_STATS_RATING").FormatExt($"<span class=\"text-primary\">{Stats.Rating.ToNumericalString()}</span>"))</div>
                            }
                        }
                        else
                        {
                            <div class="h5 mb-0">@AppState.Loc("WEBFRONT_STATS_INDEX_UNRANKED")</div>
                        }
                    </div>

                    @if (historyList.Count > 5)
                    {
                        <div class="w-full w-lg-half m-auto ml-lg-auto" id="client_performance_history_container">
                            <canvas id="client_performance_history"></canvas>
                        </div>
                    }
                </div>
                <hr class="m-10"/>

                <!-- Stat Cards Grid -->
                <div class="d-flex flex-row flex-wrap rounded">
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_TEXT_KILLS").Titleize(), aggregate?.KillCount.ToNumericalString())
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_TEXT_DEATHS").Titleize(), aggregate?.DeathCount.ToNumericalString())
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_TEXT_KDR").Titleize(), kdr)
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_SCORE").Titleize(), score?.ToString("N0") ?? "-")
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_ZSCORE"), Stats.ZScore.ToNumericalString(2))
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_TEXT_SKILL").ToLower().Titleize(), skill)
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_ELO").Titleize(), elo)
                    @RenderStatCard(AppState.Loc("PLUGINS_STATS_META_SPM").Titleize(), spm)
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_TOTAL_DAMAGE"), aggregate?.DamageInflicted.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_SUICIDES"), suicides.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_HEADSHOTS"), headShots.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_MELEES"), meleeKills.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_FAV_WEAP"), GetWeaponNameForHit(weapons.FirstOrDefault(), config))
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_FAV_ATTACHMENTS"), GetWeaponAttachmentName(weapons.FirstOrDefault()?.WeaponAttachmentCombo, config))
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_TOTAL_WEAPONS_USED"), uniqueWeapons.ToNumericalString())
                    @RenderStatCard(AppState.Loc("WEBFRONT_ADV_STATS_TOTAL_ACTIVE_TIME"), activeTime?.HumanizeForCurrentCulture())
                </div>
            </div>

            <div class="d-flex flex-wrap flex-column-reverse flex-xl-row">
                <!-- Hit Locations -->
                <div class="mr-0 mr-xl-20 flex-fill flex-xl-grow-1">
                    <h4 class="content-title mb-15 mt-15">@AppState.Loc("WEBFRONT_ADV_STATS_HIT_LOCATIONS")</h4>
                    <table class="table">
                        <thead>
                        <tr class="bg-primary text-light">
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_LOCATION")</th>
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_HITS")</th>
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_PERCENTAGE")</th>
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_DAMAGE")</th>
                        </tr>
                        </thead>
                        <tbody>
                        @{
                            var totalHits = filteredHitLocations.Sum(hit => hit.HitCount);
                        }
                        @foreach (var hit in filteredHitLocations.Take(5))
                        {
                            <tr class="bg-dark-dm bg-light-lm">
                                <td>@config.GetStringForGame(hit.HitLocation.Name, hit.HitLocation.Game)</td>
                                <td>@hit.HitCount</td>
                                <td>@(Math.Round((hit.HitCount / (float)(totalHits > 0 ? totalHits : 1)) * 100.0).ToString("N0"))%</td>
                                <td>@hit.DamageInflicted.ToNumericalString()</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <div class="h-250 p-15 card m-0 d-flex justify-content-center rounded-bottom" id="hitlocation_container">
                        <canvas id="hitlocation_model"></canvas>
                    </div>
                </div>

                <!-- Weapons Used -->
                <div class="flex-fill flex-xl-grow-1">
                    <h4 class="content-title mb-15 mt-15">@AppState.Loc("WEBFRONT_ADV_STATS_WEAP_USAGE")</h4>
                    <table class="table">
                        <thead>
                        <tr class="bg-primary text-light">
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_WEAPON")</th>
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_FAV_ATTACHMENTS")</th>
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_KILLS")</th>
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_HITS")</th>
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_DAMAGE")</th>
                            <th>@AppState.Loc("WEBFRONT_ADV_STATS_USAGE")</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var weapon in weapons.Take(10))
                        {
                            <tr class="bg-dark-dm bg-light-lm">
                                <td>@GetWeaponNameForHit(weapon, config)</td>
                                <td>@(GetWeaponAttachmentName(weapon.WeaponAttachmentCombo, config) ?? "--")</td>
                                <td>@weapon.KillCount.ToNumericalString()</td>
                                <td>@weapon.HitCount.ToNumericalString()</td>
                                <td>@weapon.DamageInflicted.ToNumericalString()</td>
                                <td>@TimeSpan.FromSeconds(weapon.UsageSeconds ?? 0).HumanizeForCurrentCulture(minUnit: TimeUnit.Second)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- side menu -->
        <div class="col-12 col-lg-3">
            <SideContextMenu Model="MenuItems"/>
        </div>
    </div>
}

@code {

    private RenderFragment RenderStatCard(string name, string value) => __builder =>
    {
        <div class="stat-card bg-very-dark-dm bg-light-ex-lm p-15 m-md-5 w-half w-md-200 rounded flex-fill">
            @if (string.IsNullOrWhiteSpace(value))
            {
                <div class="m-0">&mdash;</div>
            }
            else
            {
                <div class="m-0 font-size-16 text-primary">@value</div>
            }
            <div class="font-size-12 text-muted">@name</div>
        </div>
    };

}
