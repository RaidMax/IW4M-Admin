@page "/Client/Statistics"
@page "/Stats/TopPlayers"
@page "/stats/top"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<PageTitle>@AppState.Loc("WEBFRONT_TOP_PLAYERS_TITLE") | IW4MAdmin</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_TOP_PLAYERS_TITLE") | IW4MAdmin" />
    <meta property="og:description" content="@(SelectedServer != null ? SelectedServer.Name : AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS")) &mdash; @TotalRankedClients.ToString("#,##0") @(AppState.Loc("WEBFRONT_TOP_PLAYERS_SUBTITLE"))" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />

</HeadContent>

<div class="max-w-7xl mx-auto p-4 md:p-8 grid grid-cols-1 lg:grid-cols-4 gap-8">
    <div class="lg:col-span-3 space-y-8">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div class="flex items-center gap-4">
                 <div class="flex items-center justify-center p-3 rounded-xl bg-surface-alt/50 border border-line shadow-sm">
                    <i class="ph ph-chart-bar text-2xl text-primary"></i>
                </div>
                <div>
                     <h2 class="text-2xl font-black text-gradient-title tracking-tight text-left">
                        @(AppState.Loc("WEBFRONT_TOP_PLAYERS_TITLE"))
                    </h2>
                    <div class="text-muted mt-1 font-medium flex items-center gap-2 text-sm">
                         <i class="ph ph-globe text-subtle"></i>
                        <ColorCode Value="@(SelectedServer != null ? SelectedServer.Name : AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS"))" />
                        <span class="text-subtle">•</span>
                        <span class="text-primary font-bold">@TotalRankedClients.ToString("#,##0")</span> @(AppState.Loc("WEBFRONT_TOP_PLAYERS_SUBTITLE").ToString().ToLower())
                    </div>
                </div>
            </div>
        </div>

        <div id="topPlayersContainer" class="flex flex-col gap-4">
            @if (_hasLoaded && TotalRankedClients == 0)
            {
                <div class="bg-surface-alt/70 backdrop-blur-md rounded-2xl p-16 text-center border border-line flex flex-col items-center">
                    <div class="w-24 h-24 bg-surface rounded-full flex items-center justify-center mb-6 shadow-inner">
                        <i class="ph ph-timer text-5xl text-subtle"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-foreground">@(AppState.Loc("PLUGINS_STATS_TEXT_NOQUALIFY"))</h3>
                    <p class="text-muted mt-2 max-w-md mx-auto">@(AppState.Loc("WEBFRONT_TOP_PLAYERS_NOQUALIFY_SUBTITLE"))</p>
                </div>
            }
            
            <Virtualize @ref="_virtualizeComponent" Context="stat" ItemsProvider="LoadPlayerStats" OverscanCount="10" ItemSize="110">
                <ItemContent>
                    @{
                        var isGold = stat.Ranking == 1;
                        var isSilver = stat.Ranking == 2;
                        var isBronze = stat.Ranking == 3;
                        var isTop3 = isGold || isSilver || isBronze;

                        var containerClass = isGold ? "bg-gradient-to-br from-yellow-500/15 to-surface/80 border-l-4 border-l-yellow-500 shadow-warning/10" : 
                                            isSilver ? "bg-gradient-to-br from-zinc-400/15 to-surface/80 border-l-4 border-l-zinc-400 shadow-surface/10" : 
                                            isBronze ? "bg-gradient-to-br from-amber-600/15 to-surface/80 border-l-4 border-l-amber-600 shadow-accent/10" : 
                                            "bg-surface-alt/70 backdrop-blur-md border-l-4 border-l-transparent hover:border-l-primary hover:bg-surface-hover/80";
                        
                        var rankColor = isGold ? "text-yellow-400 drop-shadow-[0_2px_10px_rgba(234,179,8,0.5)]" : 
                                    isSilver ? "text-zinc-300 drop-shadow-[0_2px_10px_rgba(203,213,225,0.5)]" : 
                                    isBronze ? "text-amber-500 drop-shadow-[0_2px_10px_rgba(217,119,6,0.5)]" : 
                                    "text-subtle group-hover:text-primary transition-colors";
                    }

                    <div class="@containerClass relative rounded-xl p-5 md:p-0 flex flex-col md:flex-row md:items-center gap-6 transition-all duration-300 hover:transform hover:scale-[1.01] hover:shadow-xl group border-y border-r border-line overflow-hidden">
                        
                        <!-- Rank Number -->
                        <div class="flex md:flex-col items-center justify-center md:w-24 md:self-stretch md:bg-surface-alt shrink-0">
                            <span class="font-black @(isTop3 ? "text-5xl" : "text-3xl") @rankColor tracking-tighter">
                                @stat.Ranking
                            </span>
                            @if (isGold) { <i class="ph ph-crown-simple text-yellow-500 text-lg mt-1 animate-bounce"></i> }
                        </div>

                        <!-- Name & Info -->
                        <div class="flex-1 min-w-0 py-2 md:py-4 pr-4">
                            <div class="flex items-center flex-wrap gap-x-3 gap-y-1 mb-2">
                                <a href="/client/@stat.ClientId" class="text-xl md:text-2xl font-bold text-foreground hover:text-foreground transition-colors truncate tracking-tight">
                                    <ColorCode Value="@stat.Name" />
                                </a>
                                
                                <!-- Rating Change Badge -->
                                @if (stat.RatingChange != 0)
                                {
                                     var isPos = stat.RatingChange > 0;
                                     var changeColor = isPos ? "text-success bg-success/10 border-success/20" : "text-error bg-error/10 border-error/20";
                                     var changeIcon = isPos ? "ph-trend-up" : "ph-trend-down";
                                    <span class="@changeColor border px-2 py-0.5 rounded text-xs font-bold flex items-center gap-1 shadow-sm">
                                        <i class="ph @changeIcon"></i> @Math.Abs(stat.RatingChange)
                                    </span>
                                }
                            </div>

                            <div class="flex flex-col md:flex-row gap-6 md:items-center">
                                <!-- Main Performance Stat -->
                                <div class="flex flex-col">
                                     <span class="text-3xl font-black text-foreground font-mono tracking-tighter leading-none">
                                        @(stat.Performance?.ToNumericalString() ?? "--")
                                    </span>
                                    <span class="text-primary text-[10px] font-bold uppercase tracking-widest mt-1">
                                         Performance
                                    </span>
                                </div>
                                
                                <!-- Secondary Stats Grid -->
                                <div class="grid grid-cols-4 gap-x-8 gap-y-2 border-l border-line pl-6 h-full">
                                     <!-- Kills -->
                                    <div class="flex flex-col">
                                        <span class="text-foreground font-mono font-bold">@stat.Kills.ToNumericalString()</span>
                                        <span class="text-muted text-[10px] uppercase font-bold">Kills</span>
                                    </div>
                                    <!-- Deaths -->
                                    <div class="flex flex-col">
                                        <span class="text-foreground font-mono font-bold">@stat.Deaths.ToNumericalString()</span>
                                        <span class="text-muted text-[10px] uppercase font-bold">Deaths</span>
                                    </div>
                                    <!-- KDR -->
                                    <div class="flex flex-col">
                                        <span class="@(stat.KDR >= 2.0 ? "text-success" : stat.KDR >= 1.0 ? "text-foreground" : "text-error") font-mono font-bold">
                                            @stat.KDR.ToString("F2")
                                        </span>
                                        <span class="text-muted text-[10px] uppercase font-bold">KDR</span>
                                    </div>
                                     <!-- Time -->
                                    <div class="flex flex-col">
                                        <span class="text-foreground font-mono font-bold">@stat.TimePlayedValue.TotalHours.ToString("F0")h</span>
                                        <span class="text-muted text-[10px] uppercase font-bold">Played</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                         <!-- Graph (Via Component) -->
                        <PlayerPerformanceChart ClientId="@stat.ClientId" Id="@stat.Id" History="@stat.PerformanceHistory" />
                        
                        <!-- Skill Rank Icon (Hidden on mobile) -->
                        <div class="hidden md:flex items-center justify-center w-24 bg-surface-alt self-stretch shrink-0 border-l border-line">
                            <img class="w-14 h-14 object-contain filter drop-shadow-lg group-hover:scale-110 transition-transform duration-300" 
                                 src="/images/stats/ranks/rank_@(GetRankIconIndex(stat.ZScore)).png" 
                                 alt="Rank" loading="lazy" />
                        </div>
                    </div>
                </ItemContent>
                <Placeholder>
                    <div class="bg-surface-alt/70 backdrop-blur-md relative rounded-xl p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-6 animate-pulse border border-line">
                         <div class="flex md:flex-col items-center justify-center md:w-24 md:self-stretch bg-surface/50 shrink-0 h-24 rounded-l-xl"></div>
                         <div class="flex-1 space-y-4 py-2">
                             <div class="h-6 w-48 bg-surface/50 rounded"></div>
                             <div class="flex gap-4">
                                 <div class="h-10 w-24 bg-surface/50 rounded"></div>
                                 <div class="h-10 w-64 bg-surface/50 rounded"></div>
                             </div>
                         </div>
                    </div>
                </Placeholder>
            </Virtualize>
        </div>


    </div>
    
    <div class="lg:col-span-1">
        @if (MenuItems != null)
        {
             <div class="sticky top-6">
                 <SideContextMenu Model="MenuItems" />
             </div>
        }
    </div>
</div>
