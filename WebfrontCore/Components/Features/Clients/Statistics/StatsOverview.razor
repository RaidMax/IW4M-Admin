@page "/Client/Statistics"
@page "/Stats/TopPlayers"
@page "/stats/top"
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_TOP_PLAYERS_TITLE") | @AppState.WebfrontBranding</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_TOP_PLAYERS_TITLE") | @AppState.WebfrontBranding" />
    <meta property="og:site_name" content="IW4MAdmin"/>
    <meta property="og:description" content="@GetOpenGraphDescription()" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />
    <meta property="og:image" content="@GetOpenGraphImage()" />
</HeadContent>

<div class="flex flex-col xl:flex-row h-full">

    @* Main content *@
    <div class="flex-1 min-w-0 p-4 md:p-6 xl:p-8 overflow-y-auto">
        <div class="max-w-[1680px] mx-auto space-y-5">

            <!-- Heading -->
            <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
                <div class="min-w-0">
                    <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">
                        @(AppState.Loc("WEBFRONT_TOP_PLAYERS_TITLE"))
                    </h1>
                    <p class="text-sm text-muted mt-0.5 flex flex-wrap items-center gap-x-1.5">
                        <ColorCode Value="@(SelectedServer != null ? SelectedServer.Name : AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS"))"/>
                        <span class="text-muted/60">&middot;</span>
                        <span>
                            <span class="font-mono tabular-nums text-foreground">@TotalRankedClients.ToString("#,##0")</span>
                            @(AppState.Loc("WEBFRONT_TOP_PLAYERS_SUBTITLE").ToString().ToLower())
                        </span>
                    </p>
                </div>
            </div>

            <!-- Ranked list -->
            <section id="topPlayersContainer" class="rounded-xl bg-surface border border-line overflow-hidden">
                <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                    <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">
                        @AppState.LocOr("WEBFRONT_TOP_PLAYERS_RANKING", "Ranking")
                    </h2>
                    <span class="text-xs text-muted">
                        @(SelectedServer != null ? AppState.Loc("WEBFRONT_STATS_PERFORMANCE") : AppState.Loc("WEBFRONT_STATS_RATING"))
                    </span>
                </div>

                <!-- Column headers (md and up) -->
                <div class="hidden md:grid grid-cols-[2.5rem_2.25rem_minmax(0,1fr)_6rem_4.5rem_5.5rem_4.5rem_2.5rem] xl:grid-cols-[2.5rem_2.25rem_minmax(0,1fr)_6rem_4.5rem_5.5rem_4.5rem_13rem_2.5rem] gap-3 items-center px-4 py-2 border-b border-line text-[10px] font-semibold uppercase tracking-wider text-muted">
                    <div class="font-mono">#</div>
                    <div></div>
                    <div>@AppState.Loc("WEBFRONT_TABLE_PLAYER")</div>
                    <div>@(SelectedServer != null ? AppState.Loc("WEBFRONT_STATS_PERFORMANCE") : AppState.Loc("WEBFRONT_STATS_RATING"))</div>
                    <div>@AppState.Loc("WEBFRONT_STATS_KDR")</div>
                    <div class="whitespace-nowrap">@AppState.Loc("WEBFRONT_STATS_KILLS") / @AppState.Loc("WEBFRONT_STATS_DEATHS")</div>
                    <div>@AppState.Loc("WEBFRONT_STATS_PLAYED")</div>
                    <div class="hidden xl:block">@AppState.LocOr("WEBFRONT_STATS_TREND", "Trend")</div>
                    <div></div>
                </div>

                @if (_hasLoaded && TotalRankedClients == 0)
                {
                    <div class="flex flex-col items-center justify-center gap-2 py-10 px-4 text-muted text-sm text-center">
                        <i class="ph ph-timer text-3xl text-secondary"></i>
                        <span class="font-semibold text-foreground">@(AppState.Loc("PLUGINS_STATS_TEXT_NOQUALIFY"))</span>
                        <span>@(AppState.Loc("WEBFRONT_TOP_PLAYERS_NOQUALIFY_SUBTITLE"))</span>
                    </div>
                }

                <div class="divide-y divide-line">
                    <Virtualize @ref="_virtualizeComponent" Context="stat" ItemsProvider="LoadPlayerStats"
                                OverscanCount="10" ItemSize="96">
                        <ItemContent>
                            @{
                                var isTop3 = stat.Ranking <= 3;
                                var isSelf = AppState.User?.ClientId == stat.ClientId;
                                var strippedName = (stat.Name ?? string.Empty).StripColors();
                                var initial = strippedName.Length > 0 ? strippedName.Substring(0, 1).ToUpperInvariant() : "?";
                                var topPerformance = TopPlayers?.FirstOrDefault()?.Performance;
                                var barPercent = topPerformance is > 0 && stat.Performance is > 0
                                    ? Math.Clamp(stat.Performance.Value / topPerformance.Value * 100, 0, 100)
                                    : 0;
                                var kdrClass = stat.KDR >= 2.0 ? "text-success" : stat.KDR >= 1.0 ? "text-foreground" : "text-error";
                            }

                            <div class="group grid grid-cols-[2rem_2.25rem_minmax(0,1fr)_auto] md:grid-cols-[2.5rem_2.25rem_minmax(0,1fr)_6rem_4.5rem_5.5rem_4.5rem_2.5rem] xl:grid-cols-[2.5rem_2.25rem_minmax(0,1fr)_6rem_4.5rem_5.5rem_4.5rem_13rem_2.5rem] gap-3 items-center px-4 py-2 transition-colors hover:bg-surface-hover @(isSelf ? "bg-primary/10" : "")">

                                <!-- Rank -->
                                <div class="font-mono tabular-nums text-sm font-bold @(isTop3 ? "text-primary" : "text-muted")">
                                    @stat.Ranking
                                </div>

                                <!-- Avatar initial -->
                                <div class="w-9 h-9 rounded-lg bg-surface-alt border border-line flex items-center justify-center text-sm font-extrabold @(isTop3 ? "text-primary" : "text-subtle")">
                                    @initial
                                </div>

                                <!-- Name + performance bar -->
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <a href="/client/@stat.ClientId"
                                           class="font-semibold text-foreground truncate hover:text-primary transition-colors">
                                            <ColorCode Value="@stat.Name"/>
                                        </a>
                                        @if (stat.RatingChange != 0)
                                        {
                                            var isPos = stat.RatingChange > 0;
                                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-bold font-mono tabular-nums shrink-0 @(isPos ? "bg-success/15 text-success" : "bg-error/15 text-error")">
                                                <i class="ph-bold @(isPos ? "ph-trend-up" : "ph-trend-down")"></i>@Math.Abs(stat.RatingChange)
                                            </span>
                                        }
                                    </div>
                                    <div class="mt-1.5 h-1.5 max-w-xs rounded-full bg-surface-alt overflow-hidden">
                                        <div class="h-full rounded-full bg-primary" style="width:@((int)barPercent)%"></div>
                                    </div>
                                    <div class="md:hidden mt-1 text-[11px] text-muted font-mono tabular-nums whitespace-nowrap">
                                        @AppState.Loc("WEBFRONT_STATS_KDR") <span class="@kdrClass">@stat.KDR.ToString("F2")</span>
                                        <span class="text-muted/60">&middot;</span>
                                        @stat.TimePlayedValue.TotalHours.ToString("F0")h
                                    </div>
                                </div>

                                <!-- Performance / rating -->
                                <div class="text-right md:text-left font-mono tabular-nums text-sm font-bold text-foreground whitespace-nowrap">
                                    @(SelectedServer != null ? (stat.Performance?.ToNumericalString() ?? AppState.Loc("WEBFRONT_ADV_STATS_NO_PERFORMANCE")) : (stat.Performance?.ToNumericalString() ?? AppState.Loc("WEBFRONT_ADV_STATS_UNRATED")))
                                </div>

                                <!-- KDR -->
                                <div class="hidden md:block font-mono tabular-nums text-sm font-semibold @kdrClass">
                                    @stat.KDR.ToString("F2")
                                </div>

                                <!-- Kills / deaths -->
                                <div class="hidden md:block font-mono tabular-nums text-sm text-subtle whitespace-nowrap">
                                    @stat.Kills.ToNumericalString()<span class="text-muted"> / </span>@stat.Deaths.ToNumericalString()
                                </div>

                                <!-- Time played -->
                                <div class="hidden md:block font-mono tabular-nums text-sm text-subtle whitespace-nowrap">
                                    @stat.TimePlayedValue.TotalHours.ToString("F0")h
                                </div>

                                <!-- Performance history (xl and up) -->
                                <div class="hidden xl:block h-20 min-w-0">
                                    <PlayerPerformanceChart ClientId="@stat.ClientId" Id="@stat.Id"
                                                            History="@stat.PerformanceHistory"/>
                                </div>

                                <!-- Skill rank icon -->
                                <div class="hidden md:flex items-center justify-end">
                                    <img class="w-8 h-8 object-contain"
                                         src="/images/stats/ranks/rank_@(GetRankIconIndex(stat.ZScore)).png"
                                         alt="Rank" loading="lazy"/>
                                </div>
                            </div>
                        </ItemContent>
                        <Placeholder>
                            <div class="grid grid-cols-[2rem_2.25rem_minmax(0,1fr)_auto] md:grid-cols-[2.5rem_2.25rem_minmax(0,1fr)_6rem_4.5rem_5.5rem_4.5rem_2.5rem] xl:grid-cols-[2.5rem_2.25rem_minmax(0,1fr)_6rem_4.5rem_5.5rem_4.5rem_13rem_2.5rem] gap-3 items-center px-4 py-2 animate-pulse" aria-busy="true">
                                <div class="h-4 w-5 rounded bg-surface-alt"></div>
                                <div class="w-9 h-9 rounded-lg bg-surface-alt"></div>
                                <div class="min-w-0">
                                    <div class="h-4 w-40 max-w-full rounded bg-surface-alt"></div>
                                    <div class="mt-1.5 h-1.5 max-w-xs rounded-full bg-surface-alt"></div>
                                </div>
                                <div class="h-4 w-12 rounded bg-surface-alt"></div>
                                <div class="hidden md:block h-4 w-10 rounded bg-surface-alt"></div>
                                <div class="hidden md:block h-4 w-14 rounded bg-surface-alt"></div>
                                <div class="hidden md:block h-4 w-10 rounded bg-surface-alt"></div>
                                <div class="hidden xl:block h-20 rounded bg-surface-alt/50"></div>
                                <div class="hidden md:block w-8 h-8 rounded bg-surface-alt ml-auto"></div>
                            </div>
                        </Placeholder>
                    </Virtualize>
                </div>
            </section>
        </div>
    </div>

    @* ================================================================ *@
    @* SIDEBAR - server filter *@
    @* ================================================================ *@
    <div class="xl:w-80 xl:shrink-0 xl:py-6 xl:pr-0 pl-0">
        @if (MenuItems != null)
        {
            <div class="sticky top-6">
                <SideContextMenu Model="MenuItems"/>
            </div>
        }
    </div>
</div>
