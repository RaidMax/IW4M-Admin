@page "/Client/Statistics"
@page "/Stats/TopPlayers"
@page "/stats/top"
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_TOP_PLAYERS_TITLE") | @AppState.WebfrontBranding</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_TOP_PLAYERS_TITLE") | @AppState.WebfrontBranding" />
    <meta property="og:site_name" content="IW4MAdmin"/>
    <meta property="og:description" content="@GetOpenGraphDescription()" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />
    <meta property="og:image" content="@GetOpenGraphImage()" />
</HeadContent>

<div class="flex flex-col xl:flex-row h-full">

    @* Main Content Area - Scrollable *@
    <div class="flex-1 min-w-0 p-4 md:p-6 lg:p-8 overflow-y-auto">
        <div class="max-w-[1400px] mx-auto space-y-8">
            <!-- Header Section -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div
                        class="flex items-center justify-center p-3 rounded-xl bg-surface-alt/50 border border-line shadow-sm">
                        <i class="ph ph-chart-bar text-2xl text-primary"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-black text-gradient-title tracking-tight text-left">
                            @(AppState.Loc("WEBFRONT_TOP_PLAYERS_TITLE"))
                        </h2>
                        <div class="text-muted mt-1 font-medium flex items-center gap-2 text-sm">
                            <i class="ph ph-globe text-subtle"></i>
                            <ColorCode
                                Value="@(PerformanceBucket != null ? System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(PerformanceBucket.ToLower()) : SelectedServer?.Name ?? AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS"))"/>
                            <span class="text-subtle">•</span>
                            <span
                                class="text-primary font-bold">@TotalRankedClients.ToString("#,##0")</span> @(AppState.Loc("WEBFRONT_TOP_PLAYERS_SUBTITLE").ToString().ToLower())
                        </div>
                    </div>
                </div>
            </div>

            <div id="topPlayersContainer" class="flex flex-col gap-4 relative">
                @if (_showBucketSelector && _availableBuckets != null)
                {
                    <h3 class="text-lg font-bold text-foreground">Select a Category</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var bucket in _availableBuckets)
                        {
                            <a href="/stats/top?category=@bucket.Code"
                               class="group bg-surface rounded-xl border border-line p-6 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5 transition-all duration-300 hover:transform hover:scale-[1.02] no-underline">
                                <div class="flex items-center gap-4">
                                    <div class="flex items-center justify-center w-14 h-14 rounded-xl bg-primary/10 border border-primary/20 group-hover:bg-primary/20 transition-colors">
                                        <i class="ph ph-trophy text-2xl text-primary"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h3 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors capitalize">
                                            @bucket.Code
                                        </h3>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-muted text-sm">@bucket.ServerCount server@(bucket.ServerCount != 1 ? "s" : "")</span>
                                            <span class="text-subtle">•</span>
                                            <span class="text-muted text-sm">@string.Join(", ", bucket.Games)</span>
                                        </div>
                                    </div>
                                    <i class="ph ph-caret-right text-xl text-subtle group-hover:text-primary transition-colors"></i>
                                </div>
                            </a>
                        }
                    </div>
                }
                else if (_hasLoaded && TotalRankedClients == 0)
                {
                    <div
                        class="bg-surface-alt/70 backdrop-blur-md rounded-2xl p-16 text-center border border-line flex flex-col items-center">
                        <div
                            class="w-24 h-24 bg-surface rounded-full flex items-center justify-center mb-6 shadow-inner">
                            <i class="ph ph-timer text-5xl text-subtle"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-foreground">@(AppState.Loc("PLUGINS_STATS_TEXT_NOQUALIFY"))</h3>
                        <p class="text-muted mt-2 max-w-md mx-auto">@(AppState.Loc("WEBFRONT_TOP_PLAYERS_NOQUALIFY_SUBTITLE"))</p>
                    </div>
                }

                @foreach (var stat in TopPlayers ?? new())
                {
                            var isGold = stat.Ranking == 1;
                            var isSilver = stat.Ranking == 2;
                            var isBronze = stat.Ranking == 3;
                            var isTop3 = isGold || isSilver || isBronze;

                            var containerClass = isGold ? "bg-gradient-to-br from-yellow-500/15 to-surface/80 border-l-4 border-l-yellow-500 shadow-warning/10" :
                                isSilver ? "bg-gradient-to-br from-zinc-400/15 to-surface/80 border-l-4 border-l-zinc-400 shadow-surface/10" :
                                isBronze ? "bg-gradient-to-br from-amber-600/15 to-surface/80 border-l-4 border-l-amber-600 shadow-accent/10" :
                                "bg-surface-alt/70 backdrop-blur-md border-l-4 border-l-transparent hover:border-l-primary hover:bg-surface-hover/80";

                            var rankColor = isGold ? "text-yellow-400 drop-shadow-[0_2px_10px_rgba(234,179,8,0.5)]" :
                                isSilver ? "text-zinc-300 drop-shadow-[0_2px_10px_rgba(203,213,225,0.5)]" :
                                isBronze ? "text-amber-500 drop-shadow-[0_2px_10px_rgba(217,119,6,0.5)]" :
                                "text-subtle group-hover:text-primary transition-colors";

                        <div
                            class="@containerClass relative rounded-xl p-5 md:p-0 flex flex-col md:flex-row md:items-center gap-6 transition-all duration-300 hover:transform hover:scale-[1.01] hover:shadow-xl group border-y border-r border-line overflow-hidden">

                            <!-- Rank Number -->
                            <div
                                class="relative flex md:flex-col items-center justify-center md:w-24 md:self-stretch md:bg-surface-alt shrink-0">
                                @if (isGold)
                                {
                                    <i class="ph ph-crown-simple absolute text-gray-500/20 text-7xl"></i>
                                }
                                <span
                                    class="font-black @(isTop3 ? "text-5xl" : "text-3xl") @rankColor tracking-tighter relative">
                                    @stat.Ranking
                                </span>
                            </div>

                            <!-- Name & Info -->
                            <div class="flex-1 min-w-0 py-2 md:py-4 pr-4">
                                <div class="flex items-center flex-wrap gap-x-3 gap-y-1 mb-2">
                                    <a href="/client/@stat.ClientId"
                                       class="text-xl md:text-2xl font-bold text-foreground hover:text-foreground transition-colors truncate tracking-tight">
                                        <ColorCode Value="@stat.Name"/>
                                    </a>

                                    <!-- Rating Change Badge -->
                                    @if (stat.RatingChange != 0)
                                    {
                                        var isPos = stat.RatingChange > 0;
                                        var changeColor = isPos ? "text-success bg-success/10 border-success/20" : "text-error bg-error/10 border-error/20";
                                        var changeIcon = isPos ? "ph-trend-up" : "ph-trend-down";
                                        <span
                                            class="@changeColor border px-2 py-0.5 rounded text-xs font-bold flex items-center gap-1 shadow-sm">
                                            <i class="ph @changeIcon"></i> @Math.Abs(stat.RatingChange)
                                        </span>
                                    }
                                </div>

                                <div class="flex flex-col md:flex-row gap-6 md:items-center">
                                    <!-- Main Performance Stat -->
                                    <div class="flex flex-col">
                                         <span
                                             class="text-3xl font-black text-foreground font-mono tracking-tighter leading-none">
                                            @(SelectedServer != null ? (stat.Performance?.ToNumericalString() ?? AppState.Loc("WEBFRONT_ADV_STATS_NO_PERFORMANCE")) : (stat.Performance?.ToNumericalString() ?? AppState.Loc("WEBFRONT_ADV_STATS_UNRATED")))
                                        </span>
                                        <span class="text-primary text-[10px] font-bold uppercase tracking-widest mt-1">
                                             @(SelectedServer != null ? AppState.Loc("WEBFRONT_STATS_PERFORMANCE") : AppState.Loc("WEBFRONT_STATS_RATING"))
                                        </span>
                                    </div>

                                    <!-- Secondary Stats Grid (populated by StatManager + CustomStatsMetrics) -->
                                    <div class="flex flex-wrap gap-x-4 gap-y-2 lg:border-l border-line lg:pl-6 h-full">
                                        @foreach (var metric in stat.Metrics)
                                        {
                                            <div class="flex flex-col min-w-[50px]">
                                                <span class="text-foreground font-mono font-bold">@metric.Value</span>
                                                <span class="text-muted text-[10px] uppercase font-bold">@metric.Key</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Graph (Via Component) -->
                            <PlayerPerformanceChart ClientId="@stat.ClientId" Id="@stat.Id"
                                                    History="@stat.PerformanceHistory"/>

                            <!-- Skill Rank Icon (Hidden on mobile) -->
                            <div
                                class="hidden md:flex items-center justify-center w-24 bg-surface-alt self-stretch shrink-0 border-l border-line">
                                <img
                                    class="w-14 h-14 object-contain filter drop-shadow-lg group-hover:scale-110 transition-transform duration-300"
                                    src="/images/stats/ranks/rank_@(GetRankIconIndex(stat.ZScore)).png"
                                    alt="Rank" loading="lazy"/>
                            </div>
                        </div>
                }

                @if (_hasLoaded && State?.HasMore == true)
                {
                    <InfiniteScrollSentinel OnLoadMore="LoadMore"
                                            HasMore="@(State?.HasMore ?? false)"
                                            IsLoading="@_isLoadingMore">
                        <LoadingTemplate>
                            <div class="bg-surface-alt/70 backdrop-blur-md rounded-xl p-5 md:p-0 flex flex-col md:flex-row md:items-center gap-6 border-y border-r border-line overflow-hidden animate-pulse">
                                <div class="relative flex md:flex-col items-center justify-center md:w-24 md:self-stretch md:bg-surface-alt shrink-0">
                                    <div class="w-10 h-10 bg-surface/30 rounded"></div>
                                </div>
                                <div class="flex-1 min-w-0 py-2 md:py-4 pr-4">
                                    <div class="h-5 w-40 bg-surface/30 rounded mb-2"></div>
                                    <div class="h-4 w-32 bg-surface/20 rounded"></div>
                                </div>
                                <div class="w-full h-24 md:flex-1 md:h-20 md:min-w-[200px] bg-surface/10 rounded"></div>
                                <div class="hidden md:flex items-center justify-center w-24 bg-surface-alt self-stretch shrink-0 border-l border-line">
                                    <div class="w-12 h-12 bg-surface/20 rounded"></div>
                                </div>
                            </div>
                        </LoadingTemplate>
                    </InfiniteScrollSentinel>
                }
            </div>
        </div>
    </div>

    @* ================================================================ *@
    @* SIDEBAR - Fixed position *@
    @* ================================================================ *@
    <div class="xl:w-80 xl:shrink-0 xl:py-6 xl:pr-0 pl-0">
        @if (MenuItems != null)
        {
            <div class="sticky top-6">
                <SideContextMenu Model="MenuItems" Localizer="AppState.Loc"/>
            </div>
        }
    </div>
</div>
