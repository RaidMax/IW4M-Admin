@inject AppState AppState
@*
    Compact achievement-badge strip for match titlebars (leaderboard row + per-client
    history + live snapshot). Surfaces match-level milestones that would otherwise
    require expanding the row to discover. One component, one source of truth, one
    visual style — every titlebar reads the same way.

    Badges (in render order, all conditionally rendered):
      • EE Complete (R{n})   — yellow, ph-trophy. Always shown when EE fired.
      • All Built (X/Y)      — green, ph-wrench. Only when X == Y && Y > 0.
      • Marathon (R30/50/100+) — amber/orange/red, ph-fire. Tiered.
      • Flawless             — pink, ph-heart. Match-wide when TotalDowns is provided
                               (zero across all qualified players); per-player when
                               PlayerDowns is provided (zero for that player). Same
                               label, scope-aware tooltip. Floored at HighestRound ≥ 5.

    Pass null for any signal you don't have / don't want surfaced. Component never
    renders an empty container — it returns nothing when no badges qualify.
*@

@{
    var allBuilt = BuildablesTotal is { } total && total > 0 && BuildablesBuilt >= total;
    var marathonTier = HighestRound switch
    {
        >= 100 => 3,
        >= 50  => 2,
        >= 30  => 1,
        _      => 0
    };
    var showFlawless = HighestRound >= 5
                       && (TotalDowns is 0 || (TotalDowns is null && PlayerDowns is 0));
    var flawlessIsPersonal = TotalDowns is null && PlayerDowns is 0;
    var hasAny = EasterEggRound is not null || EasterEggOccurredAt is not null
                 || allBuilt || marathonTier > 0 || showFlawless;
}

@if (hasAny)
{
    <div class="inline-flex items-center gap-1.5 flex-wrap">

        @if (EasterEggOccurredAt is not null || EasterEggRound is not null)
        {
            var eeLabel = EasterEggRound is { } r
                ? string.Format(AppState.Loc("WEBFRONT_ZOMBIE_MATCH_EE_LABEL_WITH_ROUND"), r)
                : AppState.Loc("WEBFRONT_ZOMBIE_MATCH_EE_LABEL");
            <Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_EE_TOOLTIP")" WrapperClass="inline-flex shrink-0">
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-yellow-400/10 border border-yellow-400/30 text-yellow-400 text-[10px] font-bold uppercase tracking-wider cursor-help">
                    <i class="ph ph-trophy text-[10px]"></i>
                    <span>@eeLabel</span>
                </span>
            </Tooltip>
        }

        @if (allBuilt)
        {
            <Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_BUILDABLES_TOOLTIP")" WrapperClass="inline-flex shrink-0">
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-success/10 border border-success/30 text-success text-[10px] font-bold uppercase tracking-wider cursor-help font-mono">
                    <i class="ph ph-wrench text-[10px]"></i>
                    <span>@BuildablesBuilt/@BuildablesTotal!.Value</span>
                </span>
            </Tooltip>
        }

        @* "+N extra" chip — only when all iconic are built AND there are non-iconic
           extras (side-quest items, PaP-on-Tranzit, etc.). Sits next to the All-Built
           badge so the achievement reads "8/8 +2 extra". Hidden if no extras logged. *@
        @if (allBuilt && ExtraBuildablesBuilt > 0)
        {
            <Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_BUILDABLES_EXTRAS_TOOLTIP").FormatExt(ExtraBuildablesBuilt)" WrapperClass="inline-flex shrink-0">
                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-amber-500/10 border border-amber-500/30 text-amber-400 text-[10px] font-bold uppercase tracking-wider cursor-help font-mono">
                    <i class="ph ph-plus-circle text-[10px]"></i>
                    <span>@ExtraBuildablesBuilt</span>
                </span>
            </Tooltip>
        }

        @if (marathonTier > 0)
        {
            var (mBg, mBorder, mText) = marathonTier switch
            {
                3 => ("bg-red-500/10",    "border-red-500/30",    "text-red-400"),
                2 => ("bg-orange-500/10", "border-orange-500/30", "text-orange-400"),
                _ => ("bg-amber-500/10",  "border-amber-500/30",  "text-amber-400")
            };
            <Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_MARATHON_TOOLTIP").FormatExt(HighestRound)" WrapperClass="inline-flex shrink-0">
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded @mBg border @mBorder @mText text-[10px] font-bold uppercase tracking-wider cursor-help">
                    <i class="ph ph-fire text-[10px]"></i>
                    <span>R@(HighestRound)</span>
                </span>
            </Tooltip>
        }

        @if (showFlawless)
        {
            var flTooltip = flawlessIsPersonal
                ? AppState.Loc("WEBFRONT_ZOMBIE_MATCH_FLAWLESS_PERSONAL_TOOLTIP")
                : AppState.Loc("WEBFRONT_ZOMBIE_MATCH_FLAWLESS_TOOLTIP");
            <Tooltip Text="@flTooltip" WrapperClass="inline-flex shrink-0">
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-pink-500/10 border border-pink-500/30 text-pink-400 text-[10px] font-bold uppercase tracking-wider cursor-help">
                    <i class="ph ph-heart text-[10px]"></i>
                    <span>@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_FLAWLESS_LABEL")</span>
                </span>
            </Tooltip>
        }

    </div>
}

@code {
    /// <summary>Round at which the EE fired. Null hides the EE badge (unless OccurredAt is set with no round).</summary>
    [Parameter] public int? EasterEggRound { get; set; }

    /// <summary>UTC timestamp at which the EE fired. Null hides the EE badge (unless Round is set).</summary>
    [Parameter] public DateTimeOffset? EasterEggOccurredAt { get; set; }

    /// <summary>Distinct iconic buildables completed this match.</summary>
    [Parameter] public int BuildablesBuilt { get; set; }

    /// <summary>Total iconic buildables on this map. Null = no denominator known.</summary>
    [Parameter] public int? BuildablesTotal { get; set; }

    /// <summary>
    /// Count of non-iconic buildables also completed (side-quest / extras). Drives the
    /// "+N extra" chip alongside the All-Built badge — only renders when every iconic
    /// is built AND extras > 0.
    /// </summary>
    [Parameter] public int ExtraBuildablesBuilt { get; set; }

    /// <summary>Match's highest round. Drives Marathon tier and the No-Down floor.</summary>
    [Parameter, EditorRequired] public int HighestRound { get; set; }

    /// <summary>
    /// Match-wide downs across all qualified players. Set this on the leaderboard row
    /// where we want the match-level "No-Down Match" badge. Leave null on per-player
    /// views — pass <see cref="PlayerDowns"/> instead.
    /// </summary>
    [Parameter] public int? TotalDowns { get; set; }

    /// <summary>
    /// This player's downs across the match. Set this on per-client history rows.
    /// When zero (and TotalDowns null), shows a "Personal No-Down" variant.
    /// </summary>
    [Parameter] public int? PlayerDowns { get; set; }
}
