@page "/stats/zombies"
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_TITLE") | @AppState.WebfrontBranding</PageTitle>

@if (!_serviceAvailable || !_hasLoaded)
{
    return;
}

<div class="flex flex-col xl:flex-row h-full">

    @* ================================================================ *@
    @* MAIN CONTENT AREA - Scrollable *@
    @* ================================================================ *@
    <div class="flex-1 min-w-0 p-4 md:p-6 lg:p-8 overflow-y-auto overflow-x-hidden">
        <div class="max-w-[1400px] mx-auto space-y-8">

            @* ================================================================ *@
            @* HEADER *@
            @* ================================================================ *@
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="flex items-center justify-center p-3 rounded-xl bg-surface-alt/50 border border-line shadow-sm">
                        <i class="ph ph-skull text-2xl text-primary"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-black text-gradient-title tracking-tight text-left">
                            @AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_TITLE")
                        </h2>
                        <div class="text-muted mt-1 font-medium flex items-center gap-2 text-sm">
                            <i class="ph ph-game-controller text-subtle"></i>
                            @if (_selectedGame is not null)
                            {
                                <span>@_selectedGame.DisplayName</span>
                                <span class="text-subtle">&bull;</span>
                            }
                            @if (_selectedMap is not null)
                            {
                                <span>@_selectedMap.MapName</span>
                                <span class="text-subtle">&bull;</span>
                            }
                            <span class="text-primary font-bold">@GetPlayerCountLabel(_selectedPlayerCount)</span>
                        </div>
                    </div>
                </div>

                @if (_selectedMap is not null)
                {
                    <div class="flex items-center gap-1.5 p-1 bg-surface-alt/50 border border-line rounded-xl">
                        @foreach (var pc in _selectedMap.PlayerCounts)
                        {
                            var isPcSelected = _selectedPlayerCount == pc;
                            <a href="@BuildFilterUrl(players: pc.ToString())"
                               class="px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 no-underline
                                      @(isPcSelected
                                          ? "bg-primary text-on-primary shadow-lg shadow-primary/20"
                                          : "text-muted hover:text-foreground hover:bg-surface-hover")">
                                @GetPlayerCountLabel(pc)
                            </a>
                        }
                    </div>
                }
            </div>

            @if (_mapRecords.Count > 0)
            {
                <style>
                    @@keyframes zm-marquee {
                        from { transform: translateX(0); }
                        to { transform: translateX(-50%); }
                    }
                </style>
                <div class="relative overflow-hidden rounded-xl bg-surface-alt border border-line shadow-sm"
                     @onmouseenter="() => _marqueePaused = true"
                     @onmouseleave="() => _marqueePaused = false">
                    <div class="flex gap-3 px-4 py-2"
                         style="width: max-content; animation: zm-marquee 60s linear infinite; @(_marqueePaused ? "animation-play-state: paused;" : "")">
                        @for (var i = 0; i < 2; i++)
                        {
                            @foreach (var record in _mapRecords)
                            {
                                <a href="/client/@record.ClientId/stats"
                                   class="flex items-center gap-4 no-underline bg-surface hover:bg-surface-hover border border-line rounded-lg px-4 py-2 transition-colors shrink-0">
                                    <div class="flex flex-col">
                                        <span class="text-[10px] uppercase tracking-wider font-bold text-muted">@record.Label</span>
                                        <span class="text-xs text-subtle truncate max-w-[120px]">@record.PlayerName</span>
                                    </div>
                                    <span class="font-mono text-lg font-bold text-foreground">@record.Value</span>
                                </a>
                            }
                        }
                    </div>
                </div>
            }

            @if (_metadata is null || _metadata.Games.Count == 0)
            {
                <div class="bg-surface-alt/70 backdrop-blur-md rounded-2xl p-16 text-center border border-line flex flex-col items-center">
                    <div class="w-24 h-24 bg-surface rounded-full flex items-center justify-center mb-6 shadow-inner">
                        <i class="ph ph-skull text-5xl text-subtle"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-foreground">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_NO_RECORDS_TITLE")</h3>
                    <p class="text-muted mt-2 max-w-md mx-auto">
                        @AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_NO_RECORDS_DESC")
                    </p>
                </div>
            }
            else if (_selectedMap is not null)
            {
                @* ================================================================ *@
                @* LEADERBOARD LIST *@
                @* ================================================================ *@
                <div class="flex flex-col gap-3 relative">

                    @foreach (var entry in _entries)
                    {
                                var isExpanded = _expandedMatches.ContainsKey(entry.MatchId);

                            <div class="bg-surface border rounded-md overflow-hidden transition-colors duration-150
                                        @(isExpanded ? "border-line" : "border-line/80 hover:bg-surface-hover cursor-pointer")">

                                @* ── HORIZONTAL LEDGER (Collapsed) ── *@
                                @{
                                    var (badgeBg, badgeText, badgeBorder, badgeIcon, badgeLabel) = entry.Rank switch
                                    {
                                        1 => ("bg-yellow-500/10", "text-yellow-500", "border-yellow-500/20", "ph-trophy", AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_RANK_FIRST")),
                                        2 => ("bg-slate-300/10", "text-slate-300", "border-slate-300/20", "ph-medal", AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_RANK_SECOND")),
                                        3 => ("bg-amber-600/10", "text-amber-500", "border-amber-600/20", "ph-medal", AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_RANK_THIRD")),
                                        _ => ("bg-surface-alt", "text-subtle", "border-line/50", (string?)null, AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_RANK_OTHER").FormatExt(entry.Rank))
                                    };
                                }

                                @* Top bar: rank badge + round / map / duration + time + chevron *@
                                <div class="flex items-center justify-between gap-3 px-4 py-2 border-b border-line bg-surface-alt/50"
                                     @onclick="() => ToggleMatchDetail(entry.MatchId)">
                                    <div class="flex items-center gap-3 sm:gap-4 min-w-0">
                                        <div class="inline-flex items-center gap-1.5 @badgeBg @badgeText px-2 py-0.5 rounded text-xs font-bold border @badgeBorder shrink-0">
                                            @if (badgeIcon is not null)
                                            {
                                                <i class="ph @badgeIcon text-xs"></i>
                                            }
                                            <span>@badgeLabel</span>
                                        </div>
                                        <div class="text-foreground font-bold text-sm shrink-0">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_ROUND").FormatExt(entry.HighestRound)</div>
                                        <div class="text-xs text-subtle font-medium truncate hidden md:block">@entry.MapName</div>
                                        <ZombieAchievementBadges
                                            EasterEggQuests="entry.EasterEggQuests"
                                            BuildablesBuilt="entry.BuildablesBuilt"
                                            BuildablesTotal="entry.BuildablesTotal"
                                            ExtraBuildablesBuilt="entry.ExtraBuildablesBuilt"
                                            HighestRound="entry.HighestRound"
                                            TotalDowns="entry.TotalDowns" />
                                        @* Surfaces matches whose listing-shown player count is smaller than the
                                           actual concurrent participants — bucketed by the qualifier (a 2-player
                                           match where one player joined too late lands in the 1-player bucket).
                                           The badge tells viewers the entry isn't a true solo run; bucket+listing
                                           invariant stays intact. *@
                                        @if (entry.TotalPlayerCount > entry.Players.Count)
                                        {
                                            var unqualified = entry.TotalPlayerCount - entry.Players.Count;
                                            <Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_QUALIFIED_TOOLTIP").FormatExt(entry.Players.Count, entry.TotalPlayerCount, unqualified)" WrapperClass="inline-flex shrink-0">
                                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-surface-alt border border-line/60 text-subtle text-[10px] font-bold uppercase tracking-wider cursor-help shrink-0">
                                                    <i class="ph ph-users-three text-[10px]"></i>
                                                    @AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_QUALIFIED_BADGE").FormatExt(entry.Players.Count, entry.TotalPlayerCount)
                                                </span>
                                            </Tooltip>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2 text-xs text-subtle font-medium shrink-0">
                                        @if (entry.Duration is not null)
                                        {
                                            <span>@entry.Duration</span>
                                            <span class="text-line">•</span>
                                        }
                                        <Tooltip Text="@entry.MatchDate.UtcDateTime.ToStandardFormat()" WrapperClass="inline-block">
                                            @entry.MatchDate.Humanize()
                                        </Tooltip>
                                        <i class="ph @(isExpanded ? "ph-caret-up" : "ph-caret-down") text-xs ml-1"></i>
                                    </div>
                                </div>

                                @* Body: player layouts vary by count (1 / 2 / 3-8) *@
                                <div class="p-4" @onclick="() => ToggleMatchDetail(entry.MatchId)">
                                    @if (entry.Players.Count == 1)
                                    {
                                        var p = entry.Players[0];
                                        var soloInf = p.DamageReceived == 0;
                                        var soloRatio = soloInf ? 0 : (double)p.DamageDealt / p.DamageReceived;
                                        <div class="flex flex-col sm:flex-row items-stretch bg-surface-alt/30 rounded-md border border-line/50 overflow-hidden sm:divide-x divide-line/50">
                                            <div class="flex-1 p-4 flex flex-col justify-center bg-surface/20 min-w-0">
                                                <span class="text-[10px] font-bold text-subtle tracking-widest uppercase mb-1">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_PLAYER")</span>
                                                <div class="flex items-center gap-2 min-w-0">
                                                    <a href="/client/@p.ClientId/stats" @onclick:stopPropagation="true"
                                                       class="text-lg font-bold text-foreground truncate hover:text-primary transition-colors no-underline">
                                                        <ColorCode Value="@p.Name"/>
                                                    </a>
                                                    <ZombieAssistanceBadge SoloFromRound="p.SoloFromRound" HighestRound="entry.HighestRound" />
                                                </div>
                                            </div>
                                            <div class="flex-1 p-4 flex flex-col justify-center sm:items-center">
                                                <span class="text-[10px] font-bold text-subtle tracking-widest uppercase mb-1">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_KILLS")</span>
                                                <span class="text-2xl font-mono font-medium text-foreground leading-none">@p.Kills.ToString("N0")</span>
                                            </div>
                                            <div class="flex-1 p-4 flex flex-col justify-center sm:items-center">
                                                <span class="text-[10px] font-bold text-subtle tracking-widest uppercase mb-1">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_DMG_RATIO")</span>
                                                <span class="text-2xl font-mono font-medium text-muted leading-none flex items-center">
                                                    @if (soloInf)
                                                    {
                                                        <i class="ph ph-infinity"></i>
                                                    }
                                                    else
                                                    {
                                                        @soloRatio.ToString("N1")<span class="text-base text-subtle ml-0.5">x</span>
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    else if (entry.Players.Count == 2)
                                    {
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                            @foreach (var p in entry.Players)
                                            {
                                                var inf = p.DamageReceived == 0;
                                                var ratio = inf ? 0 : (double)p.DamageDealt / p.DamageReceived;
                                                <div class="flex items-center justify-between gap-2 p-3 sm:p-4 bg-surface-alt/30 rounded-md border border-line/50 min-w-0">
                                                    <div class="flex flex-col justify-center pr-2 min-w-0">
                                                        <span class="text-[10px] font-bold text-subtle tracking-widest uppercase mb-1">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_PLAYER")</span>
                                                        <div class="flex items-center gap-1.5 min-w-0">
                                                            <a href="/client/@p.ClientId/stats" @onclick:stopPropagation="true"
                                                               class="text-base font-bold text-foreground truncate hover:text-primary transition-colors no-underline">
                                                                <ColorCode Value="@p.Name"/>
                                                            </a>
                                                            <ZombieAssistanceBadge SoloFromRound="p.SoloFromRound" HighestRound="entry.HighestRound" />
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-5 shrink-0">
                                                        <div class="flex flex-col items-center">
                                                            <span class="text-[10px] font-bold text-subtle tracking-widest uppercase mb-1">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_KILLS")</span>
                                                            <span class="text-xl font-mono font-medium text-foreground leading-none">@p.Kills.ToString("N0")</span>
                                                        </div>
                                                        <div class="flex flex-col items-center">
                                                            <span class="text-[10px] font-bold text-subtle tracking-widest uppercase mb-1">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_DMG")</span>
                                                            <span class="text-xl font-mono font-medium text-muted leading-none flex items-center">
                                                                @if (inf)
                                                                {
                                                                    <i class="ph ph-infinity"></i>
                                                                }
                                                                else
                                                                {
                                                                    @ratio.ToString("N1")<span class="text-sm text-subtle ml-0.5">x</span>
                                                                }
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        @* 3-8 players: compact list with dotted leader, two-column on md+ *@
                                        <div class="grid gap-x-12 gap-y-1.5 grid-cols-1 md:grid-cols-2">
                                            @{ var idx = 0; }
                                            @foreach (var p in entry.Players)
                                            {
                                                idx++;
                                                var inf = p.DamageReceived == 0;
                                                var ratio = inf ? 0 : (double)p.DamageDealt / p.DamageReceived;
                                                <div class="flex items-center text-[13px] min-w-0">
                                                    <span class="text-subtle w-5 text-right shrink-0">@(idx).</span>
                                                    <a href="/client/@p.ClientId/stats" @onclick:stopPropagation="true"
                                                       class="font-semibold text-muted truncate ml-2 hover:text-primary transition-colors no-underline">
                                                        <ColorCode Value="@p.Name"/>
                                                    </a>
                                                    <span class="ml-1.5">
                                                        <ZombieAssistanceBadge SoloFromRound="p.SoloFromRound" HighestRound="entry.HighestRound" />
                                                    </span>
                                                    <div class="flex-1 border-b border-dashed border-line/60 mx-3 min-w-[12px]"></div>
                                                    <span class="font-mono tracking-tight tabular-nums shrink-0 flex items-center">
                                                        <span class="text-foreground text-right">@p.Kills.ToString("N0")<span class="text-[10px] text-subtle font-sans ml-0.5">K</span></span>
                                                        <span class="text-line mx-2.5">|</span>
                                                        <span class="text-muted text-right flex items-center justify-end">
                                                            @if (inf)
                                                            {
                                                                <i class="ph ph-infinity"></i>
                                                            }
                                                            else
                                                            {
                                                                @ratio.ToString("N1")<span class="text-[10px] text-subtle font-sans ml-0.5">x</span>
                                                            }
                                                        </span>
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @* ── EXPANDED SCOREBOARD ── *@
                                @if (isExpanded)
                                {
                                    <div class="border-t border-line bg-surface-alt/30">

                                        @* Scoreboard table *@
                                        <div class="overflow-x-auto">
                                            <table class="w-full text-left text-sm whitespace-nowrap">
                                                <thead class="bg-surface-alt text-[10px] font-bold uppercase tracking-widest text-subtle border-b border-line">
                                                    <tr>
                                                        <th class="py-2.5 px-4">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_PLAYER")</th>
                                                        <th class="py-2.5 px-4 text-center"><Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_SCORE_TOOLTIP")" WrapperClass="w-fit inline-block">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_SCORE")</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-center"><Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_NET_TOOLTIP")" WrapperClass="w-fit inline-block">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_NET")</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-center"><Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_SPENT_TOOLTIP")" WrapperClass="w-fit inline-block">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_SPENT")</Tooltip></th>
                                                        <th class="py-2.5 px-3 text-right text-foreground"><Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_KILLS")" WrapperClass="w-fit inline-block">K</Tooltip></th>
                                                        <th class="py-2.5 px-3 text-right text-foreground"><Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_DOWNS")" WrapperClass="w-fit inline-block">D</Tooltip></th>
                                                        <th class="py-2.5 px-3 text-right text-foreground"><Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_REVIVES")" WrapperClass="w-fit inline-block">R</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-right"><Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_KPD_TOOLTIP")" WrapperClass="w-fit inline-block">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_KPD")</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-right"><Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_HS_PCT_TOOLTIP")" WrapperClass="w-fit inline-block">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_HS_PCT")</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-right pr-6"><Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_DMG_RATIO_TOOLTIP")" WrapperClass="w-fit inline-block">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_DMG_RATIO")</Tooltip></th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-line/50">
                                                    @foreach (var p in entry.Players)
                                                    {
                                                        var kpd = p.Downs == 0 ? p.Kills : (double)p.Kills / p.Downs;
                                                        var hsPercent = p.Kills == 0 ? 0 : (double)p.HeadshotKills / p.Kills * 100;
                                                        var netPoints = p.PointsEarned - p.PointsSpent;
                                                        var dmgRatioInfinite = p.DamageReceived == 0;
                                                        var dmgRatio = dmgRatioInfinite ? 0 : (double)p.DamageDealt / p.DamageReceived;

                                                        <tr class="hover:bg-surface-hover transition-colors">
                                                            <td class="py-2 px-4">
                                                                <div class="flex items-center gap-2">
                                                                    @if (_showTimeline.Contains(entry.MatchId))
                                                                    {
                                                                        var isSelected = GetTimelinePlayer(entry.MatchId) == p.ClientId;
                                                                        <button @onclick="() => SetTimelinePlayer(entry.MatchId, p.ClientId)"
                                                                                @onclick:stopPropagation="true"
                                                                                class="w-4 h-4 rounded-full border-2 shrink-0 transition-colors
                                                                                       @(isSelected ? "border-primary bg-primary" : "border-subtle hover:border-muted")">
                                                                        </button>
                                                                    }
                                                                    <a href="/client/@p.ClientId/stats" @onclick:stopPropagation="true"
                                                                       class="font-bold text-foreground hover:text-primary transition-colors no-underline">
                                                                        <ColorCode Value="@p.Name"/>
                                                                    </a>
                                                                </div>
                                                            </td>
                                                            <td class="py-2 px-4 text-center font-mono text-muted text-xs">
                                                                @p.PointsEarned.ToString("N0")
                                                            </td>
                                                            <td class="py-2 px-4 text-center font-mono text-xs @(netPoints > 0 ? "text-success" : netPoints < 0 ? "text-error" : "text-muted")">
                                                                @(netPoints > 0 ? "+" : "")@FormatK((int)netPoints)
                                                            </td>
                                                            <td class="py-2 px-4 text-center font-mono text-xs text-error">
                                                                @FormatK((int)p.PointsSpent)
                                                            </td>
                                                            <td class="py-2 px-3 text-right font-mono text-foreground">@p.Kills.ToString("N0")</td>
                                                            <td class="py-2 px-3 text-right font-mono text-muted">@p.Downs</td>
                                                            <td class="py-2 px-3 text-right font-mono text-muted">@p.Revives</td>
                                                            <td class="py-2 px-4 text-right font-mono font-medium @(kpd >= 1000 ? "text-success" : kpd <= 50 ? "text-error" : "text-foreground")">
                                                                @(kpd > 999 ? FormatK((int)kpd) : kpd.ToString("F1"))
                                                            </td>
                                                            <td class="py-2 px-4 text-right font-mono text-foreground">
                                                                @hsPercent.ToString("F0")%
                                                            </td>
                                                            <td class="py-2 px-4 text-right pr-6 font-mono text-muted">
                                                                @(dmgRatioInfinite ? "∞" : dmgRatio.ToString("N1"))
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        @* Footer with server name and timeline toggle *@
                                        <div class="p-3 bg-surface-alt border-t border-line flex justify-between items-center text-xs">
                                            <div class="flex items-center gap-1.5 text-muted font-mono">
                                                @if (entry.ServerName is not null)
                                                {
                                                    <i class="ph ph-desktop-tower text-subtle"></i>
                                                    <ColorCode Value="@entry.ServerName"/>
                                                }
                                                <Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_MATCH_ID_TOOLTIP")">
                                                    <span class="ml-1 px-1.5 py-0.5 rounded border border-line/60 bg-surface text-[10px] font-semibold text-subtle tracking-wide">
                                                        #@entry.MatchId
                                                    </span>
                                                </Tooltip>
                                            </div>
                                            @if (_expandedMatches.TryGetValue(entry.MatchId, out var matchDetail) && matchDetail is not null)
                                            {
                                                <div class="flex items-center gap-2">
                                                    <Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_SHARE_BUTTON")">
                                                        <button @onclick="() => CopyShareLink(entry.MatchId)" @onclick:stopPropagation="true"
                                                                class="px-4 py-1.5 rounded font-bold transition-colors bg-surface text-muted hover:text-foreground border border-line inline-flex items-center gap-1.5">
                                                            <i class="ph @(_copiedMatchId == entry.MatchId ? "ph-check text-success" : "ph-link")"></i>
                                                            <span>@(_copiedMatchId == entry.MatchId
                                                                ? AppState.Loc("WEBFRONT_ZOMBIE_MATCH_SHARE_COPIED")
                                                                : AppState.Loc("WEBFRONT_ZOMBIE_MATCH_SHARE_BUTTON"))</span>
                                                        </button>
                                                    </Tooltip>
                                                    <button @onclick="() => ToggleTimeline(entry.MatchId)" @onclick:stopPropagation="true"
                                                            class="px-4 py-1.5 rounded font-bold transition-colors
                                                                   @(_showTimeline.Contains(entry.MatchId)
                                                                       ? "bg-surface text-foreground border border-line"
                                                                       : "bg-primary text-on-primary hover:bg-primary/80")">
                                                        @(_showTimeline.Contains(entry.MatchId) ? AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_HIDE_TIMELINE") : AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_VIEW_TIMELINE"))
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="flex items-center gap-2 text-muted">
                                                    <i class="ph ph-spinner animate-spin"></i>
                                                    <span>@AppState.Loc("WEBFRONT_LOADING")</span>
                                                </div>
                                            }
                                        </div>

                                        @* Timeline (existing component) *@
                                        @if (_showTimeline.Contains(entry.MatchId) &&
                                             _expandedMatches.TryGetValue(entry.MatchId, out var detail) && detail is not null)
                                        {
                                            <ZombieMatchDetail Detail="detail" SelectedClientId="GetTimelinePlayer(entry.MatchId)"/>
                                        }
                                    </div>
                                }
                            </div>
                    }

                    @if (_entriesLoaded && _hasMore)
                    {
                        <InfiniteScrollSentinel OnLoadMore="LoadMore"
                                                HasMore="@_hasMore"
                                                IsLoading="@_isLoadingMore">
                            <LoadingTemplate>
                                <div class="bg-surface border border-line/50 rounded-md overflow-hidden animate-pulse">
                                    <div class="flex items-center justify-between gap-3 px-4 py-2 border-b border-line bg-surface-alt/50">
                                        <div class="flex items-center gap-3">
                                            <div class="w-20 h-5 bg-surface-alt rounded"></div>
                                            <div class="w-24 h-4 bg-surface-alt/70 rounded"></div>
                                        </div>
                                        <div class="w-28 h-4 bg-surface-alt/70 rounded"></div>
                                    </div>
                                    <div class="p-4">
                                        <div class="h-12 bg-surface-alt/40 rounded"></div>
                                    </div>
                                </div>
                            </LoadingTemplate>
                        </InfiniteScrollSentinel>
                    }

                    @if (_entriesLoaded && _totalEntries == 0)
                    {
                        <div class="bg-surface-alt/70 backdrop-blur-md rounded-2xl p-12 text-center border border-line flex flex-col items-center mt-4">
                            <div class="w-16 h-16 bg-surface rounded-full flex items-center justify-center mb-4 shadow-inner">
                                <i class="ph ph-timer text-4xl text-subtle"></i>
                            </div>
                            <h3 class="text-xl font-bold text-foreground">@AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_NO_MATCHES_TITLE")</h3>
                            <p class="text-muted mt-2 max-w-md mx-auto text-sm">
                                @AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_NO_MATCHES_DESC")
                            </p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ================================================================ *@
    @* SIDEBAR - Fixed position *@
    @* ================================================================ *@
    <div class="xl:w-80 xl:shrink-0 xl:py-6 xl:pr-0 pl-0">
        @if (MenuItems != null)
        {
            <div class="sticky top-6">
                <SideContextMenu Model="MenuItems"/>
            </div>
        }
    </div>
</div>

@code {

    private bool _marqueePaused;
    private readonly HashSet<int> _showTimeline = new();
    private readonly Dictionary<int, int> _timelinePlayerSelection = new();
    private int? _copiedMatchId;

    private static string FormatK(int num) =>
        num >= 1000 ? ((double)num).ToMetric(decimals: 1) : num.ToString();

    private void ToggleTimeline(int matchId)
    {
        if (!_showTimeline.Remove(matchId))
        {
            _showTimeline.Add(matchId);
        }
    }

    private async Task CopyShareLink(int matchId)
    {
        var url = $"{NavManager.BaseUri.TrimEnd('/')}/zombie/match/{matchId}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedMatchId = matchId;
            StateHasChanged();
            await Task.Delay(2000);
            if (_copiedMatchId == matchId) _copiedMatchId = null;
            StateHasChanged();
        }
        catch
        {
            // Clipboard API requires HTTPS or localhost — fail silently
        }
    }

    private int GetTimelinePlayer(int matchId)
    {
        if (_timelinePlayerSelection.TryGetValue(matchId, out var clientId))
        {
            return clientId;
        }

        // Default to first player
        if (_expandedMatches.TryGetValue(matchId, out var detail) && detail?.Players.Count > 0)
        {
            var first = detail.Players[0].ClientId;
            _timelinePlayerSelection[matchId] = first;
            return first;
        }

        return 0;
    }

    private void SetTimelinePlayer(int matchId, int clientId)
    {
        _timelinePlayerSelection[matchId] = clientId;
    }

}
