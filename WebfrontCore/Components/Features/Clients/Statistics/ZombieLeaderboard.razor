@page "/stats/zombies"
@rendermode InteractiveServer

<PageTitle>Zombie Leaderboard | @AppState.WebfrontBranding</PageTitle>

@if (!_serviceAvailable || !_hasLoaded)
{
    return;
}

<div class="flex flex-col xl:flex-row h-full">

    @* ================================================================ *@
    @* MAIN CONTENT AREA - Scrollable *@
    @* ================================================================ *@
    <div class="flex-1 min-w-0 p-4 md:p-6 lg:p-8 overflow-y-auto overflow-x-hidden">
        <div class="max-w-[1400px] mx-auto space-y-8">

            @* ================================================================ *@
            @* HEADER *@
            @* ================================================================ *@
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="flex items-center justify-center p-3 rounded-xl bg-surface-alt/50 border border-line shadow-sm">
                        <i class="ph ph-skull text-2xl text-primary"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-black text-gradient-title tracking-tight text-left">
                            Zombie Leaderboard
                        </h2>
                        <div class="text-muted mt-1 font-medium flex items-center gap-2 text-sm">
                            <i class="ph ph-game-controller text-subtle"></i>
                            @if (_selectedGame is not null)
                            {
                                <span>@_selectedGame.DisplayName</span>
                                <span class="text-subtle">&bull;</span>
                            }
                            @if (_selectedMap is not null)
                            {
                                <span>@_selectedMap.MapName</span>
                                <span class="text-subtle">&bull;</span>
                            }
                            <span class="text-primary font-bold">@GetPlayerCountLabel(_selectedPlayerCount)</span>
                        </div>
                    </div>
                </div>

                @if (_selectedMap is not null)
                {
                    <div class="flex items-center gap-1.5 p-1 bg-surface-alt/50 border border-line rounded-xl">
                        @foreach (var pc in _selectedMap.PlayerCounts)
                        {
                            var isPcSelected = _selectedPlayerCount == pc;
                            <a href="@BuildFilterUrl(players: pc.ToString())"
                               class="px-4 py-2 rounded-lg text-xs font-bold transition-all duration-200 no-underline
                                      @(isPcSelected
                                          ? "bg-primary text-on-primary shadow-lg shadow-primary/20"
                                          : "text-muted hover:text-foreground hover:bg-surface-hover")">
                                @GetPlayerCountLabel(pc)
                            </a>
                        }
                    </div>
                }
            </div>

            @if (_mapRecords.Count > 0)
            {
                <style>
                    @@keyframes zm-marquee {
                        from { transform: translateX(0); }
                        to { transform: translateX(-50%); }
                    }
                </style>
                <div class="relative overflow-hidden rounded-xl bg-surface-alt border border-line shadow-sm"
                     @onmouseenter="() => _marqueePaused = true"
                     @onmouseleave="() => _marqueePaused = false">
                    <div class="flex gap-3 px-4 py-2"
                         style="width: max-content; animation: zm-marquee 60s linear infinite; @(_marqueePaused ? "animation-play-state: paused;" : "")">
                        @for (var i = 0; i < 2; i++)
                        {
                            @foreach (var record in _mapRecords)
                            {
                                <a href="/client/@record.ClientId/stats"
                                   class="flex items-center gap-4 no-underline bg-surface hover:bg-surface-hover border border-line rounded-lg px-4 py-2 transition-colors shrink-0">
                                    <div class="flex flex-col">
                                        <span class="text-[10px] uppercase tracking-wider font-bold text-muted">@record.Label</span>
                                        <span class="text-xs text-subtle truncate max-w-[120px]">@record.PlayerName</span>
                                    </div>
                                    <span class="font-mono text-lg font-bold text-foreground">@record.Value</span>
                                </a>
                            }
                        }
                    </div>
                </div>
            }

            @if (_metadata is null || _metadata.Games.Count == 0)
            {
                <div class="bg-surface-alt/70 backdrop-blur-md rounded-2xl p-16 text-center border border-line flex flex-col items-center">
                    <div class="w-24 h-24 bg-surface rounded-full flex items-center justify-center mb-6 shadow-inner">
                        <i class="ph ph-skull text-5xl text-subtle"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-foreground">No Zombie Records Yet</h3>
                    <p class="text-muted mt-2 max-w-md mx-auto">
                        Play some zombie matches to start building the leaderboard.
                    </p>
                </div>
            }
            else if (_selectedMap is not null)
            {
                @* ================================================================ *@
                @* LEADERBOARD LIST *@
                @* ================================================================ *@
                <div class="flex flex-col gap-1 relative">

                    @* Table header (desktop) *@
                    <div class="hidden md:flex px-4 py-2 text-[10px] font-bold uppercase tracking-widest text-subtle bg-surface-alt border border-line rounded-lg mb-1">
                        <div class="w-16">Rank</div>
                        <div class="w-24">Round</div>
                        <div class="w-48">Match Info</div>
                        <div class="flex-1">Player Performance <span class="normal-case tracking-normal text-subtle/60 font-normal ml-1" title="Kills / Downs / Revives">(K / D / R)</span></div>
                    </div>

                    <Virtualize @ref="_virtualizeComponent" Context="entry" ItemsProvider="LoadEntries"
                                OverscanCount="10" ItemSize="64">
                        <ItemContent>
                            @{
                                var isExpanded = _expandedMatches.ContainsKey(entry.MatchId);
                            }

                            <div class="bg-surface border rounded-lg overflow-hidden transition-colors duration-150
                                        @(isExpanded ? "border-line" : "border-line/50 hover:bg-surface-hover cursor-pointer")
                                        @(entry.Rank == 1 && !isExpanded ? "border-l-4 border-l-yellow-500" : "")">

                                @* ── DENSE ROW (Collapsed) ── *@
                                <div class="flex flex-col md:flex-row items-start md:items-stretch min-h-[60px]"
                                     @onclick="() => ToggleMatchDetail(entry.MatchId)">

                                    @* Left: Rank & Round *@
                                    <div class="flex items-stretch w-full md:w-40 shrink-0 border-b md:border-b-0 md:border-r border-line/50">
                                        <div class="flex items-center justify-center w-16 shrink-0 bg-surface-alt/50">
                                            <span class="font-black text-xl @(entry.Rank switch {
                                                1 => "text-yellow-500",
                                                2 => "text-zinc-300",
                                                3 => "text-amber-600",
                                                _ => "text-subtle"
                                            })">
                                                #@entry.Rank
                                            </span>
                                        </div>
                                        <div class="flex flex-col justify-center items-center w-24 bg-surface-alt/30">
                                            <span class="text-[28px] font-black text-foreground leading-none">@entry.HighestRound</span>
                                        </div>
                                    </div>

                                    @* Middle: Map & Time *@
                                    <div class="flex flex-col justify-center px-4 py-3 md:py-0 w-full md:w-48 shrink-0 border-b md:border-b-0 md:border-r border-line/50 bg-surface-alt/10">
                                        <span class="text-sm font-bold text-foreground">@entry.MapName</span>
                                        <span class="text-[11px] text-muted font-medium">
                                            @if (entry.Duration is not null)
                                            {
                                                <p>duration of @entry.Duration</p>
                                            }
                                            <p>happened @entry.MatchDate</p>
                                        </span>
                                    </div>

                                    @* Right: Player Performance (compact K/D/R) *@
                                    @{
                                        var isLowDensity = entry.Players.Count <= 2;
                                        var statSize = isLowDensity ? "text-sm" : "text-[11px]";
                                        var nameSize = isLowDensity ? "text-sm" : "text-[10px]";
                                        var nameMax = isLowDensity ? "max-w-[200px]" : "max-w-[80px]";
                                        var gapSize = isLowDensity ? "gap-x-8" : "gap-x-6";
                                    }
                                    <div class="flex-1 flex flex-wrap content-center @gapSize gap-y-3 p-4">
                                        @foreach (var player in entry.Players)
                                        {
                                            <div class="flex flex-col">
                                                <span class="@statSize font-mono tracking-tight">
                                                    <span class="text-foreground font-medium">@FormatK(player.Kills)</span>
                                                    <span class="text-subtle mx-0.5">/</span>
                                                    <span class="text-error">@player.Downs</span>
                                                    <span class="text-subtle mx-0.5">/</span>
                                                    <span class="text-success">@player.Revives</span>
                                                </span>
                                                <span class="@nameSize text-muted font-medium truncate mt-0.5 @nameMax">
                                                    <ColorCode Value="@player.Name"/>
                                                </span>
                                            </div>
                                        }
                                    </div>

                                    @* Expand chevron *@
                                    <div class="hidden md:flex items-center justify-center w-12 shrink-0 border-l border-line/50 text-subtle bg-surface-alt/30 hover:bg-surface-hover">
                                        <i class="ph @(isExpanded ? "ph-caret-up" : "ph-caret-down") text-sm"></i>
                                    </div>
                                </div>

                                @* ── EXPANDED SCOREBOARD ── *@
                                @if (isExpanded)
                                {
                                    <div class="border-t border-line bg-surface-alt/30">

                                        @* Scoreboard table *@
                                        <div class="overflow-x-auto">
                                            <table class="w-full text-left text-sm whitespace-nowrap">
                                                <thead class="bg-surface-alt text-[10px] font-bold uppercase tracking-widest text-subtle border-b border-line">
                                                    <tr>
                                                        <th class="py-2.5 px-4">Player</th>
                                                        <th class="py-2.5 px-4 text-center"><Tooltip Text="Points Earned" WrapperClass="w-fit inline-block">Score</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-center"><Tooltip Text="Points Earned minus Points Spent" WrapperClass="w-fit inline-block">Net</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-center"><Tooltip Text="Points Spent on perks, doors, weapons, etc." WrapperClass="w-fit inline-block">Spent</Tooltip></th>
                                                        <th class="py-2.5 px-3 text-right text-foreground"><Tooltip Text="Kills" WrapperClass="w-fit inline-block">K</Tooltip></th>
                                                        <th class="py-2.5 px-3 text-right text-foreground"><Tooltip Text="Downs" WrapperClass="w-fit inline-block">D</Tooltip></th>
                                                        <th class="py-2.5 px-3 text-right text-foreground"><Tooltip Text="Revives" WrapperClass="w-fit inline-block">R</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-right"><Tooltip Text="Kills per Down" WrapperClass="w-fit inline-block">KPD</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-right"><Tooltip Text="Headshot Percentage" WrapperClass="w-fit inline-block">HS%</Tooltip></th>
                                                        <th class="py-2.5 px-4 text-right pr-6"><Tooltip Text="Damage Dealt / Received" WrapperClass="w-fit inline-block">Dmg Ratio</Tooltip></th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-line/50">
                                                    @foreach (var p in entry.Players)
                                                    {
                                                        var kpd = p.Downs == 0 ? p.Kills : (double)p.Kills / p.Downs;
                                                        var hsPercent = p.Kills == 0 ? 0 : (double)p.HeadshotKills / p.Kills * 100;
                                                        var netPoints = p.PointsEarned - p.PointsSpent;
                                                        var dmgRatio = p.DamageReceived == 0 ? 0 : (double)p.DamageDealt / p.DamageReceived;

                                                        <tr class="hover:bg-surface-hover transition-colors">
                                                            <td class="py-2 px-4">
                                                                <div class="flex items-center gap-2">
                                                                    @if (_showTimeline.Contains(entry.MatchId))
                                                                    {
                                                                        var isSelected = GetTimelinePlayer(entry.MatchId) == p.ClientId;
                                                                        <button @onclick="() => SetTimelinePlayer(entry.MatchId, p.ClientId)"
                                                                                @onclick:stopPropagation="true"
                                                                                class="w-4 h-4 rounded-full border-2 shrink-0 transition-colors
                                                                                       @(isSelected ? "border-primary bg-primary" : "border-subtle hover:border-muted")">
                                                                        </button>
                                                                    }
                                                                    <a href="/client/@p.ClientId/stats" @onclick:stopPropagation="true"
                                                                       class="font-bold text-foreground hover:text-primary transition-colors no-underline">
                                                                        <ColorCode Value="@p.Name"/>
                                                                    </a>
                                                                </div>
                                                            </td>
                                                            <td class="py-2 px-4 text-center font-mono text-muted text-xs">
                                                                @p.PointsEarned.ToString("N0")
                                                            </td>
                                                            <td class="py-2 px-4 text-center font-mono text-xs @(netPoints > 0 ? "text-success" : netPoints < 0 ? "text-error" : "text-muted")">
                                                                @(netPoints > 0 ? "+" : "")@FormatK((int)netPoints)
                                                            </td>
                                                            <td class="py-2 px-4 text-center font-mono text-xs text-error">
                                                                @FormatK((int)p.PointsSpent)
                                                            </td>
                                                            <td class="py-2 px-3 text-right font-mono text-foreground">@p.Kills.ToString("N0")</td>
                                                            <td class="py-2 px-3 text-right font-mono text-muted">@p.Downs</td>
                                                            <td class="py-2 px-3 text-right font-mono text-muted">@p.Revives</td>
                                                            <td class="py-2 px-4 text-right font-mono font-medium @(kpd >= 1000 ? "text-success" : kpd <= 50 ? "text-error" : "text-foreground")">
                                                                @(kpd > 999 ? FormatK((int)kpd) : kpd.ToString("F1"))
                                                            </td>
                                                            <td class="py-2 px-4 text-right font-mono text-foreground">
                                                                @hsPercent.ToString("F0")%
                                                            </td>
                                                            <td class="py-2 px-4 text-right pr-6 font-mono text-muted">
                                                                @(dmgRatio > 999 ? "∞" : dmgRatio.ToString("F1"))
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        @* Footer with server name and timeline toggle *@
                                        <div class="p-3 bg-surface-alt border-t border-line flex justify-between items-center text-xs">
                                            <div class="flex items-center gap-1.5 text-muted font-mono">
                                                @if (entry.ServerName is not null)
                                                {
                                                    <i class="ph ph-desktop-tower text-subtle"></i>
                                                    <ColorCode Value="@entry.ServerName"/>
                                                }
                                            </div>
                                            @if (_expandedMatches.TryGetValue(entry.MatchId, out var matchDetail) && matchDetail is not null)
                                            {
                                                <button @onclick="() => ToggleTimeline(entry.MatchId)" @onclick:stopPropagation="true"
                                                        class="px-4 py-1.5 rounded font-bold transition-colors
                                                               @(_showTimeline.Contains(entry.MatchId)
                                                                   ? "bg-surface text-foreground border border-line"
                                                                   : "bg-primary text-on-primary hover:bg-primary/80")">
                                                    @(_showTimeline.Contains(entry.MatchId) ? "Hide Timeline" : "View Timeline")
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="flex items-center gap-2 text-muted">
                                                    <i class="ph ph-spinner animate-spin"></i>
                                                    <span>Loading...</span>
                                                </div>
                                            }
                                        </div>

                                        @* Timeline (existing component) *@
                                        @if (_showTimeline.Contains(entry.MatchId) &&
                                             _expandedMatches.TryGetValue(entry.MatchId, out var detail) && detail is not null)
                                        {
                                            <ZombieMatchDetail Detail="detail" SelectedClientId="GetTimelinePlayer(entry.MatchId)"/>
                                        }
                                    </div>
                                }
                            </div>
                        </ItemContent>
                        <Placeholder>
                            <div class="bg-surface border border-line/50 rounded-lg overflow-hidden animate-pulse">
                                <div class="flex flex-col md:flex-row min-h-[60px]">
                                    <div class="md:w-40 bg-surface-alt/50 flex items-center justify-center border-r border-line/50">
                                        <div class="w-20 h-6 bg-surface/30 rounded"></div>
                                    </div>
                                    <div class="flex-1 p-4">
                                        <div class="h-6 w-full bg-surface-alt/50 rounded"></div>
                                    </div>
                                </div>
                            </div>
                        </Placeholder>
                    </Virtualize>

                    @if (_entriesLoaded && _totalEntries == 0)
                    {
                        <div class="bg-surface-alt/70 backdrop-blur-md rounded-2xl p-12 text-center border border-line flex flex-col items-center mt-4">
                            <div class="w-16 h-16 bg-surface rounded-full flex items-center justify-center mb-4 shadow-inner">
                                <i class="ph ph-timer text-4xl text-subtle"></i>
                            </div>
                            <h3 class="text-xl font-bold text-foreground">No Records Yet</h3>
                            <p class="text-muted mt-2 max-w-md mx-auto text-sm">
                                No completed matches found for this combination.
                            </p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ================================================================ *@
    @* SIDEBAR - Fixed position *@
    @* ================================================================ *@
    <div class="xl:w-80 xl:shrink-0 xl:py-6 xl:pr-0 pl-0">
        @if (MenuItems != null)
        {
            <div class="sticky top-6">
                <SideContextMenu Model="MenuItems"/>
            </div>
        }
    </div>
</div>

@code {

    private bool _marqueePaused;
    private readonly HashSet<int> _showTimeline = new();
    private readonly Dictionary<int, int> _timelinePlayerSelection = new();

    private static string FormatK(int num) =>
        num >= 1000 ? ((double)num).ToMetric(decimals: 1) : num.ToString();

    private void ToggleTimeline(int matchId)
    {
        if (!_showTimeline.Remove(matchId))
        {
            _showTimeline.Add(matchId);
        }
    }

    private int GetTimelinePlayer(int matchId)
    {
        if (_timelinePlayerSelection.TryGetValue(matchId, out var clientId))
        {
            return clientId;
        }

        // Default to first player
        if (_expandedMatches.TryGetValue(matchId, out var detail) && detail?.Players.Count > 0)
        {
            var first = detail.Players[0].ClientId;
            _timelinePlayerSelection[matchId] = first;
            return first;
        }

        return 0;
    }

    private void SetTimelinePlayer(int matchId, int clientId)
    {
        _timelinePlayerSelection[matchId] = clientId;
    }

}
