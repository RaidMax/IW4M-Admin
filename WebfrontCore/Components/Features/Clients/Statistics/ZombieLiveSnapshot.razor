@using SharedLibraryCore.Interfaces
@using Data.Models.Zombie

@*
    Live snapshot of an in-progress zombie match. Distinct from the post-match
    ZombieMatchDetail — emphasises "happening right now" rather than "review past
    performance". Refreshes via the parent ZombieLiveModalWrapper every 5s.

    Layout: compact horizontal banner across the top, then a 3-col grid for the
    body (Objectives / Roster / Telemetry). Each body column scrolls
    independently so a noisy Telemetry feed doesn't push the roster off-screen.

    Roster adaptation:
      - 1P → single rich hero card (kept richer than mockup's uniform card so
        solo runs surface KPD, HS%, Net Pts up-front rather than just K/D/HS)
      - 2+ → uniform player cards (mockup-style; 1 col, 2 col on 2xl)
*@

@* Wrapper inherits height from the modal body (which is now a flex-1 min-h-0
   container — see ActionModal + ServerCard.OpenZombieLive). h-full + min-h-0
   lets the 3-col grid below fill the available vertical space without
   stacking against a separate max-h cap that previously produced a double
   scrollbar (modal body scroll AND inner column scroll). *@
<div class="flex flex-col h-full min-h-0 overflow-hidden">

    @* ── HEADER BANNER ── round + pace + elapsed + map; compact across the
         top of the modal so the 3-col body has maximum vertical space. *@
    <header class="relative shrink-0 bg-surface-alt/40 border-b border-line p-3 md:p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 overflow-hidden">
        @* Live accents (vertical bar, gradient wash, round-number tint) use the
           error token (red) — semantically: "this match is HAPPENING now, watch
           it". Per-round metrics like CurrentRoundKills below keep text-warning
           (amber) because they're a numerical reading, not a live indicator. *@
        <div class="absolute top-0 left-0 w-1 h-full bg-error"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-error/5 to-transparent pointer-events-none"></div>

        <div class="relative z-10 flex flex-wrap items-center gap-6 md:gap-8">
            @{ var liveSpecial = PaceVisuals.SpecialBadge(Snapshot.CurrentRoundSpecialType, AppState); }

            @* Round block: big mono number + pace chip + zombies-left + sph. *@
            <div class="flex flex-col">
                <div class="flex items-center gap-2 mb-0.5">
                    <span class="text-[10px] uppercase tracking-widest text-subtle font-bold">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_CURRENT_ROUND")</span>
                    @if (liveSpecial is { } titleSb)
                    {
                        <Tooltip Text="@titleSb.Tooltip" WrapperClass="inline-flex">
                            <span class="@($"inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider {titleSb.ColorClass}")"
                                  aria-label="@titleSb.Label">
                                <i class="@($"ph {titleSb.Icon}")" style="font-size: 11px;"></i>@titleSb.Label
                            </span>
                        </Tooltip>
                    }
                </div>
                <div class="flex items-center gap-3">
                    <span class="text-4xl md:text-5xl font-mono font-bold text-error leading-none">@Snapshot.CurrentRound</span>
                    <div class="flex flex-col items-start leading-tight">
                        @if (_roundElapsedSeconds is { } rs)
                        {
                            // Pace tint suppressed on special rounds — EMA isn't comparable
                            // across round types, and the title-row badge already signals
                            // the round type.
                            var liveBand = liveSpecial is null
                                ? PaceVisuals.ClassifyLive(rs, Snapshot.CurrentRoundEmaSeconds)
                                : null;
                            var liveTint = PaceVisuals.ColorClass(liveBand?.Band);
                            var liveTooltip = LiveBannerTooltip(rs, liveBand);
                            <Tooltip Text="@liveTooltip" WrapperClass="inline-flex">
                                <span class="text-xs font-mono font-bold tabular-nums @liveTint">+@FormatElapsed(rs)</span>
                            </Tooltip>
                            if (liveSpecial is null)
                            {
                                if (Snapshot.CurrentRoundEmaSeconds is { } emaSeconds && emaSeconds > 0)
                                {
                                    <span class="text-[10px] font-mono text-subtle/70 tabular-nums">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_PACE_AVG_PREFIX") @FormatElapsed(emaSeconds)</span>
                                }
                                if (Snapshot.CurrentRoundBudget is { } budget && budget > 24
                                    && Snapshot.CurrentRoundZombiesRemaining is { } remaining
                                    && Snapshot.CurrentRoundZombiesAlive is { } alive)
                                {
                                    var cleared = budget - remaining - alive;
                                    if (cleared > 0)
                                    {
                                        var liveSph = rs / (cleared / 24.0);
                                        <span class="text-[10px] font-mono text-subtle/70 tabular-nums">@liveSph.ToString("F1") sph</span>
                                    }
                                }
                            }
                        }
                        @* Zombies-left counter; clamped at 0 because dynamically-spawned
                           enemies can push remaining+alive above the static initial
                           total briefly. *@
                        @if (Snapshot.CurrentRoundZombiesRemaining is { } zr
                             && Snapshot.CurrentRoundZombiesAlive is { } za)
                        {
                            var zombiesLeft = Math.Max(0, zr + za);
                            <span class="text-[10px] font-mono text-subtle/60 tabular-nums">
                                @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_ZOMBIES_REMAINING").FormatExt(zombiesLeft)
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="w-px h-12 bg-line/50 hidden sm:block"></div>

            @* Elapsed match clock + live pulse dot, with power-state caption
               below — power belongs visually with the match-elapsed grouping
               (both are match-wide state) rather than crammed into the right
               map block. *@
            <div class="flex flex-col">
                <span class="text-[10px] uppercase tracking-widest text-subtle font-bold mb-1">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_MATCH_ELAPSED")</span>
                <div class="flex items-center gap-3">
                    <span class="text-2xl font-mono font-medium text-foreground leading-none tabular-nums">@FormatElapsed(_elapsedSeconds)</span>
                    <span class="relative flex h-2 w-2" title="@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_LIVE_TOOLTIP")">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-error opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-error"></span>
                    </span>
                </div>
                @if (Snapshot.PowerStateChanges.Count > 0)
                {
                    var currentlyOn = Snapshot.PowerStateChanges[^1].IsOn;
                    var dotColor = currentlyOn ? "bg-success" : "bg-error";
                    var stateText = currentlyOn
                        ? AppState.Loc("WEBFRONT_ZOMBIE_MATCH_POWER_ON")
                        : AppState.Loc("WEBFRONT_ZOMBIE_MATCH_POWER_OFF");
                    <div class="flex items-center gap-1.5 text-muted text-[10px] mt-1.5">
                        <span class="relative flex h-2 w-2 shrink-0">
                            <span class="relative inline-flex rounded-full h-2 w-2 @dotColor"></span>
                        </span>
                        <span>@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_POWER_LABEL") · @stateText</span>
                    </div>
                }
            </div>
        </div>

        @* Map + achievement badges. Power-state lives under Match Elapsed
           (above) — kept this block focused on map identity only.
           flex-1 + min-w-0 + justify-end claims remaining header width and
           allows the inner badge strip to shrink → its internal flex-wrap
           kicks in when too many quests are active (Castle hits 10+).
           Badges + map stay on the SAME row vertically; badges wrap onto
           additional rows above the map chip when crowded. Map chip is
           shrink-0 so its label never truncates. *@
        @if (!string.IsNullOrEmpty(Snapshot.Map))
        {
            <div class="relative z-10 flex flex-1 items-center justify-end gap-3 min-w-0">
                <ZombieAchievementBadges
                    EasterEggQuests="Snapshot.EasterEggQuests"
                    HighestRound="Snapshot.CurrentRound"
                    AlignEnd="true" />
                <div class="flex items-center gap-1.5 bg-surface border border-line px-2.5 py-1 rounded-sm shrink-0">
                    <i class="ph ph-map-trifold text-subtle text-sm"></i>
                    <span class="text-xs font-bold text-foreground uppercase tracking-wider truncate">@Snapshot.Map</span>
                </div>
            </div>
        }
    </header>

    @* ── 3-COLUMN BODY ── stacks to a single column on <lg so mobile reads
         top-down: Objectives → Roster → Telemetry. Each column owns its own
         scroll region so a noisy column doesn't push the others off-screen. *@
    <div class="flex-1 overflow-hidden grid grid-cols-1 lg:grid-cols-12 lg:divide-x divide-line min-h-0">

        @* ── COL 1: OBJECTIVES (3/12) — EE quests + Songs subsection;
             Match Pace pinned at the bottom (shows at every player count
             since round durations are match-wide, not per-player). *@
        <div class="lg:col-span-3 flex flex-col h-full min-h-0 overflow-hidden bg-surface-alt/20">
            <div class="shrink-0 p-2 border-b border-line bg-surface-alt/30 flex items-center gap-2">
                <i class="ph ph-target text-subtle text-sm"></i>
                <h3 class="text-[10px] font-bold uppercase tracking-widest text-muted">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_OBJECTIVES_LOG")</h3>
            </div>
            <div class="flex-1 overflow-y-auto p-2 space-y-2 min-h-0" style="scrollbar-width: thin;">
                @{
                    // Filter keeps incomplete quests AND branching placeholders
                    // (BranchGroupId set, Total==0 until a path is committed).
                    // Without the BranchGroupId clause, Tower of Babble / High
                    // Maintenance / Mined Games would silently disappear from
                    // the live log on every match — they only have Total>0
                    // after Maxis or Richtofen path commits.
                    var liveQuests = Snapshot.EasterEggQuests
                        .Where(q => !q.IsComplete && (q.Total > 0 || q.BranchGroupId is not null))
                        .ToList();
                    // Songs split into their own subsection below the main quest
                    // list. Quest id convention: "song" / "song_*" prefixes mark
                    // music EEs. Done at split time so each subsection renders
                    // with its own visual weight.
                    var mainQuests = liveQuests.Where(q => !q.Id.StartsWith("song", StringComparison.Ordinal)).ToList();
                    var songQuests = liveQuests.Where(q => q.Id.StartsWith("song", StringComparison.Ordinal)).ToList();
                    // Empty-state message discrimination — three cases (collapsed
                    // from five permutations; pending sections render their own
                    // content, so the empty block only ever shows when both
                    // lists are zero):
                    //   • No quests configured for this map at all          → NONE_CONFIGURED
                    //   • Main quest(s) existed and all are complete (songs → ALL_COMPLETE
                    //     done too, or no songs configured at all)
                    //   • Only songs configured and all are complete        → SONGS_COMPLETE
                    var hasMainConfigured = Snapshot.EasterEggQuests
                        .Any(q => !q.Id.StartsWith("song", StringComparison.Ordinal));
                    var emptyKey = Snapshot.EasterEggQuests.Count == 0
                        ? "WEBFRONT_ZOMBIE_LIVE_OBJECTIVES_NONE_CONFIGURED"
                        : hasMainConfigured
                            ? "WEBFRONT_ZOMBIE_LIVE_OBJECTIVES_ALL_COMPLETE"
                            : "WEBFRONT_ZOMBIE_LIVE_OBJECTIVES_SONGS_COMPLETE";
                }

                @if (mainQuests.Count == 0 && songQuests.Count == 0)
                {
                    <div class="p-3 text-center text-subtle text-xs">
                        @AppState.Loc(emptyKey)
                    </div>
                }

                @foreach (var quest in mainQuests)
                {
                    @RenderObjectiveCard(quest, isSong: false)
                }

                @if (songQuests.Count > 0)
                {
                    <div class="pt-2 mt-2 border-t border-line/50 space-y-1">
                        <div class="text-[9px] uppercase tracking-widest text-subtle font-bold px-1.5 pb-1 flex items-center gap-1.5">
                            <i class="ph ph-music-notes text-xs"></i>
                            @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_SONGS_LABEL")
                        </div>
                        @foreach (var song in songQuests)
                        {
                            @RenderSongRow(song)
                        }
                    </div>
                }
            </div>

            @* Match Pace — pinned to the bottom of the objectives column at a
               fixed height so it survives at every player count (was previously
               in the roster column and only shown for 1p/2p). Uses Players[0]
               as the data source — round durations are match-wide, the per-
               player pick is cosmetic. Skipped on empty roster. The sparkline
               renders its own section header so this wrapper stays structural
               only — no padding, no card-in-card duplication. *@
            @if (Snapshot.Players.Count > 0)
            {
                <div class="shrink-0 border-t border-line h-48 flex flex-col">
                    @RenderMatchPaceSparkline(Snapshot.Players[0])
                </div>
            }
        </div>

        @* ── COL 2: ROSTER (6/12) — unified card style:
               1p → 1 card (relaxed) + "Solo" badge
               2p → 2 cards (relaxed)
               3p+ → N cards (compact, mock-aligned 12-col split)
             Match Pace moved to the Objectives column so it's visible at
             every player count without competing for roster real-estate. *@
        <div class="lg:col-span-6 flex flex-col h-full min-h-0 overflow-hidden bg-surface/40 relative">
            @{
                var playerCount = Snapshot.Players.Count;
                var compact = playerCount >= 3;
                var showSoloBadge = playerCount == 1;
                // Roster always renders sorted by match kills desc. Stable on
                // Name so two players tied on kills keep a deterministic order
                // across the 5s snapshot refresh — prevents row jitter when
                // kills tick up simultaneously. No sort UI: defaulting to
                // kills aligns with the "who's carrying" question the live
                // modal answers.
                var orderedPlayers = Snapshot.Players
                    .OrderByDescending(pl => pl.MatchKills)
                    .ThenBy(pl => pl.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList();
                @* Accent glow only when a single-card "presence" makes sense
                   (1p / 2p); on 3p+ the dense card stack reads as a roster,
                   not a hero focus. *@
                var showAccentGlow = playerCount is 1 or 2;
            }

            @if (showAccentGlow)
            {
                <div class="absolute top-0 inset-x-0 h-40 bg-gradient-to-b from-primary/5 to-transparent pointer-events-none"></div>
            }

            @if (playerCount == 0)
            {
                <div class="shrink-0 p-2 border-b border-line bg-surface-alt/30 flex items-center gap-2">
                    <i class="ph ph-users text-subtle text-sm"></i>
                    <h3 class="text-[10px] font-bold uppercase tracking-widest text-muted">
                        @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_ROSTER_LABEL") (0)
                    </h3>
                </div>
                <div class="flex-1 p-3 text-center text-subtle text-xs">
                    @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_ROSTER_EMPTY")
                </div>
            }
            else
            {
                @* Generic Roster header for 3p+ (keeps the player-count read
                   at the top of the column). 1p/2p own their column header
                   via the player cards themselves. *@
                @if (compact)
                {
                    <div class="shrink-0 p-2 border-b border-line bg-surface-alt/30 flex items-center gap-2 relative z-10">
                        <i class="ph ph-users text-subtle text-sm"></i>
                        <h3 class="text-[10px] font-bold uppercase tracking-widest text-muted">
                            @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_ROSTER_LABEL") (@playerCount)
                        </h3>
                    </div>
                }

                <div class="flex-1 overflow-y-auto @(compact ? "p-3" : "p-4") flex flex-col gap-3 relative z-10" style="scrollbar-width: thin;">
                    @foreach (var p in orderedPlayers)
                    {
                        @* 3+ players use the mock-aligned compact card
                           (12-col horizontal split: hero pair LEFT, micro
                           stats RIGHT). 1p/2p keep the relaxed solo card. *@
                        if (compact)
                        {
                            @RenderCompactPlayerCard(p)
                        }
                        else
                        {
                            @RenderSoloPlayerCard(p, compact: false, showSoloBadge)
                        }
                    }
                </div>
            }
        </div>

        @* ── COL 3: TELEMETRY (3/12) — vertical activity timeline. *@
        <div class="lg:col-span-3 flex flex-col h-full min-h-0 overflow-hidden bg-surface-alt/20">
            <div class="shrink-0 p-2 border-b border-line bg-surface-alt/30 flex items-center gap-2">
                <i class="ph ph-activity text-subtle text-sm"></i>
                <h3 class="text-[10px] font-bold uppercase tracking-widest text-muted">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_TELEMETRY_LABEL")</h3>
            </div>
            <div class="flex-1 overflow-y-auto p-3" style="scrollbar-width: thin;">
                @if (Snapshot.RecentEvents.Count == 0)
                {
                    <div class="p-3 text-center text-subtle text-xs">
                        @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_TELEMETRY_EMPTY")
                    </div>
                }
                else
                {
                    var orderedEvents = Snapshot.RecentEvents.AsEnumerable().Reverse().ToList();
                    @* Timeline layout (mockup-aligned):
                       - Vertical thread line on the left (ml-2.5 + border-l on the
                         outer wrapper) — single continuous line; rows ride on it.
                       - Per-row: squircle icon (w-5 h-5 rounded-sm) absolutely
                         positioned ON the line at -left-[10px] with a bg-surface
                         backdrop so the line is masked by the icon. Then the
                         content (time + message) flows to the right with ml-5.
                       - Row layout: ICON · TIME · MESSAGE (time first, message
                         second on the same baseline). Round rows reserve the
                         second line for the pace caption when present. *@
                    <div class="relative border-l border-line/80 ml-2.5 space-y-3.5 pb-2">
                        @for (var i = 0; i < orderedEvents.Count; i++)
                        {
                            var evt = orderedEvents[i];
                            var visuals = GetEventVisuals(evt.Category);
                            var isRound = evt.Category == "round";

                            <div class="relative flex items-start gap-3 group">
                                @* Squircle icon on the thread. bg-surface backdrop
                                   on the wrapper masks the underlying border line
                                   where the icon sits. Round rows render an empty
                                   squircle with a tiny dot inside (matches mockup's
                                   "milestone marker" look — distinct from event
                                   icons but same shape). *@
                                <div class="absolute -left-[10px] top-0 bg-surface-alt/20 py-0.5">
                                    @if (isRound)
                                    {
                                        <div class="w-5 h-5 rounded-sm border border-line bg-surface flex items-center justify-center shrink-0">
                                            <div class="w-1.5 h-1.5 rounded-sm bg-foreground"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-5 h-5 rounded-sm border border-line/50 @visuals.Bg/15 flex items-center justify-center shrink-0">
                                            <i class="ph @visuals.Icon @visuals.Text" style="font-size: 10px;"></i>
                                        </div>
                                    }
                                </div>

                                @* Content flows right of the icon (ml-5 to clear
                                   the icon's right edge + a small gap). *@
                                <div class="ml-5 flex flex-col gap-0.5 min-w-0 mt-0.5">
                                    <div class="flex items-baseline gap-2 flex-wrap">
                                        <span class="font-mono text-[10px] text-subtle shrink-0 tabular-nums">@evt.Time</span>
                                        <span class="text-xs font-semibold @(isRound ? "text-foreground" : visuals.Text) break-words">
                                            @evt.Label
                                        </span>
                                    </div>
                                    @if (isRound && evt.PaceBand is not null && evt.PaceRatio is { } ratio
                                         && evt.PaceTypicalSeconds is { } typicalSec)
                                    {
                                        var paceTint = PaceVisuals.ColorClass(evt.PaceBand);
                                        var pacePrefix = ratio > 0.05 ? "+" : (ratio < -0.05 ? "−" : "");
                                        var paceTooltip = LiveTimelinePaceTooltip(evt);
                                        var actualSec = typicalSec * (1 + ratio);
                                        <Tooltip Text="@paceTooltip" WrapperClass="inline-flex items-baseline gap-1.5">
                                            <span class="text-[10px] font-mono text-muted tabular-nums">@PaceVisuals.FormatRoundTime(actualSec)</span>
                                            <span class="text-[10px] font-mono @paceTint">@pacePrefix@(Math.Abs(ratio * 100).ToString("F0"))%</span>
                                            <span class="text-[10px] font-mono text-subtle/60">(@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_PACE_AVG_PREFIX") @PaceVisuals.FormatRoundTime(typicalSec))</span>
                                        </Tooltip>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@code {

    private double _elapsedSeconds;
    private double? _roundElapsedSeconds;

    protected override void OnParametersSet()
    {
        var now = DateTimeOffset.UtcNow;
        _elapsedSeconds = Math.Max(0, (now - Snapshot.MatchStartedAt).TotalSeconds);
        _roundElapsedSeconds = Snapshot.CurrentRoundStartedAt is { } rs
            ? Math.Max(0, (now - rs).TotalSeconds)
            : null;
    }

    @* ─────────── OBJECTIVES COL: per-quest card ───────────
       Bordered card with title row (icon + name + mini bar + X/Y) and step
       grid below. Steps render as chip-style bordered rects (icon + optional
       X/Y for nested parents) — the narrow Objectives column suits chips
       better than circles when 5+ steps per quest are common (Castle bows). *@
    private RenderFragment RenderObjectiveCard(EasterEggQuestProgress quest, bool isSong) => __builder =>
    {
        var firedKeys = quest.Steps.ToDictionary(s => s.Key, StringComparer.OrdinalIgnoreCase);
        var pct = quest.Total > 0 ? Math.Min(100, quest.Completed * 100 / quest.Total) : 0;
        // Palette mirrors the Match Page's per-quest Color (set on Castle bows,
        // Origins staffs, Wrath, etc.); fallback = song=purple / main=amber so
        // quests without an explicit colour render identically to before.
        var palette = ResolveLivePalette(quest.Color, isSong);
        // Branching placeholder = group has no path committed yet (Total==0 but
        // BranchGroupId set, e.g. TranZit Tower of Babble pre-commit). Suppress
        // the progress bar + step grid + count chip in that state; show a
        // pending-path caption instead so the card reads as "we know this exists,
        // nobody has committed Maxis or Richtofen yet".
        var isBranchingPlaceholder = quest.Total == 0 && quest.BranchGroupId is not null;

        <div class="bg-surface-alt/40 border border-line rounded-sm p-2 flex flex-col gap-2">
            <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5 min-w-0 @palette.TitleText">
                    <i class="ph @quest.Icon text-sm shrink-0"></i>
                    <span class="text-[11px] font-bold uppercase tracking-wide truncate">@AppState.Loc(quest.LocKey)</span>
                </div>
                @if (!isBranchingPlaceholder)
                {
                    <div class="flex items-center gap-1.5 shrink-0">
                        <div class="w-16 h-1 bg-surface-alt rounded-sm overflow-hidden border border-line/40">
                            <div class="h-full @palette.BarBg transition-all duration-500" style="width: @(pct)%;"></div>
                        </div>
                        <span class="text-[10px] font-mono font-bold tabular-nums @palette.CountText">@quest.Completed / @quest.Total</span>
                    </div>
                }
            </div>

            @if (isBranchingPlaceholder)
            {
                <div class="text-[10px] text-subtle italic px-0.5">
                    @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_BRANCH_NO_PATH")
                </div>
            }
            else
            {

            <div class="flex items-center gap-1 flex-wrap">
                @foreach (var step in quest.Inventory)
                {
                    @if (!step.IsLeaf())
                    {
                        // Parent step: aggregate fired/total over leaves; tooltip lists
                        // each child as a structured row (via BodyContent fragment, so
                        // the JS tooltip renders the markup verbatim instead of
                        // collapsing newlines into one runon line).
                        var leaves = step.Leaves().ToList();
                        var subFired = leaves.Count(l => firedKeys.ContainsKey(l.Key));
                        var subTotal = leaves.Count;
                        var parentDone = subFired == subTotal && subTotal > 0;
                        var partial = subFired > 0 && !parentDone;
                        var stateClass = parentDone
                            ? palette.ChipDone
                            : partial
                                ? palette.ChipPartial
                                : palette.ChipDefault;
                        <Tooltip BodyContent="@(RenderParentStepBody(step, leaves, firedKeys, subFired, subTotal))"
                                 WrapperClass="inline-flex">
                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-sm border @stateClass">
                                <i class="ph @step.Icon text-xs"></i>
                                <span class="text-[9px] font-mono tabular-nums">@subFired/@subTotal</span>
                            </span>
                        </Tooltip>
                        continue;
                    }

                    var fired = firedKeys.TryGetValue(step.Key, out var rec);
                    var label = AppState.Loc(step.LocKey);
                    var tooltip = fired && rec is not null
                        ? (rec.RoundNumber is { } rn && rn > 0
                            ? $"{label} • R{rn}"
                            : label)
                        : $"{label} — pending";
                    var leafState = fired ? palette.ChipDone : palette.ChipDefault;
                    <Tooltip Text="@tooltip" WrapperClass="inline-flex">
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded-sm border @leafState">
                            <i class="ph @step.Icon text-xs"></i>
                        </span>
                    </Tooltip>
                }
            </div>
            }
        </div>
    };

    @* Nested-parent step tooltip body — header row (parent label + X/Y) plus a
       per-leaf list with a check / dash icon per state. Bypasses the JS
       tooltip's plain-text path so the structure renders as proper rows
       instead of collapsing to one runon line. *@
    private RenderFragment RenderParentStepBody(
        EasterEggStepInventoryEntry parent,
        List<EasterEggStepInventoryEntry> leaves,
        Dictionary<string, EasterEggStepRecord> firedKeys,
        int subFired,
        int subTotal) => __builder =>
    {
        var parentLabel = AppState.Loc(parent.LocKey);
        <div class="flex flex-col gap-1.5 min-w-[180px]">
            <div class="flex items-center justify-between gap-3 pb-1 border-b border-line/60">
                <span class="text-[11px] font-bold text-foreground">@parentLabel</span>
                <span class="text-[10px] font-mono tabular-nums text-muted">@subFired / @subTotal</span>
            </div>
            <ul class="flex flex-col gap-0.5">
                @foreach (var leaf in leaves)
                {
                    var leafLabel = AppState.Loc(leaf.LocKey);
                    var fired = firedKeys.TryGetValue(leaf.Key, out var rec);
                    <li class="flex items-center gap-1.5 text-[10px]">
                        @if (fired)
                        {
                            <i class="ph ph-check-circle text-success text-xs shrink-0"></i>
                            <span class="text-foreground truncate flex-1">@leafLabel</span>
                            @if (rec?.RoundNumber is { } rn && rn > 0)
                            {
                                <span class="text-muted font-mono tabular-nums shrink-0">R@(rn)</span>
                            }
                        }
                        else
                        {
                            <i class="ph ph-circle-dashed text-subtle text-xs shrink-0"></i>
                            <span class="text-subtle truncate flex-1">@leafLabel</span>
                            <span class="text-subtle text-[9px] uppercase tracking-wider shrink-0">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_STEP_PENDING")</span>
                        }
                    </li>
                }
            </ul>
        </div>
    };

    @* ─────────── OBJECTIVES COL: compact song row ───────────
       Songs are usually short (1-3 step pickups) and don't need the per-step
       chip grid. Compact one-liner: icon + name + per-step pip strip. Hover
       on a pip surfaces the same tooltip the quest card would. *@
    private RenderFragment RenderSongRow(EasterEggQuestProgress song) => __builder =>
    {
        var firedKeys = song.Steps.ToDictionary(s => s.Key, StringComparer.OrdinalIgnoreCase);

        <div class="flex items-center justify-between gap-2 px-1.5 py-1 rounded-sm hover:bg-surface-hover/30 transition-colors">
            <div class="flex items-center gap-1.5 min-w-0 text-purple-300">
                <i class="ph @song.Icon text-sm shrink-0"></i>
                <span class="text-[10px] font-semibold tracking-wide uppercase truncate">@AppState.Loc(song.LocKey)</span>
            </div>
            <div class="flex gap-0.5 shrink-0">
                @foreach (var step in song.Inventory)
                {
                    if (!step.IsLeaf())
                    {
                        // Songs rarely nest; defensively render parents as a single pip
                        // tinted by aggregate completion rather than expanding leaves.
                        var leaves = step.Leaves().ToList();
                        var subFired = leaves.Count(l => firedKeys.ContainsKey(l.Key));
                        var parentDone = subFired == leaves.Count && leaves.Count > 0;
                        var pipClass = parentDone ? "bg-purple-400" : (subFired > 0 ? "bg-purple-400/40" : "bg-surface-alt");
                        var label = AppState.Loc(step.LocKey);
                        <Tooltip Text="@($"{label} ({subFired}/{leaves.Count})")" WrapperClass="inline-flex">
                            <span class="block w-3 h-1.5 rounded-sm @pipClass"></span>
                        </Tooltip>
                        continue;
                    }

                    var fired = firedKeys.TryGetValue(step.Key, out var rec);
                    var label2 = AppState.Loc(step.LocKey);
                    var tooltip = fired && rec is not null
                        ? (rec.RoundNumber is { } rn && rn > 0 ? $"{label2} • R{rn}" : label2)
                        : $"{label2} — pending";
                    var pip = fired ? "bg-purple-400" : "bg-surface-alt";
                    <Tooltip Text="@tooltip" WrapperClass="inline-flex">
                        <span class="block w-3 h-1.5 rounded-sm @pip"></span>
                    </Tooltip>
                }
            </div>
        </div>
    };

    @* ─────────── ROSTER COL: Solo-styled player card (1p/2p only) ───────────
       Header (name + optional Solo badge + status) → hero cards row (Net
       Pts + Total Kills) → telemetry strip (HS%/KPD/DMG/Downs/Deaths).
       Used for relaxed (1p/2p) presentation only — 3+ uses
       RenderCompactPlayerCard with a horizontal 12-col split. The
       `compact` parameter is retained for future tweaks but the caller
       always passes false from the 1p/2p branch. *@
    private RenderFragment RenderSoloPlayerCard(ZombieLivePlayerSnapshot p, bool compact, bool showSoloBadge) => __builder =>
    {
        var dmgInf = p.MatchDamageReceived == 0;
        var dmgRatio = dmgInf ? 0 : (double)p.MatchDamageDealt / p.MatchDamageReceived;
        var hsPct = p.MatchKills == 0 ? 0 : (double)p.MatchHeadshotKills / p.MatchKills * 100;
        var kpd = p.MatchDowns == 0 ? p.MatchKills : (double)p.MatchKills / p.MatchDowns;
        var net = p.MatchPointsEarned - p.MatchPointsSpent;
        var netColor = net >= 0 ? "text-success" : "text-error";

        @* Density tokens — literal class strings so Tailwind purge keeps
           every variant. Two pre-baked sets rather than ternaries inline
           so the diff between modes is one line, not scattered. *@
        var headerPad = compact ? "p-2" : "p-3";
        var bodyPad = compact ? "p-3 gap-3" : "p-4 gap-4";
        var heroPad = compact ? "p-3" : "p-5";
        var heroNum = compact
            ? "text-2xl md:text-3xl"
            : "text-4xl md:text-5xl";
        var stripPad = compact ? "p-2" : "p-3";
        var stripNum = compact ? "text-base" : "text-lg";
        var nameClass = compact
            ? "text-xs font-bold text-foreground truncate hover:text-primary transition-colors no-underline"
            : "text-sm font-bold text-foreground truncate hover:text-primary transition-colors no-underline";

        @* Outer shell — full-width card per player. Border tint on downed
           players (orange) so the panic state is visible across the
           stack at a glance without reading the status pill. *@
        var downed = p.Status == ZombieLivePlayerStatus.Down;
        var shellBorder = downed ? "border-orange-400/40" : "border-line";

        <div class="bg-surface-alt/30 border @shellBorder rounded-lg overflow-hidden shrink-0 @(p.IsConnected ? "" : "opacity-60 grayscale-[0.5]")">
            @* Header — name + Solo/joined badges + status pill. *@
            <div class="@headerPad border-b border-line bg-surface/60 backdrop-blur-sm flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                    <a href="/client/@p.ClientId/stats" @onclick:stopPropagation="true"
                       class="@nameClass">
                        <ColorCode Value="@p.Name" />
                    </a>
                    @if (showSoloBadge)
                    {
                        <span class="px-1.5 py-0.5 rounded text-[8px] font-bold uppercase tracking-widest bg-primary/10 text-primary border border-primary/20 shrink-0">
                            @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_SOLO_BADGE")
                        </span>
                    }
                    @RenderJoinedBadge(p)
                </div>
                @RenderStatusPill(p)
            </div>

            <div class="flex flex-col @bodyPad">
                @* HERO ROW — Net Points + Total Kills. Side-by-side at sm+,
                   stacked on mobile. Phosphor watermark only on relaxed
                   density (it's pure decoration; compact drops it for
                   information density). *@
                <div class="flex flex-col sm:flex-row gap-3 shrink-0">
                    <div class="flex-1 bg-surface-alt/30 border border-line rounded-md @heroPad relative overflow-hidden group hover:bg-surface-alt/50 transition-colors">
                        @if (!compact)
                        {
                            <div class="absolute -right-4 -top-4 p-4 opacity-5 group-hover:opacity-10 transition-opacity transform group-hover:scale-110 duration-500">
                                <i class="ph ph-lightning" style="font-size: 120px;"></i>
                            </div>
                        }
                        <span class="text-[10px] uppercase tracking-widest text-subtle font-bold flex items-center gap-1.5 mb-1.5">
                            <i class="ph ph-lightning @netColor"></i> @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_NET_PTS")
                        </span>
                        <div class="flex items-baseline gap-2">
                            <span class="@heroNum font-mono font-bold @netColor drop-shadow-sm tracking-tight leading-none">@FormatSigned(net)</span>
                        </div>
                    </div>

                    <div class="flex-1 bg-surface-alt/30 border border-line rounded-md @heroPad relative overflow-hidden group hover:bg-surface-alt/50 transition-colors">
                        @if (!compact)
                        {
                            <div class="absolute -right-4 -top-4 p-4 opacity-5 group-hover:opacity-10 transition-opacity transform group-hover:scale-110 duration-500">
                                <i class="ph ph-sword" style="font-size: 120px;"></i>
                            </div>
                        }
                        <span class="text-[10px] uppercase tracking-widest text-subtle font-bold flex items-center gap-1.5 mb-1.5">
                            <i class="ph ph-sword text-foreground"></i> @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_KILLS")
                        </span>
                        <div class="flex items-baseline gap-3 flex-wrap">
                            <span class="@heroNum font-mono font-bold text-foreground drop-shadow-sm tracking-tight leading-none">@p.MatchKills.ToString("N0")</span>
                            <span class="text-[10px] font-mono text-warning font-semibold bg-warning/10 px-1.5 py-0.5 rounded border border-warning/20 tabular-nums">
                                @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_THIS_ROUND_SUFFIX").FormatExt(p.CurrentRoundKills)
                            </span>
                        </div>
                    </div>
                </div>

                @* TELEMETRY STRIP — secondary stats in equal-width cells.
                   DMG cell hides on the smallest viewport to keep the
                   first 4 cells legible when the modal narrows. *@
                <div class="bg-surface-alt/40 border border-line rounded-md flex flex-wrap shrink-0 mt-3">
                    @RenderSoloStripCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_HS_PCT"), $"{hsPct:F0}%", "text-foreground", "ph-target", false, true, stripPad, stripNum)
                    @RenderSoloStripCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_KPD"), kpd >= 1000 ? FormatCompactNumber((long)kpd) : kpd.ToString("F1"), "text-foreground", "ph-crosshair", false, true, stripPad, stripNum)
                    @RenderSoloStripDmgCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_DMG"), dmgInf, dmgRatio, stripPad, stripNum)
                    @RenderSoloStripCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_DOWNS"), p.MatchDowns.ToString("N0"), "text-orange-400", null, false, true, stripPad, stripNum)
                    @RenderSoloStripCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_DEATHS"), p.MatchDeaths.ToString("N0"), "text-error", null, false, false, stripPad, stripNum)
                </div>
            </div>
        </div>
    };

    @* ─────────── ROSTER COL: compact card (3+ players) ───────────
       Mock-aligned 12-col horizontal split — hero pair (Net Pts + Kills)
       on the LEFT 6 cols, micro stats (HS · KPD · DMG · Downs · Deaths)
       on the RIGHT 6 cols. Stacks vertically on small viewports so the
       card stays readable when the modal narrows. Header strip carries
       name + joined-late badge + status pill; downed players get an
       orange border tint matching the solo card's panic accent so the
       state reads across the stack at a glance. *@
    private RenderFragment RenderCompactPlayerCard(ZombieLivePlayerSnapshot p) => __builder =>
    {
        var dmgInf = p.MatchDamageReceived == 0;
        var dmgRatio = dmgInf ? 0 : (double)p.MatchDamageDealt / p.MatchDamageReceived;
        var hsPct = p.MatchKills == 0 ? 0 : (double)p.MatchHeadshotKills / p.MatchKills * 100;
        var kpd = p.MatchDowns == 0 ? p.MatchKills : (double)p.MatchKills / p.MatchDowns;
        var net = p.MatchPointsEarned - p.MatchPointsSpent;
        var netColor = net >= 0 ? "text-success" : "text-error";

        var downed = p.Status == ZombieLivePlayerStatus.Down;
        var shellBorder = downed ? "border-orange-400/40" : "border-line";
        var disconnectedClass = p.IsConnected ? "" : "opacity-60 grayscale-[0.5]";

        <div class="bg-surface-alt/30 border @shellBorder rounded-md overflow-hidden shrink-0 @disconnectedClass">
            @* Header strip — name + joined-late badge LEFT, status pill RIGHT. *@
            <div class="bg-surface/60 p-2 flex items-center justify-between gap-2 border-b border-line/40">
                <div class="flex items-center gap-2 min-w-0">
                    <a href="/client/@p.ClientId/stats" @onclick:stopPropagation="true"
                       class="text-xs font-bold text-foreground truncate hover:text-primary transition-colors no-underline">
                        <ColorCode Value="@p.Name" />
                    </a>
                    @RenderJoinedBadge(p)
                </div>
                @RenderStatusPill(p)
            </div>

            @* Body — 12-col split. Hero pair LEFT, micro stats RIGHT. Stacks
               on <sm so the card stays legible when the modal narrows. *@
            <div class="p-2.5 grid grid-cols-12 gap-3 items-center">
                @* LEFT 6: Net Pts + Kills sub-widgets *@
                <div class="col-span-12 sm:col-span-6 flex gap-2">
                    <div class="flex-1 bg-surface-alt/30 border border-line/50 p-1.5 rounded flex flex-col justify-center min-w-0">
                        <span class="text-[8px] uppercase tracking-wider text-subtle font-semibold inline-flex items-center gap-0.5">
                            <i class="ph ph-lightning @netColor" style="font-size: 10px;"></i>
                            @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_NET_PTS")
                        </span>
                        <span class="text-base font-mono font-bold @netColor mt-0.5 leading-none truncate">@FormatSigned(net)</span>
                    </div>
                    <div class="flex-1 bg-surface-alt/30 border border-line/50 p-1.5 rounded flex flex-col justify-center min-w-0">
                        <span class="text-[8px] uppercase tracking-wider text-subtle font-semibold inline-flex items-center gap-0.5">
                            <i class="ph ph-sword text-foreground" style="font-size: 10px;"></i>
                            @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_KILLS")
                        </span>
                        <div class="flex items-baseline justify-between gap-1 mt-0.5">
                            <span class="text-base font-mono font-bold text-foreground leading-none">@p.MatchKills.ToString("N0")</span>
                            <span class="text-[8px] font-mono text-warning bg-warning/10 px-1 rounded border border-warning/20 tabular-nums shrink-0">
                                @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_THIS_ROUND_SUFFIX").FormatExt(p.CurrentRoundKills)
                            </span>
                        </div>
                    </div>
                </div>

                @* RIGHT 6: 5-col micro stat strip (HS · KPD · DMG · Downs · Deaths) *@
                <div class="col-span-12 sm:col-span-6 grid grid-cols-5 gap-1 text-center bg-surface-alt/20 border border-line/40 rounded p-1.5">
                    @RenderCompactMicroCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_HS_PCT"), $"{hsPct:F0}%", "text-foreground", "text-muted")
                    @RenderCompactMicroCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_KPD"), kpd >= 1000 ? FormatCompactNumber((long)kpd) : kpd.ToString("F1"), "text-foreground", "text-muted")
                    @RenderCompactMicroDmgCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_DMG"), dmgInf, dmgRatio)
                    @RenderCompactMicroCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_DOWNS"), p.MatchDowns.ToString("N0"), "text-orange-400", "text-orange-400")
                    @RenderCompactMicroCell(AppState.Loc("WEBFRONT_ZOMBIE_LIVE_DEATHS"), p.MatchDeaths.ToString("N0"), "text-error", "text-error")
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderCompactMicroCell(string label, string value, string valueColor, string labelColor) => __builder =>
    {
        <div class="flex flex-col min-w-0">
            <span class="text-[8px] uppercase @labelColor tracking-tight truncate">@label</span>
            <span class="text-xs font-mono font-semibold @valueColor mt-0.5 leading-none truncate">@value</span>
        </div>
    };

    private RenderFragment RenderCompactMicroDmgCell(string label, bool inf, double ratio) => __builder =>
    {
        <div class="flex flex-col min-w-0">
            <span class="text-[8px] uppercase text-muted tracking-tight truncate">@label</span>
            @if (inf)
            {
                <span class="text-xs font-mono font-semibold text-foreground mt-0.5 leading-none"><i class="ph ph-infinity"></i></span>
            }
            else
            {
                <span class="text-xs font-mono font-semibold text-foreground mt-0.5 leading-none truncate">@ratio.ToString("N1")<span class="text-[8px] text-subtle ml-0.5">x</span></span>
            }
        </div>
    };

    private RenderFragment RenderSoloStripCell(string label, string value, string colorClass, string? icon, bool hiddenSm, bool divider, string padClass, string numClass) => __builder =>
    {
        var border = divider ? "border-r border-line/50" : "";
        var visibility = hiddenSm ? "hidden sm:flex" : "flex";
        <div class="flex-1 min-w-[70px] @padClass flex-col items-center justify-center @border @visibility">
            <span class="text-[9px] uppercase tracking-widest text-subtle mb-1 inline-flex items-center gap-1">
                @if (icon is not null)
                {
                    <i class="ph @icon" style="font-size: 11px;"></i>
                }
                @label
            </span>
            <span class="font-mono @numClass font-semibold @colorClass leading-none">@value</span>
        </div>
    };

    private RenderFragment RenderSoloStripDmgCell(string label, bool inf, double ratio, string padClass, string numClass) => __builder =>
    {
        <div class="flex-1 min-w-[70px] @padClass flex flex-col items-center justify-center border-r border-line/50 hidden sm:flex">
            <span class="text-[9px] uppercase tracking-widest text-subtle mb-1 inline-flex items-center gap-1">
                <i class="ph ph-activity" style="font-size: 11px;"></i> @label
            </span>
            @if (inf)
            {
                <span class="font-mono @numClass font-semibold text-muted leading-none"><i class="ph ph-infinity"></i></span>
            }
            else
            {
                <span class="font-mono @numClass font-semibold text-foreground leading-none">@ratio.ToString("N1")<span class="text-xs text-subtle ml-0.5">x</span></span>
            }
        </div>
    };

    @* ─────────── ROSTER COL (solo): Match Pace sparkline ───────────
       Bar-per-round CSS sparkline. Bar HEIGHT scales with duration so
       a 12-min round reads tall; TINT is a per-bar gradient interpolated
       from the round's PaceRatio (faster=emerald, neutral=muted,
       slower=rose) — replaces the 5-step palette with continuous shading.
       Each bar carries a 45° stripe texture; live bar adds an animated
       shimmer + ring so it reads as "in progress" at a glance. *@
    private RenderFragment RenderMatchPaceSparkline(ZombieLivePlayerSnapshot p) => __builder =>
    {
        var completedRounds = p.RoundsCompleted.OrderBy(r => r.RoundNumber).ToList();
        var liveRound = Snapshot.CurrentRound;
        var liveKills = p.CurrentRoundKills;
        var liveBudget = Snapshot.CurrentRoundBudget;
        // Bar height scales with DURATION (pace = time, not kills). A 12-min
        // round reads as a tall bar; a 1-min round reads as a short bar — the
        // visual answer to "how long did this round take?" matches the panel
        // label. Tint = pace band (vs EMA), so a tall green bar = took longer
        // than typical for this round, a short red bar = slowing down despite
        // brevity. Kills surface in the per-bar tooltip.
        var liveElapsed = _roundElapsedSeconds ?? 0;
        var maxDuration = Math.Max(1.0,
            Math.Max(liveElapsed, completedRounds.Count > 0 ? completedRounds.Max(r => r.DurationSeconds) : 0));
        // Avg per round across completed rounds only (live round excluded so
        // the caption reads "rolling avg" not "incl. current"). Falls back to
        // null pre-R2 so we don't surface a meaningless 0:00 average.
        double? avgSeconds = completedRounds.Count > 0
            ? completedRounds.Average(r => r.DurationSeconds)
            : null;

        var liveBand = _roundElapsedSeconds is { } rsForBand
            ? PaceVisuals.ClassifyLive(rsForBand, Snapshot.CurrentRoundEmaSeconds)
            : null;
        var liveTint = PaceVisuals.ColorClass(liveBand?.Band);

        @* flex-1 + flex-col so the panel grows to fill the parent wrapper
           (set on caller). Inner header is shrink-0, bars region takes the
           remaining vertical space — fills the roster column's dead area
           below the solo card. *@
        @* Section renders flush inside the parent column — no outer card
           border/bg/rounded. The header (below) matches the column's own
           header convention (p-2, bg-surface-alt/30) so the strip reads as
           a sibling section to "Objectives Log" rather than nested card. *@
        <div class="flex-1 flex flex-col min-h-0">
            <div class="shrink-0 p-2 bg-surface-alt/30 border-b border-line flex items-center justify-between gap-2">
                <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-muted">
                    <i class="ph ph-chart-line text-xs"></i>
                    @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_MATCH_PACE_LABEL")
                </span>
                <div class="flex items-center gap-3 text-[10px] font-mono tabular-nums text-subtle">
                    @if (avgSeconds is { } avg)
                    {
                        <span>@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_PACE_AVG_PREFIX") @FormatElapsed(avg)</span>
                    }
                    @if (_roundElapsedSeconds is { } rs)
                    {
                        <span class="@liveTint">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_PACE_LIVE_PREFIX") @FormatElapsed(rs)</span>
                    }
                </div>
            </div>

            @if (completedRounds.Count == 0 && liveRound <= 0)
            {
                <div class="flex-1 flex items-center justify-center p-4 text-center text-[10px] text-subtle">
                    @AppState.Loc("WEBFRONT_ZOMBIE_LIVE_MATCH_PACE_EMPTY")
                </div>
            }
            else
            {
                @* Bars take the remaining panel height (flex-1) so the chart
                   fills the column's dead space instead of being capped at a
                   fixed pixel height. Inner bar heights still scale by % of
                   the row — relative shape preserved regardless of total size. *@
                <div class="flex-1 min-h-0 flex flex-col px-3 pt-3 pb-2">
                    <div class="flex-1 min-h-[6rem] flex items-end gap-1">
                        @foreach (var round in completedRounds)
                        {
                            var heightPct = Math.Max(8, (int)Math.Round(round.DurationSeconds / maxDuration * 100));
                            @* Per-bar gradient + interpolated tint. PaceBarStyle
                               returns a continuous RGB blend from the round's
                               PaceRatio (no 5-step palette discretisation). *@
                            var barStyle = PaceBarStyle(round.PaceRatio);
                            <Tooltip BodyContent="@RenderPaceBarTooltip(round)" WrapperClass="flex-1 min-w-[10px] flex flex-col items-stretch justify-end h-full">
                                <div class="w-full rounded-t-sm transition-all duration-300 relative overflow-hidden border"
                                     style="height: @(heightPct)%; @barStyle">
                                    @* 45° stripe texture — subtle on completed
                                       bars; live bar (below) gets the same plus
                                       a shimmer animation. *@
                                    <div class="absolute inset-0 pointer-events-none"
                                         style="background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.08) 0 2px, transparent 2px 6px);"></div>
                                </div>
                            </Tooltip>
                        }
                        @if (liveRound > 0)
                        {
                            @* Live bar — same per-bar gradient/tint as completed
                               bars, plus animated shimmer overlay + foreground
                               ring so it reads as "in progress" at a glance.
                               Live ratio comes from liveBand (vs EMA); falls
                               back to neutral when EMA isn't computed yet. *@
                            var liveHeightPct = Math.Max(8, (int)Math.Round(liveElapsed / maxDuration * 100));
                            var liveBarStyle = PaceBarStyle(liveBand?.Ratio);
                            <Tooltip BodyContent="@RenderLivePaceBarTooltip(liveRound, liveKills, _roundElapsedSeconds, Snapshot.CurrentRoundEmaSeconds, liveBand, liveBudget)"
                                     WrapperClass="flex-1 min-w-[10px] flex flex-col items-stretch justify-end h-full">
                                <div class="w-full rounded-t-sm transition-all duration-300 relative overflow-hidden border ring-1 ring-inset ring-foreground/25 shadow-[0_0_12px_rgba(255,255,255,0.06)]"
                                     style="height: @(liveHeightPct)%; @liveBarStyle">
                                    @* Animated shimmer — moves the 45° stripe
                                       pattern so the live bar visibly "lives".
                                       Keyframes defined globally (.zm-bar-shimmer)
                                       so the animation works without inline
                                       @@keyframes. *@
                                    <div class="absolute inset-0 pointer-events-none zm-bar-shimmer"
                                         style="background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.18) 0 2px, transparent 2px 6px); background-size: 20px 20px;"></div>
                                </div>
                            </Tooltip>
                        }
                    </div>
                    @* Round-number axis. Skips labels when there are >12 rounds
                       to avoid cramming — shows first + last + live only. *@
                    <div class="flex items-center gap-1 mt-1.5 text-[9px] font-mono text-subtle/60 tabular-nums">
                        @{
                            var totalBars = completedRounds.Count + (liveRound > 0 ? 1 : 0);
                            var dense = totalBars > 12;
                        }
                        @for (var i = 0; i < completedRounds.Count; i++)
                        {
                            var r = completedRounds[i];
                            var showLabel = !dense || i == 0 || i == completedRounds.Count - 1;
                            <span class="flex-1 min-w-[10px] text-center">@(showLabel ? $"R{r.RoundNumber}" : "")</span>
                        }
                        @if (liveRound > 0)
                        {
                            <span class="flex-1 min-w-[10px] text-center @liveTint">R@(liveRound)</span>
                        }
                    </div>
                </div>
            }
        </div>
    };

    @* Per-completed-round bar tooltip. *@
    private RenderFragment RenderPaceBarTooltip(ZombieMatchHistoryRound round) => __builder =>
    {
        <div class="flex flex-col gap-1 min-w-[160px]">
            <div class="flex items-center justify-between gap-3 pb-1 border-b border-line/60">
                <span class="text-[11px] font-bold text-foreground">R@(round.RoundNumber)</span>
                <span class="text-[10px] font-mono tabular-nums text-muted">@PaceVisuals.FormatRoundTime(round.DurationSeconds)</span>
            </div>
            <div class="flex flex-col gap-0.5 text-[10px]">
                <div class="flex items-center justify-between gap-3">
                    <span class="text-subtle">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_KILLS")</span>
                    <span class="text-foreground font-mono tabular-nums">@round.Kills</span>
                </div>
                @if (round.PaceBand is { } band && round.PaceRatio is { } ratio)
                {
                    var sign = ratio > 0.05 ? "+" : (ratio < -0.05 ? "−" : "±");
                    var paceTint = PaceVisuals.ColorClass(band);
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-subtle">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_PACE_AVG_PREFIX")</span>
                        <span class="font-mono tabular-nums @paceTint">@sign@(Math.Abs(ratio * 100).ToString("F0"))%</span>
                    </div>
                }
                @if (round.Downs > 0)
                {
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-subtle">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_DOWNS")</span>
                        <span class="text-orange-400 font-mono tabular-nums">@round.Downs</span>
                    </div>
                }
            </div>
        </div>
    };

    @* Live (in-progress) round bar tooltip. Different shape — no fixed time, no
       pace ratio (incomplete); shows elapsed + live pace delta vs typical when
       known. *@
    private RenderFragment RenderLivePaceBarTooltip(
        int roundNumber,
        int currentRoundKills,
        double? elapsedSeconds,
        double? emaSeconds,
        (PaceBand Band, double Ratio)? liveBand,
        int? budget) => __builder =>
    {
        <div class="flex flex-col gap-1 min-w-[160px]">
            <div class="flex items-center justify-between gap-3 pb-1 border-b border-line/60">
                <span class="text-[11px] font-bold text-foreground">R@(roundNumber)</span>
                <span class="text-[10px] font-mono tabular-nums uppercase tracking-wider text-error">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_PACE_LIVE_PREFIX")</span>
            </div>
            <div class="flex flex-col gap-0.5 text-[10px]">
                <div class="flex items-center justify-between gap-3">
                    <span class="text-subtle">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_KILLS")</span>
                    <span class="text-foreground font-mono tabular-nums">@currentRoundKills</span>
                </div>
                @if (elapsedSeconds is { } el)
                {
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-subtle">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_MATCH_ELAPSED")</span>
                        <span class="text-foreground font-mono tabular-nums">@FormatElapsed(el)</span>
                    </div>
                }
                @if (emaSeconds is { } ema && ema > 0)
                {
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-subtle">@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_PACE_AVG_PREFIX")</span>
                        <span class="text-muted font-mono tabular-nums">@PaceVisuals.FormatRoundTime(ema)</span>
                    </div>
                }
                @if (liveBand is { } b)
                {
                    var sign = b.Ratio > 0.05 ? "+" : (b.Ratio < -0.05 ? "−" : "±");
                    var paceTint = PaceVisuals.ColorClass(b.Band);
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-subtle">Δ</span>
                        <span class="font-mono tabular-nums @paceTint">@sign@(Math.Abs(b.Ratio * 100).ToString("F0"))%</span>
                    </div>
                }
            </div>
        </div>
    };

    @* Bar style resolver — emits an inline CSS chunk with a continuous
       RGB tint interpolated from the round's PaceRatio (faster=emerald,
       neutral=muted, slower=rose), wrapped in a vertical gradient and a
       matching border colour. Replaces the 5-step palette (PaceBarBg)
       with smooth shading so a 7% slower round reads as a subtly
       different hue from a 25% slower round.

       Clamp |ratio| to 0.35 (35%) so the extremes saturate at the same
       end-stop colours the palette uses (-emerald-400 / -rose-400 -ish).
       Neutral colour matches text-muted (slate-500ish #64748b). *@
    private static string PaceBarStyle(double? ratio)
    {
        var r = Math.Clamp(ratio ?? 0, -0.35, 0.35);
        // Stops: emerald-400 (#34d399) on the faster side, muted (#64748b) at
        // zero, rose-400 (#fb7185) on the slower side. Interp in RGB. Written
        // as if/else (not a switch expression with `< 0 =>`) because Razor's
        // parser interprets a bare `<` at the start of a switch arm as an
        // HTML tag opener and the file fails to compile.
        int baseR = 100, baseG = 116, baseB = 139;
        if (r < 0)
        {
            (baseR, baseG, baseB) = Lerp(100, 116, 139,  52, 211, 153, -r / 0.35);
        }
        else if (r > 0)
        {
            (baseR, baseG, baseB) = Lerp(100, 116, 139, 251, 113, 133,  r / 0.35);
        }
        // Vertical gradient: darker base at bottom (more saturated),
        // softer top so the bar reads as filled-from-bottom volume.
        return string.Create(System.Globalization.CultureInfo.InvariantCulture,
            $"background: linear-gradient(to top, rgba({baseR},{baseG},{baseB},0.65) 0%, rgba({baseR},{baseG},{baseB},0.22) 100%); border-color: rgba({baseR},{baseG},{baseB},0.55);");
    }

    private static (int R, int G, int B) Lerp(int r1, int g1, int b1, int r2, int g2, int b2, double t)
    {
        var c = Math.Clamp(t, 0.0, 1.0);
        return (
            (int)Math.Round(r1 + (r2 - r1) * c),
            (int)Math.Round(g1 + (g2 - g1) * c),
            (int)Math.Round(b1 + (b2 - b1) * c)
        );
    }

    @* ─────────── shared bits ─────────── *@

    @* "Joined late" badge — inline next to the player name so the indicator
       never changes the host card's height. Renders nothing when the player
       was present from round 1. *@
    private RenderFragment RenderJoinedBadge(ZombieLivePlayerSnapshot p) => __builder =>
    {
        if (p.JoinedRound is not { } jr || jr <= 1) return;
        <Tooltip Text="@AppState.Loc("WEBFRONT_ZOMBIE_LIVE_JOINED_LATE_TOOLTIP").FormatExt(jr)" WrapperClass="inline-flex">
            <span class="inline-flex items-center gap-0.5 text-[9px] font-bold uppercase tracking-wider text-subtle bg-surface-alt/60 border border-line/50 px-1.5 py-0.5 rounded shrink-0">
                <i class="ph ph-sign-in" style="font-size: 9px;"></i>R@(jr)
            </span>
        </Tooltip>
    };

    private RenderFragment RenderStatusPill(ZombieLivePlayerSnapshot p) => __builder =>
    {
        var (label, colorClass, bgClass, dotClass, animate, tooltip) = StatusVisuals(p.Status, AppState);
        <span class="flex items-center gap-1.5 text-[9px] font-bold uppercase tracking-wider @colorClass @bgClass border border-current/20 px-1.5 py-0.5 rounded-sm shrink-0"
              title="@tooltip">
            <span class="w-1 h-1 rounded-sm @dotClass @(animate ? "animate-pulse" : "")"></span>@label
        </span>
    };

    private static string FormatElapsed(double seconds)
    {
        var span = TimeSpan.FromSeconds(seconds);
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}h {span.Minutes}m"
            : $"{span.Minutes}m {span.Seconds}s";
    }

    private static string FormatCompactNumber(long value) => value switch
    {
        <= -1_000_000 or >= 1_000_000 => $"{value / 1_000_000.0:F1}M",
        <= -1_000 or >= 1_000 => $"{value / 1_000.0:F1}k",
        _ => value.ToString("N0")
    };

    private static string FormatSigned(long value) =>
        (value > 0 ? "+" : "") + FormatCompactNumber(value);
}
