@using SharedLibraryCore.Interfaces
@* Match detail panel with per-player tabs, timeline, and round breakdown *@

@if (Detail.Players.Count == 0)
{
    return;
}

<div class="bg-surface-alt/30 overflow-hidden border-t border-line">

    @* ── PLAYER TABS (hidden when selection is controlled externally) ── *@
    @if (SelectedClientId is null)
    {
        <div class="flex items-center gap-1 p-2 border-b border-line bg-surface-alt/50 overflow-x-auto" style="scrollbar-width: thin;">
            @foreach (var player in Detail.Players)
            {
                var isActive = player.ClientId == ActiveClientId;
                <button @onclick="() => SelectPlayer(player.ClientId)"
                        @onclick:stopPropagation="true"
                        class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 shrink-0
                               @(isActive
                                   ? "bg-primary text-on-primary shadow-lg shadow-primary/20"
                                   : "text-muted hover:text-foreground hover:bg-surface-hover")">
                    <i class="ph ph-user text-xs"></i>
                    <ColorCode Value="@player.Name"/>
                </button>
            }
        </div>
    }

    @{
        var activePlayer = SelectedPlayer;
    }

    @if (activePlayer is not null)
    {
        <div class="p-4 sm:p-6 space-y-8">

            @* ── PLAYER NAME + ASSISTANCE BADGE ──
                 Hidden when selection is controlled externally (leaderboard scorecard
                 already shows the row the user picked, so the duplicated name reads
                 as noise). Internal selection still gets it as a tab-bar echo. *@
            @if (SelectedClientId is null)
            {
                <div class="flex items-center gap-3">
                    <span class="text-sm font-bold text-foreground">
                        <ColorCode Value="@activePlayer.Name" />
                    </span>
                    <ZombieAssistanceBadge SoloFromRound="activePlayer.SoloFromRound" HighestRound="Detail.HighestRound" />
                </div>
            }

            @* ── PLAYER SUMMARY ── *@
            <div class="flex flex-wrap gap-6">
                @RenderStat("ph-sword", "Kills", activePlayer.Kills.ToString("N0"))
                @RenderStat("ph-skull", "Deaths", activePlayer.Deaths.ToString())
                @RenderStat("ph-warning-circle", "Downs", activePlayer.Downs.ToString())
                @RenderStat("ph-first-aid", "Revives", activePlayer.Revives.ToString())
                @RenderStat("ph-coins", "Points", activePlayer.PointsEarned.ToString("N0"))
                @RenderStat("ph-crosshair", "Headshots", activePlayer.Headshots.ToString())
                @RenderStat("ph-fire", "Dmg Dealt", activePlayer.DamageDealt.ToString("N0"))
                @RenderStat("ph-shield-warning", "Dmg Taken", activePlayer.DamageReceived.ToString("N0"))
            </div>

            @* ── TIMELINE ── *@
            @if (activePlayer.Events.Count > 0)
            {
                var gapRanges = ZombieTimelineGaps.Compute(activePlayer.Rounds, activePlayer.Events, Detail.HighestRound);
                <ZombieTimeline Events="activePlayer.Events"
                                GapRanges="gapRanges"
                                ZoomLevel="_zoomLevel"
                                Filter="@_timelineFilter"
                                ZoomLevelChanged="OnZoomLevelChanged"
                                FilterChanged="OnFilterChanged" />
            }

            @* ── ROUND TABLE ── *@
            @if (activePlayer.Rounds.Count > 0)
            {
                <ZombieRoundTable Rounds="activePlayer.Rounds" MatchHighestRound="Detail.HighestRound" />
            }
        </div>
    }
</div>

@code {

    private RenderFragment RenderStat(string icon, string label, string value) => __builder =>
    {
        <div class="flex flex-col">
            <div class="flex items-center gap-1.5 text-muted text-[10px] uppercase font-bold tracking-wider mb-1">
                <i class="ph @icon text-xs"></i>
                <span>@label</span>
            </div>
            <span class="font-mono text-sm font-bold text-foreground">@value</span>
        </div>
    };
}
