@using SharedLibraryCore.Interfaces
@if (Matches.Count == 0)
{
    return;
}

<div class="space-y-4">
    <div class="flex items-center gap-3">
        <i class="ph ph-clock-counter-clockwise text-lg text-primary"></i>
        <h4 class="text-lg font-bold text-foreground">Match History</h4>
    </div>

    @foreach (var match in Matches)
    {
        var state = GetCardState(match.MatchId);
        var hasDetails = match.Rounds.Count > 0 || match.Events.Count > 0;

        <div class="bg-surface rounded-xl border border-line transition-all duration-300 hover:border-line/80">

            @* ── CARD HEADER ── *@
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 cursor-pointer hover:bg-surface-hover/30 transition-colors"
                 @onclick="() => ToggleExpand(match.MatchId)">

                <div class="flex items-center gap-4 min-w-[200px]">
                    <div class="w-11 h-11 rounded-lg bg-surface-alt flex items-center justify-center border border-line/50 shadow-inner shrink-0">
                        <i class="ph ph-map-trifold text-xl text-subtle"></i>
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-foreground">
                            @match.Map
                        </h4>
                        <div class="text-xs text-muted font-mono mt-0.5">@match.Date</div>
                    </div>
                </div>

                <div class="grid grid-cols-4 sm:flex items-center gap-4 sm:gap-8 flex-1 justify-between sm:justify-end">
                    @RenderStatBadge("ph-clock", "Duration", $"{match.DurationMinutes:F0}m", false)
                    @RenderStatBadge("ph-sword", "Kills", match.Kills.ToString("N0"), true)
                    @RenderStatBadge("ph-skull", "Deaths", match.Deaths.ToString(), false)
                    @RenderStatBadge("ph-coins", "Points", match.PointsEarned.ToString("N0"), true)

                    <div class="hidden sm:flex items-center gap-3 ml-4 pl-4 border-l border-line">
                        @if (match.Completed)
                        {
                            <span class="flex items-center gap-1.5 text-xs font-bold text-success bg-success/10 px-2.5 py-1 rounded-full">
                                <i class="ph ph-trophy text-xs"></i> WON
                            </span>
                        }
                        else
                        {
                            <span class="text-xs font-bold text-subtle bg-surface-alt px-2.5 py-1 rounded-full">DNF</span>
                        }
                        <div class="w-6 h-6 flex items-center justify-center rounded-full bg-surface-alt text-muted">
                            <i class="ph @(state.IsExpanded ? "ph-caret-up" : "ph-caret-down") text-sm"></i>
                        </div>
                    </div>
                </div>
            </div>

            @* ── EXPANDED CONTENT ── *@
            @if (state.IsExpanded && hasDetails)
            {
                <div class="border-t border-line bg-surface-alt/30 p-4 sm:p-6 space-y-8">

                    @if (match.Events.Count > 0)
                    {
                        @RenderTimeline(match)
                    }

                    @if (match.Rounds.Count > 0)
                    {
                        @RenderRoundTable(match)
                    }

                </div>
            }
            else if (state.IsExpanded)
            {
                <div class="border-t border-line bg-surface-alt/30 p-8 text-center text-muted text-sm">
                    No detailed round or event data available for this match.
                </div>
            }
        </div>
    }
</div>

@code {

    private RenderFragment RenderStatBadge(string icon, string label, string value, bool highlight) => __builder =>
    {
        <div class="flex flex-col items-start sm:items-center">
            <div class="flex items-center gap-1.5 text-muted text-[10px] uppercase font-bold tracking-wider mb-1">
                <i class="ph @icon text-xs"></i>
                <span class="hidden sm:inline">@label</span>
            </div>
            <span class="font-mono text-sm sm:text-base @(highlight ? "text-foreground font-bold" : "text-subtle")">
                @value
            </span>
        </div>
    };

    private RenderFragment RenderTimeline(ZombieMatchHistoryMatch match) => __builder =>
    {
        var state = GetCardState(match.MatchId);
        var filteredEvents = match.Events.Where(e => EventMatchesFilter(e, state.TimelineFilter)).ToList();
        var allTimes = match.Events.Select(e => e.Seconds).ToList();
        var minTime = allTimes.Count > 0 ? allTimes.Min() : 0;
        var maxTime = allTimes.Count > 0 ? allTimes.Max() : 1;
        var duration = Math.Max(maxTime - minTime, 1);

        <div>
            <div class="flex items-center justify-between mb-4">
                <h5 class="text-xs font-bold uppercase tracking-wider text-muted flex items-center gap-2">
                    <i class="ph ph-crosshair text-sm"></i>
                    Match Timeline
                </h5>

                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-0.5 bg-surface p-0.5 rounded-md border border-line">
                        @RenderFilterButton(match.MatchId, "all", "All", state.TimelineFilter)
                        @RenderFilterButton(match.MatchId, "critical", "Danger", state.TimelineFilter, "text-error")
                        @RenderFilterButton(match.MatchId, "powerups", "Drops", state.TimelineFilter, "text-yellow-400")
                    </div>

                    <div class="flex items-center gap-0.5 bg-surface p-0.5 rounded-md border border-line">
                        <button @onclick="() => SetZoom(match.MatchId, -0.5)" @onclick:stopPropagation="true"
                                disabled="@(state.ZoomLevel <= 1)"
                                class="p-1 text-muted hover:text-foreground transition-colors disabled:opacity-30">
                            <i class="ph ph-minus text-xs"></i>
                        </button>
                        <span class="text-xs font-mono text-subtle px-1.5 w-10 text-center">@(state.ZoomLevel)x</span>
                        <button @onclick="() => SetZoom(match.MatchId, 0.5)" @onclick:stopPropagation="true"
                                disabled="@(state.ZoomLevel >= 5)"
                                class="p-1 text-muted hover:text-foreground transition-colors disabled:opacity-30">
                            <i class="ph ph-plus text-xs"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="w-full bg-surface rounded-xl border border-line p-4 overflow-x-auto"
                 style="scrollbar-width: thin;"
                 @onwheel="(e) => OnTimelineWheel(e, match.MatchId)" @onwheel:preventDefault="true">
                <div class="relative h-12 flex items-center my-2" style="width: @(state.ZoomLevel * 100)%;">

                    <div class="absolute h-2 bg-surface-alt rounded-full inset-y-0 my-auto shadow-inner border border-line" style="left: 1%; right: 1%;"></div>

                    @foreach (var evt in filteredEvents)
                    {
                        var pct = 1 + ((evt.Seconds - minTime) / duration) * 98;
                        var visuals = GetEventVisuals(evt.Category);
                        var leftStyle = $"left: {pct.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%; z-index: {visuals.ZIndex};";

                        <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2" style="@leftStyle">
                            @if (visuals.IsTick)
                            {
                                <Tooltip Text="@FormatTooltipText(evt)" WrapperClass="w-fit">
                                    <div class="w-1 h-5 bg-muted/50 rounded-full hover:bg-foreground/50 transition-colors shadow-sm cursor-pointer"></div>
                                </Tooltip>
                            }
                            else
                            {
                                <Tooltip Text="@FormatTooltipText(evt)" WrapperClass="w-fit">
                                    <div class="w-5 h-5 rounded-full flex items-center justify-center shadow-lg border-2 border-surface cursor-pointer transition-transform duration-200 hover:scale-150 @visuals.Bg">
                                        <i class="ph @visuals.Icon" style="font-size: 10px; color: white;"></i>
                                    </div>
                                </Tooltip>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderFilterButton(int matchId, string filter, string label, string currentFilter, string? activeTextColor = null) => __builder =>
    {
        var isActive = currentFilter == filter;
        var activeClass = isActive
            ? $"bg-surface-alt {activeTextColor ?? "text-foreground"}"
            : "text-subtle hover:text-muted";

        <button @onclick="() => SetFilter(matchId, filter)" @onclick:stopPropagation="true"
                class="px-2 py-1 text-[10px] uppercase tracking-wider font-bold rounded transition-colors @activeClass">
            @label
        </button>
    };

    private RenderFragment RenderRoundTable(ZombieMatchHistoryMatch match) => __builder =>
    {
        var maxKills = Math.Max(match.Rounds.Max(r => r.Kills), 1);

        <div>
            <h5 class="text-xs font-bold uppercase tracking-wider text-muted mb-4 flex items-center gap-2">
                <i class="ph ph-chart-bar text-sm"></i>
                Round Breakdown
            </h5>

            <div class="overflow-x-auto overflow-y-auto max-h-[400px] border border-line rounded-lg" style="scrollbar-width: thin;">
                <table class="w-full text-left text-sm whitespace-nowrap relative">
                    <thead class="sticky top-0 bg-surface-alt z-10 shadow-sm">
                        <tr class="text-[10px] uppercase tracking-wider text-muted border-b border-line">
                            <th class="py-3 pl-4 font-medium">Round</th>
                            <th class="py-3 font-medium pr-4 w-1/3">Kills</th>
                            <th class="py-3 font-medium pr-4">Downs / Deaths</th>
                            <th class="py-3 font-medium pr-4">Points</th>
                            <th class="py-3 font-medium pr-4 text-right">Time</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line/50">
                        @foreach (var round in match.Rounds)
                        {
                            <tr class="group hover:bg-surface-hover/20 transition-colors">
                                <td class="py-2.5 pl-4 font-mono text-subtle w-24">
                                    <span class="inline-flex w-6 h-6 items-center justify-center rounded bg-surface-alt text-xs text-muted mr-2">
                                        @round.RoundNumber
                                    </span>
                                </td>
                                <td class="py-2.5 pr-4 relative">
                                    <div class="flex items-center gap-3">
                                        <span class="font-mono text-foreground w-8">@round.Kills</span>
                                        <div class="flex-1 h-4 bg-surface-alt rounded overflow-hidden">
                                            <div class="h-full bg-primary/30 rounded transition-all duration-500"
                                                 style="width: @(((double)round.Kills / maxKills * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-2.5 pr-4 font-mono text-muted">
                                    <span class="@(round.Downs > 0 ? "text-orange-400 font-bold" : "")">@round.Downs</span>
                                    <span class="opacity-50 mx-1">/</span>
                                    <span class="@(round.Deaths > 0 ? "text-error font-bold" : "")">@round.Deaths</span>
                                </td>
                                <td class="py-2.5 pr-4 font-mono text-success">@round.Points.ToString("N0")</td>
                                <td class="py-2.5 pr-4 text-right font-mono text-subtle text-xs">@($"{round.DurationSeconds:F0}s")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    };
}
