@page "/zombie/match/{MatchId:int}"
@page "/zombie/match/{MatchId:int}/{ClientId:int?}"
@rendermode InteractiveServer
@using SharedLibraryCore.Interfaces
@inject AppState AppState
@inject NavigationManager NavManager
@inject IServiceProvider ServiceProvider

@*
    Public, anonymous, deep-linkable share page for one zombie match. Mirrors the
    Profile.razor OG-meta pattern: PersistentState carries server-rendered detail
    through the SSR→interactive handoff so Discord/Twitter crawlers see the meta
    tags without running JS.
*@

<PageTitle>@(_ogTitle) | @AppState.WebfrontBranding</PageTitle>

<HeadContent>
    <meta property="og:title" content="@(_ogTitle) | @AppState.WebfrontBranding" />
    <meta property="og:site_name" content="IW4MAdmin" />
    <meta property="og:description" content="@_ogDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />
    <meta name="twitter:card" content="summary" />
</HeadContent>

@if (_premiumMissing)
{
    <div class="max-w-7xl mx-auto mt-8 px-6">
        <div class="bg-warning/10 border border-warning/20 text-warning p-6 rounded-lg flex items-center gap-3" role="alert">
            <i class="ph ph-warning text-2xl"></i>
            <span>@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_NOT_FOUND").FormatExt(MatchId)</span>
        </div>
    </div>
}
else if (Detail is null)
{
    @if (_loading)
    {
        <div class="max-w-7xl mx-auto mt-8 px-6 text-muted">
            <i class="ph ph-spinner-gap animate-spin mr-2"></i>
            @AppState.Loc("WEBFRONT_ZOMBIE_MATCH_LOADING")
        </div>
    }
    else
    {
        <div class="max-w-7xl mx-auto mt-8 px-6">
            <div class="bg-warning/10 border border-warning/20 text-warning p-6 rounded-lg flex items-center gap-3" role="alert">
                <i class="ph ph-warning text-2xl"></i>
                <span>@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_NOT_FOUND").FormatExt(MatchId)</span>
            </div>
        </div>
    }
}
else
{
    <div class="max-w-[1400px] mx-auto p-4 md:p-6 lg:p-8 space-y-4 lg:space-y-6">

        @* ── HEADER ── *@
        <div class="bg-surface rounded-2xl border border-line shadow-xl p-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center gap-4 min-w-0">
                    <div class="w-14 h-14 rounded-xl bg-surface-alt flex items-center justify-center border border-line shrink-0">
                        <i class="ph ph-map-trifold text-2xl text-primary"></i>
                    </div>
                    <div class="min-w-0">
                        <h1 class="text-2xl md:text-3xl font-bold text-foreground truncate">@Detail.Map</h1>
                        <div class="flex flex-wrap items-center gap-3 text-sm text-muted mt-1">
                            <span class="font-bold text-foreground">
                                @AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_ROUND").FormatExt(Detail.HighestRound)
                            </span>
                            <span>•</span>
                            <span>@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_HISTORY_DURATION"): @Detail.DurationMinutes.ToString("F0")m</span>
                            <span>•</span>
                            @* Match start time: rendered UTC server-side; utcLocalTime.js
                               (in blazor_lib.js) swaps in the browser-local value at first
                               paint. The Tooltip exposes the canonical UTC on hover. *@
                            <Tooltip Text="@Detail.Date.UtcDateTime.ToStandardFormat()" WrapperClass="inline-block">
                                <span data-utc-time="@Detail.Date.UtcDateTime.ToString("o")"
                                      data-utc-fmt="datetime">
                                    @Detail.Date.UtcDateTime.ToStandardFormat()
                                </span>
                            </Tooltip>
                            @if (!string.IsNullOrEmpty(Detail.ServerName))
                            {
                                <span>•</span>
                                <span class="truncate"><ColorCode Value="@Detail.ServerName" /></span>
                            }
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    @* SHOW_ALL toggle — only renders when the match actually has drop-ins.
                       Mirrors the leaderboard's button (same translation keys, same icon
                       choice, same hover style) but starts in the inverted state because
                       the share page defaults to "show everyone". *@
                    @{
                        var dropInCount = Detail.Players.Count(p => !p.IsQualified);
                    }
                    @if (dropInCount > 0)
                    {
                        <button @onclick="ToggleShowAllPlayers"
                                class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-surface text-muted hover:text-foreground border border-line text-xs font-bold transition-colors">
                            <i class="ph @(_showAllPlayers ? "ph-funnel" : "ph-users")"></i>
                            <span>@(_showAllPlayers
                                ? AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_HIDE_DROPINS")
                                : AppState.Loc("WEBFRONT_ZOMBIE_LEADERBOARD_SHOW_ALL").FormatExt(dropInCount))</span>
                        </button>
                    }
                    <button @onclick="CopyShareLink"
                            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-on-primary font-semibold text-sm hover:opacity-90 transition">
                        <i class="ph @(_copied ? "ph-check" : "ph-link")"></i>
                        @(_copied
                            ? AppState.Loc("WEBFRONT_ZOMBIE_MATCH_SHARE_COPIED")
                            : AppState.Loc("WEBFRONT_ZOMBIE_MATCH_SHARE_BUTTON"))
                    </button>
                </div>
            </div>
        </div>

        @* ── FULL-WIDTH STACK ──
             1. Player section (tabs / stats / timeline / rounds)
             2. Buildables card (full width; inner inventory grid widens to fill)
             3. Per-quest cards in a 2-col grid (full width below)
             Quests moved out of the right rail per redesign — letting them
             breathe in a 2-col grid surfaces step inventories without cramping. *@
        @{
            var hasBuildablesRow = Detail.BuildablesBuilt > 0 || Detail.BuildablesTotal.HasValue;
        }

        <div class="bg-surface rounded-md border border-line overflow-hidden">
            <ZombieMatchDetail Detail="Detail" SelectedClientId="@ClientId" ShowAllPlayers="_showAllPlayers" />
        </div>

        @if (hasBuildablesRow)
        {
            @RenderBuildablesCard()
        }

        @if (Detail.EasterEggQuests.Count == 0)
        {
            @* Maps with no configured EE quests (Nacht der Untoten is the only
               stock case). Render a muted placeholder so the section position
               stays stable across maps. *@
            <div class="bg-surface rounded-md border border-line p-3 flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 bg-surface-alt text-subtle">
                    <i class="ph ph-trophy text-xl"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="text-sm font-bold text-foreground">@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_EE_LABEL")</h2>
                    <p class="text-xs text-subtle mt-0.5">@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_EE_NONE_ON_MAP")</p>
                </div>
            </div>
        }
        else
        {
            @* 2-col grid; quests stack 1-col on narrow viewports, fill 2-col
               from md+. Auto-rows-fr keeps adjacent cards equal-height so a
               6-step quest and a 3-step quest side-by-side don't read as one
               taller card next to a stub. *@
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 auto-rows-fr">
                @foreach (var quest in Detail.EasterEggQuests)
                {
                    @RenderQuestCard(quest)
                }
            </div>
        }
    </div>
}

@code {
    /// <summary>
    /// Per-quest palette resolver. Returns the literal Tailwind class strings
    /// for each surface (head icon bg, count text, progress bar, step chip).
    /// Explicit Color wins over the fallback. Fallback preserves the prior
    /// 2-colour scheme (song=purple, main=amber) so unconfigured quests render
    /// exactly as before.
    /// </summary>
    private sealed record QuestPalette(
        string HeadIconBg,
        string CountText,
        string BarColor,
        string StepFiredBg,
        string StepFiredIcon,
        string StepCheckIcon);

    private static QuestPalette ResolvePalette(string? color, bool isSong, bool isDone)
    {
        if (!string.IsNullOrEmpty(color))
        {
            return color switch
            {
                "purple"  => BuildPalette("purple",  "300", "400", isDone),
                "red"     => BuildPalette("red",     "300", "400", isDone),
                "indigo"  => BuildPalette("indigo",  "300", "400", isDone),
                "amber"   => BuildPalette("amber",   "300", "400", isDone),
                "cyan"    => BuildPalette("cyan",    "300", "400", isDone),
                "emerald" => BuildPalette("emerald", "300", "400", isDone),
                "rose"    => BuildPalette("rose",    "300", "400", isDone),
                _ => ResolvePalette(null, isSong, isDone),
            };
        }

        // Fallback — same colour weights as the prior merged panel so unconfigured
        // quests render identically to the previous design.
        return isSong
            ? new QuestPalette(
                isDone ? "bg-purple-400/15 text-purple-300" : "bg-surface-alt text-purple-400",
                isDone ? "text-purple-300" : "text-muted",
                isDone ? "bg-purple-300" : "bg-purple-400",
                "bg-purple-400/5 border-purple-400/30",
                "text-purple-300",
                "text-purple-300")
            : new QuestPalette(
                isDone ? "bg-yellow-400/15 text-yellow-400" : "bg-surface-alt text-amber-400",
                isDone ? "text-yellow-400" : "text-muted",
                isDone ? "bg-yellow-400" : "bg-amber-400",
                "bg-yellow-400/5 border-yellow-400/30",
                "text-yellow-400",
                "text-yellow-400");
    }

    // Manual palette builder keeps the literal class strings visible to
    // Tailwind's purge pass while avoiding 7 hand-rolled QuestPalette copies.
    // Each colour expands into the exact same 6-class shape; interpolation
    // alone would be invisible to purge, so we still spell every variant once
    // in the switch above per supported colour.
    private static QuestPalette BuildPalette(string color, string doneShade, string progressShade, bool isDone) => color switch
    {
        "purple"  => isDone
            ? new("bg-purple-400/15 text-purple-300",   "text-purple-300",  "bg-purple-300",  "bg-purple-400/5 border-purple-400/30",  "text-purple-300",  "text-purple-300")
            : new("bg-surface-alt text-purple-400",     "text-muted",       "bg-purple-400",  "bg-purple-400/5 border-purple-400/30",  "text-purple-300",  "text-purple-300"),
        "red"     => isDone
            ? new("bg-red-400/15 text-red-300",         "text-red-300",     "bg-red-300",     "bg-red-400/5 border-red-400/30",        "text-red-300",     "text-red-300")
            : new("bg-surface-alt text-red-400",        "text-muted",       "bg-red-400",     "bg-red-400/5 border-red-400/30",        "text-red-300",     "text-red-300"),
        "indigo"  => isDone
            ? new("bg-indigo-400/15 text-indigo-300",   "text-indigo-300",  "bg-indigo-300",  "bg-indigo-400/5 border-indigo-400/30",  "text-indigo-300",  "text-indigo-300")
            : new("bg-surface-alt text-indigo-400",     "text-muted",       "bg-indigo-400",  "bg-indigo-400/5 border-indigo-400/30",  "text-indigo-300",  "text-indigo-300"),
        "amber"   => isDone
            ? new("bg-amber-400/15 text-amber-300",     "text-amber-300",   "bg-amber-300",   "bg-amber-400/5 border-amber-400/30",    "text-amber-300",   "text-amber-300")
            : new("bg-surface-alt text-amber-400",      "text-muted",       "bg-amber-400",   "bg-amber-400/5 border-amber-400/30",    "text-amber-300",   "text-amber-300"),
        "cyan"    => isDone
            ? new("bg-cyan-400/15 text-cyan-300",       "text-cyan-300",    "bg-cyan-300",    "bg-cyan-400/5 border-cyan-400/30",      "text-cyan-300",    "text-cyan-300")
            : new("bg-surface-alt text-cyan-400",       "text-muted",       "bg-cyan-400",    "bg-cyan-400/5 border-cyan-400/30",      "text-cyan-300",    "text-cyan-300"),
        "emerald" => isDone
            ? new("bg-emerald-400/15 text-emerald-300", "text-emerald-300", "bg-emerald-300", "bg-emerald-400/5 border-emerald-400/30","text-emerald-300", "text-emerald-300")
            : new("bg-surface-alt text-emerald-400",    "text-muted",       "bg-emerald-400", "bg-emerald-400/5 border-emerald-400/30","text-emerald-300", "text-emerald-300"),
        "rose"    => isDone
            ? new("bg-rose-400/15 text-rose-300",       "text-rose-300",    "bg-rose-300",    "bg-rose-400/5 border-rose-400/30",      "text-rose-300",    "text-rose-300")
            : new("bg-surface-alt text-rose-400",       "text-muted",       "bg-rose-400",    "bg-rose-400/5 border-rose-400/30",      "text-rose-300",    "text-rose-300"),
        _ => new("bg-surface-alt text-muted", "text-muted", "bg-muted", "bg-surface-alt/40 border-line/40", "text-muted", "text-muted"),
    };

    /// <summary>
    /// Per-quest card — bordered shell with header (icon + title + variant chip
    /// + X/Y), progress bar, and the step inventory grid. Sits in the right
    /// rail of the 7/5 grid; each quest is its own card so the user can scan
    /// quest-by-quest rather than as a single merged tracker.
    /// </summary>
    private RenderFragment RenderQuestCard(EasterEggQuestProgress quest) => __builder =>
    {
        var stepsByKey = quest.Steps.ToDictionary(s => s.Key, StringComparer.OrdinalIgnoreCase);
        var qPct = quest.Total > 0 ? Math.Min(100, quest.Completed * 100 / quest.Total) : 0;
        var qDone = quest.IsComplete;
        var isSong = quest.Id.StartsWith("song", StringComparison.Ordinal);
        var palette = ResolvePalette(quest.Color, isSong, qDone);

        <div class="bg-surface rounded-md border border-line p-3 sm:p-4">
            <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 @palette.HeadIconBg">
                    <i class="ph @quest.Icon text-lg"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-3 flex-wrap">
                        <div class="flex items-baseline gap-2 flex-wrap min-w-0">
                            <h3 class="text-sm font-bold text-foreground truncate">@AppState.Loc(quest.LocKey)</h3>
                            @if (!string.IsNullOrEmpty(quest.ActiveVariantLocKey))
                            {
                                <span class="text-[10px] font-semibold text-amber-400/80 uppercase tracking-wide">
                                    @AppState.Loc("WEBFRONT_ZOMBIE_EE_VIA_PATH").FormatExt(AppState.Loc(quest.ActiveVariantLocKey))
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(quest.BranchGroupId))
                            {
                                <span class="text-[10px] font-semibold text-subtle uppercase tracking-wide">
                                    @AppState.Loc("WEBFRONT_ZOMBIE_EE_NO_PATH_CHOSEN")
                                </span>
                            }
                        </div>
                        <span class="text-xs font-mono font-bold tabular-nums @palette.CountText">
                            @quest.Completed / @quest.Total
                        </span>
                    </div>

                    <div class="mt-1.5 h-1.5 bg-surface-alt rounded-full overflow-hidden border border-line/60">
                        <div class="h-full transition-all duration-500 @palette.BarColor"
                             style="width: @(qPct)%;"></div>
                    </div>

                    @* Step grid: 1-col on narrow rails, 2-col when the right rail
                       has room. Per-element Tooltip surfaces the full step name (in
                       case truncated) and the canonical UTC timestamp (because the
                       visible text is converted to local time by utcLocalTime.js). *@
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-3">
                        @foreach (var step in quest.Inventory)
                        {
                            @if (!step.IsLeaf())
                            {
                                @RenderEeParent(quest, step, stepsByKey, palette.StepFiredBg, palette.StepFiredIcon, palette.StepCheckIcon)
                                continue;
                            }
                            var fired = stepsByKey.TryGetValue(step.Key, out var record);
                            var label = AppState.Loc(step.LocKey);
                            var utcDisplay = fired && record is not null
                                ? record.OccurredAt.UtcDateTime.ToStandardFormat()
                                : null;
                            <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md border @(fired ? palette.StepFiredBg : "bg-surface-alt/40 border-line/40")">
                                <i class="ph @step.Icon text-sm shrink-0 @(fired ? palette.StepFiredIcon : "text-subtle/60")"></i>
                                <Tooltip Text="@label" WrapperClass="flex-1 min-w-0">
                                    <div class="text-xs font-semibold truncate @(fired ? "text-foreground" : "text-subtle")">@label</div>
                                </Tooltip>
                                @if (fired && record is not null)
                                {
                                    <div class="text-[10px] font-mono text-muted shrink-0 flex items-center">
                                        @if (record.RoundNumber is { } rn && rn > 0)
                                        {
                                            <span>R@(rn)</span>
                                            <span class="mx-1 text-subtle">•</span>
                                        }
                                        <Tooltip Text="@utcDisplay" WrapperClass="inline-block">
                                            <span data-utc-time="@record.OccurredAt.UtcDateTime.ToString("o")"
                                                  data-utc-fmt="time">
                                                @record.OccurredAt.UtcDateTime.ToString("HH:mm:ss")
                                            </span>
                                        </Tooltip>
                                    </div>
                                    <i class="ph ph-check-circle @palette.StepCheckIcon text-xs shrink-0"></i>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    };

    /// <summary>
    /// Buildables card — same shell weight as the quest cards. Renders the
    /// configured inventory as a 2-col chip grid (mockup density), with the
    /// "extras" strip below the divider for non-iconic side-quest buildables.
    /// </summary>
    private RenderFragment RenderBuildablesCard() => __builder =>
    {
        var allBuilt = Detail!.BuildablesTotal is { } total && total > 0 && Detail.BuildablesBuilt >= total;
        var pct = Detail.BuildablesTotal is { } t2 && t2 > 0
            ? Math.Min(100, Detail.BuildablesBuilt * 100 / t2)
            : 100;
        var headIconBg = allBuilt
            ? "bg-blue-400/15 text-blue-300"
            : "bg-surface-alt text-blue-400";
        var countText = allBuilt ? "text-blue-300" : "text-muted";
        var barColor = allBuilt ? "bg-blue-300" : "bg-blue-400";

        <div class="bg-surface rounded-md border border-line p-3 sm:p-4">
            <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 @headIconBg">
                    <i class="ph ph-wrench text-lg"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-3 flex-wrap">
                        <h3 class="text-sm font-bold text-foreground">@AppState.Loc("WEBFRONT_ZOMBIE_MATCH_BUILDABLES_LABEL")</h3>
                        <span class="text-xs font-mono font-bold tabular-nums @countText">
                            @Detail.BuildablesBuilt @(Detail.BuildablesTotal.HasValue ? $"/ {Detail.BuildablesTotal.Value}" : "")
                        </span>
                    </div>

                    @if (Detail.BuildablesTotal.HasValue)
                    {
                        <div class="mt-1.5 h-1.5 bg-surface-alt rounded-full overflow-hidden border border-line/60">
                            <div class="h-full transition-all duration-500 @barColor"
                                 style="width: @(pct)%;"></div>
                        </div>
                    }

                    @* Inventory-driven checklist — every iconic item the map could
                       register renders as a chip; filled blue when built, muted when
                       not. Falls back to a flat "built only" list for unconfigured
                       maps (custom maps, T4/T5) where Inventory is empty but built
                       items exist. *@
                    @if (Detail.BuildableInventory.Count > 0)
                    {
                        var builtKeys = new HashSet<string>(
                            Detail.BuildableNames.Select(b => b.Key),
                            StringComparer.OrdinalIgnoreCase);
                        @* Buildables card is full-width now; let the chip grid
                           widen to 3/4 cols so big inventories (Origins staffs)
                           don't waste horizontal space. *@
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-1.5 mt-3">
                            @foreach (var item in Detail.BuildableInventory)
                            {
                                var built = builtKeys.Contains(item.Key);
                                <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md border @(built ? "bg-blue-400/5 border-blue-400/30" : "bg-surface-alt/40 border-line/40")"
                                     title="@item.DisplayName">
                                    <i class="ph ph-wrench text-sm shrink-0 @(built ? "text-blue-300" : "text-subtle/60")"></i>
                                    <div class="text-xs font-semibold truncate flex-1 min-w-0 @(built ? "text-foreground" : "text-subtle")">@item.DisplayName</div>
                                    @if (built)
                                    {
                                        <i class="ph ph-check-circle text-blue-300 text-xs shrink-0"></i>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (Detail.BuildableNames.Count > 0)
                    {
                        @* Unconfigured map fallback: no inventory template, just
                           show what was built. *@
                        <div class="flex flex-wrap gap-2 mt-3">
                            @foreach (var entry in Detail.BuildableNames)
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-400/5 border border-blue-400/30 text-xs text-blue-300">
                                    <i class="ph ph-check-circle text-blue-300 text-xs"></i>
                                    @entry.DisplayName
                                </span>
                            }
                        </div>
                    }

                    @* Extras: side-quest / non-iconic buildables. Surfaced separately
                       so they don't dilute the main count; the heading flags them as
                       bonus rather than core progression. *@
                    @if (Detail.ExtraBuildableNames.Count > 0)
                    {
                        <div class="mt-4 pt-3 border-t border-line/40">
                            <div class="text-[10px] uppercase tracking-widest text-subtle font-bold mb-2 flex items-center gap-1.5">
                                <i class="ph ph-plus-circle text-xs"></i>
                                @AppState.Loc("WEBFRONT_ZOMBIE_MATCH_BUILDABLES_EXTRAS_LABEL").FormatExt(Detail.ExtraBuildablesBuilt)
                            </div>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var entry in Detail.ExtraBuildableNames)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/5 border border-amber-500/20 text-xs text-amber-300/90">
                                        <i class="ph ph-plus-circle text-amber-400 text-xs"></i>
                                        @entry.DisplayName
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    };

    @* Nested parent step row: spans the full step grid (col-span-full) so the
       expanded child grid below it reads as one unit. Header always visible
       (chevron + parent label + sub-progress chip); child grid renders inline
       when expanded — auto-expanded for mid-progress parents so the user can
       see pending sub-steps without clicking. *@
    private RenderFragment RenderEeParent(
        EasterEggQuestProgress quest,
        EasterEggStepInventoryEntry parent,
        Dictionary<string, EasterEggStepRecord> stepsByKey,
        string firedBg,
        string firedIcon,
        string checkIcon) => __builder =>
    {
        var leaves = parent.Leaves().ToList();
        var subFired = leaves.Count(l => stepsByKey.ContainsKey(l.Key));
        var subTotal = leaves.Count;
        var parentDone = subFired == subTotal && subTotal > 0;
        var expanded = IsEeStepExpanded(quest.Id, parent, stepsByKey);
        var label = AppState.Loc(parent.LocKey);

        <div class="col-span-full">
            <button type="button"
                    class="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-md border text-left transition-colors @(parentDone ? firedBg : "bg-surface-alt/40 border-line/40 hover:bg-surface-alt/60")"
                    @onclick="() => ToggleEeStep(quest.Id, parent.Key)">
                <i class="ph @(expanded ? "ph-caret-down" : "ph-caret-right") text-xs shrink-0 text-subtle"></i>
                <i class="ph @parent.Icon text-sm shrink-0 @(parentDone ? firedIcon : "text-subtle/60")"></i>
                <div class="text-xs font-semibold truncate flex-1 min-w-0 @(parentDone ? "text-foreground" : "text-subtle")">@label</div>
                <span class="text-[10px] font-mono text-muted shrink-0 tabular-nums">@subFired / @subTotal</span>
                @if (parentDone)
                {
                    <i class="ph ph-check-circle @checkIcon text-xs shrink-0"></i>
                }
            </button>
            @if (expanded)
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-1.5 pl-5">
                    @foreach (var child in parent.Children!)
                    {
                        @if (!child.IsLeaf())
                        {
                            @* Nested deeper than 2 levels: render the deeper parent
                               inline as a flat label + count chip. Convention is to
                               cap at 2 levels so this should not fire under normal
                               config — render defensively rather than throw. *@
                            var deeperLeaves = child.Leaves().ToList();
                            var deeperFired = deeperLeaves.Count(l => stepsByKey.ContainsKey(l.Key));
                            var deeperDone = deeperFired == deeperLeaves.Count && deeperLeaves.Count > 0;
                            <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md border @(deeperDone ? firedBg : "bg-surface-alt/40 border-line/40")">
                                <i class="ph @child.Icon text-sm shrink-0 @(deeperDone ? firedIcon : "text-subtle/60")"></i>
                                <div class="text-xs font-semibold truncate flex-1 min-w-0 @(deeperDone ? "text-foreground" : "text-subtle")">@AppState.Loc(child.LocKey)</div>
                                <span class="text-[10px] font-mono text-muted shrink-0 tabular-nums">@deeperFired / @deeperLeaves.Count</span>
                            </div>
                            continue;
                        }

                        var leafFired = stepsByKey.TryGetValue(child.Key, out var leafRec);
                        var leafLabel = AppState.Loc(child.LocKey);
                        var leafUtc = leafFired && leafRec is not null
                            ? leafRec.OccurredAt.UtcDateTime.ToStandardFormat()
                            : null;
                        <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md border @(leafFired ? firedBg : "bg-surface-alt/40 border-line/40")">
                            <i class="ph @child.Icon text-sm shrink-0 @(leafFired ? firedIcon : "text-subtle/60")"></i>
                            <Tooltip Text="@leafLabel" WrapperClass="flex-1 min-w-0">
                                <div class="text-xs font-semibold truncate @(leafFired ? "text-foreground" : "text-subtle")">@leafLabel</div>
                            </Tooltip>
                            @if (leafFired && leafRec is not null)
                            {
                                <div class="text-[10px] font-mono text-muted shrink-0 flex items-center">
                                    @if (leafRec.RoundNumber is { } rn && rn > 0)
                                    {
                                        <span>R@(rn)</span>
                                        <span class="mx-1 text-subtle">•</span>
                                    }
                                    <Tooltip Text="@leafUtc" WrapperClass="inline-block">
                                        <span data-utc-time="@leafRec.OccurredAt.UtcDateTime.ToString("o")"
                                              data-utc-fmt="time">
                                            @leafRec.OccurredAt.UtcDateTime.ToString("HH:mm:ss")
                                        </span>
                                    </Tooltip>
                                </div>
                                <i class="ph ph-check-circle @checkIcon text-xs shrink-0"></i>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    };
}
