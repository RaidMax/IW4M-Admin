@using SharedLibraryCore.Interfaces
@inject AppState AppState
@inject IJSRuntime JS
@implements IAsyncDisposable
@*
    Multi-lane Konva-rendered match timeline scrubber. Replaces ZombieTimeline.razor.
    Owner-of-state: this component holds Filter / ZoomLevel / ScrubSeconds. JS owns
    rendering + interaction, and notifies the component via dotnetRef callbacks.
    Single-lane payload (per-client view) renders identically — JS decides layout.
*@

<div class="space-y-3">

    @* ── TOOLBAR ── *@
    <div class="flex items-center justify-between flex-wrap gap-2">
        <h5 class="text-xs font-bold uppercase tracking-wider text-muted flex items-center gap-2">
            <i class="ph ph-crosshair text-sm"></i>
            @AppState.Loc("WEBFRONT_ZOMBIE_TIMELINE_TITLE")
        </h5>

        <div class="flex items-center gap-2">
            @* Lane-mode (qualified vs all-players) used to live here as a button on
               the scrubber itself. Removed: it duplicated the SHOW_ALL toggle the
               consumer (leaderboard card / match-detail page) already exposes, and
               two toggles for the same concept invited drift. The scrubber now
               consumes ShowAllPlayers as a parameter from the consumer; lane
               visibility follows whatever the consumer's single SHOW_ALL state
               says. Share-link to an unqualified player still auto-promotes
               internally via ResolveLaneMode so the focused lane never hides. *@

            <div class="flex items-center gap-0.5 bg-surface p-0.5 rounded-md border border-line">
                @foreach (var (key, locKey, color) in _filters)
                {
                    var isActive = _filter == key;
                    <button type="button" @onclick="() => SelectFilter(key)" @onclick:stopPropagation="true"
                            class="px-2 py-1 text-[10px] uppercase tracking-wider font-bold rounded transition-colors @(isActive ? $"bg-surface-alt {color}" : "text-subtle hover:text-muted")">
                        @AppState.Loc(locKey)
                    </button>
                }
            </div>

            <div class="flex items-center gap-0.5 bg-surface p-0.5 rounded-md border border-line">
                <button @onclick="() => MultiplyZoom(1 / 1.5)" @onclick:stopPropagation="true"
                        disabled="@(_zoomLevel <= 1.001)"
                        class="px-1 text-muted hover:text-foreground transition-colors disabled:opacity-30">
                    <i class="ph ph-minus text-xs"></i>
                </button>
                <span class="text-xs font-mono text-subtle px-1.5 w-12 text-center">@FormatZoom(_zoomLevel)x</span>
                <button @onclick="() => MultiplyZoom(1.5)" @onclick:stopPropagation="true"
                        disabled="@(_zoomLevel >= 19.999)"
                        class="px-1 text-muted hover:text-foreground transition-colors disabled:opacity-30">
                    <i class="ph ph-plus text-xs"></i>
                </button>
            </div>
        </div>
    </div>

    @* ── CANVAS + EVENT WINDOW (single bordered container, divider between) ── *@
    <div class="bg-surface rounded-xl border border-line overflow-hidden">

        @* Konva stage mount — horizontal scroll on zoom > 1x.
           `relative` is load-bearing: the JS module appends DOM overlays (lane names,
           EE band watermark) that are position:absolute and rely on this container as
           their offsetParent. JS sets it once on first init — but Blazor re-emits the
           entire `style` attribute whenever _minHeight changes (e.g. SHOW_ALL toggle),
           wiping the inline `position:relative` JS added. With it gone, the overlays
           re-parent to <body> and the `translateX(scrollLeft)` math makes them fly
           right with zoom. Declaring `relative` in the class list survives Blazor
           style resets. *@
        <div id="@_elementId" class="w-full p-2 overflow-x-auto overflow-y-hidden relative"
             style="min-height: @(_minHeight)px;"></div>

        @* Divider + events-at-scrub-time panel inside the same container *@
        @if (_payload is not null && _payload.Lanes.Count > 0)
        {
            <div class="border-t border-line bg-surface-alt/30 p-3">
                @if (_windowEvents.Count > 0)
                {
                    <div class="text-[10px] uppercase tracking-wider text-muted font-bold mb-2">
                        @AppState.Loc("WEBFRONT_ZOMBIE_SCRUBBER_AT_TIME").FormatExt(_scrubTimeLabel, _scrubRoundLabel)
                    </div>
                    <div class="space-y-1.5">
                        @foreach (var w in _windowEvents)
                        {
                            <div class="flex items-center gap-2 text-foreground">
                                <span class="text-[10px] font-mono text-muted w-10">@w.Time</span>
                                <span class="text-xs font-semibold text-subtle truncate max-w-[140px]">
                                    <ColorCode Value="@w.PlayerName" />
                                </span>
                                <span class="text-xs">@w.Label</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-xs text-muted">
                        @AppState.Loc("WEBFRONT_ZOMBIE_SCRUBBER_NO_EVENTS_IN_WINDOW")
                    </div>
                }
            </div>
        }
    </div>
</div>
