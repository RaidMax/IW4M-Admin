@using SharedLibraryCore.Interfaces
@inject AppState AppState
@*
    Shared zombie match timeline. Used by both ZombieMatchHistory (per-client advanced
    stats) and ZombieMatchDetail (leaderboard match expand). State (Zoom, Filter) is
    owned by the parent so each container can persist it however it likes; this component
    just renders + emits change callbacks.
*@

@{
    var filteredEvents = Events.Where(e => EventMatchesFilter(e, Filter)).ToList();
    @* Include gap range endpoints when computing the axis extents — otherwise a
       "joined late" gap that starts at second 0 would clip out when the player's
       first event is after second 0, and the bar would render at left:1% width:0. *@
    var allTimes = Events.Select(e => e.Seconds).ToList();
    foreach (var g in GapRanges) { allTimes.Add(g.Start); allTimes.Add(g.End); }
    var minTime = allTimes.Count > 0 ? allTimes.Min() : 0;
    var maxTime = allTimes.Count > 0 ? allTimes.Max() : 1;
    var duration = Math.Max(maxTime - minTime, 1);
}

<div>
    <div class="flex items-center justify-between mb-4">
        <h5 class="text-xs font-bold uppercase tracking-wider text-muted flex items-center gap-2">
            <i class="ph ph-crosshair text-sm"></i>
            @AppState.Loc("WEBFRONT_ZOMBIE_TIMELINE_TITLE")
        </h5>

        <div class="flex items-center gap-2">
            <div class="flex items-center gap-0.5 bg-surface p-0.5 rounded-md border border-line">
                <button type="button" @onclick='() => SelectFilter("all")' @onclick:stopPropagation="true"
                        class="px-2 py-1 text-[10px] uppercase tracking-wider font-bold rounded transition-colors @(Filter == "all" ? "bg-surface-alt text-foreground" : "text-subtle hover:text-muted")">
                    @AppState.Loc("WEBFRONT_ZOMBIE_TIMELINE_FILTER_ALL")
                </button>
                <button type="button" @onclick='() => SelectFilter("critical")' @onclick:stopPropagation="true"
                        class="px-2 py-1 text-[10px] uppercase tracking-wider font-bold rounded transition-colors @(Filter == "critical" ? "bg-surface-alt text-error" : "text-subtle hover:text-muted")">
                    @AppState.Loc("WEBFRONT_ZOMBIE_TIMELINE_FILTER_DANGER")
                </button>
                <button type="button" @onclick='() => SelectFilter("powerups")' @onclick:stopPropagation="true"
                        class="px-2 py-1 text-[10px] uppercase tracking-wider font-bold rounded transition-colors @(Filter == "powerups" ? "bg-surface-alt text-yellow-400" : "text-subtle hover:text-muted")">
                    @AppState.Loc("WEBFRONT_ZOMBIE_TIMELINE_FILTER_DROPS")
                </button>
                <button type="button" @onclick='() => SelectFilter("economy")' @onclick:stopPropagation="true"
                        class="px-2 py-1 text-[10px] uppercase tracking-wider font-bold rounded transition-colors @(Filter == "economy" ? "bg-surface-alt text-primary" : "text-subtle hover:text-muted")">
                    @AppState.Loc("WEBFRONT_ZOMBIE_TIMELINE_FILTER_ECONOMY")
                </button>
            </div>

            <div class="flex items-center gap-0.5 bg-surface p-0.5 rounded-md border border-line">
                <button @onclick="() => ChangeZoom(-0.5)" @onclick:stopPropagation="true"
                        disabled="@(ZoomLevel <= 1)"
                        class="p-1 text-muted hover:text-foreground transition-colors disabled:opacity-30">
                    <i class="ph ph-minus text-xs"></i>
                </button>
                <span class="text-xs font-mono text-subtle px-1.5 w-10 text-center">@(ZoomLevel)x</span>
                <button @onclick="() => ChangeZoom(0.5)" @onclick:stopPropagation="true"
                        disabled="@(ZoomLevel >= 5)"
                        class="p-1 text-muted hover:text-foreground transition-colors disabled:opacity-30">
                    <i class="ph ph-plus text-xs"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="w-full bg-surface rounded-xl border border-line p-4 overflow-x-auto"
         style="scrollbar-width: thin;"
         @onwheel="OnWheel" @onwheel:preventDefault="true">
        <div class="relative h-12 flex items-center my-2" style="width: @(ZoomLevel * 100)%;">

            <div class="absolute h-2 bg-surface-alt rounded-full inset-y-0 my-auto shadow-inner border border-line" style="left: 1%; right: 1%;"></div>

            @* Gap bars — rendered behind events (lower z-index) so event dots stay clickable.
               Tooltip wraps the bar so the WrapperStyle carries the absolute positioning
               (giving the JS-positioned tooltip a real bounding rect to anchor to). *@
            @foreach (var gap in GapRanges)
            {
                var startPct = 1 + ((Math.Max(gap.Start, minTime) - minTime) / duration) * 98;
                var endPct = 1 + ((Math.Min(gap.End, maxTime) - minTime) / duration) * 98;
                if (endPct <= startPct) continue;

                double leftPct, widthPct;
                if (gap.Compact)
                {
                    @* Compact: slim marker centered in the gap range. Point-in-time
                       interruptions (player not tracked / data missing) read as a
                       discrete event rather than dominating the axis. *@
                    var midPct = (startPct + endPct) / 2;
                    widthPct = Math.Clamp((endPct - startPct) * 0.15, 1.5, 4.0);
                    leftPct = midPct - widthPct / 2;
                }
                else
                {
                    @* Full-width: joined-late / left-early — the bar's extents
                       describe an actual range of player absence. *@
                    leftPct = startPct;
                    widthPct = Math.Max(endPct - startPct, 0.5);
                }
                var leftStr = leftPct.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);
                var widthStr = widthPct.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);
                var barStyle =
                    $"position: absolute; top: 0; bottom: 0; left: {leftStr}%; width: {widthStr}%; z-index: 5;" +
                    "background-color: rgba(248,113,113,0.18);" +
                    "background-image: repeating-linear-gradient(135deg, rgba(248,113,113,0.65) 0, rgba(248,113,113,0.65) 6px, rgba(248,113,113,0.15) 6px, rgba(248,113,113,0.15) 12px);" +
                    "border-left: 2px dashed rgb(248,113,113);" +
                    "border-right: 2px dashed rgb(248,113,113);";

                <Tooltip Text="@gap.Tooltip" WrapperClass="cursor-help" WrapperStyle="@barStyle" />
            }

            @foreach (var evt in filteredEvents)
            {
                var pct = 1 + ((evt.Seconds - minTime) / duration) * 98;
                var visuals = GetEventVisuals(evt.Category);
                var leftStyle = $"left: {pct.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%; z-index: {visuals.ZIndex};";

                <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2" style="@leftStyle">
                    @if (visuals.IsTick)
                    {
                        <Tooltip Text="@FormatTooltipText(evt)" WrapperClass="w-fit">
                            <div class="w-1 h-5 bg-muted/50 rounded-full hover:bg-foreground/50 transition-colors shadow-sm cursor-pointer"></div>
                        </Tooltip>
                    }
                    else
                    {
                        <Tooltip Text="@FormatTooltipText(evt)" WrapperClass="w-fit">
                            <div class="w-5 h-5 rounded-full flex items-center justify-center shadow-lg border-2 border-surface cursor-pointer transition-transform duration-200 hover:scale-150 @visuals.Bg">
                                <i class="ph @visuals.Icon" style="font-size: 10px; color: white;"></i>
                            </div>
                        </Tooltip>
                    }
                </div>
            }
        </div>
    </div>
</div>

