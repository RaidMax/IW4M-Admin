@page "/About"
@inject NavigationManager NavManager

@if (AboutInfo == null)
{
    <PageTitle>@AppState.Loc("WEBFRONT_ABOUT_TITLE") | IW4MAdmin</PageTitle>

    <div class="flex flex-col items-center justify-center py-20 text-muted animate-pulse">
        <i class="ph ph-spinner animate-spin text-4xl mb-4 text-primary"></i>
        <span class="text-sm">Loading community info...</span>
    </div>
}
else
{
    <PageTitle>@AboutInfo.CommunityInformation.Name | IW4MAdmin</PageTitle>

    <HeadContent>
        <meta property="og:title"
              content="@($"{AboutInfo.CommunityInformation.Name} | {AppState.Loc("WEBFRONT_ABOUT_TITLE")}")"/>
        <meta property="og:description" content="@AboutInfo.CommunityInformation.Description.StripColors()"/>
        <meta property="og:type" content="website"/>
        <meta property="og:url" content="@NavManager.Uri"/>
        <meta name="theme-color" content="#3b82f6">
    </HeadContent>

    <div class="max-w-7xl mx-auto p-4 md:p-8">
        <!-- Banner & Header -->
        <div class="mb-8">
            @if (!string.IsNullOrWhiteSpace(AboutInfo.CommunityInformation?.Name))
            {
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center p-2.5 rounded-lg bg-surface-alt/50 border border-line shadow-sm">
                        <i class="ph ph-info text-xl text-primary"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-gradient-title mb-0.5 tracking-tight">
                            <ColorCode Value="@AboutInfo.CommunityInformation.Name"/>
                        </h1>

                        @if (!string.IsNullOrWhiteSpace(AboutInfo.CommunityInformation?.Tagline))
                        {
                            <div class="text-sm text-subtle font-medium">
                                <ColorCode Value="@AboutInfo.CommunityInformation.Tagline"/>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Left Column: Description & Socials -->
            <div class="md:col-span-2 space-y-8">
                <!-- Description Card -->
                @if (!string.IsNullOrWhiteSpace(AboutInfo.CommunityInformation?.Description))
                {
                    <div class="bg-surface border border-line rounded-lg p-6 shadow-sm">
                        <h2 class="text-xl font-semibold text-foreground mb-4 flex items-center gap-2">
                            <i class="ph ph-info text-secondary"></i>
                            @AppState.Loc("WEBFRONT_ABOUT_TITLE")
                        </h2>
                        <div class="prose prose-invert max-w-none text-subtle">
                            <ColorCode Value="@AboutInfo.CommunityInformation.Description"/>
                        </div>

                        <!-- Social Links -->
                        @if (AboutInfo.CommunityInformation.SocialAccounts?.Any() == true)
                        {
                            <div class="mt-8 pt-6 border-t border-line">
                                <h3 class="text-sm font-medium text-muted uppercase tracking-wider mb-4">Connect</h3>
                                <div class="flex flex-wrap gap-4">
                                    @foreach (var social in AboutInfo.CommunityInformation.SocialAccounts)
                                    {
                                        <a href="@social.Url" target="_blank" title="@social.Title"
                                           class="flex items-center gap-3 px-4 py-3 bg-surface-alt hover:bg-surface-hover border border-line rounded-lg transition-all group">
                                            @if (!string.IsNullOrWhiteSpace(social.IconId))
                                            {
                                                <i class="ph @social.IconId text-xl text-muted group-hover:text-primary transition-colors"></i>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(social.IconUrl))
                                            {
                                                var url = Uri.TryCreate(social.IconUrl, UriKind.Absolute, out var parsedUrl)
                                                    ? parsedUrl.AbsoluteUri
                                                    : $"images/community/{social.IconUrl}";
                                                <img
                                                    class="w-6 h-6 object-contain filter grayscale group-hover:grayscale-0 transition-all"
                                                    src="@url" alt="@social.Title"/>
                                            }
                                            <span
                                                class="text-sm font-medium text-foreground group-hover:text-foreground">@social.Title</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Right Column: Rules -->
            <div class="md:col-span-1">
                @if (AllRules.Any(rule => rule.Rules.Any()))
                {
                    <div class="bg-surface border border-line rounded-lg p-6 shadow-sm sticky top-8">
                        <h2 class="text-xl font-semibold text-foreground mb-6 flex items-center gap-2">
                            <i class="ph ph-book-open-text text-secondary"></i>
                            @AppState.Loc("WEBFRONT_ABOUT_COMMUNITY_GUIDELINES")
                        </h2>

                        <div class="space-y-6">
                            @foreach (var ruleSet in AllRules)
                            {
                                if (!ruleSet.Rules.Any())
                                    continue;

                                <div>
                                    <h3 class="text-sm font-bold text-primary uppercase tracking-wider mb-3 pb-2 border-b border-line">
                                        <ColorCode Value="@ruleSet.ServerName"/>
                                    </h3>
                                    <ol class="space-y-3">
                                        @{ var imgStart = 1; }
                                        @foreach (var rule in ruleSet.Rules)
                                        {
                                            <li class="flex gap-3 text-sm text-subtle">
                                                @if (!rule.StartsWith("#") && !Regex.IsMatch(rule.StripColors(), @"^(Rule ?#?)?\d+(\.|\))"))
                                                {
                                                    <span class="font-mono text-secondary select-none">@(imgStart++).</span>
                                                }
                                                <span class="flex-1">
                                                    <ColorCode Value="@rule"/>
                                                </span>
                                            </li>
                                        }
                                    </ol>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
