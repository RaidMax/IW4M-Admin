@page "/About"

@* ================================================================ *@
@* OpenGraph / Meta Tags - Always render for crawlers *@
@* ================================================================ *@
<PageTitle>@(AboutInfo?.CommunityInformation?.Name ?? AppState.Loc("WEBFRONT_ABOUT_TITLE")) | @AppState.WebfrontBranding</PageTitle>

<HeadContent>
    <meta property="og:site_name" content="IW4MAdmin"/>
    <meta property="og:title"
          content="@(AboutInfo?.CommunityInformation?.Name ?? "Community") | @AppState.Loc("WEBFRONT_ABOUT_TITLE")"/>
    <meta property="og:description" content="@(AboutInfo?.CommunityInformation?.Description?.StripColors() ?? AppState.Loc("WEBFRONT_ABOUT_TITLE"))"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="@NavManager.Uri"/>
    <meta property="og:image" content="@($"{NavManager.BaseUri}images/icon.png")"/>
</HeadContent>

@if (AboutInfo == null)
{
    <div class="p-4 md:p-6 xl:p-8 max-w-4xl mx-auto space-y-5" aria-busy="true">
        <div class="h-8 w-56 max-w-full rounded bg-surface animate-pulse"></div>
        <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
        <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
        <span class="sr-only">@AppState.Loc("WEBFRONT_ABOUT_LOADING")</span>
    </div>
}
else
{
    <div class="p-4 md:p-6 xl:p-8 max-w-4xl mx-auto space-y-5">

        <!-- Heading -->
        <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
            <div class="min-w-0">
                <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">
                    @if (!string.IsNullOrWhiteSpace(AboutInfo.CommunityInformation?.Name))
                    {
                        <ColorCode Value="@AboutInfo.CommunityInformation.Name"/>
                    }
                    else
                    {
                        @AppState.Loc("WEBFRONT_ABOUT_TITLE")
                    }
                </h1>
                @if (!string.IsNullOrWhiteSpace(AboutInfo.CommunityInformation?.Tagline))
                {
                    <p class="text-sm text-muted mt-0.5">
                        <ColorCode Value="@AboutInfo.CommunityInformation.Tagline"/>
                    </p>
                }
            </div>
        </div>

        <!-- Community / about text -->
        @if (!string.IsNullOrWhiteSpace(AboutInfo.CommunityInformation?.Description))
        {
            <section class="rounded-xl bg-surface border border-line overflow-hidden">
                <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                    <i class="ph ph-info text-base text-secondary"></i>
                    <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_ABOUT_TITLE")</h2>
                </div>
                <div class="p-4 text-sm leading-relaxed text-subtle">
                    <ColorCode Value="@AboutInfo.CommunityInformation.Description"/>
                </div>
            </section>
        }

        <!-- Social links -->
        @if (AboutInfo.CommunityInformation?.SocialAccounts?.Any() == true)
        {
            <section class="rounded-xl bg-surface border border-line overflow-hidden">
                <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                    <i class="ph ph-share-network text-base text-secondary"></i>
                    <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_ABOUT_CONNECT")</h2>
                </div>
                <div class="divide-y divide-line">
                    @foreach (var social in AboutInfo.CommunityInformation.SocialAccounts)
                    {
                        <a href="@social.Url" target="_blank" rel="noopener noreferrer" title="@social.Title"
                           class="group flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-surface-hover transition-colors">
                            <span class="w-8 h-8 rounded-lg bg-surface-alt border border-line flex items-center justify-center shrink-0">
                                @if (!string.IsNullOrWhiteSpace(social.IconId))
                                {
                                    <i class="ph @social.IconId text-lg text-muted group-hover:text-primary transition-colors"></i>
                                }
                                else if (!string.IsNullOrWhiteSpace(social.IconUrl))
                                {
                                    var url = Uri.TryCreate(social.IconUrl, UriKind.Absolute, out var parsedUrl)
                                        ? parsedUrl.AbsoluteUri
                                        : $"images/community/{social.IconUrl}";
                                    <img class="w-4 h-4 object-contain" src="@url" alt="@social.Title"/>
                                }
                                else
                                {
                                    <i class="ph ph-link text-lg text-muted group-hover:text-primary transition-colors"></i>
                                }
                            </span>
                            <span class="flex-1 min-w-0 font-medium text-foreground truncate">@social.Title</span>
                            <i class="ph ph-arrow-up-right text-base text-muted group-hover:text-foreground transition-colors"></i>
                        </a>
                    }
                </div>
            </section>
        }

        <!-- Rules -->
        @if (AllRules.Any(rule => rule.Rules.Any()))
        {
            <section class="rounded-xl bg-surface border border-line overflow-hidden">
                <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                    <i class="ph ph-book-open-text text-base text-secondary"></i>
                    <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_ABOUT_COMMUNITY_GUIDELINES")</h2>
                </div>
                <div class="divide-y divide-line">
                    @foreach (var ruleSet in AllRules)
                    {
                        if (!ruleSet.Rules.Any())
                            continue;

                        <div class="px-4 py-3">
                            <h3 class="text-[11px] font-semibold uppercase tracking-wider text-primary mb-2">
                                <ColorCode Value="@ruleSet.ServerName"/>
                            </h3>
                            <ol class="space-y-1.5">
                                @{ var imgStart = 1; }
                                @foreach (var rule in ruleSet.Rules)
                                {
                                    <li class="flex gap-3 text-sm text-subtle leading-relaxed">
                                        @if (!rule.StartsWith("#") && !Regex.IsMatch(rule.StripColors(), @"^(Rule ?#?)?\d+(\.|\))"))
                                        {
                                            <span class="font-mono tabular-nums text-muted select-none w-6 shrink-0 text-right">@(imgStart++).</span>
                                        }
                                        <span class="flex-1 min-w-0">
                                            <ColorCode Value="@rule"/>
                                        </span>
                                    </li>
                                }
                            </ol>
                        </div>
                    }
                </div>
            </section>
        }
    </div>
}
