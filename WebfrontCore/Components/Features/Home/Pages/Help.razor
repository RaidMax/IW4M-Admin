@page "/Help"
@page "/commands"
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_HELP_TITLE") | @AppState.WebfrontBranding</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_HELP_TITLE") | @AppState.WebfrontBranding" />
    <meta property="og:site_name" content="IW4MAdmin"/>
    <meta property="og:description" content="@AppState.Loc("WEBFRONT_HELP_SUBTITLE")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />
    <meta property="og:image" content="@($"{NavManager.BaseUri}images/icon.png")" />
</HeadContent>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
    @if (CommandGroups == null)
    {
        <div class="space-y-5" aria-busy="true">
            <div class="h-8 w-56 max-w-full rounded bg-surface animate-pulse"></div>
            <div class="grid grid-cols-2 xl:grid-cols-4 gap-3">
                <div class="rounded-xl bg-surface border border-line h-20 animate-pulse"></div>
                <div class="rounded-xl bg-surface border border-line h-20 animate-pulse"></div>
                <div class="rounded-xl bg-surface border border-line h-20 animate-pulse"></div>
                <div class="rounded-xl bg-surface border border-line h-20 animate-pulse"></div>
            </div>
            <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
            <span class="sr-only">@AppState.Loc("WEBFRONT_HELP_LOADING")</span>
        </div>
    }
    else
    {
        const string viewTabBase = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium whitespace-nowrap transition-colors ";
        const string viewTabActive = viewTabBase + "bg-surface-alt text-foreground shadow-sm";
        const string viewTabIdle = viewTabBase + "text-subtle hover:text-foreground hover:bg-surface-hover";
        const string levelPill = "inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border border-current bg-transparent whitespace-nowrap ";
        const string gamePill = "inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-surface-alt text-subtle";

        <!-- Heading + view toggle -->
        <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
            <div class="min-w-0">
                <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@AppState.Loc("WEBFRONT_HELP_COMMANDS_NATIVE_TITLE")</h1>
                <p class="text-sm text-muted mt-0.5">@AppState.Loc("WEBFRONT_HELP_SUBTITLE")</p>
            </div>

            <div class="ml-auto inline-flex gap-1 p-1 rounded-lg bg-surface border border-line" role="group">
                <button type="button" @onclick="() => ViewMode = ViewModeType.Cards"
                        class="@(ViewMode == ViewModeType.Cards ? viewTabActive : viewTabIdle)"
                        title="@AppState.Loc("WEBFRONT_HELP_VIEW_CARDS")">
                    <i class="ph ph-squares-four text-base"></i>
                    <span class="hidden sm:inline">@AppState.Loc("WEBFRONT_HELP_VIEW_CARDS")</span>
                </button>
                <button type="button" @onclick="() => ViewMode = ViewModeType.Table"
                        class="@(ViewMode == ViewModeType.Table ? viewTabActive : viewTabIdle)"
                        title="@AppState.Loc("WEBFRONT_HELP_VIEW_TABLE")">
                    <i class="ph ph-table text-base"></i>
                    <span class="hidden sm:inline">@AppState.Loc("WEBFRONT_HELP_VIEW_TABLE")</span>
                </button>
            </div>
        </div>

        <!-- Stat tiles -->
        <div class="grid grid-cols-2 xl:grid-cols-4 gap-3">
            <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_HELP_STAT_TOTAL")</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none">@CommandGroups.Sum(g => g.Commands.Count).ToString("#,##0")</div>
            </div>
            <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_HELP_STAT_CATEGORIES")</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none">@CommandGroups.Count</div>
            </div>
            <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_HELP_STAT_USER_COMMANDS")</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none text-success">@CommandGroups.Sum(g => g.Commands.Count(c => c.Permission == Data.Models.Client.EFClient.Permission.User))</div>
            </div>
            <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.Loc("WEBFRONT_HELP_STAT_ADMIN_COMMANDS")</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none text-warning">@CommandGroups.Sum(g => g.Commands.Count(c => c.Permission >= Data.Models.Client.EFClient.Permission.Moderator))</div>
            </div>
        </div>

        <!-- Search + permission filters -->
        <div class="flex flex-col lg:flex-row lg:items-center gap-3">
            <div class="relative flex-1 max-w-md">
                <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-base text-muted pointer-events-none"></i>
                <input @bind="SearchTerm" @bind:event="oninput"
                       type="text"
                       class="block w-full h-10 pl-9 pr-3 rounded-lg bg-background border border-line text-sm text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                       placeholder="@AppState.Loc("WEBFRONT_HELP_SEARCH_PLACEHOLDER")" />
            </div>

            <div class="flex flex-wrap items-center gap-1.5">
                @foreach (var permission in AvailablePermissions)
                {
                    var isActive = SelectedPermissions.Contains(permission);
                    <button type="button" @onclick="() => TogglePermissionFilter(permission)"
                            class="px-3 py-1.5 rounded-full border text-xs font-semibold transition-colors @(isActive ? $"border-current bg-surface-alt {AppState.GetLevelColorClass(permission)}" : "border-line bg-surface text-subtle hover:text-foreground")">
                        @permission.ToLocalizedLevelName()
                    </button>
                }
                @if (SelectedPermissions.Any())
                {
                    <button type="button" @onclick="ClearPermissionFilters"
                            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-semibold text-muted hover:text-foreground hover:bg-surface-hover transition-colors">
                        <i class="ph-bold ph-x"></i>
                        @AppState.Loc("WEBFRONT_FILTER_CLEAR")
                    </button>
                }
            </div>
        </div>

        @if (!FilteredCommandGroups.Any())
        {
            <section class="rounded-xl bg-surface border border-line overflow-hidden">
                <div class="flex flex-col items-center justify-center gap-2 py-10 px-4 text-muted text-sm text-center">
                    <i class="ph ph-magnifying-glass text-3xl text-secondary"></i>
                    <span class="font-semibold text-foreground">@AppState.Loc("WEBFRONT_HELP_NO_COMMANDS")</span>
                    <span>@AppState.Loc("WEBFRONT_SEARCH_NO_RESULTS")</span>
                </div>
            </section>
        }
        else if (ViewMode == ViewModeType.Cards)
        {
            <!-- CARD VIEW: one collapsible card per command group -->
            <div class="space-y-4">
                @foreach (var group in FilteredCommandGroups)
                {
                    var isExpanded = ExpandedGroups.Contains(group.Name);
                    var groupIcon = GetGroupIcon(group.Name);

                    <section class="rounded-xl bg-surface border border-line overflow-hidden">
                        <button type="button" @onclick="() => ToggleGroup(group.Name)"
                                class="w-full flex items-center gap-3 px-4 py-2.5 text-left hover:bg-surface-hover transition-colors @(isExpanded ? "border-b border-line" : "")"
                                aria-expanded="@(isExpanded ? "true" : "false")">
                            <i class="ph @groupIcon text-base text-primary"></i>
                            <h2 class="flex-1 min-w-0 text-[11px] font-semibold uppercase tracking-wider text-muted truncate">
                                @group.Name
                                <span class="font-mono normal-case tracking-normal ml-1">@AppState.Loc("WEBFRONT_HELP_COMMAND_COUNT").FormatExt(group.Commands.Count)</span>
                            </h2>
                            <div class="hidden md:flex flex-wrap gap-1">
                                @foreach (var perm in group.Commands.Select(c => c.Permission).Distinct().OrderBy(p => p))
                                {
                                    <span class="@levelPill @AppState.GetLevelColorClass(perm)">@perm.ToLocalizedLevelName()</span>
                                }
                            </div>
                            <i class="ph-bold @(isExpanded ? "ph-caret-up" : "ph-caret-down") text-muted"></i>
                        </button>

                        @if (isExpanded)
                        {
                            <div class="divide-y divide-line">
                                @foreach (var command in group.Commands)
                                {
                                    <div class="grid gap-x-4 gap-y-1.5 md:grid-cols-[minmax(0,1fr)_auto] items-start px-4 py-3">
                                        <div class="min-w-0">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <span class="font-mono text-sm font-semibold text-primary">@HighlightSearchTerm(command.Name)</span>
                                                @if (!string.IsNullOrWhiteSpace(command.Alias))
                                                {
                                                    <span class="font-mono text-xs text-muted">@HighlightSearchTerm(command.Alias)</span>
                                                }
                                                @if (command.RequiresTarget)
                                                {
                                                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-success">
                                                        <i class="ph ph-user-focus"></i>@AppState.Loc("WEBFRONT_TABLE_TARGET")
                                                    </span>
                                                }
                                                @if (command.SupportedGames is not null && command.SupportedGames.Any())
                                                {
                                                    @foreach (var game in command.SupportedGames)
                                                    {
                                                        <span class="@gamePill" title="@AppState.Loc($"GAME_{game.ToString().ToUpper()}")">@game.ToString()</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center gap-1 text-[11px] text-muted">
                                                        <i class="ph ph-globe"></i>@AppState.Loc("GAME_ALL")
                                                    </span>
                                                }
                                            </div>
                                            <p class="mt-1 text-sm text-subtle">@HighlightSearchTerm(command.Description)</p>
                                            <div class="mt-1.5 flex items-center gap-2 font-mono text-xs text-muted">
                                                <code class="break-all">@HighlightSearchTerm(command.Syntax)</code>
                                                <button type="button"
                                                        @onclick="@(() => CopyToClipboard($"{CommandPrefix}{command.Syntax}"))"
                                                        @onclick:stopPropagation="true"
                                                        title="@AppState.LocOr("WEBFRONT_HELP_COPY", "Copy to clipboard")"
                                                        class="w-6 h-6 rounded-md flex items-center justify-center shrink-0 text-muted hover:text-foreground hover:bg-surface-hover transition-colors">
                                                    <i class="ph ph-copy text-sm"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <span class="@levelPill @AppState.GetLevelColorClass(command.Permission) justify-self-start md:justify-self-end">
                                            @command.Permission.ToLocalizedLevelName()
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
        else
        {
            <!-- TABLE VIEW: one card per command group -->
            <div class="space-y-4">
                @foreach (var group in FilteredCommandGroups)
                {
                    var groupIcon = GetGroupIcon(group.Name);

                    <section class="rounded-xl bg-surface border border-line overflow-hidden">
                        <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                            <i class="ph @groupIcon text-base text-primary"></i>
                            <h2 class="flex-1 min-w-0 text-[11px] font-semibold uppercase tracking-wider text-muted truncate">@group.Name</h2>
                            <span class="text-xs text-muted font-mono">@AppState.Loc("WEBFRONT_HELP_COMMAND_COUNT").FormatExt(group.Commands.Count)</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="text-[10px] font-semibold uppercase tracking-wider text-muted">
                                        <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_TABLE_COMMAND")</th>
                                        <th class="text-left px-4 py-2.5 border-b border-line hidden md:table-cell">@AppState.Loc("WEBFRONT_TABLE_DESCRIPTION")</th>
                                        <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_TABLE_SYNTAX")</th>
                                        <th class="text-center px-4 py-2.5 border-b border-line hidden sm:table-cell">@AppState.Loc("WEBFRONT_TABLE_TARGET")</th>
                                        <th class="text-center px-4 py-2.5 border-b border-line hidden lg:table-cell">@AppState.Loc("WEBFRONT_TABLE_GAMES")</th>
                                        <th class="text-right px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_TABLE_LEVEL")</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-line">
                                    @foreach (var command in group.Commands)
                                    {
                                        <tr class="hover:bg-surface-hover transition-colors">
                                            <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-mono text-sm font-semibold text-primary">@HighlightSearchTerm(command.Name)</span>
                                                    @if (!string.IsNullOrWhiteSpace(command.Alias))
                                                    {
                                                        <span class="font-mono text-xs text-muted">@HighlightSearchTerm(command.Alias)</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="px-4 py-2.5 align-middle text-subtle hidden md:table-cell">
                                                @HighlightSearchTerm(command.Description)
                                            </td>
                                            <td class="px-4 py-2.5 align-middle">
                                                <div class="flex items-center gap-2 font-mono text-xs text-muted">
                                                    <code class="break-all">@HighlightSearchTerm(command.Syntax)</code>
                                                    <button type="button"
                                                            @onclick="@(() => CopyToClipboard($"{CommandPrefix}{command.Syntax}"))"
                                                            @onclick:stopPropagation="true"
                                                            title="@AppState.LocOr("WEBFRONT_HELP_COPY", "Copy to clipboard")"
                                                            class="w-6 h-6 rounded-md flex items-center justify-center shrink-0 text-muted hover:text-foreground hover:bg-surface-hover transition-colors">
                                                        <i class="ph ph-copy text-sm"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="px-4 py-2.5 align-middle text-center hidden sm:table-cell">
                                                @if (command.RequiresTarget)
                                                {
                                                    <i class="ph-bold ph-check text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="ph-bold ph-minus text-muted"></i>
                                                }
                                            </td>
                                            <td class="px-4 py-2.5 align-middle text-center hidden lg:table-cell">
                                                @if (command.SupportedGames is not null && command.SupportedGames.Any())
                                                {
                                                    <div class="flex justify-center flex-wrap gap-1">
                                                        @foreach (var game in command.SupportedGames)
                                                        {
                                                            <span class="@gamePill" title="@AppState.Loc($"GAME_{game.ToString().ToUpper()}")">@game.ToString()</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-muted">@AppState.Loc("GAME_ALL")</span>
                                                }
                                            </td>
                                            <td class="px-4 py-2.5 align-middle text-right whitespace-nowrap">
                                                <span class="@levelPill @AppState.GetLevelColorClass(command.Permission)">
                                                    @command.Permission.ToLocalizedLevelName()
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            </div>
        }
    }
</div>
