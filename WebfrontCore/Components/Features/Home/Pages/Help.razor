@page "/Help"
@page "/commands"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<PageTitle>@AppState.Loc("WEBFRONT_HELP_COMMANDS_NATIVE_TITLE") | IW4MAdmin</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_HELP_TITLE") | IW4MAdmin" />
    <meta property="og:description" content="@AppState.Loc("WEBFRONT_HELP_COMMANDS")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />
</HeadContent>

<div class="relative max-w-7xl mx-auto p-4 md:p-8">
    @if (CommandGroups == null)
    {
        <div class="flex justify-center items-center mt-20">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
        </div>
    }
    else
    {
        <div class="flex items-center gap-3 mb-8">
            <div class="flex items-center justify-center p-2.5 rounded-lg bg-surface-alt/50 border border-line shadow-sm">
                <i class="ph ph-question text-xl text-primary"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gradient-title">@AppState.Loc("WEBFRONT_HELP_COMMANDS_NATIVE_TITLE")</h2>
                 <div class="text-sm text-subtle font-medium mt-0.5">
                     @(FilteredCommandGroups.Sum(g => g.Commands.Count()).ToString("#,##0")) total commands
                 </div>
            </div>
        </div>

        <!-- Search Input -->
        <div class="mb-12 md:mb-0 flex justify-center md:absolute md:top-8 md:right-8">
            <div class="relative max-w-md w-full md:w-80">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                     <i class="ph ph-magnifying-glass text-xl text-muted"></i>
                </div>
                <input @bind="SearchTerm" @bind:event="oninput" 
                       type="text" 
                       class="block w-full pl-10 pr-3 py-2 border border-input-border rounded-md leading-5 bg-input-bg text-foreground placeholder-input-placeholder focus:outline-none focus:ring-1 focus:ring-input-border-focus focus:border-input-border-focus sm:text-sm"
                       placeholder="Search commands..." />
            </div>
        </div>

         @if (!FilteredCommandGroups.Any())
        {
             <div class="text-center text-muted mt-10">
                @AppState.Loc("WEBFRONT_SEARCH_NO_RESULTS")
            </div>
        }

        @foreach (var group in FilteredCommandGroups)
        {
            <div class="mb-10">
                <h2 class="text-2xl font-bold text-foreground mb-4">
                    @group.Name
                </h2>

                <!-- Desktop Table -->
                <div class="hidden lg:block overflow-x-auto bg-surface rounded-lg shadow ring-1 ring-line">
                    <table class="min-w-full divide-y divide-line">
                        <thead class="bg-surface-alt/50 border-b border-line">
                            <tr>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider whitespace-nowrap">@AppState.Loc("WEBFRONT_HELP_COMMAND_DESC_NAME")</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider whitespace-nowrap">@AppState.Loc("WEBFRONT_HELP_COMMAND_DESC_ALIAS")</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider w-1/3">@AppState.Loc("WEBFRONT_HELP_COMMAND_DESC_DESCRIPTION")</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider whitespace-nowrap">Target?</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider w-1/4">@AppState.Loc("WEBFRONT_HELP_COMMAND_DESC_SYNTAX")</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider whitespace-nowrap">@AppState.Loc("WEBFRONT_HELP_SUPPORTED_GAMES")</th>
                                <th scope="col" class="px-4 py-3 text-right text-xs font-bold text-muted uppercase tracking-wider whitespace-nowrap">@AppState.Loc("WEBFRONT_HELP_COMMAND_DESC_REQUIRED_LEVEL")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line">
                            @foreach (var command in group.Commands)
                            {
                                <tr class="hover:bg-surface-hover/30 transition-colors">
                                    <td class="px-4 py-3 whitespace-nowrap text-sm font-semibold text-foreground">@command.Name</td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-subtle">@command.Alias</td>
                                    <td class="px-4 py-3 text-sm text-subtle break-words">@command.Description</td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm">
                                        @if (command.RequiresTarget)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success border border-success/20">
                                                Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-alt text-muted border border-line">
                                                No
                                            </span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-sm font-mono text-subtle">
                                        <span class="bg-surface-alt border border-line rounded px-1.5 py-0.5 whitespace-pre-wrap break-all text-xs">@CommandPrefix@command.Syntax</span>
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-muted">
                                        @if (command.SupportedGames is not null && command.SupportedGames.Any())
                                        {
                                            <div class="flex flex-wrap gap-1">
                                                @foreach (var game in command.SupportedGames)
                                                {
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-primary/10 text-primary border border-primary/20" title="@AppState.Loc($"GAME_{game.ToString().ToUpper()}")">
                                                        @game.ToString()
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-alt text-muted border border-line">
                                                All
                                            </span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-right font-medium @GetLevelColorClass(command.Permission)">
                                        @command.Permission.ToLocalizedLevelName()
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Cards -->
                <div class="lg:hidden space-y-4">
                    @foreach (var command in group.Commands)
                    {
                        <div class="bg-surface rounded-lg shadow p-4 ring-1 ring-line">
                            <div class="flex justify-between items-start mb-2">
                                <h3 class="text-lg font-bold text-foreground">@command.Name</h3>
                                <div class="text-right">
                                    <span class="text-xs font-medium px-2 py-0.5 rounded @GetLevelColorClass(command.Permission) bg-surface-alt border border-line">
                                        @command.Permission.ToLocalizedLevelName()
                                    </span>
                                </div>
                            </div>
                            
                            <p class="text-sm text-muted mb-3">@command.Description</p>
                            
                            <!-- Syntax Box -->
                            <div class="bg-surface-alt/50 p-2 rounded border border-line mb-3 font-mono text-xs text-subtle break-all">
                                @CommandPrefix@command.Syntax
                            </div>
                            
                            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-subtle">
                                @if (!string.IsNullOrWhiteSpace(command.Alias))
                                {
                                    <div class="flex items-center gap-1">
                                        <span class="text-muted">Alias</span>
                                        <span class="font-mono bg-surface-alt px-1 rounded border border-line">@command.Alias</span>
                                    </div>
                                }
                                
                                <div class="flex items-center gap-1">
                                    <span class="text-muted">Target</span>
                                    <span class="@(command.RequiresTarget ? "text-success" : "text-muted") font-medium">
                                        @(command.RequiresTarget ? "Yes" : "No")
                                    </span>
                                </div>

                                <div class="flex items-center gap-1">
                                    <span class="text-muted">@AppState.Loc("WEBFRONT_HELP_SUPPORTED_GAMES")</span>
                                    @if (command.SupportedGames is not null && command.SupportedGames.Any())
                                    {
                                        <div class="flex flex-wrap gap-1">
                                            @foreach (var game in command.SupportedGames)
                                            {
                                                <span class="font-medium text-foreground">@game.ToString()</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-foreground">All</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
