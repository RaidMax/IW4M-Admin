@page "/"
@page "/servers"
@rendermode InteractiveServer

<PageTitle>@GetLocalizedString("WEBFRONT_HOME_TITLE") | @AppState.WebfrontBranding</PageTitle>

<HeadContent>
    <meta property="og:title" content="@GetLocalizedString("WEBFRONT_SERVERS_TITLE") | @AppState.WebfrontBranding"/>
    <meta property="og:site_name" content="IW4MAdmin"/>
    <meta property="og:description" content="@GetOpenGraphDescription()"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="@NavManager.Uri"/>
    <meta property="og:image" content="@($"{NavManager.BaseUri}images/icon.png")"/>
</HeadContent>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
    <!-- MOTD announcement banner -->
    <AnnouncementBanner GlobalOnly="false" ExcludeGlobal="true"/>

    <!-- Heading + game filter tabs -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h2 class="text-2xl font-extrabold tracking-tight text-gradient-title">
                @(AppState.Loc("WEBFRONT_SERVERS_TITLE"))
            </h2>
            @if (Model != null)
            {
                <p class="text-sm text-muted mt-0.5">
                    @(AppState.LocOr("WEBFRONT_HOME_SERVERS_COUNT", "{0} {1}").FormatExt(Model.TotalServerCount.ToString("#,##0"), Model.TotalServerCount == 1 ? AppState.LocOr("WEBFRONT_HOME_SERVER_SINGULAR", "server") : AppState.LocOr("WEBFRONT_HOME_SERVER_PLURAL", "servers")))
                    <span class="text-muted/60">&middot;</span>
                    @(Model.Game.HasValue ? AppState.Loc($"GAME_{Model.Game}") : AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS"))
                </p>
            }
        </div>

        @if (Model?.ActiveServerGames is { Length: > 1 })
        {
            <nav class="ml-auto max-w-full overflow-x-auto" aria-label="@AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_GAME")">
                <div class="inline-flex gap-1 p-1 rounded-lg bg-surface border border-line">
                    <a href="/" class="@TabClass(!Model.Game.HasValue)">@AppState.Loc("GAME_ALL")</a>
                    @foreach (var game in Model.ActiveServerGames)
                    {
                        <a href="/?game=@game" class="@TabClass(game == Model.Game)">@AppState.Loc($"GAME_{game}")</a>
                    }
                </div>
            </nav>
        }
    </div>

    @if (Model != null)
    {
        <!-- Stat tiles -->
        <div class="grid grid-cols-2 xl:grid-cols-4 gap-3">
            <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.LocOr("WEBFRONT_HOME_STAT_ONLINE", "Online now")</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none">
                    @Model.TotalOccupiedClientSlots<span class="text-base font-semibold text-muted"> / @Model.TotalAvailableClientSlots</span>
                </div>
                <div class="mt-2 h-1 rounded-full bg-surface-alt overflow-hidden">
                    <div class="h-full rounded-full bg-primary" style="width:@(OccupancyPercent)%"></div>
                </div>
            </div>
            <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.LocOr("WEBFRONT_HOME_STAT_PEAK_TODAY", "Peak today")</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none">@Model.MaxConcurrentClients.ToString("#,##0")</div>
                <div class="mt-1.5 text-xs text-muted truncate" title="@Model.MaxConcurrentClientsTime.ToString("f")">@Model.MaxConcurrentClientsTime.Humanize().Titleize()</div>
            </div>
            <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.LocOr("WEBFRONT_HOME_STAT_RECENT", "Recent players")</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none">@Model.RecentClientCount.ToString("#,##0")</div>
                <div class="mt-1.5 text-xs text-muted">@AppState.LocOr("WEBFRONT_HOME_STAT_RECENT_DESC", "last 24 hours")</div>
            </div>
            <div class="rounded-xl bg-surface border border-line px-4 py-3.5">
                <div class="text-[11px] font-semibold uppercase tracking-wider text-muted">@AppState.LocOr("WEBFRONT_HOME_STAT_TOTAL_PLAYERS", "Total players")</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight tabular-nums leading-none">@Model.TotalClientCount.ToString("#,##0")</div>
                <div class="mt-1.5 text-xs text-muted">@AppState.LocOr("WEBFRONT_HOME_STAT_TOTAL_DESC", "tracked all time")</div>
            </div>
        </div>

        <ServerList Game="Model.Game"/>
    }
</div>
