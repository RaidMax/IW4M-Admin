@page "/"
@page "/servers"
@inject NavigationManager NavManager

<PageTitle>@AppState.Loc("WEBFRONT_HOME_TITLE") | IW4MAdmin</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_SERVERS_TITLE") | IW4MAdmin" />
    <meta property="og:description" content="@((MarkupString)FormatTranslation("WEBFRONT_HOME_DESCRIPTION", Model?.TotalClientCount.ToString("#,##0") ?? "0", Model?.RecentClientCount.ToString("#,##0") ?? "0"))" /> 
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />
    <meta name="theme-color" content="#007bff">
</HeadContent>

<div class="flex flex-col xl:flex-row h-full">
    <div class="flex-1 p-6 space-y-6 overflow-y-auto">
        <div class="flex items-center justify-between">
            <h2 class="text-2xl font-bold text-slate-100">@(AppState.Loc("WEBFRONT_SERVERS_TITLE"))</h2>
            @if (Model != null)
            {
                @if (Model.Game.HasValue)
                {
                    <span class="px-3 py-1 rounded-full bg-slate-800 text-sm text-slate-400 border border-slate-700">@(AppState.Loc($"GAME_{Model.Game.Value}"))</span>
                }
                else
                {
                     <span class="px-3 py-1 rounded-full bg-slate-800 text-sm text-slate-400 border border-slate-700">@(AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS"))</span>
                }
            }
        </div>

        @if (Model != null)
        {
            <!-- Compact Stats Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-0 bg-slate-800 rounded-lg border border-slate-700/50 shadow-sm overflow-hidden mb-6 divide-y md:divide-y-0 md:divide-x divide-slate-700/50">
                <!-- Max Players -->
                <div class="flex flex-col items-center justify-center p-3 hover:bg-slate-700/20 transition-colors group">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 group-hover:text-slate-400 transition-colors">Peak Today</span>
                    <span class="text-lg font-bold text-slate-200 group-hover:text-slate-100 transition-colors" title="@Model.MaxConcurrentClientsTime.Humanize().Titleize()">@Model.MaxConcurrentClients.ToString("#,##0")</span>
                </div>
                
                <!-- Online -->
                <div class="flex flex-col items-center justify-center p-3 hover:bg-slate-700/20 transition-colors group">
                     <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 group-hover:text-slate-400 transition-colors">Online</span>
                     <span class="text-lg font-bold text-slate-200 group-hover:text-slate-100 transition-colors">@((MarkupString)FormatTranslation("WEBFRONT_HOME_CLIENTS_ONLINE", Model.TotalOccupiedClientSlots, Model.TotalAvailableClientSlots))</span>
                </div>
                
                <!-- Recent -->
                <div class="flex flex-col items-center justify-center p-3 hover:bg-slate-700/20 transition-colors group">
                     <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 group-hover:text-slate-400 transition-colors">Recent (24h)</span>
                     <span class="text-lg font-bold text-slate-200 group-hover:text-slate-100 transition-colors">@Model.RecentClientCount.ToString("#,##0")</span>
                </div>

                <!-- Total -->
                <div class="flex flex-col items-center justify-center p-3 hover:bg-slate-700/20 transition-colors group">
                     <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 group-hover:text-slate-400 transition-colors">Total Players</span>
                     <span class="text-lg font-bold text-slate-200 group-hover:text-slate-100 transition-colors">@Model.TotalClientCount.ToString("#,##0")</span>
                </div>
            </div>
            
            <ServerList />
        }
    </div>
    
    @if (Model != null)
    {
         var menuItems = new SideContextMenuItems
        {
            MenuTitle = AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_GAME"),
            Items = Model.ActiveServerGames.Select(game => new SideContextMenuItem
            {
                IsLink = true,
                Reference = $"/?game={game}",
                Title = AppState.Loc($"GAME_{game}"),
                IsActive = game == Model.Game
            }).Prepend(new SideContextMenuItem
            {
                IsLink = true,
                Reference = "/",
                Title = AppState.Loc("GAME_ALL"),
                IsActive = !Model.Game.HasValue
            }).ToList()
        };
        
        <SideContextMenu Model="menuItems" />
    }
</div>
