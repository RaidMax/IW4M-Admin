@page "/"
@page "/servers"
@inject NavigationManager NavManager

<PageTitle>@AppState.Loc("WEBFRONT_HOME_TITLE") | IW4MAdmin</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_SERVERS_TITLE") | IW4MAdmin" />
    <meta property="og:description" content="@((MarkupString)FormatTranslation("WEBFRONT_HOME_DESCRIPTION", Model?.TotalClientCount.ToString("#,##0") ?? "0", Model?.RecentClientCount.ToString("#,##0") ?? "0"))" /> 
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />
    <meta name="theme-color" content="#007bff">
</HeadContent>

<div class="flex flex-col xl:flex-row h-full">
    <div class="flex-1 p-6 space-y-6 overflow-y-auto">
        <div class="flex items-center justify-between">
            <h2 class="text-2xl font-bold text-slate-100">@(AppState.Loc("WEBFRONT_SERVERS_TITLE"))</h2>
            @if (Model != null)
            {
                @if (Model.Game.HasValue)
                {
                    <span class="px-3 py-1 rounded-full bg-slate-800 text-sm text-slate-400 border border-slate-700">@(AppState.Loc($"GAME_{Model.Game.Value}"))</span>
                }
                else
                {
                     <span class="px-3 py-1 rounded-full bg-slate-800 text-sm text-slate-400 border border-slate-700">@(AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS"))</span>
                }
            }
        </div>

        @if (Model != null)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
                <div class="bg-slate-800 p-4 rounded-lg border border-slate-700 shadow-sm flex flex-col justify-center">
                    <div class="text-sm text-slate-400 mb-1">Max Players Today</div>
                    <div class="text-2xl font-bold text-blue-500" data-toggle="tooltip" data-title="@Model.MaxConcurrentClientsTime.Humanize().Titleize()">@Model.MaxConcurrentClients.ToString("#,##0")</div>
                </div>
                <!-- ... other stats ... (simplifying for brevity, but I should keep original logic) -->
                 <div class="bg-slate-800 p-4 rounded-lg border border-slate-700 shadow-sm flex flex-col justify-center">
                    <div class="text-sm text-slate-400 mb-1">Clients Online</div>
                    <div class="text-2xl font-bold text-green-500">@((MarkupString)FormatTranslation("WEBFRONT_HOME_CLIENTS_ONLINE", Model.TotalOccupiedClientSlots, Model.TotalAvailableClientSlots))</div>
                </div>
                 <div class="bg-slate-800 p-4 rounded-lg border border-slate-700 shadow-sm flex flex-col justify-center">
                    <div class="text-sm text-slate-400 mb-1">Recent Clients</div>
                    <div class="text-2xl font-bold text-purple-500">@Model.RecentClientCount.ToString("#,##0")</div>
                </div>
                 <div class="bg-slate-800 p-4 rounded-lg border border-slate-700 shadow-sm flex flex-col justify-center">
                    <div class="text-sm text-slate-400 mb-1">Total Clients</div>
                    <div class="text-2xl font-bold text-slate-100">@Model.TotalClientCount.ToString("#,##0")</div>
                </div>
            </div>
            
            <ServerList />
        }
    </div>
    
    @if (Model != null)
    {
         var menuItems = new SideContextMenuItems
        {
            MenuTitle = AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_GAME"),
            Items = Model.ActiveServerGames.Select(game => new SideContextMenuItem
            {
                IsLink = true,
                Reference = $"/?game={game}",
                Title = AppState.Loc($"GAME_{game}"),
                IsActive = game == Model.Game
            }).Prepend(new SideContextMenuItem
            {
                IsLink = true,
                Reference = "/",
                Title = AppState.Loc("GAME_ALL"),
                IsActive = !Model.Game.HasValue
            }).ToList()
        };
        
        <SideContextMenu Model="menuItems" />
    }
</div>
