@page "/"
@page "/servers"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<PageTitle>@AppState.Loc("WEBFRONT_HOME_TITLE") | IW4MAdmin</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_SERVERS_TITLE") | IW4MAdmin"/>
    <meta property="og:description"
          content="@((MarkupString)FormatTranslation("WEBFRONT_HOME_DESCRIPTION", Model?.TotalClientCount.ToString("#,##0") ?? "0", Model?.RecentClientCount.ToString("#,##0") ?? "0"))"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="@NavManager.Uri"/>
</HeadContent>

<div class="flex flex-col xl:flex-row h-full">
    <div class="flex-1 p-4 md:p-8 space-y-6 overflow-y-auto">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div
                    class="flex items-center justify-center p-2.5 rounded-lg bg-surface-alt/50 border border-line shadow-sm">
                    <i class="ph ph-hard-drives text-xl text-primary"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gradient-title">
                        @(AppState.Loc("WEBFRONT_SERVERS_TITLE"))
                    </h2>
                    @if (Model != null)
                    {
                        <div class="text-sm text-subtle font-medium mt-0.5">
                            @Model.TotalServerCount.ToString("#,##0") @(Model.TotalServerCount == 1 ? "server" : "servers") monitored
                        </div>
                    }
                </div>
            </div>
            @if (Model != null)
            {
                @if (Model.Game.HasValue)
                {
                    <span
                        class="px-3 py-1 rounded-full bg-surface text-sm text-subtle border border-line">@(AppState.Loc($"GAME_{Model.Game}"))</span>
                }
                else
                {
                    <span
                        class="px-3 py-1 rounded-full bg-surface text-sm text-subtle border border-line">@(AppState.Loc("WEBFRONT_STATS_INDEX_ALL_SERVERS"))</span>
                }
            }

        </div>

        @if (Model != null)
        {
            <!-- Compact Stats Bar -->
            <div
                class="grid grid-cols-2 md:grid-cols-4 gap-0 bg-surface rounded-lg border border-line shadow-sm overflow-hidden mb-6 divide-y md:divide-y-0 md:divide-x divide-divider">
                <!-- Online (Current Players - First) -->
                <div
                    class="flex flex-col items-center justify-center p-3 hover:bg-surface-hover transition-colors group">
                    <span
                        class="text-[10px] uppercase tracking-wider font-bold text-muted group-hover:text-subtle transition-colors">Online</span>
                    <span
                        class="text-lg font-bold text-primary group-hover:text-primary transition-colors">@Model.TotalOccupiedClientSlots/@Model.TotalAvailableClientSlots</span>
                </div>

                <!-- Peak Today -->
                <div
                    class="flex flex-col items-center justify-center p-3 hover:bg-surface-hover transition-colors group">
                    <span
                        class="text-[10px] uppercase tracking-wider font-bold text-muted group-hover:text-subtle transition-colors">Peak Today</span>
                    <span class="text-lg font-bold text-primary group-hover:text-primary transition-colors"
                          title="@Model.MaxConcurrentClientsTime.Humanize().Titleize()">@Model.MaxConcurrentClients.ToString("#,##0")</span>
                </div>

                <!-- Recent -->
                <div
                    class="flex flex-col items-center justify-center p-3 hover:bg-surface-hover transition-colors group">
                    <span
                        class="text-[10px] uppercase tracking-wider font-bold text-muted group-hover:text-subtle transition-colors">Recent (24h)</span>
                    <span
                        class="text-lg font-bold text-primary group-hover:text-primary transition-colors">@Model.RecentClientCount.ToString("#,##0")</span>
                </div>

                <!-- Total -->
                <div
                    class="flex flex-col items-center justify-center p-3 hover:bg-surface-hover transition-colors group">
                    <span
                        class="text-[10px] uppercase tracking-wider font-bold text-muted group-hover:text-subtle transition-colors">Total Players</span>
                    <span
                        class="text-lg font-bold text-primary group-hover:text-primary transition-colors">@Model.TotalClientCount.ToString("#,##0")</span>
                </div>
            </div>


            <ServerList Game="Model.Game"/>
        }
    </div>

    @if (Model != null)
    {
        var menuItems = new SideContextMenuItems
        {
            MenuTitle = AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_GAME"),
            Items = Model.ActiveServerGames.Select(game => new SideContextMenuItem
            {
                IsLink = true,
                Reference = $"/?game={game}",
                Title = AppState.Loc($"GAME_{game}"),
                IsActive = game == Model.Game
            }).Prepend(new SideContextMenuItem
            {
                IsLink = true,
                Reference = "/",
                Title = AppState.Loc("GAME_ALL"),
                IsActive = !Model.Game.HasValue
            }).ToList()
        };

        <div class="xl:w-80 xl:shrink-0 xl:py-6 xl:pr-0 pl-0">
            <div class="sticky top-6">
                <SideContextMenu Model="menuItems"/>
            </div>
        </div>
    }
</div>
