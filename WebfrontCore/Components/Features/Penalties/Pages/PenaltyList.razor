
@page "/Penalty/List"
@page "/penalties"
@implements IAsyncDisposable
@attribute [StreamRendering]
@rendermode InteractiveServer
@inject NavigationManager NavManager

<PageTitle>@AppState.Loc("WEBFRONT_PENALTY_TITLE") | IW4MAdmin</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_PENALTY_TITLE") | IW4MAdmin" />
    <meta property="og:description" content="@AppState.Loc("WEBFRONT_PENALTY_TITLE")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />

</HeadContent>

<div class="max-w-7xl mx-auto p-4 md:p-8">
    <div class="flex items-center gap-3 mb-8">
        <div class="flex items-center justify-center p-2.5 rounded-lg bg-surface-alt/50 border border-line shadow-sm">
            <i class="ph ph-lock-simple text-xl text-primary"></i>
        </div>
        <div>
            <h2 class="text-2xl font-bold text-gradient-title">@AppState.Loc("WEBFRONT_PENALTY_TITLE")</h2>
            <div class="text-sm text-subtle font-medium mt-0.5">
                @Penalties.Count.ToString("#,##0") bans found
            </div>
        </div>
    </div>
    
    <div class="md:bg-surface md:rounded-lg md:shadow md:ring-1 md:ring-line md:overflow-hidden">
        <!-- Filters Header -->
        <div class="p-4 bg-surface md:bg-background border border-line md:border-0 md:border-b md:border-line rounded-lg md:rounded-none shadow-sm md:shadow-none mb-4 md:mb-0 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
             <!-- Hide Automated Toggle -->
            <div class="flex items-center">
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="hide_automated_penalties_checkbox" checked="@IgnoreAutomated" @onchange="@OnIgnoreAutomatedChanged" class="sr-only peer" />
                    <div class="w-11 h-6 bg-surface-alt peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-primary/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                </label>
                <label for="hide_automated_penalties_checkbox" class="ml-3 text-sm font-medium text-foreground select-none cursor-pointer">@AppState.Loc("WEBFRONT_PENALTY_HIDE_AUTOMATED")</label>
            </div>

            <!-- Show Only Dropdown -->
             <div class="flex items-center w-full md:w-auto">
                 <span class="text-sm font-medium text-muted mr-3 whitespace-nowrap">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_SHOWONLY")</span>
                 <select class="bg-surface-alt border border-line text-foreground text-sm rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary focus:outline-none block w-full md:w-48 p-2.5 transition-all duration-200" @onchange="@OnShowOnlyChanged">
                    @foreach (var penaltyType in Enum.GetValues(typeof(EFPenalty.PenaltyType)).Cast<EFPenalty.PenaltyType>().OrderByDescending(p => p == EFPenalty.PenaltyType.Any))
                    {
                        <option value="@((int)penaltyType)" selected="@(penaltyType == ShowOnly)">@AppState.Loc($"WEBFRONT_PENALTY_{penaltyType.ToString().ToUpper()}")</option>
                    }
                </select>
            </div>
        </div>

        <!-- Desktop Table -->
        <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-surface-alt/30 text-xs text-muted uppercase border-b border-line">
                <tr>
                    <th class="px-6 py-3 font-medium w-[20%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_NAME")</th>
                    <th class="px-6 py-3 font-medium w-[10%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_TYPE")</th>
                    <th class="px-6 py-3 font-medium w-[35%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_OFFENSE")</th>
                    <th class="px-6 py-3 font-medium w-[20%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_ADMIN")</th>
                    <th class="px-6 py-3 font-medium text-right w-[15%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_TIME")</th>
                </tr>
                </thead>
                <tbody id="penalty_table" class="divide-y divide-line">
                    @if (_isLoading && Penalties.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center">
                                <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var penalty in Penalties)
                        {
                            <tr class="hover:bg-surface-hover/30 transition-colors group">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="/client/@penalty.OffenderId" class="text-sm font-medium hover:text-primary transition-colors @AppState.GetLevelColorClass(penalty.OffenderLevel)">
                                        <ColorCode Value="@penalty.OffenderName" />
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border @AppState.GetPenaltyBadgeClass(penalty.PenaltyType)">
                                        @AppState.Loc($"WEBFRONT_PENALTY_{penalty.PenaltyType.ToString().ToUpper()}")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm text-subtle break-words">
                                    <ColorCode Value="@($"{penalty.Offense}{penalty.AdditionalPenaltyInformation}")" />
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="/client/@penalty.PunisherId" class="text-sm font-medium hover:text-primary transition-colors @AppState.GetLevelColorClass(penalty.PunisherLevel)">
                                        <ColorCode Value="@penalty.PunisherName" />
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-muted">
                                    @if (penalty.Expired)
                                    {
                                        <span>@penalty.TimePunishedString</span>
                                    }
                                    else
                                    {
                                        <span>@penalty.TimeRemaining</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile List -->
        <div class="md:hidden space-y-4">
             @if (_isLoading && Penalties.Count == 0)
             {
                 <div class="text-center py-8">
                     <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                 </div>
             }
             else
             {
                 foreach (var penalty in Penalties)
                 {
                     <div class="bg-surface border border-line rounded-lg p-4 shadow-sm">
                         <!-- Header: Name & Badge -->
                         <div class="flex justify-between items-start mb-3">
                             <a href="/client/@penalty.OffenderId" class="font-bold hover:text-primary transition-colors text-lg @AppState.GetLevelColorClass(penalty.OffenderLevel)">
                                 <ColorCode Value="@penalty.OffenderName" />
                             </a>
                             <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border @AppState.GetPenaltyBadgeClass(penalty.PenaltyType)">
                                 @AppState.Loc($"WEBFRONT_PENALTY_{penalty.PenaltyType.ToString().ToUpper()}")
                             </span>
                         </div>

                         <!-- Reason Box -->
                         <div class="mb-4 text-sm text-subtle break-words bg-surface-alt/30 p-3 rounded border border-line/50">
                             <ColorCode Value="@($"{penalty.Offense}{penalty.AdditionalPenaltyInformation}")" />
                         </div>

                         <!-- Footer: Admin & Time -->
                         <div class="flex items-center justify-between text-xs text-muted border-t border-line pt-3">
                             <div class="flex items-center gap-1.5">
                                 <span class="uppercase tracking-wide font-semibold text-muted text-[10px]">By</span>
                                 <a href="/client/@penalty.PunisherId" class="hover:text-primary transition-colors font-medium @AppState.GetLevelColorClass(penalty.PunisherLevel)">
                                     <ColorCode Value="@penalty.PunisherName" />
                                 </a>
                             </div>
                             <div>
                                 @if (penalty.Expired)
                                 {
                                     <span>@penalty.TimePunishedString</span>
                                 }
                                 else
                                 {
                                     <span class="text-warning font-medium">@penalty.TimeRemaining</span>
                                 }
                             </div>
                         </div>
                     </div>
                 }
             }
        </div>
    </div>
    
    <!-- Infinite scroll trigger element -->
    <!-- Infinite scroll trigger element -->
    <div id="loadMoreTrigger" class="w-full text-center py-8">
        @if (_isLoading && Penalties.Count > 0)
        {
            <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div>
        }
        else if (HasMoreResults)
        {
            <div class="h-10"></div> <!-- Sentinel spacer -->
        }
        else if (Penalties.Count > 0)
        {
            <span class="text-muted text-sm">No more penalties to display</span>
        }
    </div>

</div>

@code {
}
