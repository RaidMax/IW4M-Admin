@page "/Penalty/List"
@page "/penalties"
@implements IAsyncDisposable
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permissions.Penalty.Read")]

<PageTitle>@AppState.Loc("WEBFRONT_PENALTY_TITLE") | @AppState.WebfrontBranding</PageTitle>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
    <!-- Heading + hide automated toggle -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@AppState.Loc("WEBFRONT_PENALTY_TITLE")</h1>
            <p class="text-sm text-muted mt-0.5">
                @if (State is null)
                {
                    <span class="inline-block w-24 h-3.5 rounded bg-surface-alt animate-pulse align-middle"></span>
                }
                else
                {
                    @(AppState.Loc("WEBFRONT_PENALTY_BANS_FOUND").FormatExt(State.TotalCount.ToString("#,##0")))
                }
            </p>
        </div>

        <div class="ml-auto flex items-center gap-2">
            <ToggleSwitch Id="hide_automated_penalties_checkbox"
                          Label="@AppState.Loc("WEBFRONT_PENALTY_HIDE_AUTOMATED")"
                          Value="IgnoreAutomated"
                          ValueChanged="@(v => OnIgnoreAutomatedChanged(new ChangeEventArgs { Value = v }))"/>
        </div>
    </div>

    <!-- Penalty type filter chips -->
    <div class="flex flex-wrap items-center gap-2">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-muted mr-1">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_SHOWONLY")</span>
        @foreach (var penaltyType in Enum.GetValues(typeof(EFPenalty.PenaltyType)).Cast<EFPenalty.PenaltyType>().OrderByDescending(p => p == EFPenalty.PenaltyType.Any))
        {
            <button type="button"
                    @onclick="() => OnShowOnlyChanged(new ChangeEventArgs { Value = ((int)penaltyType).ToString() })"
                    class="px-3 py-1.5 rounded-full border text-xs font-semibold transition-colors @(penaltyType == ShowOnly ? "border-primary text-primary bg-primary/10" : "border-line bg-surface text-subtle hover:text-foreground")">
                @AppState.Loc($"WEBFRONT_PENALTY_{penaltyType.ToString().ToUpper()}")
            </button>
        }
    </div>

    <!-- Penalties table -->
    <section class="rounded-xl bg-surface border border-line overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-[10px] font-semibold uppercase tracking-wider text-muted">
                        <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_NAME")</th>
                        <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_TYPE")</th>
                        <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_OFFENSE")</th>
                        <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_ADMIN")</th>
                        <th class="text-left px-4 py-2.5 border-b border-line">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_TIME")</th>
                        <th class="text-right px-4 py-2.5 border-b border-line">@AppState.LocOr("WEBFRONT_PENALTY_TEMPLATE_EXPIRES", "Expires")</th>
                    </tr>
                </thead>
                <tbody id="penalty_table" class="divide-y divide-line">
                @if (_isLoading && State?.Penalties.Count == 0)
                {
                    for (var i = 0; i < 6; i++)
                    {
                        <tr>
                            <td colspan="6" class="px-4 py-3">
                                <div class="h-4 rounded bg-surface-alt animate-pulse"></div>
                            </td>
                        </tr>
                    }
                }
                else if ((State?.Penalties.Count ?? 0) == 0)
                {
                    <tr>
                        <td colspan="6">
                            <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
                                <i class="ph ph-tray text-3xl text-secondary"></i>
                                <span>@AppState.Loc("WEBFRONT_SEARCH_NO_RESULTS")</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var penalty in State?.Penalties ?? [])
                    {
                        <tr class="hover:bg-surface-hover transition-colors">
                            <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                <a href="/client/@penalty.OffenderId"
                                   class="font-semibold hover:underline @AppState.GetLevelColorClass(penalty.OffenderLevel)">
                                    <ColorCode Value="@penalty.OffenderName"/>
                                </a>
                            </td>
                            <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wide border @AppState.GetPenaltyBadgeClass(penalty.PenaltyType)">
                                    @AppState.Loc($"WEBFRONT_PENALTY_{penalty.PenaltyType.ToString().ToUpper()}")
                                </span>
                            </td>
                            <td class="px-4 py-2.5 align-middle text-subtle min-w-[16rem] max-w-xl break-words">
                                <ColorCode Value="@($"{penalty.Offense}{penalty.AdditionalPenaltyInformation}")"/>
                            </td>
                            <td class="px-4 py-2.5 align-middle whitespace-nowrap">
                                <a href="/client/@penalty.PunisherId"
                                   class="font-semibold hover:underline @AppState.GetLevelColorClass(penalty.PunisherLevel)">
                                    <ColorCode Value="@penalty.PunisherName"/>
                                </a>
                            </td>
                            <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-muted whitespace-nowrap"
                                title="@penalty.TimePunished.ToString("f")">
                                @penalty.TimePunishedString
                            </td>
                            <td class="px-4 py-2.5 align-middle font-mono tabular-nums text-right whitespace-nowrap">
                                @if (penalty.Expired)
                                {
                                    <span class="text-muted">@AppState.LocOr("WEBFRONT_PENALTY_EXPIRED", "Expired")</span>
                                }
                                else if (penalty.Expires.HasValue && penalty.Expires.Value.Year < DateTime.MaxValue.Year)
                                {
                                    <span class="text-warning" title="@penalty.Expires.Value.ToString("f")">@penalty.TimeRemaining</span>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Infinite scroll trigger element (id is observed by wwwroot/js/infinite-scroll.js) -->
    <div id="loadMoreTrigger" class="w-full flex justify-center py-4">
        @if (_isLoading && State is not null && State.Penalties.Count > 0)
        {
            <span class="inline-flex items-center gap-2 text-sm text-muted">
                <i class="ph ph-spinner animate-spin text-base"></i>
                @AppState.Loc("WEBFRONT_LOADING")
            </span>
        }
        else if (State?.HasMoreResults ?? false)
        {
            <div class="h-10"></div>
            <!-- Sentinel spacer -->
        }
        else if (State?.Penalties.Count > 0)
        {
            <span class="text-muted text-sm">@AppState.Loc("WEBFRONT_PENALTY_NO_MORE")</span>
        }
    </div>
</div>

@code {
}
