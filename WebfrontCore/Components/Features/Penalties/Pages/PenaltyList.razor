
@page "/Penalty/List"
@page "/penalties"
@implements IAsyncDisposable
@rendermode InteractiveServer
@inject NavigationManager NavManager

<PageTitle>@AppState.Loc("WEBFRONT_PENALTY_TITLE") | IW4MAdmin</PageTitle>

<HeadContent>
    <meta property="og:title" content="@AppState.Loc("WEBFRONT_PENALTY_TITLE") | IW4MAdmin" />
    <meta property="og:description" content="@AppState.Loc("WEBFRONT_PENALTY_TITLE")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavManager.Uri" />
    <meta name="theme-color" content="#dc3545">
</HeadContent>

<div class="max-w-7xl mx-auto p-4 md:p-8">
    <div class="mb-8">
        <h2 class="text-3xl font-bold text-slate-100 mb-2">@AppState.Loc("WEBFRONT_PENALTY_TITLE")</h2>
        <p class="text-slate-400">View and manage server penalties.</p>
    </div>
    
    <div class="bg-slate-800 rounded-lg shadow ring-1 ring-slate-700/50 overflow-hidden">
        <!-- Filters Header -->
        <div class="p-4 bg-slate-800/50 border-b border-slate-700 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
             <!-- Hide Automated Toggle -->
            <div class="flex items-center">
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="hide_automated_penalties_checkbox" checked="@IgnoreAutomated" @onchange="@OnIgnoreAutomatedChanged" class="sr-only peer" />
                    <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-blue-500 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                </label>
                <label for="hide_automated_penalties_checkbox" class="ml-3 text-sm font-medium text-slate-300 select-none cursor-pointer">@AppState.Loc("WEBFRONT_PENALTY_HIDE_AUTOMATED")</label>
            </div>

            <!-- Show Only Dropdown -->
             <div class="flex items-center w-full md:w-auto">
                 <span class="text-sm font-medium text-slate-400 mr-3 whitespace-nowrap">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_SHOWONLY")</span>
                 <select class="bg-slate-700 border border-slate-600 text-slate-200 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full md:w-48 p-2.5 transition-colors" @onchange="@OnShowOnlyChanged">
                    @foreach (var penaltyType in Enum.GetValues(typeof(EFPenalty.PenaltyType)).Cast<EFPenalty.PenaltyType>().OrderByDescending(p => p == EFPenalty.PenaltyType.Any))
                    {
                        <option value="@((int)penaltyType)" selected="@(penaltyType == ShowOnly)">@AppState.Loc($"WEBFRONT_PENALTY_{penaltyType.ToString().ToUpper()}")</option>
                    }
                </select>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <!-- Table Header (Desktop) -->
                <thead class="bg-slate-900/30 text-xs text-slate-400 uppercase border-b border-slate-700 hidden md:table-header-group">
                <tr>
                    <th class="px-6 py-3 font-medium w-[20%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_NAME")</th>
                    <th class="px-6 py-3 font-medium w-[10%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_TYPE")</th>
                    <th class="px-6 py-3 font-medium w-[35%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_OFFENSE")</th>
                    <th class="px-6 py-3 font-medium w-[20%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_ADMIN")</th>
                    <th class="px-6 py-3 font-medium text-right w-[15%]">@AppState.Loc("WEBFRONT_PENALTY_TEMPLATE_TIME")</th>
                </tr>
                </thead>
                <tbody id="penalty_table" class="divide-y divide-slate-700">
                    @if (_isLoading && Penalties.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center">
                                <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var penalty in Penalties)
                        {
                            <!-- Desktop Row -->
                            <tr class="hidden md:table-row hover:bg-slate-700/30 transition-colors group">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="/client/@penalty.OffenderId" class="text-sm font-medium hover:text-blue-400 transition-colors @AppState.GetLevelColorClass(penalty.OffenderLevel)">
                                        <ColorCode Value="@penalty.OffenderName" />
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border @AppState.GetPenaltyBadgeClass(penalty.PenaltyType)">
                                        @AppState.Loc($"WEBFRONT_PENALTY_{penalty.PenaltyType.ToString().ToUpper()}")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-300 break-words">
                                    <ColorCode Value="@($"{penalty.Offense}{penalty.AdditionalPenaltyInformation}")" />
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="/client/@penalty.PunisherId" class="text-sm font-medium hover:text-blue-400 transition-colors @AppState.GetLevelColorClass(penalty.PunisherLevel)">
                                        <ColorCode Value="@penalty.PunisherName" />
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-slate-400">
                                    @if (penalty.Expired)
                                    {
                                        <span>@penalty.TimePunishedString</span>
                                    }
                                    else
                                    {
                                        <span>@penalty.TimeRemaining</span>
                                    }
                                </td>
                            </tr>

                             <!-- Mobile Card -->
                             <tr class="md:hidden border-b border-slate-700 last:border-none">
                                <td class="p-4 block">
                                    <div class="flex justify-between items-start mb-2">
                                        <div class="flex items-center space-x-2">
                                             <a href="/client/@penalty.OffenderId" class="font-bold hover:text-blue-400 transition-colors @AppState.GetLevelColorClass(penalty.OffenderLevel)">
                                                <ColorCode Value="@penalty.OffenderName" />
                                            </a>
                                        </div>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border @AppState.GetPenaltyBadgeClass(penalty.PenaltyType)">
                                            @AppState.Loc($"WEBFRONT_PENALTY_{penalty.PenaltyType.ToString().ToUpper()}")
                                        </span>
                                    </div>
                                    
                                    <div class="mb-3 text-sm text-slate-300 break-words bg-slate-900/50 p-2 rounded border border-slate-700/50">
                                        <ColorCode Value="@($"{penalty.Offense}{penalty.AdditionalPenaltyInformation}")" />
                                    </div>
                                    
                                    <div class="flex justify-between items-center text-xs text-slate-400">
                                        <div class="flex items-center space-x-1">
                                            <span class="uppercase tracking-wide font-semibold text-slate-500">By</span>
                                            <a href="/client/@penalty.PunisherId" class="hover:text-blue-400 transition-colors @AppState.GetLevelColorClass(penalty.PunisherLevel)">
                                                <ColorCode Value="@penalty.PunisherName" />
                                            </a>
                                        </div>
                                        <div>
                                            @if (penalty.Expired)
                                            {
                                                <span>@penalty.TimePunishedString</span>
                                            }
                                            else
                                            {
                                                <span class="text-yellow-500 font-medium">@penalty.TimeRemaining</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                             </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Infinite scroll trigger element -->
    <!-- Infinite scroll trigger element -->
    <div id="loadMoreTrigger" class="w-full text-center py-8">
        @if (_isLoading && Penalties.Count > 0)
        {
            <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500"></div>
        }
        else if (HasMoreResults)
        {
            <div class="h-10"></div> <!-- Sentinel spacer -->
        }
        else if (Penalties.Count > 0)
        {
            <span class="text-slate-500 text-sm">No more penalties to display</span>
        }
    </div>

</div>

