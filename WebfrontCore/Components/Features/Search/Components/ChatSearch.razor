<EditForm Model="Model" OnSubmit="Submit" class="space-y-4">
    @if (!string.IsNullOrEmpty(_validationError))
    {
        <div class="p-3 rounded-lg bg-error/10 border border-error/20 text-error text-sm font-medium flex items-center gap-2">
            <i class="ph ph-warning-circle text-lg"></i>
            @_validationError
        </div>
    }
    <div id="chatSearchWrapper" class="space-y-3 text-foreground">
        <!-- Message Search -->
        <div class="space-y-1">
            <label for="messageContains" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                @(AppState.Loc("WEBFRONT_ACTION_LABEL_MESSAGE"))
            </label>
            <div class="relative">
                <input type="text"
                       class="block w-full rounded-md bg-input-bg border border-input-border text-foreground placeholder-input-placeholder focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 sm:text-sm px-3 py-2 pr-16"
                       id="messageContains"
                       placeholder="Search text..."
                       @bind="Model.MessageContains"/>
                <button type="button"
                        @onclick="() => Model.IsExactMatch = !Model.IsExactMatch"
                        class="absolute right-2 top-1/2 -translate-y-1/2 px-2 py-0.5 rounded text-xs font-medium transition-colors @(Model.IsExactMatch ? "bg-primary text-white" : "bg-surface-hover text-muted hover:text-foreground")">
                    Exact
                </button>
            </div>
        </div>

        <!-- Filters Row -->
        <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
                <label for="serverId" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                    @(AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_SERVER"))
                </label>
                <select
                    class="block w-full rounded-md bg-input-bg border border-input-border text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 text-sm px-2 py-2"
                    id="serverId"
                    @bind="Model.ServerId">
                    <option value="">Any</option>
                    @foreach (var server in Manager.GetServers())
                    {
                        <option value="@server.Id">@server.ServerName.StripColors()</option>
                    }
                </select>
            </div>
            <div class="space-y-1">
                <label for="clientId" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                    @(AppState.Loc("WEBFRONT_BAN_MGMT_FORM_ID"))
                </label>
                <input type="text"
                       class="block w-full rounded-md bg-input-bg border border-input-border text-foreground placeholder-input-placeholder focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 text-sm px-3 py-2"
                       id="clientId"
                       placeholder="Any"
                       @bind="Model.ClientId"/>
            </div>
        </div>

        <!-- Time Range - stacked for popup width -->
        <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
                <label for="sentAfter" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                    @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_SENT_AFTER"))
                </label>
                <input type="datetime-local"
                       class="block w-full rounded-md bg-input-bg border border-input-border text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 text-sm px-2 py-2 [color-scheme:dark]"
                       id="sentAfter"
                       @bind="LocalSentAfter"/>
            </div>
            <div class="space-y-1">
                <label for="sentBefore" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                    @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_SENT_BEFORE"))
                </label>
                <input type="datetime-local"
                       class="block w-full rounded-md bg-input-bg border border-input-border text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 text-sm px-2 py-2 [color-scheme:dark]"
                       id="sentBefore"
                       @bind="LocalSentBefore"/>
            </div>
        </div>

        <!-- Options & Submit -->
        <div class="flex items-center justify-between pt-1">
            <label class="relative inline-flex items-center cursor-pointer group">
                <input type="checkbox" id="oldestFirst" class="sr-only peer" @bind="_oldestFirst">
                <div
                    class="w-8 h-4 bg-line peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[0px] after:left-[0px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary flex-shrink-0"></div>
                <span class="ml-2 text-sm text-muted group-hover:text-foreground transition-colors">Oldest first</span>
            </label>
            <button type="submit"
                    class="flex items-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-primary hover:bg-action-primary-hover focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all duration-200">
                <i class="ph ph-magnifying-glass"></i>
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_BUTTON_SUBMIT"))
            </button>
        </div>
    </div>
</EditForm>
