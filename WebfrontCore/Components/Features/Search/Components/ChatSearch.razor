<EditForm Model="Model" OnSubmit="Submit" class="space-y-4">
    @if (!string.IsNullOrEmpty(_validationError))
    {
        <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-error/10 border border-error/20 text-error text-sm font-medium">
            <i class="ph ph-warning-circle text-base"></i>
            <span>@_validationError</span>
        </div>
    }
    <div id="chatSearchWrapper" class="space-y-4 text-foreground">
        <!-- Message Search -->
        <div>
            <label for="messageContains" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                @(AppState.Loc("WEBFRONT_ACTION_LABEL_MESSAGE"))
            </label>
            <div class="relative">
                <input type="text"
                       class="block w-full h-10 pl-3 pr-20 rounded-lg bg-background border border-line text-sm text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                       id="messageContains"
                       placeholder="@AppState.LocOr("WEBFRONT_SEARCH_PLACEHOLDER_MESSAGE", "Search text")"
                       @bind="Model.MessageContains"/>
                <button type="button"
                        @onclick="() => Model.IsExactMatch = !Model.IsExactMatch"
                        class="absolute right-1.5 top-1/2 -translate-y-1/2 px-2 py-0.5 rounded-full border text-[11px] font-semibold uppercase tracking-wide transition-colors @(Model.IsExactMatch ? "border-primary text-primary bg-primary/10" : "border-line bg-surface text-subtle hover:text-foreground")">
                    @AppState.LocOr("WEBFRONT_SEARCH_EXACT", "Exact")
                </button>
            </div>
        </div>

        <!-- Filters Row -->
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label for="serverId" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                    @(AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_SERVER"))
                </label>
                <select
                    class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm text-foreground focus:outline-none focus:border-primary"
                    id="serverId"
                    @bind="Model.ServerId">
                    <option value="">@AppState.LocOr("WEBFRONT_FILTER_ANY", "Any")</option>
                    @foreach (var server in Manager.GetServers())
                    {
                        <option value="@server.Id">@server.ServerName.StripColors()</option>
                    }
                </select>
            </div>
            <div>
                <label for="clientId" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                    @(AppState.Loc("WEBFRONT_BAN_MGMT_FORM_ID"))
                </label>
                <input type="text"
                       class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm font-mono text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                       id="clientId"
                       placeholder="@AppState.LocOr("WEBFRONT_FILTER_ANY", "Any")"
                       @bind="Model.ClientId"/>
            </div>
        </div>

        <!-- Time Range - stacked for popup width -->
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label for="sentAfter" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                    @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_SENT_AFTER"))
                </label>
                <input type="datetime-local"
                       class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm font-mono text-foreground focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all [color-scheme:dark]"
                       id="sentAfter"
                       @bind="LocalSentAfter"/>
            </div>
            <div>
                <label for="sentBefore" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                    @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_SENT_BEFORE"))
                </label>
                <input type="datetime-local"
                       class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm font-mono text-foreground focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all [color-scheme:dark]"
                       id="sentBefore"
                       @bind="LocalSentBefore"/>
            </div>
        </div>

        <!-- Options & Submit -->
        <div class="flex items-center justify-between gap-3 pt-1">
            <ToggleSwitch Id="oldestFirst" Label="@AppState.LocOr("WEBFRONT_SEARCH_OLDEST_FIRST", "Oldest first")" Value="OldestFirst" ValueChanged="@(v => OldestFirst = v)" />
            <button type="submit"
                    class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg bg-primary text-sm font-semibold text-white hover:brightness-110 transition">
                <i class="ph ph-magnifying-glass text-base"></i>
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_BUTTON_SUBMIT"))
            </button>
        </div>
    </div>
</EditForm>
