<EditForm Model="Model" OnSubmit="Submit" class="space-y-4">
    @if (!string.IsNullOrEmpty(_validationError))
    {
        <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-error/10 border border-error/20 text-error text-sm font-medium">
            <i class="ph ph-warning-circle text-base"></i>
            <span>@_validationError</span>
        </div>
    }
    <div id="clientSearchWrapper" class="space-y-4 text-foreground">
        <!-- Name Search -->
        <div>
            <label for="clientName" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_NAME"))
            </label>
            <div class="relative">
                <input type="text"
                       class="block w-full h-10 pl-3 pr-20 rounded-lg bg-background border border-line text-sm text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                       id="clientName"
                       placeholder="@AppState.LocOr("WEBFRONT_SEARCH_PLACEHOLDER_NAME", "Player name")"
                       @bind="Model.ClientName"/>
                <button type="button"
                        @onclick="() => Model.IsExactClientName = !Model.IsExactClientName"
                        class="absolute right-1.5 top-1/2 -translate-y-1/2 px-2 py-0.5 rounded-full border text-[11px] font-semibold uppercase tracking-wide transition-colors @(Model.IsExactClientName ? "border-primary text-primary bg-primary/10" : "border-line bg-surface text-subtle hover:text-foreground")">
                    @AppState.Loc("WEBFRONT_SEARCH_EXACT")
                </button>
            </div>
        </div>

        <!-- IP Search -->
        <div>
            <label for="clientIP" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_IP"))
            </label>
            <div class="relative">
                <input type="text"
                       class="block w-full h-10 pl-3 pr-20 rounded-lg bg-background border border-line text-sm font-mono text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                       id="clientIP"
                       placeholder="1.1.1.1"
                       @bind="Model.ClientIp"/>
                <button type="button"
                        @onclick="() => Model.IsExactClientIp = !Model.IsExactClientIp"
                        class="absolute right-1.5 top-1/2 -translate-y-1/2 px-2 py-0.5 rounded-full border text-[11px] font-semibold uppercase tracking-wide transition-colors @(Model.IsExactClientIp ? "border-primary text-primary bg-primary/10" : "border-line bg-surface text-subtle hover:text-foreground")">
                    @AppState.Loc("WEBFRONT_SEARCH_EXACT")
                </button>
            </div>
        </div>

        <!-- GUID/Network ID -->
        <div>
            <label for="clientGuid" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                @AppState.Loc("WEBFRONT_SEARCH_GUID_LABEL")
            </label>
            <input type="text"
                   class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm font-mono text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                   id="clientGuid"
                   placeholder="110000100000001"
                   @bind="Model.ClientGuid"/>
        </div>

        <!-- Level & Game -->
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label for="clientLevel" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                    @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_PERMISSION"))
                </label>
                <select
                    class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm text-foreground focus:outline-none focus:border-primary"
                    id="clientLevel"
                    @bind="Model.ClientLevel">
                    <option value="">@AppState.Loc("WEBFRONT_FILTER_ANY")</option>
                    @foreach (EFClient.Permission permission in Enum.GetValues(typeof(EFClient.Permission)))
                    {
                        <option value="@permission">@permission.ToString()</option>
                    }
                </select>
            </div>
            <div>
                <label for="clientGameName" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                    @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_GAME"))
                </label>
                <select
                    class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm text-foreground focus:outline-none focus:border-primary"
                    id="clientGameName"
                    @bind="Model.GameName">
                    <option value="">@AppState.Loc("WEBFRONT_FILTER_ANY")</option>
                    @foreach (Reference.Game game in Enum.GetValues(typeof(Reference.Game)))
                    {
                        <option value="@game">@game.ToString()</option>
                    }
                </select>
            </div>
        </div>

        <!-- Last Connected -->
        <div>
            <label for="clientConnected" class="block text-[11px] font-semibold uppercase tracking-wider text-muted mb-1.5">
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_CONNECTED_SINCE"))
            </label>
            <input type="datetime-local"
                   class="block w-full h-10 px-3 rounded-lg bg-background border border-line text-sm font-mono text-foreground focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all [color-scheme:dark]"
                   id="clientConnected"
                   @bind="Model.ClientConnected"/>
        </div>

        <!-- Options & Submit -->
        <div class="flex items-center justify-between gap-3 pt-1">
            <ToggleSwitch Id="resultOrder" Label="@AppState.Loc("WEBFRONT_SEARCH_OLDEST_FIRST")" Value="IsAscending" ValueChanged="@(v => IsAscending = v)" />
            <button type="submit"
                    class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg bg-primary text-sm font-semibold text-white hover:brightness-110 transition">
                <i class="ph ph-magnifying-glass text-base"></i>
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_BUTTON_SUBMIT"))
            </button>
        </div>
    </div>
</EditForm>
