<EditForm Model="Model" OnSubmit="Submit" class="space-y-4">
    @if (!string.IsNullOrEmpty(_validationError))
    {
        <div class="p-3 rounded-lg bg-error/10 border border-error/20 text-error text-sm font-medium flex items-center gap-2">
            <i class="ph ph-warning-circle text-lg"></i>
            @_validationError
        </div>
    }
    <div id="clientSearchWrapper" class="space-y-3 text-foreground">
        <!-- Name Search -->
        <div class="space-y-1">
            <label for="clientName" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_NAME"))
            </label>
            <div class="relative">
                <input type="text"
                       class="block w-full rounded-md bg-input-bg border border-input-border text-foreground placeholder-input-placeholder focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 sm:text-sm px-3 py-2 pr-16"
                       id="clientName"
                       placeholder="Player name..."
                       @bind="Model.ClientName"/>
                <button type="button"
                        @onclick="() => Model.IsExactClientName = !Model.IsExactClientName"
                        class="absolute right-2 top-1/2 -translate-y-1/2 px-2 py-0.5 rounded text-xs font-medium transition-colors @(Model.IsExactClientName ? "bg-primary text-white" : "bg-surface-hover text-muted hover:text-foreground")">
                    @AppState.Loc("WEBFRONT_SEARCH_EXACT")
                </button>
            </div>
        </div>

        <!-- IP Search -->
        <div class="space-y-1">
            <label for="clientIP" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_IP"))
            </label>
            <div class="relative">
                <input type="text"
                       class="block w-full rounded-md bg-input-bg border border-input-border text-foreground placeholder-input-placeholder focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 sm:text-sm px-3 py-2 pr-16"
                       id="clientIP"
                       placeholder="1.1.1.1"
                       @bind="Model.ClientIp"/>
                <button type="button"
                        @onclick="() => Model.IsExactClientIp = !Model.IsExactClientIp"
                        class="absolute right-2 top-1/2 -translate-y-1/2 px-2 py-0.5 rounded text-xs font-medium transition-colors @(Model.IsExactClientIp ? "bg-primary text-white" : "bg-surface-hover text-muted hover:text-foreground")">
                    @AppState.Loc("WEBFRONT_SEARCH_EXACT")
                </button>
            </div>
        </div>

        <!-- GUID/Network ID -->
        <div class="space-y-1">
            <label for="clientGuid" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                @AppState.Loc("WEBFRONT_SEARCH_GUID_LABEL")
            </label>
            <input type="text"
                   class="block w-full rounded-md bg-input-bg border border-input-border text-foreground placeholder-input-placeholder focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 sm:text-sm px-3 py-2"
                   id="clientGuid"
                   placeholder="110000100000001"
                   @bind="Model.ClientGuid"/>
        </div>

        <!-- Level & Game -->
        <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
                <label for="clientLevel" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                    @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_PERMISSION"))
                </label>
                <select
                    class="block w-full rounded-md bg-input-bg border border-input-border text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 text-sm px-2 py-2"
                    id="clientLevel"
                    @bind="Model.ClientLevel">
                    <option value="">@AppState.Loc("WEBFRONT_FILTER_ANY")</option>
                    @foreach (EFClient.Permission permission in Enum.GetValues(typeof(EFClient.Permission)))
                    {
                        <option value="@permission">@permission.ToString()</option>
                    }
                </select>
            </div>
            <div class="space-y-1">
                <label for="clientGameName" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                    @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_GAME"))
                </label>
                <select
                    class="block w-full rounded-md bg-input-bg border border-input-border text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 text-sm px-2 py-2"
                    id="clientGameName"
                    @bind="Model.GameName">
                    <option value="">@AppState.Loc("WEBFRONT_FILTER_ANY")</option>
                    @foreach (Reference.Game game in Enum.GetValues(typeof(Reference.Game)))
                    {
                        <option value="@game">@game.ToString()</option>
                    }
                </select>
            </div>
        </div>

        <!-- Last Connected -->
        <div class="space-y-1">
            <label for="clientConnected" class="block text-xs font-semibold text-muted uppercase tracking-wider">
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_CONNECTED_SINCE"))
            </label>
            <input type="datetime-local"
                   class="block w-full rounded-md bg-input-bg border border-input-border text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-200 text-sm px-3 py-2 [color-scheme:dark]"
                   id="clientConnected"
                   @bind="Model.ClientConnected"/>
        </div>

        <!-- Options & Submit -->
        <div class="flex items-center justify-between pt-1">
            <label class="relative inline-flex items-center cursor-pointer group">
                <input type="checkbox" id="resultOrder" class="sr-only peer" @bind="IsAscending">
                <div
                    class="w-8 h-4 bg-line peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[0px] after:left-[0px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary flex-shrink-0"></div>
                <span class="ml-2 text-sm text-muted group-hover:text-foreground transition-colors">@AppState.Loc("WEBFRONT_SEARCH_OLDEST_FIRST")</span>
            </label>
            <button type="submit"
                    class="flex items-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-primary hover:bg-action-primary-hover focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all duration-200">
                <i class="ph ph-magnifying-glass"></i>
                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_BUTTON_SUBMIT"))
            </button>
        </div>
    </div>
</EditForm>
