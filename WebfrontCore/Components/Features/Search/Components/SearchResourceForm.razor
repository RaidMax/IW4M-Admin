<form @onsubmit="BasicSubmit" class="relative w-full group">
    <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-lg text-muted group-focus-within:text-primary transition-colors pointer-events-none"></i>
    <input @bind="ClientName"
           type="text"
           class="block w-full h-10 pl-10 pr-11 rounded-lg bg-background border border-line text-sm text-foreground placeholder-muted focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
           placeholder="@(AppState.Loc("WEBFRONT_NAV_SEARCH"))"
           required/>

    <!-- Advanced search toggle -->
    <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.AdvancedSearch}.{WebfrontPermission.Read}")">
        <button type="button"
                class="absolute right-1.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-md flex items-center justify-center text-muted hover:text-foreground hover:bg-surface-hover transition-colors"
                @onclick="ToggleAdvancedSearch"
                title="@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_TITLE"))">
            <i class="ph ph-sliders text-lg"></i>
        </button>
    </AuthorizeView>
</form>

@code {
    private void ToggleAdvancedSearch()
    {
        AppState.IsAdvancedSearchOpen = !AppState.IsAdvancedSearchOpen;
    }
}
