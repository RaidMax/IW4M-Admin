<div class="relative inline-block text-left w-full max-w-sm ml-auto">
    <div class="flex items-center gap-2">
        <!-- Search Input Group -->
        <form @onsubmit="BasicSubmit" class="flex-1 flex items-center relative w-full">
            <input @bind="ClientName" 
                   type="text" 
                   class="block w-full h-10 rounded-l-md bg-slate-900 border border-slate-700 border-r-0 text-white placeholder-slate-400 focus:ring-blue-500 focus:border-blue-500 sm:text-sm px-3 py-2 min-w-0"
                   placeholder="@(AppState.Loc("WEBFRONT_NAV_SEARCH"))" 
                   required />

            <!-- Advanced Search Toggle (Inside Input Group) -->
            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.AdvancedSearch}.{WebfrontPermission.Read}")">
                <button type="button" 
                        class="h-10 px-3 bg-slate-900 border-y border-slate-700 text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors border-l-0" 
                        @onclick="ToggleAdvancedSearch"
                        title="@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_TITLE"))">
                    <i class="ph ph-caret-down text-lg"></i>
                </button>
            </AuthorizeView>

            <button type="button" 
                    @onclick="BasicSubmit"
                    class="inline-flex items-center px-3 py-2 h-10 border border-slate-700 border-l-0 rounded-r-md bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-900 focus:ring-blue-500 transition-colors">
                <i class="ph ph-magnifying-glass text-lg"></i>
            </button>
        </form>
    </div>

    <!-- Advanced Search Dropdown -->
    <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.AdvancedSearch}.{WebfrontPermission.Read}")">
        @if (_showAdvanced)
        {
            <div class="origin-top-right absolute right-0 mt-2 w-96 rounded-md shadow-lg bg-slate-800 ring-1 ring-black/5 ring-opacity-5 focus:outline-none z-50 border border-slate-700">
                <div class="p-4">
                    <div class="flex items-center justify-between mb-4 border-b border-slate-700 pb-2">
                         <h3 class="text-sm font-bold text-slate-200 uppercase tracking-wider">
                            @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_TITLE"))
                        </h3>
                        <button type="button" @onclick="ToggleAdvancedSearch" class="text-slate-400 hover:text-white">
                            <i class="ph ph-x"></i>
                        </button>
                    </div>

                    <div class="space-y-4">
                        <div class="space-y-1">
                            <label for="searchType" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                @(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_FOR"))
                            </label>
                            <select id="searchType" 
                                    class="block w-full rounded-md bg-slate-900 border border-slate-700 text-white focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2" 
                                    @bind="SearchType">
                                <option value="client">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_SELECT_TYPE_PLAYERS"))</option>
                                <option value="chat">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_SELECT_TYPE_CHAT"))</option>
                            </select>
                        </div>

                        @if (SearchType == "client")
                        {
                            <ClientSearch />
                        }
                        else
                        {
                            <ChatSearch />
                        }
                    </div>
                </div>
            </div>
            
            <!-- Backdrop for mobile to close on click outside -->
            <div class="fixed inset-0 z-40 bg-transparent" @onclick="ToggleAdvancedSearch"></div>
        }
    </AuthorizeView>
</div>

@code {
    private bool _showAdvanced = false;

    private void ToggleAdvancedSearch()
    {
        _showAdvanced = !_showAdvanced;
    }
}
