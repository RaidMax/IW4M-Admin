@if (_isLoading)
{
    <div class="space-y-4" aria-busy="true">
        <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
        <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
    </div>
}
else if (_error != null)
{
    <div class="flex flex-col items-center justify-center gap-2 py-10 text-sm text-error text-center" role="alert">
        <i class="ph ph-warning-circle text-3xl"></i>
        <span>@_error</span>
    </div>
}
else if (_scoreboardInfo != null)
{
    <ScoreboardTable Model="_scoreboardInfo" DualColumnMode="true" ShowHeader="false" />
}
