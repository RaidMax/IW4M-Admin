
@using WebfrontCore.Components.Features.Servers.Models

@if (_isLoading)
{
    <div class="flex justify-center items-center py-12">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
    </div>
}
else if (_error != null)
{
    <div class="bg-error/10 border border-error/20 text-error p-4 rounded-lg text-sm text-center">
        @_error
    </div>
}
else if (_scoreboardInfo != null)
{
    <div class="mb-4 text-xl font-bold text-subtle">
        <ColorCode Value="@_scoreboardInfo.ServerName" />
    </div>
    <ScoreboardTable Model="_scoreboardInfo" DualColumnMode="true" ShowHeader="false" />
}
