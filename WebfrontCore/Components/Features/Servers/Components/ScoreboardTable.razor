@using EFClient = SharedLibraryCore.Database.Models.EFClient
@rendermode InteractiveServer

@if (ShowHeader)
{
    <div class="mb-6 flex items-center gap-3">
        <h4 class="text-2xl font-bold text-foreground">
            @(AppState.Loc("WEBFRONT_TITLE_SCOREBOARD"))
        </h4>
        <span class="text-muted text-lg">
            <ColorCode Value="@Model.ServerName"/>
        </span>
    </div>
}

@if (!Model.ClientInfo.Any())
{
    <div class="bg-surface rounded-lg p-12 text-center border border-line">
        <i class="ph ph-users text-4xl text-secondary mb-4"></i>
        <div class="text-muted text-lg">@(AppState.Loc("WEBFRONT_SCOREBOARD_NO_PLAYERS"))</div>
    </div>
}
else
{
    <!-- Team-based layout -->
    @if (HasTeamPlayers)
    {
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mb-4">
            <!-- Allies Column (normal order) -->
            <div class="bg-surface rounded-lg border @GetTeamBorderClass(EFClient.TeamType.Allies) shadow-sm overflow-hidden">
                <div class="px-4 py-2 bg-sky-900/20 border-b border-sky-500/30 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i class="ph ph-users text-sky-400"></i>
                        <span class="font-semibold @GetTeamColorClass(EFClient.TeamType.Allies)">@AppState.Loc("WEBFRONT_TEAM_ALLIES")</span>
                        <span class="text-xs text-muted">(@AlliesPlayers.Count())</span>
                    </div>
                    <span class="font-mono font-bold text-sky-400">@AlliesTeamScore</span>
                </div>
                @if (AlliesPlayers.Any())
                {
                    @RenderPlayerTable(AlliesPlayers)
                }
                else
                {
                    <div class="p-4 text-center text-muted text-sm">@AppState.Loc("WEBFRONT_SCOREBOARD_NO_PLAYERS")</div>
                }
            </div>

            <!-- Axis Column (reversed order for symmetry on desktop) -->
            <div class="bg-surface rounded-lg border @GetTeamBorderClass(EFClient.TeamType.Axis) shadow-sm overflow-hidden">
                <!-- Mobile: left-aligned, Desktop: right-aligned for symmetry -->
                <div class="px-4 py-2 bg-rose-900/20 border-b border-rose-500/30 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i class="ph ph-users text-rose-400"></i>
                        <span class="font-semibold @GetTeamColorClass(EFClient.TeamType.Axis)">@AppState.Loc("WEBFRONT_TEAM_AXIS")</span>
                        <span class="text-xs text-muted">(@AxisPlayers.Count())</span>
                    </div>
                    <span class="font-mono font-bold text-rose-400">@AxisTeamScore</span>
                </div>
                @if (AxisPlayers.Any())
                {
                    @RenderPlayerTable(AxisPlayers)
                }
                else
                {
                    <div class="p-4 text-center text-muted text-sm">@AppState.Loc("WEBFRONT_SCOREBOARD_NO_PLAYERS")</div>
                }
            </div>
        </div>
    }
    else if (UnknownPlayers.Any())
    {
        <!-- No team players but has Unknown players - show them without header -->
        <div class="bg-surface rounded-lg border border-line shadow-sm overflow-hidden mb-4">
            @RenderPlayerTable(UnknownPlayers)
        </div>
    }

    <!-- Unknown Players (no team assigned) -->
    @if (HasTeamPlayers && UnknownPlayers.Any())
    {
        <div class="bg-surface rounded-lg border border-line shadow-sm overflow-hidden mb-4">
            <div class="px-4 py-2 bg-surface-alt/50 border-b border-line flex items-center gap-2">
                <i class="ph ph-question text-muted"></i>
                <span class="font-semibold text-muted">@AppState.Loc("WEBFRONT_TEAM_UNASSIGNED")</span>
                <span class="text-xs text-muted">(@UnknownPlayers.Count())</span>
            </div>
            @RenderPlayerTable(UnknownPlayers)
        </div>
    }

    <!-- Spectators -->
    @if (SpectatorPlayers.Any())
    {
        <div class="bg-surface rounded-lg border border-secondary-700/50 shadow-sm overflow-hidden">
            <div class="px-4 py-2 bg-secondary-800/30 border-b border-secondary-700/50 flex items-center gap-2">
                <i class="ph ph-eye text-secondary-500"></i>
                <span class="font-semibold text-secondary-500">@AppState.Loc("WEBFRONT_TEAM_SPECTATORS")</span>
                <span class="text-xs text-muted">(@SpectatorPlayers.Count())</span>
            </div>
            @RenderPlayerTable(SpectatorPlayers, isSpectator: true)
        </div>
    }
}

@code {

    private RenderFragment RenderPlayerTable(IEnumerable<ClientScoreboardInfo> clients, bool isSpectator = false) => __builder =>
    {
        <div class="overflow-x-auto">
            <!-- Desktop Table -->
            <table class="w-full text-sm text-left hidden md:table">
                <thead class="text-[10px] text-muted uppercase bg-surface-alt/30 border-b border-line">
                <tr>
                    <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground" @onclick="@(() => Sort("ClientName"))">
                        <div class="pl-1">@AppState.Loc("WEBFRONT_TABLE_PLAYER")</div>
                    </th>
                    @if (!isSpectator)
                    {
                        <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-16" @onclick="@(() => Sort("Score"))">
                            <div class="flex items-center">Score @GetSortIndicator("Score")</div>
                        </th>
                        <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-14" @onclick="@(() => Sort("Kills"))">
                            <div class="flex items-center">K @GetSortIndicator("Kills")</div>
                        </th>
                        <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-14" @onclick="@(() => Sort("Deaths"))">
                            <div class="flex items-center">D @GetSortIndicator("Deaths")</div>
                        </th>
                        <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-16" @onclick="@(() => Sort("Kdr"))">
                            <div class="flex items-center">K/D @GetSortIndicator("Kdr")</div>
                        </th>
                        <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-14" @onclick="@(() => Sort("ZScore"))">
                            <div class="flex items-center">Z @GetSortIndicator("ZScore")</div>
                        </th>
                    }

                    <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground text-right w-16"
                        @onclick="@(() => Sort("Ping"))">
                        <div class="flex items-center justify-end">Ping @GetSortIndicator("Ping")</div>
                    </th>
                </tr>
                </thead>
                <tbody class="divide-y divide-line/50">

                @{
                    var clientScoreboardInfos = clients as ClientScoreboardInfo[] ?? clients.ToArray();
                }
                @foreach (var client in clientScoreboardInfos)
                {
                    <tr class="hover:bg-surface-hover/30 transition-colors">
                        <td class="px-3 py-2 truncate">
                            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                                <Authorized>
                                    <a href="/client/@client.ClientId"
                                       class="font-medium hover:text-primary transition-colors @AppState.GetLevelColorClass(client.Level)">
                                        <ColorCode Value="@client.ClientName"/>
                                    </a>
                                </Authorized>
                                <NotAuthorized>
                                    <a href="/client/@client.ClientId"
                                       class="font-medium text-foreground hover:text-primary transition-colors">
                                        <ColorCode Value="@client.ClientName"/>
                                    </a>
                                </NotAuthorized>
                            </AuthorizeView>
                            @if (client.ZScore is not null and not 0)
                            {
                                <i class="ph-fill ph-lightning text-accent ml-1 text-xs" title="Ranked"></i>
                            }
                        </td>
                        @if (!isSpectator)
                        {
                            <td class="px-3 py-2 text-subtle font-mono text-xs">@client.Score</td>
                            <td class="px-3 py-2 text-success font-mono text-xs">@(client.Kills ?? 0)</td>
                            <td class="px-3 py-2 text-error font-mono text-xs">@(client.Deaths ?? 0)</td>
                            <td class="px-3 py-2 text-subtle font-mono text-xs">@Math.Round(client.Kdr ?? 0, 2)</td>
                            <td class="px-3 py-2 text-subtle font-mono text-xs">
                                @if (client.ZScore is not null and not 0)
                                {
                                    <span class="text-accent">@Math.Round(client.ZScore.Value, 1)</span>
                                }
                                else
                                {
                                    <span class="text-muted">--</span>
                                }
                            </td>
                        }

                        <td class="px-3 py-2 text-right">
                            <span
                                class="@(client.Ping < 100 ? "text-success" : client.Ping < 200 ? "text-warning" : "text-error") font-mono text-xs">
                                @client.Ping
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <!-- Mobile Grid (like ClientActivity) -->
            <div class="md:hidden">
                <!-- Mobile Header -->
                <div
                    class="grid @(isSpectator ? "grid-cols-[1fr_40px]" : "grid-cols-[1fr_repeat(4,minmax(30px,40px))]") gap-1 px-3 py-2 border-b border-line text-[10px] font-bold text-muted uppercase tracking-wider select-none bg-surface-alt/50">
                    <div class="pl-1">Player</div>
                    @if (!isSpectator)
                    {
                        <div class="text-center" title="Score">Scr</div>
                        <div class="text-center" title="Kills">K</div>
                        <div class="text-center" title="Deaths">D</div>
                    }
                    <div class="text-center">Ping</div>
                </div>

                <!-- Mobile Rows -->
                <div class="p-1 space-y-0.5">
                    @foreach (var client in clientScoreboardInfos)
                    {
                        <div
                            class="grid @(isSpectator ? "grid-cols-[1fr_40px]" : "grid-cols-[1fr_repeat(4,minmax(30px,40px))]") gap-1 items-center px-2 rounded text-[11px] font-mono hover:bg-surface-hover/80 transition-colors">
                            <!-- Player -->
                            <div class="flex items-center min-w-0 pr-2">
                                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                                    <Authorized>
                                        <a href="/client/@client.ClientId"
                                           class="font-bold truncate hover:text-foreground transition-colors @AppState.GetLevelColorClass(client.Level)">
                                            <ColorCode Value="@client.ClientName"/>
                                        </a>
                                    </Authorized>
                                    <NotAuthorized>
                                        <a href="/client/@client.ClientId"
                                           class="font-bold text-muted truncate hover:text-foreground transition-colors">
                                            <ColorCode Value="@client.ClientName"/>
                                        </a>
                                    </NotAuthorized>
                                </AuthorizeView>
                                @if (client.ZScore is not null and not 0)
                                {
                                    <i class="ph-fill ph-lightning text-accent ml-1.5 text-xs"></i>
                                }
                            </div>

                            <!-- Stats -->
                            @if (!isSpectator)
                            {
                                <div class="text-center text-muted">@client.Score</div>
                                <div class="text-center text-success/80 font-bold">@(client.Kills ?? 0)</div>
                                <div class="text-center text-error/80 font-bold">@(client.Deaths ?? 0)</div>
                            }
                            <div class="text-center text-muted">@client.Ping</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    };


}
