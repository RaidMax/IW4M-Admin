@using EFClient = SharedLibraryCore.Database.Models.EFClient
@rendermode InteractiveServer

@if (ShowHeader)
{
    <div class="flex flex-wrap items-end gap-x-3 gap-y-1 mb-4">
        <h2 class="text-lg font-bold tracking-tight text-foreground">
            @(AppState.Loc("WEBFRONT_TITLE_SCOREBOARD"))
        </h2>
        <span class="text-sm text-muted">
            <ColorCode Value="@Model.ServerName"/>
        </span>
    </div>
}

@if (!Model.ClientInfo.Any())
{
    <section class="rounded-xl bg-surface border border-line overflow-hidden">
        <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm">
            <i class="ph ph-users text-3xl text-secondary"></i>
            <span>@(AppState.Loc("WEBFRONT_SCOREBOARD_NO_PLAYERS"))</span>
        </div>
    </section>
}
else
{
    <div class="space-y-4">
        <!-- Team-based layout -->
        @if (HasTeamPlayers)
        {
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
                <!-- Allies -->
                <section class="rounded-xl bg-surface border @GetTeamBorderClass(EFClient.TeamType.Allies) overflow-hidden">
                    <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                        <i class="ph-fill ph-shield-check text-base @GetTeamColorClass(EFClient.TeamType.Allies)"></i>
                        <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider @GetTeamColorClass(EFClient.TeamType.Allies)">
                            @AppState.Loc("WEBFRONT_TEAM_ALLIES")
                            <span class="font-mono tabular-nums text-muted ml-1">@AlliesPlayers.Count()</span>
                        </h2>
                        <span class="font-mono tabular-nums text-sm font-bold @GetTeamColorClass(EFClient.TeamType.Allies)">@AlliesTeamScore</span>
                    </div>
                    @if (AlliesPlayers.Any())
                    {
                        @RenderPlayerTable(AlliesPlayers)
                    }
                    else
                    {
                        <div class="px-4 py-6 text-center text-muted text-sm">@AppState.Loc("WEBFRONT_SCOREBOARD_NO_PLAYERS")</div>
                    }
                </section>

                <!-- Axis -->
                <section class="rounded-xl bg-surface border @GetTeamBorderClass(EFClient.TeamType.Axis) overflow-hidden">
                    <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                        <i class="ph-fill ph-shield-warning text-base @GetTeamColorClass(EFClient.TeamType.Axis)"></i>
                        <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider @GetTeamColorClass(EFClient.TeamType.Axis)">
                            @AppState.Loc("WEBFRONT_TEAM_AXIS")
                            <span class="font-mono tabular-nums text-muted ml-1">@AxisPlayers.Count()</span>
                        </h2>
                        <span class="font-mono tabular-nums text-sm font-bold @GetTeamColorClass(EFClient.TeamType.Axis)">@AxisTeamScore</span>
                    </div>
                    @if (AxisPlayers.Any())
                    {
                        @RenderPlayerTable(AxisPlayers)
                    }
                    else
                    {
                        <div class="px-4 py-6 text-center text-muted text-sm">@AppState.Loc("WEBFRONT_SCOREBOARD_NO_PLAYERS")</div>
                    }
                </section>
            </div>
        }
        else if (UnknownPlayers.Any())
        {
            <!-- No team players but has Unknown players - show them without header -->
            <section class="rounded-xl bg-surface border border-line overflow-hidden">
                @RenderPlayerTable(UnknownPlayers)
            </section>
        }

        <!-- Unknown players (no team assigned) -->
        @if (HasTeamPlayers && UnknownPlayers.Any())
        {
            <section class="rounded-xl bg-surface border border-line overflow-hidden">
                <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                    <i class="ph ph-question text-base text-muted"></i>
                    <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider text-muted">
                        @AppState.Loc("WEBFRONT_TEAM_UNASSIGNED")
                        <span class="font-mono tabular-nums ml-1">@UnknownPlayers.Count()</span>
                    </h2>
                </div>
                @RenderPlayerTable(UnknownPlayers)
            </section>
        }

        <!-- Spectators -->
        @if (SpectatorPlayers.Any())
        {
            <section class="rounded-xl bg-surface border border-line overflow-hidden">
                <div class="flex items-center gap-3 px-4 py-2.5 border-b border-line">
                    <i class="ph ph-eye text-base @GetTeamColorClass(EFClient.TeamType.Spectator)"></i>
                    <h2 class="flex-1 text-[11px] font-semibold uppercase tracking-wider @GetTeamColorClass(EFClient.TeamType.Spectator)">
                        @AppState.Loc("WEBFRONT_TEAM_SPECTATORS")
                        <span class="font-mono tabular-nums text-muted ml-1">@SpectatorPlayers.Count()</span>
                    </h2>
                </div>
                @RenderPlayerTable(SpectatorPlayers, isSpectator: true)
            </section>
        }
    </div>
}

@code {

    private RenderFragment RenderPlayerTable(IEnumerable<ClientScoreboardInfo> clients, bool isSpectator = false) => __builder =>
    {
        var clientScoreboardInfos = clients as ClientScoreboardInfo[] ?? clients.ToArray();

        <!-- Desktop table -->
        <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                <tr class="text-[10px] font-semibold uppercase tracking-wider text-muted select-none">
                    <th class="text-left px-4 py-2.5 border-b border-line cursor-pointer hover:text-foreground transition-colors" @onclick="@(() => Sort("ClientName"))">
                        <span class="inline-flex items-center">@AppState.Loc("WEBFRONT_TABLE_PLAYER") @GetSortIndicator("ClientName")</span>
                    </th>
                    @if (!isSpectator)
                    {
                        <th class="text-right px-4 py-2.5 border-b border-line w-20 cursor-pointer hover:text-foreground transition-colors" @onclick="@(() => Sort("Score"))">
                            <span class="inline-flex items-center justify-end">@AppState.LocOr("WEBFRONT_TABLE_SCORE", "Score") @GetSortIndicator("Score")</span>
                        </th>
                        <th class="text-right px-4 py-2.5 border-b border-line w-16 cursor-pointer hover:text-foreground transition-colors" @onclick="@(() => Sort("Kills"))">
                            <span class="inline-flex items-center justify-end">@AppState.LocOr("WEBFRONT_TABLE_KILLS_SHORT", "K") @GetSortIndicator("Kills")</span>
                        </th>
                        <th class="text-right px-4 py-2.5 border-b border-line w-16 cursor-pointer hover:text-foreground transition-colors" @onclick="@(() => Sort("Deaths"))">
                            <span class="inline-flex items-center justify-end">@AppState.LocOr("WEBFRONT_TABLE_DEATHS_SHORT", "D") @GetSortIndicator("Deaths")</span>
                        </th>
                        <th class="text-right px-4 py-2.5 border-b border-line w-20 cursor-pointer hover:text-foreground transition-colors" @onclick="@(() => Sort("Kdr"))">
                            <span class="inline-flex items-center justify-end">@AppState.LocOr("WEBFRONT_TABLE_KDR_SHORT", "K/D") @GetSortIndicator("Kdr")</span>
                        </th>
                        <th class="text-right px-4 py-2.5 border-b border-line w-16 cursor-pointer hover:text-foreground transition-colors" @onclick="@(() => Sort("ZScore"))">
                            <span class="inline-flex items-center justify-end">@AppState.LocOr("WEBFRONT_TABLE_RATING_SHORT", "Z") @GetSortIndicator("ZScore")</span>
                        </th>
                    }
                    <th class="text-right px-4 py-2.5 border-b border-line w-20 cursor-pointer hover:text-foreground transition-colors" @onclick="@(() => Sort("Ping"))">
                        <span class="inline-flex items-center justify-end">@AppState.LocOr("WEBFRONT_TABLE_PING", "Ping") @GetSortIndicator("Ping")</span>
                    </th>
                </tr>
                </thead>
                <tbody class="divide-y divide-line">
                @foreach (var client in clientScoreboardInfos)
                {
                    <tr class="hover:bg-surface-hover transition-colors">
                        <td class="px-4 py-2.5 align-middle">
                            <div class="flex items-center gap-1.5 min-w-0">
                                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                                    <Authorized>
                                        <a href="/client/@client.ClientId"
                                           class="font-semibold truncate hover:text-primary transition-colors @AppState.GetLevelColorClass(client.Level)">
                                            <ColorCode Value="@client.ClientName"/>
                                        </a>
                                    </Authorized>
                                    <NotAuthorized>
                                        <a href="/client/@client.ClientId"
                                           class="font-semibold truncate text-foreground hover:text-primary transition-colors">
                                            <ColorCode Value="@client.ClientName"/>
                                        </a>
                                    </NotAuthorized>
                                </AuthorizeView>
                                @if (client.ZScore is not null and not 0)
                                {
                                    <i class="ph-fill ph-lightning text-accent text-xs shrink-0" title="@AppState.LocOr("WEBFRONT_SCOREBOARD_RANKED", "Ranked")"></i>
                                }
                            </div>
                        </td>
                        @if (!isSpectator)
                        {
                            <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums text-foreground">@client.Score</td>
                            <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums text-success">@(client.Kills ?? 0)</td>
                            <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums text-error">@(client.Deaths ?? 0)</td>
                            <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums text-subtle">@Math.Round(client.Kdr ?? 0, 2)</td>
                            <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums">
                                @if (client.ZScore is not null and not 0)
                                {
                                    <span class="text-accent">@Math.Round(client.ZScore.Value, 1)</span>
                                }
                                else
                                {
                                    <span class="text-muted">--</span>
                                }
                            </td>
                        }
                        <td class="px-4 py-2.5 align-middle text-right font-mono tabular-nums @(client.Ping < 100 ? "text-success" : client.Ping < 200 ? "text-warning" : "text-error")">
                            @client.Ping
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Mobile grid -->
        <div class="md:hidden">
            <div class="grid @(isSpectator ? "grid-cols-[minmax(0,1fr)_3rem]" : "grid-cols-[minmax(0,1fr)_repeat(4,2.75rem)]") gap-1 px-4 py-2 border-b border-line text-[10px] font-semibold uppercase tracking-wider text-muted select-none">
                <div>@AppState.Loc("WEBFRONT_TABLE_PLAYER")</div>
                @if (!isSpectator)
                {
                    <div class="text-right" title="@AppState.LocOr("WEBFRONT_TABLE_SCORE", "Score")">@AppState.LocOr("WEBFRONT_TABLE_SCORE_SHORT", "Scr")</div>
                    <div class="text-right" title="@AppState.Loc("WEBFRONT_STATS_KILLS")">@AppState.LocOr("WEBFRONT_TABLE_KILLS_SHORT", "K")</div>
                    <div class="text-right" title="@AppState.Loc("WEBFRONT_STATS_DEATHS")">@AppState.LocOr("WEBFRONT_TABLE_DEATHS_SHORT", "D")</div>
                }
                <div class="text-right">@AppState.LocOr("WEBFRONT_TABLE_PING", "Ping")</div>
            </div>

            <div class="divide-y divide-line">
                @foreach (var client in clientScoreboardInfos)
                {
                    <div class="grid @(isSpectator ? "grid-cols-[minmax(0,1fr)_3rem]" : "grid-cols-[minmax(0,1fr)_repeat(4,2.75rem)]") gap-1 items-center px-4 py-2 text-sm font-mono tabular-nums hover:bg-surface-hover transition-colors">
                        <!-- Player -->
                        <div class="flex items-center gap-1.5 min-w-0 pr-2">
                            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                                <Authorized>
                                    <a href="/client/@client.ClientId"
                                       class="font-sans font-semibold truncate hover:text-primary transition-colors @AppState.GetLevelColorClass(client.Level)">
                                        <ColorCode Value="@client.ClientName"/>
                                    </a>
                                </Authorized>
                                <NotAuthorized>
                                    <a href="/client/@client.ClientId"
                                       class="font-sans font-semibold truncate text-foreground hover:text-primary transition-colors">
                                        <ColorCode Value="@client.ClientName"/>
                                    </a>
                                </NotAuthorized>
                            </AuthorizeView>
                            @if (client.ZScore is not null and not 0)
                            {
                                <i class="ph-fill ph-lightning text-accent text-xs shrink-0"></i>
                            }
                        </div>

                        <!-- Stats -->
                        @if (!isSpectator)
                        {
                            <div class="text-right text-foreground">@client.Score</div>
                            <div class="text-right text-success">@(client.Kills ?? 0)</div>
                            <div class="text-right text-error">@(client.Deaths ?? 0)</div>
                        }
                        <div class="text-right @(client.Ping < 100 ? "text-success" : client.Ping < 200 ? "text-warning" : "text-error")">@client.Ping</div>
                    </div>
                }
            </div>
        </div>
    };

}
