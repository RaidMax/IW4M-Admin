@using EFClient = SharedLibraryCore.Database.Models.EFClient
@rendermode InteractiveServer

@if (ShowHeader)
{
    <div class="mb-6 flex items-center gap-3">
        <h4 class="text-2xl font-bold text-foreground">
            @(AppState.Loc("WEBFRONT_TITLE_SCOREBOARD"))
        </h4>
        <span class="text-muted text-lg">
            <ColorCode Value="@Model.ServerName"/>
        </span>
    </div>
}

@if (!Model.ClientInfo.Any())
{
    <div class="bg-surface rounded-lg p-12 text-center border border-line">
        <i class="ph ph-users text-4xl text-secondary mb-4"></i>
        <div class="text-muted text-lg">@(AppState.Loc("WEBFRONT_SCOREBOARD_NO_PLAYERS"))</div>
    </div>
}
else
{
    <!-- Team-based layout -->
    @if (HasTeamPlayers)
    {
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mb-4">
            <!-- Allies Column (normal order) -->
            <div class="bg-surface rounded-lg border @GetTeamBorderClass(EFClient.TeamType.Allies) shadow-sm overflow-hidden">
                <div class="px-4 py-2 bg-sky-900/20 border-b border-sky-500/30 flex items-center gap-2">
                    <i class="ph ph-users text-sky-400"></i>
                    <span class="font-semibold @GetTeamColorClass(EFClient.TeamType.Allies)">Allies</span>
                    <span class="text-xs text-muted">(@AlliesPlayers.Count())</span>
                </div>
                @if (AlliesPlayers.Any())
                {
                    @RenderPlayerTable(AlliesPlayers, reversed: false)
                }
                else
                {
                    <div class="p-4 text-center text-muted text-sm">No players</div>
                }
            </div>

            <!-- Axis Column (reversed order for symmetry) -->
            <div class="bg-surface rounded-lg border @GetTeamBorderClass(EFClient.TeamType.Axis) shadow-sm overflow-hidden">
                <div class="px-4 py-2 bg-rose-900/20 border-b border-rose-500/30 flex items-center justify-end gap-2">
                    <span class="text-xs text-muted">(@AxisPlayers.Count())</span>
                    <span class="font-semibold @GetTeamColorClass(EFClient.TeamType.Axis)">Axis</span>
                    <i class="ph ph-users text-rose-400"></i>
                </div>
                @if (AxisPlayers.Any())
                {
                    @RenderPlayerTable(AxisPlayers, reversed: true)
                }
                else
                {
                    <div class="p-4 text-center text-muted text-sm">No players</div>
                }
            </div>
        </div>
    }
    else if (UnknownPlayers.Any())
    {
        <!-- No team players but has Unknown players - show them without header -->
        <div class="bg-surface rounded-lg border border-line shadow-sm overflow-hidden mb-4">
            @RenderPlayerTable(UnknownPlayers, reversed: false)
        </div>
    }

    <!-- Unknown Players (no team assigned) -->
    @if (HasTeamPlayers && UnknownPlayers.Any())
    {
        <div class="bg-surface rounded-lg border border-line shadow-sm overflow-hidden mb-4">
            <div class="px-4 py-2 bg-surface-alt/50 border-b border-line flex items-center gap-2">
                <i class="ph ph-question text-muted"></i>
                <span class="font-semibold text-muted">Unassigned</span>
                <span class="text-xs text-muted">(@UnknownPlayers.Count())</span>
            </div>
            @RenderPlayerTable(UnknownPlayers, reversed: false)
        </div>
    }

    <!-- Spectators -->
    @if (SpectatorPlayers.Any())
    {
        <div class="bg-surface rounded-lg border border-secondary-700/50 shadow-sm overflow-hidden">
            <div class="px-4 py-2 bg-secondary-800/30 border-b border-secondary-700/50 flex items-center gap-2">
                <i class="ph ph-eye text-secondary-500"></i>
                <span class="font-semibold text-secondary-500">Spectators</span>
                <span class="text-xs text-muted">(@SpectatorPlayers.Count())</span>
            </div>
            @RenderPlayerTable(SpectatorPlayers, reversed: false, isSpectator: true)
        </div>
    }
}

@code {

    private RenderFragment RenderPlayerTable(IEnumerable<ClientScoreboardInfo> clients, bool reversed = false, bool isSpectator = false) => __builder =>
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-[10px] text-muted uppercase bg-surface-alt/30 border-b border-line hidden md:table-header-group">
                <tr>
                    @if (reversed)
                    {
                        <!-- Reversed: Ping, K/D, D, K, Score, Name -->
                        <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-16" @onclick="@(() => Sort("Ping"))">
                            <div class="flex items-center">Ping @GetSortIndicator("Ping")</div>
                        </th>
                        @if (!isSpectator)
                        {
                            <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-16"
                                @onclick="@(() => Sort("Kdr"))">
                                <div class="flex items-center">K/D @GetSortIndicator("Kdr")</div>
                            </th>
                            <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-14"
                                @onclick="@(() => Sort("Deaths"))">
                                <div class="flex items-center">D @GetSortIndicator("Deaths")</div>
                            </th>
                            <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-14"
                                @onclick="@(() => Sort("Kills"))">
                                <div class="flex items-center">K @GetSortIndicator("Kills")</div>
                            </th>
                            <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-16"
                                @onclick="@(() => Sort("Score"))">
                                <div class="flex items-center">Score @GetSortIndicator("Score")</div>
                            </th>
                        }

                        <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground text-right"
                            @onclick="@(() => Sort("ClientName"))">
                            <div class="flex items-center justify-end">Player @GetSortIndicator("ClientName")</div>
                        </th>
                    }
                    else
                    {
                        <!-- Normal: Name, Score, K, D, K/D, Ping -->
                        <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground" @onclick="@(() => Sort("ClientName"))">
                            <div class="flex items-center">Player @GetSortIndicator("ClientName")</div>
                        </th>
                        @if (!isSpectator)
                        {
                            <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-16" @onclick="@(() => Sort("Score"))">
                                <div class="flex items-center">Score @GetSortIndicator("Score")</div>
                            </th>
                            <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-14" @onclick="@(() => Sort("Kills"))">
                                <div class="flex items-center">K @GetSortIndicator("Kills")</div>
                            </th>
                            <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-14" @onclick="@(() => Sort("Deaths"))">
                                <div class="flex items-center">D @GetSortIndicator("Deaths")</div>
                            </th>
                            <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground w-16" @onclick="@(() => Sort("Kdr"))">
                                <div class="flex items-center">K/D @GetSortIndicator("Kdr")</div>
                            </th>
                        }

                        <th class="px-3 py-2 font-medium cursor-pointer hover:text-foreground text-right w-16"
                            @onclick="@(() => Sort("Ping"))">
                            <div class="flex items-center justify-end">Ping @GetSortIndicator("Ping")</div>
                        </th>
                    }
                </tr>
                </thead>
                <tbody class="divide-y divide-line/50">
                @foreach (var client in clients)
                {
                    <!-- Desktop row -->
                    <tr class="hidden md:table-row hover:bg-surface-hover/30 transition-colors">
                        @if (reversed)
                        {
                            <!-- Reversed order -->
                            <td class="px-3 py-2">
                                <span
                                    class="@(client.Ping < 100 ? "text-success" : client.Ping < 200 ? "text-warning" : "text-error") font-mono text-xs">
                                    @client.Ping
                                </span>
                            </td>
                            @if (!isSpectator)
                            {
                                <td class="px-3 py-2 text-subtle font-mono text-xs">@Math.Round(client.Kdr ?? 0, 2)</td>
                                <td class="px-3 py-2 text-error font-mono text-xs">@(client.Deaths ?? 0)</td>
                                <td class="px-3 py-2 text-success font-mono text-xs">@(client.Kills ?? 0)</td>
                                <td class="px-3 py-2 text-subtle font-mono text-xs">@client.Score</td>
                            }

                            <td class="px-3 py-2 truncate text-right">
                                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                                    <Authorized>
                                        <a href="/client/@client.ClientId"
                                           class="font-medium hover:text-primary transition-colors @AppState.GetLevelColorClass(client.Level)">
                                            <ColorCode Value="@client.ClientName"/>
                                        </a>
                                    </Authorized>
                                    <NotAuthorized>
                                        <a href="/client/@client.ClientId"
                                           class="font-medium text-foreground hover:text-primary transition-colors">
                                            <ColorCode Value="@client.ClientName"/>
                                        </a>
                                    </NotAuthorized>
                                </AuthorizeView>
                                @if (client.ZScore is not null and not 0)
                                {
                                    <i class="ph-fill ph-lightning text-accent ml-1 text-xs" title="Ranked"></i>
                                }
                            </td>
                        }
                        else
                        {
                            <!-- Normal order -->
                            <td class="px-3 py-2 truncate">
                                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                                    <Authorized>
                                        <a href="/client/@client.ClientId"
                                           class="font-medium hover:text-primary transition-colors @AppState.GetLevelColorClass(client.Level)">
                                            <ColorCode Value="@client.ClientName"/>
                                        </a>
                                    </Authorized>
                                    <NotAuthorized>
                                        <a href="/client/@client.ClientId"
                                           class="font-medium text-foreground hover:text-primary transition-colors">
                                            <ColorCode Value="@client.ClientName"/>
                                        </a>
                                    </NotAuthorized>
                                </AuthorizeView>
                                @if (client.ZScore is not null and not 0)
                                {
                                    <i class="ph-fill ph-lightning text-accent ml-1 text-xs" title="Ranked"></i>
                                }
                            </td>
                            @if (!isSpectator)
                            {
                                <td class="px-3 py-2 text-subtle font-mono text-xs">@client.Score</td>
                                <td class="px-3 py-2 text-success font-mono text-xs">@(client.Kills ?? 0)</td>
                                <td class="px-3 py-2 text-error font-mono text-xs">@(client.Deaths ?? 0)</td>
                                <td class="px-3 py-2 text-subtle font-mono text-xs">@Math.Round(client.Kdr ?? 0, 2)</td>
                            }

                            <td class="px-3 py-2 text-right">
                                <span
                                    class="@(client.Ping < 100 ? "text-success" : client.Ping < 200 ? "text-warning" : "text-error") font-mono text-xs">
                                    @client.Ping
                                </span>
                            </td>
                        }
                    </tr>

                    <!-- Mobile row -->
                    <tr class="md:hidden">
                        <td colspan="6" class="p-0">
                            <div class="flex items-center justify-between p-3">
                                <div class="flex items-center gap-2 min-w-0">
                                    <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ClientLevel}.{WebfrontPermission.Read}")">
                                        <Authorized>
                                            <a href="/client/@client.ClientId"
                                               class="font-medium hover:text-primary transition-colors truncate @AppState.GetLevelColorClass(client.Level)">
                                                <ColorCode Value="@client.ClientName"/>
                                            </a>
                                        </Authorized>
                                        <NotAuthorized>
                                            <a href="/client/@client.ClientId"
                                               class="font-medium text-foreground hover:text-primary truncate">
                                                <ColorCode Value="@client.ClientName"/>
                                            </a>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                    @if (client.ZScore is not null and not 0)
                                    {
                                        <i class="ph-fill ph-lightning text-accent text-xs"></i>
                                    }
                                </div>
                                <div class="flex items-center gap-3 text-xs shrink-0">
                                    @if (!isSpectator)
                                    {
                                        <span><span class="text-success">@(client.Kills ?? 0)</span>/<span
                                                class="text-error">@(client.Deaths ?? 0)</span></span>
                                    }
                                    <span
                                        class="@(client.Ping < 100 ? "text-success" : client.Ping < 200 ? "text-warning" : "text-error") font-mono">
                                        @client.Ping ms
                                    </span>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    };

}
