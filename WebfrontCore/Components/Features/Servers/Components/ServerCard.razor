
@implements IDisposable


<div class="relative overflow-hidden rounded-lg bg-surface-alt border border-line shadow-lg transition-all duration-300 hover:shadow-2xl hover:border-line-hover group flex flex-col">
    
    <!-- Compact Header -->
    <div class="relative h-10 px-4 flex items-center justify-between bg-surface border-b border-line z-10" id="server_header_@Model.Id">
        
        <!-- Left: Basic Info -->
        <div class="flex items-center space-x-3 overflow-hidden">
             <span class="px-1.5 py-0.5 rounded bg-surface text-[10px] font-mono text-muted border border-line uppercase tracking-widest shrink-0">
                @Model.Game
            </span>
            <h3 class="text-sm font-bold text-foreground truncate max-w-[200px]">
                <ColorCode Value="@Model.Name"/>
            </h3>
            
             <!-- Actions (Always Visible) -->
            <div class="flex items-center space-x-1">
                <a href="@Model.ConnectProtocolUrl" 
                   class="flex items-center justify-center w-6 h-6 rounded bg-surface hover:bg-surface-hover text-foreground transition-colors"
                   title="@(AppState.Loc("WEBFRONT_HOME_JOIN_DESC"))">
                    <i class="ph-fill ph-play text-xs"></i>
                </a>
                
                <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.AdminMenu}.{WebfrontPermission.Write}")">
                    <button @onclick:preventDefault @onclick="() => OnChat.InvokeAsync(Model.Endpoint)" 
                            class="flex items-center justify-center w-6 h-6 rounded bg-surface text-muted hover:bg-surface-hover hover:text-foreground transition-colors">
                        <i class="ph-bold ph-chat-circle-text text-xs"></i>
                    </button>
                </AuthorizeView>
                
                <a href="scoreboard/@Model.Id" 
                   class="flex items-center justify-center w-6 h-6 rounded bg-surface text-muted hover:bg-surface-hover hover:text-foreground transition-colors"
                   title="@(AppState.Loc("WEBFRONT_TITLE_SCOREBOARD"))">
                    <i class="ph-bold ph-list text-xs"></i>
                </a>
            </div>
        </div>

        <!-- Right: Map & Stats -->
        <div class="flex items-center space-x-4 text-xs font-medium text-subtle">
             <div class="hidden md:flex items-center space-x-1">
                <span class="text-foreground">@Model.Map</span>
                @if (!string.IsNullOrEmpty(Model.GameType) && Model.GameType.Length > 1)
                {
                    <span class="text-muted">&bull;</span>
                    <span class="text-subtle">@Model.GameType</span>
                }
            </div>

            <div class="flex items-center space-x-3 pl-3 border-l border-line">
                 @if (Model.LobbyZScore != null)
                {
                    <div class="flex items-center space-x-0.5 " title="@(AppState.Loc("WEBFRONT_HOME_RATING_DESC"))">
                        <span>@(Model.LobbyZScore ?? 0)</span>
                        <i class="ph-fill ph-lightning text-accent"></i>
                    </div>
                }
                
                <!-- Player Count Badge -->
                <div class="px-2 py-0.5 rounded-full bg-surface text-foreground font-mono text-xs border border-line shadow-sm">
                    <span class="font-bold">@Model.ClientCount</span>
                    <span class="opacity-50 mx-0.5">/</span>
                    <span class="opacity-75">@(Model.MaxClients - Model.PrivateClientSlots)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Body: Player List -->
    <div class="relative z-10 flex-1 flex @(Model.ClientCount == 0 ? "min-h-[60px] items-center" : "min-h-[120px]") bg-surface-alt">
        <div id="server_clientactivity_@Model.Id" class="w-full">
             <ClientActivity Model="@Model"/>
        </div>
    </div>

    <!-- Separator -->
    <div class="h-px w-full bg-line"></div>

    <!-- Bottom Graph (Overlaid slightly or bottom stacked) -->
    <div class="server-history relative h-[50px] w-full mt-auto mb-0 bg-surface-alt">
        <div class="server-history-row w-full h-full" id="server_history_@Model.Id">
             <!-- Canvas managed by JS -->
            <canvas id="server_history_canvas_@Model.Id" class="w-full h-full block"></canvas>
        </div>
    </div>
</div>
