@rendermode InteractiveServer
@using Data.Models
@inject IWebfrontDataService DataService
@inject IActionService ActionService

@if (_servers != null)
{
    <div class="space-y-4">
        @foreach (var serverInfo in _servers)
        {
            <ServerCard Model="serverInfo" OnChat="OpenChat"/>
        }
    </div>
}
else
{
    <p>Loading servers...</p>
}

@code {
    [Parameter] public Reference.Game? Game { get; set; }

    private List<ServerInfo>? _servers;
    private Reference.Game? _lastGame;

    protected override async Task OnParametersSetAsync()
    {
        // Only reload if game filter changed
        if (_servers == null || _lastGame != Game)
        {
            _lastGame = Game;
            try
            {
                _servers = await DataService.GetServersAsync(Game);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ServerList] ERROR in OnParametersSetAsync: {ex}");
            }
        }
    }

    private void OpenChat(string serverId)
    {
        ActionService.OpenAction("Chat", serverId: serverId, targetId: null, meta: null);
    }

}
