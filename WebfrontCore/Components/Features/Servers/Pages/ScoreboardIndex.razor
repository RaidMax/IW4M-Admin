@page "/Server/Scoreboard"
@page "/scoreboard"
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_TITLE_SCOREBOARD") | @AppState.WebfrontBranding</PageTitle>

@if (Loading)
{
    <div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5" aria-busy="true">
        <div class="h-8 w-48 max-w-full rounded bg-surface animate-pulse"></div>
        <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
    </div>
}
else if (NoServers)
{
    <div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">
        <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
            <div class="min-w-0">
                <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@AppState.Loc("WEBFRONT_TITLE_SCOREBOARD")</h1>
            </div>
        </div>

        <section class="rounded-xl bg-surface border border-line overflow-hidden" role="alert">
            <div class="flex flex-col items-center justify-center gap-2 py-10 text-muted text-sm text-center px-4">
                <i class="ph ph-hard-drives text-3xl text-secondary"></i>
                <span class="font-semibold text-foreground">@AppState.LocOr("WEBFRONT_SCOREBOARD_NO_SERVERS_TITLE", "No servers")</span>
                <span>@AppState.LocOr("WEBFRONT_SCOREBOARD_NO_SERVERS", "No servers are currently available.")</span>
            </div>
        </section>
    </div>
}
