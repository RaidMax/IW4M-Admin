@page "/Server/{Id}/Scoreboard"
@page "/scoreboard/{Id}"
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_TITLE_SCOREBOARD") | @AppState.WebfrontBranding</PageTitle>

<div class="p-4 md:p-6 xl:p-8 max-w-[1680px] mx-auto space-y-5">

    <!-- Heading + server tabs -->
    <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">@AppState.Loc("WEBFRONT_TITLE_SCOREBOARD")</h1>
            @if (ScoreboardModel != null)
            {
                <p class="text-sm text-muted mt-0.5 flex flex-wrap items-center gap-x-1.5">
                    <ColorCode Value="@ScoreboardModel.ServerName"/>
                    @if (!string.IsNullOrEmpty(ScoreboardModel.MapName))
                    {
                        <span class="text-muted/60">&middot;</span>
                        <span>@ScoreboardModel.MapName</span>
                    }
                </p>
            }
        </div>

        @if (ContextItems?.Items?.Any() == true)
        {
            <nav class="ml-auto max-w-full overflow-x-auto" aria-label="@ContextItems.MenuTitle">
                <div class="inline-flex gap-1 p-1 rounded-lg bg-surface border border-line">
                    @foreach (var item in ContextItems.Items)
                    {
                        <a href="@item.Reference"
                           class="px-3 py-1.5 rounded-md text-sm font-medium whitespace-nowrap transition-colors @(item.IsActive ? "bg-primary text-background font-semibold shadow-sm" : "text-subtle hover:text-foreground hover:bg-surface-hover")">
                            @(item.Title?.StripColors())
                        </a>
                    }
                </div>
            </nav>
        }
    </div>

    @if (ScoreboardModel != null)
    {
        <div data-server-id="@Id">
            <ScoreboardTable Model="ScoreboardModel" ShowHeader="false"/>
        </div>
    }
    else
    {
        <div class="space-y-4" aria-busy="true">
            <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
            <div class="rounded-xl bg-surface border border-line h-24 animate-pulse"></div>
        </div>
    }
</div>
