@page "/Server/{Id}/Scoreboard"
@page "/scoreboard/{Id}"
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>@AppState.Loc("WEBFRONT_TITLE_SCOREBOARD") | IW4MAdmin</PageTitle>

<div class="max-w-7xl mx-auto p-4 md:p-8 grid grid-cols-1 lg:grid-cols-4 gap-6">
    <div class="lg:col-span-3">
        @if (ScoreboardModel != null)
        {
            <div data-server-id="@Id">
                <ScoreboardTable Model="ScoreboardModel" />
            </div>
        }
        else
        {
             <div class="flex justify-center mt-20">
                <i class="ph ph-spinner animate-spin text-4xl text-blue-500"></i>
            </div>
        }
    </div>
    <div class="lg:col-span-1">
        @if (ContextItems != null)
        {
           <SideContextMenu Model="ContextItems" />
        }
    </div>
</div>
