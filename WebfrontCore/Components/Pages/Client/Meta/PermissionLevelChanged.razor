@using SharedLibraryCore.Dtos.Meta.Responses
@using SharedLibraryCore
@using WebfrontCore.Components.Shared
@using Humanizer
@inject WebfrontCore.Services.AppState AppState

@if (ShowHeader)
{
    <span class="text-muted font-size-12 mr-5">@Meta.When.HumanizeForCurrentCulture() &mdash;</span>
}

@{
    var tooltipText = string.Format(AppState.Loc("WEBFRONT_META_TOOLTIP_TIME"), Meta.When.ToString("G"));
}

<span data-toggle="tooltip" data-title="@tooltipText" data-placement="top">
@foreach (var token in Utilities.SplitTranslationTokens(AppState.Loc("WEBFRONT_CLIENT_META_PERMISSION_CHANGED")))
{
    if (token.IsInterpolation)
    {
        switch (token.MatchValue)
        {
            case "permission":
                <span class="level-color-@((int)Meta.CurrentPermissionLevel)">@Meta.CurrentPermissionLevel.ToLocalizedLevelName()</span>
                break;
            case "originClient":
                <span class="text-highlight">
                    <a href="/Client/Profile/@Meta.ChangedById">
                        <ColorCode Value="@Meta.ChangedByName" />
                    </a>
                </span>
                break;
            case "type":
                 <span class="text-white-50">@token.TranslationValue</span>
                break;
        }
    }
    else
    {
        <span class="text-muted">@token.MatchValue</span>
    }
}
</span>

@code {
    [Parameter] public PermissionLevelChangedResponse Meta { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
}
