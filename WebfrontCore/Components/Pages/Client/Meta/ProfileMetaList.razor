@implements IAsyncDisposable

@if (Loading && !MetaItems.Any())
{
     <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
}
else
{
    string lastHeader = null;
    
    foreach (var item in MetaItems)
    {
        var currentHeader = item.When.HumanizeForCurrentCulture();
        
        if (currentHeader != lastHeader)
        {
            <div class="text-muted font-size-16 font-weight-medium mt-20 mb-10">@currentHeader</div>
            lastHeader = currentHeader;
        }
        
        <div class="mb-5">
            @if (item is AdministeredPenaltyResponse penalized)
            {
                <AdministeredPenalty Meta="penalized" ShowHeader="false" />
            }
            else if (item is ReceivedPenaltyResponse received)
            {
                <ReceivedPenalty Meta="received" ShowHeader="false" />
            }
            else if (item is MessageResponse message)
            {
                 <Message Meta="message" ShowHeader="false" />
            }
             else if (item is UpdatedAliasResponse alias)
            {
                 <UpdatedAlias Meta="alias" ShowHeader="false" />
            }
             else if (item is ConnectionHistoryResponse connection)
            {
                 <ConnectionHistory Meta="connection" ShowHeader="false" />
            }
            else if (item is PermissionLevelChangedResponse permission)
            {
                 <PermissionLevelChanged Meta="permission" ShowHeader="false" />
            }
            else if (item is InformationResponse info)
            {
                 <div class="mb-5 p-15 rounded bg-very-dark-dm bg-light-ex-lm profile-meta-entry">
                     <div class="profile-meta-value text-primary font-size-14"><ColorCode Value="@info.Value" /></div>
                     <div class="profile-meta-title text-muted font-size-12">@info.Key.Titleize()</div>
                 </div>
            }
            else if (item is ClientNoteMetaResponse note)
            {
                <span data-toggle="tooltip" data-title="@string.Format(AppState.Loc("WEBFRONT_META_TOOLTIP_TIME"), note.When.ToString("G"))" data-placement="top">
                    <span class="text-muted">@AppState.Loc("WEBFRONT_CLIENT_META_NOTE")</span>
                    <span class="text-white-dm text-black-lm">@note.Note</span>
                    <span class="text-muted">&mdash;</span>
                    <a class="link-inverse" href="/Client/Profile/@note.OriginEntityId">
                        <ColorCode Value="@note.OriginEntityName" />
                    </a>
                </span>
            }
            else
            {
                <div class="alert alert-warning">
                    Unknown Meta Type: @item.GetType().Name (@item.Type)
                </div>
            }
        </div>
    }

    @if (HasMore)
    {
        <div @ref="_loadMoreTrigger" style="height: 1px;"></div>
    }
}
 
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-10">
        @_errorMessage
    </div>
}
