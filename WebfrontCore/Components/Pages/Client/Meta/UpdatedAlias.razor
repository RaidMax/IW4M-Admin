@inject AppState AppState

@if (ShowHeader)
{
    <span class="text-muted font-size-12 mr-5">@Meta.When.HumanizeForCurrentCulture() &mdash;</span>
}

@{
    var tooltipText = string.Format(AppState.Loc("WEBFRONT_META_TOOLTIP_TIME"), Meta.When.ToString("G"));
}

<span data-toggle="tooltip" data-title="@tooltipText" data-placement="top">
@foreach (var token in Utilities.SplitTranslationTokens(AppState.Loc("WEBFRONT_PROFILE_META_CONNECT_ALIAS")))
{
    if (token.IsInterpolation)
    {
        switch (token.MatchValue)
        {
            case "action":
                <span class="text-secondary">@token.TranslationValue</span>
                break;
            case "alias":
                <span class="text-light-dm text-dark-lm">
                    <ColorCode Value="@Meta.Name" />
                     @* Permission check for IP needed? Passed via props or injected? *@
                     @* Assuming Authorized is enough for now, or check permission explicitly. 
                        In Blazor, it's harder to check detailed permissions without AppState having them.
                        Legacy used <has-permission>.
                        I'll use AppState.HasPermission logic if available, or just render for now.
                      *@
                     [@Meta.IPAddress]
                     &nbsp;
                </span>
                break;
        }
    }

    else
    {
        <span class="text-muted">@token.MatchValue&nbsp;</span>
    }
}
</span>

@code {
    [Parameter] public UpdatedAliasResponse Meta { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
}
