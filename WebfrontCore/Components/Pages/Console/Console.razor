    ./(((((((((((((((((((((((((((((((/  ,******,                     
       ,(((((((((((((((((((((((((((((* ********//**.                 
         */(((((((((((((((((((((((((* ***************                
      ,***  ,(((((((((((((((((((((((,  ,***************.             
     ,****/**,*/(((((((((((((((((((.       *************,            
    ************,,((((((((((((((((*.         ,************           
  .***********,     *(((((((((((((            .*//*********          
 .,**********,        ,(((((((((/               ***********          
 ,**********,           *(((((((/               ,**********          
 ,/*********,             .*(((*                 **********,         
 ,/*********,                .*.                 ***********.        
 ,**********,                                   ***********          
  .***********                                  ***********          
