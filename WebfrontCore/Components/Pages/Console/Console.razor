@page "/Console"
@rendermode InteractiveServer

<div class="content mt-0">
    <h2 class="content-title mt-20">@AppState.Loc("WEBFRONT_CONSOLE_TITLE")</h2>

    <div id="console" class="card m-0 mb-20">
        <div id="console_command_response" class="bg-dark-dm bg-light-lm p-10 code rounded overflow-y-scroll h-300">
             @foreach(var line in CommandOutput)
             {
                 <div>@line</div>
             }
