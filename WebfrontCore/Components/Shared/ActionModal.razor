<div class="modal" id="@ModalId" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(_actionInfo?.Name ?? (_isLogin ? AppState.Loc("WEBFRONT_NAV_TITLE_LOGIN") : "Action"))</h5>
                <button type="button" class="close" @onclick="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body position-relative">
                @if (_isLoading)
                {
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 100px;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                    </div>
                }
                else if (_error != null)
                {
                    <div class="alert alert-danger">@_error</div>
                }
                else if (_actionInfo != null)
                {
                    @if (_isLegacy)
                    {
                        <form action="/Action/@_actionInfo.Action" method="post">
                            @RenderInputs()
                            @RenderSubmitButton()
                        </form>
                    }
                    else
                    {
                        <form @onsubmit="Submit">
                            @RenderInputs()
                            @RenderSubmitButton()
                        </form>
                    }
                }
                else if (_isLogin)
                {
                    <LoginForm/>
                }
            </div>
        </div>
    </div>
</div>


@code {

    private RenderFragment RenderInputs() => __builder =>
    {
        foreach (var input in _actionInfo.Inputs)
        {
            if (input.Type == "hidden")
            {
                continue;
            }

            var inputType = input.Type ?? "text";
            var inputId = $"input_{input.Name}";

            if (inputType == "checkbox")
            {
                <div class="form-group mb-10">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" name="@input.Name" class="custom-control-input" id="@inputId"
                               checked="@(_formData.ContainsKey(input.Name) && _formData[input.Name] is true)"
                               @onchange="@((ChangeEventArgs e) => _formData[input.Name] = e.Value)">
                        <label class="custom-control-label" for="@inputId">@input.Label</label>
                    </div>
                </div>
            }
            else
            {
                <div class="input-group mb-10">
                    <div class="input-group-prepend">
                        <span class="input-group-text">@input.Label</span>
                    </div>

                    @if (inputType == "select")
                    {
                        <select name="@input.Name" id="@inputId" class="form-control" value="@_formData[input.Name]"
                                @onchange="@((ChangeEventArgs e) => _formData[input.Name] = e.Value)">
                            @foreach (var kvp in input.Values)
                            {
                                var val = kvp.Key.Replace("!selected!", "");
                                <option value="@val">@ProcessColor(kvp.Value)</option>
                            }
                        </select>
                    }
                    else if (inputType == "textarea")
                    {
                        <textarea name="@input.Name" id="@inputId" class="form-control" placeholder="@input.Placeholder"
                                  value="@_formData[input.Name]" @onchange="@((ChangeEventArgs e) => _formData[input.Name] = e.Value)"></textarea>
                    }
                    else
                    {
                        <input type="@inputType" name="@input.Name" class="form-control" id="@inputId" placeholder="@input.Placeholder"
                               value="@_formData[input.Name]" @onchange="@((ChangeEventArgs e) => _formData[input.Name] = e.Value)"
                               required="@input.Required"/>
                    }
                </div>
            }
        }
    };

    private RenderFragment RenderSubmitButton() => __builder =>
    {
        <div class="text-right mt-20">
            <button type="submit" class="btn btn-primary mr-5">@(_actionInfo.ActionButtonLabel ?? "Submit")</button>
            <button type="button" class="btn btn-secondary" @onclick="Close">@AppState.Loc("WEBFRONT_ACTION_MODAL_BUTTON_CLOSE")</button>
        </div>
    };

}
