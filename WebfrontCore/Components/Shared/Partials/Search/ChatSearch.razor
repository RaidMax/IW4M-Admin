<div id="chatSearchWrapper">
    <div class="form-group">
        <label for="messageContains">@(AppState.Loc("WEBFRONT_ACTION_LABEL_MESSAGE"))</label>
        <div class="d-flex">
            <input type="text" class="form-control" id="messageContains" placeholder="Contains" @bind="Model.MessageContains"/>
            <div class="custom-control ml-10 align-self-center">
                <div class="custom-switch">
                    <input type="checkbox" id="isExactMatch" @bind="Model.IsExactMatch"/>
                    <label for="isExactMatch">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_EXACT"))</label>
                </div>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label for="serverId" class="w-quarter">@(AppState.Loc("WEBFRONT_BAN_MGMT_FORM_ID"))</label>
        <label for="clientId" class="">@(AppState.Loc("WEBFRONT_CONTEXT_MENU_GLOBAL_SERVER"))</label>

        <div class="d-flex">
            <input type="text" class="form-control w-quarter" id="clientId" placeholder="Id" @bind="Model.ClientId"/>
            <select class="form-control w-three-quarter ml-10" id="serverId" @bind="Model.ServerId">
                <option value="">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_SELECT_PERMISSIONS_ANY"))</option>
                @foreach (var server in Manager.GetServers())
                {
                    <option value="@server.Id">[@server.GameName.ToString()] @server.ServerName.StripColors()</option>
                }
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="sentAfter">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_SENT_AFTER"))</label>
        <div class="d-flex">
            <input type="datetime-local" class="form-control" id="sentAfter" @bind="LocalSentAfter"/>
        </div>
    </div>

    <div class="form-group">
        <label for="sentBefore">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_SENT_BEFORE"))</label>
        <div class="d-flex">
            <input type="datetime-local" class="form-control" id="sentBefore" @bind="LocalSentBefore"/>
        </div>
    </div>

    <button class="btn btn-primary" @onclick="@Submit">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_BUTTON_SUBMIT"))</button>
</div>
