@inject AppState AppState

<h6 class="dropdown-header">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_TITLE"))</h6>
<div class="dropdown-divider"></div>
<div class="dropdown-content">

    <div class="form-group" id="searchTypeSelectorParent">
        <label for="searchType">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_LABEL_FOR"))</label>
        <br/>
        <select class="form-control" id="searchType" name="searchType" @bind="SearchType">
            <option value="client">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_SELECT_TYPE_PLAYERS"))</option>
            <option value="chat">@(AppState.Loc("WEBFRONT_ADVANCED_SEARCH_SELECT_TYPE_CHAT"))</option>
        </select>
    </div>

    @if (SearchType == "client")
    {
        <ClientSearch/>
    }
    else
    {
        <ChatSearch/>
    }
</div>

@code {
    private string SearchType { get; set; } = "client";
}
