<div class="fixed inset-0 z-50 flex items-center justify-center p-4 @(_isVisible ? "" : "hidden")" role="dialog" aria-modal="true">
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/50 transition-opacity" @onclick="Close"></div>

    <!-- Modal Content -->
    <div class="relative bg-slate-800 rounded-lg shadow-xl w-full max-w-lg overflow-hidden transform transition-all flex flex-col max-h-[90vh]">
        <!-- Header -->
        <div class="bg-slate-700/50 px-6 py-4 flex items-center justify-between border-b border-slate-700 flex-shrink-0">
            <h5 class="text-lg font-medium text-white">
                @(_actionInfo?.Name ?? (_childContent != null ? _customTitle : (_isLogin ? AppState.Loc("WEBFRONT_NAV_TITLE_LOGIN") : "Action")))
            </h5>
            <button type="button" class="text-slate-400 hover:text-white transition-colors focus:outline-none" @onclick="Close">
                <i class="ph ph-x text-xl"></i>
            </button>
        </div>

        <!-- Body -->
        <div class="p-6 overflow-y-auto">
            @if (_isLoading)
            {
                <div class="flex justify-center items-center py-8">
                   <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
                </div>
            }
            else if (_error != null)
            {
                <div class="bg-red-900/20 border border-red-900/50 text-red-400 p-4 rounded-lg text-sm">
                    @_error
                </div>
            }
            else if (_childContent != null)
            {
                @_childContent
            }
            else if (_actionInfo != null)
            {
                @if (_isLegacy)
                {
                    <form action="/Action/@_actionInfo.Action" method="post" class="space-y-4">
                        @RenderInputs()
                        @RenderSubmitButton()
                    </form>
                }
                else
                {
                    <form @onsubmit="Submit" class="space-y-4">
                        @RenderInputs()
                        @RenderSubmitButton()
                    </form>
                }
            }
            else if (_isLogin)
            {
                <LoginForm/>
            }
        </div>
    </div>
</div>


@code {

    private RenderFragment RenderInputs() => __builder =>
    {
        foreach (var input in _actionInfo.Inputs)
        {
            if (input.Type == "hidden")
            {
                continue;
            }

            var inputType = input.Type ?? "text";
            var inputId = $"input_{input.Name}";

            if (inputType == "checkbox")
            {
                <div class="flex items-center">
                    <input type="checkbox" name="@input.Name" id="@inputId"
                           class="w-4 h-4 text-blue-600 bg-slate-700 border-slate-600 rounded focus:ring-blue-600 ring-offset-slate-800"
                           checked="@(_formData.ContainsKey(input.Name) && _formData[input.Name] is true)"
                           @onchange="@((ChangeEventArgs e) => _formData[input.Name] = e.Value)">
                    <label class="ml-2 text-sm font-medium text-slate-300" for="@inputId">@input.Label</label>
                </div>
            }
            else
            {
                <div class="space-y-1">
                    <label for="@inputId" class="block text-sm font-medium text-slate-300">@input.Label</label>

                    @if (inputType == "select")
                    {
                        <select name="@input.Name" id="@inputId" class="bg-slate-900 border border-slate-700 text-slate-100 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5"
                                value="@_formData[input.Name]"
                                @onchange="@((ChangeEventArgs e) => _formData[input.Name] = e.Value)">
                            @foreach (var kvp in input.Values)
                            {
                                var val = kvp.Key.Replace("!selected!", "");
                                <option value="@val">@ProcessColor(kvp.Value)</option>
                            }
                        </select>
                    }
                    else if (inputType == "textarea")
                    {
                        <textarea name="@input.Name" id="@inputId" class="bg-slate-900 border border-slate-700 text-slate-100 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="@input.Placeholder"
                                  value="@_formData[input.Name]" @onchange="@((ChangeEventArgs e) => _formData[input.Name] = e.Value)"></textarea>
                    }
                    else
                    {
                        <input type="@inputType" name="@input.Name" class="bg-slate-900 border border-slate-700 text-slate-100 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" id="@inputId" placeholder="@input.Placeholder"
                               value="@_formData[input.Name]" @onchange="@((ChangeEventArgs e) => _formData[input.Name] = e.Value)"
                               required="@input.Required"/>
                    }
                </div>
            }
        }
    };

    private RenderFragment RenderSubmitButton() => __builder =>
    {
        <div class="flex justify-end space-x-3 mt-6 pt-4 border-t border-slate-700">
            <button type="button" class="px-4 py-2 text-sm font-medium text-slate-300 bg-slate-700 rounded-lg hover:bg-slate-600 focus:ring-4 focus:outline-none focus:ring-slate-800 transition-colors" @onclick="Close">
                @AppState.Loc("WEBFRONT_ACTION_MODAL_BUTTON_CLOSE")
            </button>
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-800 transition-colors">
                @(_actionInfo.ActionButtonLabel ?? "Submit")
            </button>
        </div>
    };

}
