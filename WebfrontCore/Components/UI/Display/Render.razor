@page "/Interaction/Render/{InteractionName}"
@attribute [Authorize(Policy = "Permissions.Interaction.Read")]
@rendermode InteractiveServer

@layout EmptyLayout

@if (IsLoading)
{
    <LayoutView Layout="@typeof(MainLayout)">
        <div class="p-4 md:p-6 xl:p-8 max-w-4xl mx-auto space-y-5">
            <div class="h-8 w-64 rounded bg-surface-alt animate-pulse"></div>
            <div class="rounded-xl bg-surface border border-line h-40 animate-pulse"></div>
        </div>
    </LayoutView>
}
else if (ErrorMessage != null)
{
    <LayoutView Layout="@typeof(MainLayout)">
        <div class="p-4 md:p-6 xl:p-8 max-w-4xl mx-auto">
            <div class="rounded-xl border border-error/40 bg-error/10 px-4 py-3 text-sm text-error">@ErrorMessage</div>
        </div>
    </LayoutView>
}
else if (InteractionData != null)
{
    if (ParsedInteractionType == InteractionType.TemplateContent)
    {
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="p-4 md:p-6 xl:p-8 max-w-4xl mx-auto space-y-5">
                <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
                    <div class="min-w-0">
                        <h1 class="text-2xl font-extrabold tracking-tight text-gradient-title">
                            <ColorCode Value="@InteractionData.Title"/>
                        </h1>
                        @if (!string.IsNullOrWhiteSpace(InteractionData.Description))
                        {
                            <p class="text-sm text-muted mt-0.5">@InteractionData.Description</p>
                        }
                    </div>
                </div>

                <section class="rounded-xl bg-surface border border-line overflow-hidden">
                    @((MarkupString)InteractionData.Content)
                </section>
            </div>
        </LayoutView>
    }
    else
    {
        @((MarkupString)InteractionData.Content)
    }
}
