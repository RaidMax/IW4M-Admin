@page "/Interaction/Render/{InteractionName}"
@attribute [Authorize(Policy = "Permissions.Interaction.Read")]
@rendermode InteractiveServer

@layout EmptyLayout

@if (IsLoading)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
}
else if (ErrorMessage != null)
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
else if (InteractionData != null)
{
    if (ParsedInteractionType == InteractionType.TemplateContent)
    {
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="max-w-7xl mx-auto p-4 md:p-8">
                <div class="flex items-center gap-3 mb-8">
                    <div class="flex items-center justify-center p-2.5 rounded-lg bg-surface-alt/50 border border-line shadow-sm">
                        <i class="ph ph-puzzle-piece text-xl text-primary"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-gradient-title">
                            <ColorCode Value="@InteractionData.Title"/>
                        </h2>
                    </div>
                </div>
                <div class="bg-surface rounded-lg shadow ring-1 ring-line overflow-hidden p-6">
                    @((MarkupString)InteractionData.Content)
                </div>
            </div>
        </LayoutView>
    }
    else
    {
        @((MarkupString)InteractionData.Content)
    }
}
