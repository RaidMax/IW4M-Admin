@* Tooltip component - hover on desktop, tap on mobile *@
@if (!string.IsNullOrEmpty(Text))
{
    <div class="tooltip-wrapper group/tooltip relative" @onclick="ToggleTooltip" @onclick:stopPropagation>
        @ChildContent
        <div class="@TooltipClasses">
            <div class="bg-surface-alt text-foreground text-xs px-3 py-2 rounded-lg shadow-xl border border-line max-w-[200px] text-center">
                @Text
            </div>
            <div class="absolute left-1/2 -translate-x-1/2 -bottom-1 w-2 h-2 bg-surface-alt border-r border-b border-line rotate-45"></div>
        </div>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public string Text { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    
    private bool _showMobile;
    
    private string TooltipClasses => $"absolute z-50 bottom-full left-1/2 -translate-x-1/2 mb-2 " +
        // Desktop: show on hover
        "opacity-0 invisible group-hover/tooltip:opacity-100 group-hover/tooltip:visible " +
        // Mobile: show on tap (controlled by _showMobile)
        $"{(_showMobile ? "!opacity-100 !visible" : "")} " +
        "transition-all duration-200 pointer-events-none";

    private void ToggleTooltip()
    {
        // Only toggle on touch devices (mobile)
        _showMobile = !_showMobile;
    }
}
