@inherits LayoutComponentBase

@implements IDisposable

@if (!_isInitialized)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">@AppState.Loc("WEBFRONT_LOADING")</span>
        </div>
    </div>
}
else
{
    <div class="flex flex-col h-screen w-full bg-background text-primay-100 font-sans">
        <AntiforgeryToken />
        
        <!-- Top Menu Bar (Interactive) -->
        <TopBar />

        <div class="flex flex-1 overflow-hidden relative">
            <!-- Sidebar / NavMenu (Interactive Container) -->
            <SidebarContainer />

            <!-- Main Content Area -->
            <main class="flex-1 overflow-auto relative bg-background">
                 <div id="target_id"></div>
                 <div id="mainLoadingBar" class="loading-bar hidden"></div>
                 
                <!-- Toast Container -->
                <ToastContainer />

                @Body
                
                <ActionModal @rendermode="InteractiveServer"/>
                <AdvancedSearchModal @rendermode="InteractiveServer" />
            </main>
        </div>
    </div>
}
