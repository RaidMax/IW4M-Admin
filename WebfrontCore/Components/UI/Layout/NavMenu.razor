<!-- left side navigation -->
<aside class="flex flex-col h-full z-30 flex-1 md:w-full">
    <div class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
        <!-- Search Form Placeholder -->
        <!-- Search Form Mobile -->
        <div class="mb-4 px-1 md:hidden">
            <SearchResourceForm/>
        </div>

        <div
            class="text-xs font-semibold text-muted uppercase tracking-wider mb-2 px-3">@(Loc("WEBFRONT_NAV_TITLE_MAIN"))</div>

        <!-- servers -->
        <NavLink href="servers" Match="NavLinkMatch.All" @onclick="CloseMobileMenu"
                 class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
            <i class="ph ph-hard-drives mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
            <span class="truncate">@(Loc("WEBFRONT_NAV_SERVERS"))</span>
        </NavLink>
        <!-- about -->
        <NavLink href="about" @onclick="CloseMobileMenu"
                 class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
            <i class="ph ph-info mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
            <span class="truncate">@(Loc("WEBFRONT_NAV_ABOUT"))</span>
        </NavLink>
        <!-- penalties -->
        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.Penalty}.{WebfrontPermission.Read}")">
            <NavLink href="penalties" @onclick="CloseMobileMenu"
                     class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                <i class="ph ph-lock-simple mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                <span class="truncate">@(Loc("WEBFRONT_NAV_PENALTIES"))</span>
            </NavLink>
        </AuthorizeView>
        <!-- privileged -->
        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.PrivilegedClientsPage}.{WebfrontPermission.Read}")">
            <NavLink href="privileged-clients" @onclick="CloseMobileMenu"
                     class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                <i class="ph ph-users mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                <span class="truncate">@(Loc("WEBFRONT_NAV_PRIVILEGED"))</span>
            </NavLink>
        </AuthorizeView>
        <!-- help -->
        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.HelpPage}.{WebfrontPermission.Read}")">
            <NavLink href="commands" @onclick="CloseMobileMenu"
                     class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                <i class="ph ph-question mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                <span class="truncate">@(Loc("WEBFRONT_NAV_HELP"))</span>
            </NavLink>
        </AuthorizeView>

        @if (NavData?.Interactions is not null)
        {
            foreach (var interaction in NavData.Interactions.Where(i => i.InteractionId.StartsWith("Webfront::Nav::Main")))
            {
                <AuthorizeView
                    Policy="@($"Permissions.{WebfrontEntity.Interaction}.{WebfrontPermission.Read}")">
                    <NavLink href="@($"Interaction/Render/{interaction.InteractionId}")" @onclick="CloseMobileMenu"
                             class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                        <i class="ph @interaction.DisplayMeta mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                        <span class="truncate">@interaction.Name</span>
                    </NavLink>
                </AuthorizeView>
            }
        }

        <!-- profile -->
        @if (AppState.User is not null)
        {
            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ProfilePage}.{WebfrontPermission.Read}")">
                <NavLink href="@($"client/{AppState.User.ClientId}")" Match="NavLinkMatch.All" @onclick="CloseMobileMenu"
                         class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                    <i class="ph ph-user mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                    <span class="truncate">@(Loc("WEBFRONT_NAV_TITLE_PROFILE"))</span>
                </NavLink>
            </AuthorizeView>
        }

        <div class="my-4 border-t border-divider"></div>

        <!-- stats -->
        <div
            class="text-xs font-semibold text-muted uppercase tracking-wider mb-2 px-3">@(Loc("WEBFRONT_NAV_TITLE_STATS"))</div>

        <!-- my stats (logged in users only) -->
        @if (AppState.User is not null)
        {
            <NavLink href="@($"client/{AppState.User.ClientId}/stats")" @onclick="CloseMobileMenu"
                     class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                <i class="ph ph-chart-line-up mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                <span class="truncate">My Stats</span>
            </NavLink>
        }

        <!-- dynamically registered pages -->
        @if (NavData?.Pages is not null && NavData.Pages.Any())
        {
            foreach (var pageLink in NavData.Pages)
            {
                <a class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover"
                   href="@pageLink.Location" @onclick="CloseMobileMenu">
                    <i class="ph @(pageLink.Location.EndsWith("radar") ? "ph-wifi-high" : "ph-chart-bar") mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                    <span class="truncate">@pageLink.Name</span>
                </a>
            }
        }



        <!-- socials -->
        @if (NavData?.CommunityInformation?.IsEnabled == true && NavData.CommunityInformation.SocialAccounts?.Any() == true)
        {
            <div class="my-4 border-t border-divider"></div>
            <div
                class="text-xs font-semibold text-muted uppercase tracking-wider mb-2 px-3">@(Loc("WEBFRONT_NAV_TITLE_SOCIALS"))</div>

            @foreach (var social in NavData.CommunityInformation.SocialAccounts)
            {
                <a href="@social.Url" @onclick="CloseMobileMenu"
                   class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover"
                   target="_blank" title="@social.Title">
                    <div class="flex items-center w-full">
                        @if (!string.IsNullOrWhiteSpace(social.IconId))
                        {
                            <i class="ph @social.IconId mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                        }
                        else if (!string.IsNullOrWhiteSpace(social.IconUrl))
                        {
                            var url = Uri.TryCreate(social.IconUrl, UriKind.Absolute, out var parsedUrl)
                                ? parsedUrl?.AbsoluteUri ?? $"/images/community/{social.IconUrl}"
                                : $"/images/community/{social.IconUrl}";
                            <img class="h-4 w-4 mr-3 object-contain" src="@url" alt="@social.Title"/>
                        }
                        <div class="truncate">@social.Title</div>
                    </div>
                </a>
            }

            @if (NavData?.Interactions is not null)
            {
                foreach (var interaction in NavData.Interactions.Where(i => i.InteractionId.StartsWith("Webfront::Nav::Social")))
                {
                    if (AppState.User != null && (int)AppState.User.Level >= interaction.MinimumPermission)
                    {
                        <AuthorizeView
                            Policy="@($"Permissions.{WebfrontEntity.Interaction}.{WebfrontPermission.Read}")">
                            <NavLink href="@($"Interaction/Render/{interaction.InteractionId}")"
                                     @onclick="CloseMobileMenu"
                                     class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                                <i class="ph @interaction.DisplayMeta mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                                <span class="truncate">@interaction.Name</span>
                            </NavLink>
                        </AuthorizeView>
                    }
                }
            }
        }

        <!-- Admin Section -->
        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.AdminMenu}.{WebfrontPermission.Read}")">
            <div class="my-4 border-t border-primary/10"></div>
            <div
                class="text-xs font-semibold text-muted uppercase tracking-wider mb-2 px-3">@(Loc("WEBFRONT_NAV_TITLE_ADMIN"))</div>

            <!-- Console -->
            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.ConsolePage}.{WebfrontPermission.Read}")"
                           Context="consoleContext">
                <NavLink href="console" @onclick="CloseMobileMenu"
                         class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                    <i class="ph ph-terminal mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                    <span class="truncate">@(Loc("WEBFRONT_NAV_CONSOLE"))</span>
                </NavLink>
            </AuthorizeView>

            <!-- Ban Management -->
            <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.BanManagementPage}.{WebfrontPermission.Read}")"
                           Context="banContext">
                <NavLink href="manage-bans" @onclick="CloseMobileMenu"
                         class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                    <i class="ph ph-prohibit mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                    <span class="truncate">@(Loc("WEBFRONT_NAV_TITLE_BAN_MANAGEMENT"))</span>
                </NavLink>
            </AuthorizeView>
        </AuthorizeView>

        <!-- Configuration (Owner only) -->
        <AuthorizeView Roles="Owner">
            <NavLink href="configuration" @onclick="CloseMobileMenu"
                     class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                <i class="ph ph-gear mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                <span class="truncate">@(Loc("WEBFRONT_NAV_TITLE_CONFIGURATION"))</span>
            </NavLink>
        </AuthorizeView>

        <!-- Audit Log -->
        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.AuditPage}.{WebfrontPermission.Read}")">
            <NavLink href="audit" @onclick="CloseMobileMenu"
                     class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                <i class="ph ph-books mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                <span class="truncate">@(Loc("WEBFRONT_NAV_AUDIT_LOG"))</span>
            </NavLink>
        </AuthorizeView>

        <!-- Recent Clients -->
        <AuthorizeView Policy="@($"Permissions.{WebfrontEntity.RecentPlayersPage}.{WebfrontPermission.Read}")">
            <NavLink href="find-client?direction=1&sortColumn=FirstConnection" @onclick="CloseMobileMenu"
                     class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                <i class="ph ph-clock mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                <span class="truncate">@(Loc("WEBFRONT_ACTION_RECENT_CLIENTS"))</span>
            </NavLink>
        </AuthorizeView>

        <!-- Admin Interactions -->
        @if (NavData?.Interactions != null)
        {
            foreach (var interaction in NavData.Interactions.Where(i => i.InteractionId.StartsWith("Webfront::Nav::Admin")))
            {
                if (AppState.User != null && (int)AppState.User.Level >= interaction.MinimumPermission)
                {
                    <AuthorizeView
                        Policy="@($"Permissions.{WebfrontEntity.Interaction}.{WebfrontPermission.Read}")">
                        <NavLink href="@($"Interaction/Render/{interaction.InteractionId}")" @onclick="CloseMobileMenu"
                                 class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors [&.active]:bg-action-primary [&.active]:text-foreground [&.active]:hover:bg-action-primary-hover">
                            <i class="ph @interaction.DisplayMeta mr-3 text-lg text-secondary group-hover:text-foreground group-[.active]:text-foreground"></i>
                            <span class="truncate">@interaction.Name</span>
                        </NavLink>
                    </AuthorizeView>
                }
            }
        }

    </div>
    <div class="border-t border-divider pt-4 px-3 pb-4">
        <!-- Login Token (for authenticated users) -->
        @if (AppState.User is not null)
        {
            <a href="#" @onclick:preventDefault
               @onclick='() => { ActionService.OpenAction("GenerateLoginToken", null, string.Empty); CloseMobileMenu(); }'
               class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors mb-2">
                <i class="ph ph-key mr-3 text-lg text-secondary group-hover:text-foreground"></i>
                <span class="truncate">@(Loc("WEBFRONT_ACTION_TOKEN"))</span>
            </a>

            <!-- Logout -->
            <form action="/Account/Logout" method="post" class="w-full">
                <AntiforgeryToken/>
                <button type="submit"
                        class="w-full group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors text-left bg-transparent border-none cursor-pointer">
                    <i class="ph ph-sign-out mr-3 text-lg text-secondary group-hover:text-foreground"></i>
                    <span class="truncate">@(Loc("WEBFRONT_NAV_LOGOUT"))</span>
                </button>
            </form>
        }
        else
        {
            <!-- Login (for unauthenticated users) -->
            <a href="#" @onclick:preventDefault
               @onclick='() => { ActionService.OpenAction("Login", null, string.Empty); CloseMobileMenu(); }'
               class="group flex items-center px-3 py-2 text-sm font-medium rounded-md text-subtle hover:bg-surface-hover hover:text-foreground transition-colors">
                <i class="ph ph-key mr-3 text-lg text-secondary group-hover:text-foreground"></i>
                <span class="truncate">@(Loc("WEBFRONT_NAV_TITLE_LOGIN"))</span>
            </a>
        }

        <!-- User Info / Login Status -->
        <div class="mt-4 px-3 text-xs text-muted">
            @if (AppState.User is not null)
            {
                var format = Loc("WEBFRONT_NAV_LOGIN_YES_FORMAT");
                @foreach (var match in Utilities.SplitTranslationTokens(format))
                {
                    if (match.IsInterpolation && match.MatchValue == "username")
                    {
                        <span class="font-bold text-primary"><ColorCode Value="@AppState.User.Name"/></span>
                    }
                    else
                    {
                        <span>@match.MatchValue</span>
                    }

                    <span>&nbsp;</span>
                }
            }
            else
            {
                <span>@(Loc("WEBFRONT_NAV_LOGIN_NO_FORMAT"))</span>
            }

            <div class="mt-1">
                <a href="https://github.com/RaidMax/IW4M-Admin/releases" class="hover:text-subtle transition-colors"
                   target="_blank">
                    IW4MAdmin <span class="text-primary">@Program.Manager.Version</span>
                </a>
            </div>
        </div>
    </div>

</aside>
