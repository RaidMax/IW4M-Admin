@using WebfrontCore.Core.Services
@inject AppState AppState
@implements IDisposable
@rendermode InteractiveServer

<!-- Desktop Sidebar (hidden on mobile) -->
<div
    class="hidden md:flex flex-col h-full bg-surface border-r border-divider transition-all duration-300 flex-shrink-0 @(AppState.SidebarCollapsed ? "w-0 overflow-hidden border-none" : "w-64")">
    <NavMenu/>
</div>

<!-- Mobile Sidebar (hidden on desktop) -->
<div class="md:hidden">
    <!-- Overlay -->
    @if (AppState.IsMobileNavOpen)
    {
        <div class="fixed inset-0 bg-black/50 z-30" @onclick="ToggleMobile"></div>
    }
    <!-- Sliding Panel -->
    <div
        class="fixed inset-y-0 left-0 w-64 z-40 bg-surface border-r border-divider transition-transform duration-300 transform @(AppState.IsMobileNavOpen ? "translate-x-0" : "-translate-x-full")">
        <NavMenu/>
    </div>
</div>

