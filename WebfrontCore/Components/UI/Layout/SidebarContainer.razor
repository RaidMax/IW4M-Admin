@using WebfrontCore.Core.Services
@inject AppState AppState
@implements IDisposable
@rendermode InteractiveServer

<!-- Desktop rail (hidden on mobile). Collapses to an icon strip instead of disappearing. -->
<div
    class="hidden md:flex flex-col h-full bg-surface border-r border-divider transition-[width] duration-200 ease-out flex-shrink-0 overflow-hidden @(AppState.SidebarCollapsed ? "w-16" : "w-64")">
    <NavMenu @key="@("desktop")" Collapsed="AppState.SidebarCollapsed"/>
</div>

<!-- Mobile drawer (hidden on desktop) -->
<div class="md:hidden">
    @if (AppState.IsMobileNavOpen)
    {
        <div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-30" @onclick="ToggleMobile"></div>
    }
    <div
        class="fixed inset-y-0 left-0 w-72 max-w-[85vw] z-40 bg-surface border-r border-divider shadow-2xl transition-transform duration-300 transform @(AppState.IsMobileNavOpen ? "translate-x-0" : "-translate-x-full")">
        <NavMenu @key="@("mobile")" Collapsed="false"/>
    </div>
</div>
