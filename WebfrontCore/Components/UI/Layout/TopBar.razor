@using WebfrontCore.Components.UI.Theme
@inject AppState AppState
@inject ApplicationConfiguration AppConfig
@rendermode InteractiveServer

<header
    class="h-16 flex items-center justify-between px-4 bg-surface-alt border-b border-divider shadow-sm z-20 flex-shrink-0 gap-4">
    <!-- Left: Toggle & Brand -->
    <div class="flex items-center gap-3">
        <button
            class="md:hidden text-accent hover:text-foreground transition-colors p-2 -ml-2 rounded-lg hover:bg-surface-hover"
            type="button" @onclick="ToggleMobile" title="Toggle Navigation">
            <i class="ph ph-list text-2xl flex justify-center"></i>
        </button>
        <button
            class="hidden md:block text-subtle hover:text-foreground transition-colors p-2 -ml-2 rounded-lg hover:bg-surface-hover"
            type="button" @onclick="ToggleDesktop" title="Toggle Sidebar">
            <i class="ph ph-list text-2xl flex justify-center"></i>
        </button>

        <a href="/"
           class="text-xl font-bold tracking-wide text-foreground hover:text-subtle transition-colors truncate">
            @if (string.IsNullOrEmpty(AppConfig.WebfrontCustomBranding))
            {
                <span>IW4MAdmin</span>
            }
            else
            {
                <span>@AppConfig.WebfrontCustomBranding</span>
            }
        </a>
    </div>

    <!-- Center: Client Badges -->
    <div class="hidden md:flex flex-1 justify-center px-4 min-w-0">
        <ClientBadges/>
    </div>

    <!-- Right: Actions -->
    <div class="flex items-center gap-2 md:gap-4 shrink-0">
        <div class="relative hidden md:block">
            <SearchResourceForm/>
        </div>

        <div class="h-6 w-px bg-divider hidden md:block"></div>

        <div class="flex items-center gap-1">
            <div class="md:hidden">
                <ClientBadges IconOnly="true"/>
            </div>
            <NotificationCenter/>

            <ThemeSelector/>
        </div>
    </div>
</header>


@code {

    private void ToggleMobile()
    {
        Console.WriteLine("TopBar: ToggleMobile clicked. Current State: " + AppState.IsMobileNavOpen);
        AppState.IsMobileNavOpen = !AppState.IsMobileNavOpen;
        Console.WriteLine("TopBar: New State: " + AppState.IsMobileNavOpen);
    }

    private void ToggleDesktop()
    {
        AppState.SidebarCollapsed = !AppState.SidebarCollapsed;
    }

}
