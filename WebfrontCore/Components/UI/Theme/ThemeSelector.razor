@implements IDisposable

<div class="relative">
    <!-- Theme Toggle Button -->
    <button class="p-2 text-secondary hover:text-foreground hover:bg-surface-hover rounded-lg transition-colors"
            @onclick="ToggleDropdown"
            @onclick:stopPropagation
            title="Theme Settings">
        <i class="ph ph-palette text-xl flex justify-center"></i>
    </button>

    @if (_isOpen)
    {
        <!-- Dropdown Panel -->
        <div
            class="absolute right-0 mt-2 w-80 bg-surface border border-line rounded-lg shadow-xl z-50 p-4 space-y-4 max-h-[80vh] overflow-y-auto">
            @if (AppConfig.Webfront.PreventUserCustomization)
            {
                <div class="flex flex-col items-center justify-center py-4 text-center space-y-2 text-muted">
                    <i class="ph ph-lock-key text-3xl text-primary"></i>
                    <p class="text-sm">Theme customization is disabled.</p>
                </div>
            }
            else
            {
                <!-- Preset Selection -->
                <div class="space-y-2">
                    <label class="text-xs font-semibold text-muted uppercase tracking-wider">Theme Preset</label>
                    <div class="flex gap-2">
                        <button
                            class="flex-1 px-3 py-2 text-xs font-medium rounded-md transition-colors @GetPresetButtonClass("minimal")"
                            @onclick="@(() => SetPreset("minimal"))">
                            Minimal
                        </button>
                        <button
                            class="flex-1 px-3 py-2 text-xs font-medium rounded-md transition-colors @GetPresetButtonClass("balanced")"
                            @onclick="@(() => SetPreset("balanced"))">
                            Balanced
                        </button>
                        <button
                            class="flex-1 px-3 py-2 text-xs font-medium rounded-md transition-colors @GetPresetButtonClass("high-contrast")"
                            @onclick="@(() => SetPreset("high-contrast"))">
                            Contrast
                        </button>
                    </div>
                </div>

                <!-- Primary Color -->
                <div class="space-y-2">
                    <label class="text-xs font-semibold text-muted uppercase tracking-wider">Primary Color</label>
                    <div class="space-y-3">
                        <select
                            class="w-full bg-input-bg border border-input-border rounded px-2 py-1.5 text-sm text-foreground focus:border-input-border-focus focus:outline-none"
                            value="@_primaryPalette" @onchange="OnPrimaryChange">
                            <option value="custom" selected="@(_primaryPalette == "custom")">Custom</option>
                            @foreach (var palette in AvailablePalettes)
                            {
                                <option value="@palette"
                                        selected="@(_primaryPalette == palette)">@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(palette)</option>
                            }
                        </select>

                        @if (_primaryPalette == "custom")
                        {
                            <div class="space-y-2 pt-2 border-t border-divider">
                                <div class="flex items-center gap-2">
                                    <input type="text" 
                                           value="@PrimaryHex" 
                                           @onchange="OnPrimaryHexChange"
                                           maxlength="7"
                                           placeholder="#000000"
                                           class="w-20 bg-input-bg border border-input-border rounded px-2 py-1 text-xs text-foreground font-mono focus:border-input-border-focus focus:outline-none"/>
                                    <div class="w-10 h-6 rounded border border-line"
                                         style="background: hsl(@_primaryHue, @(_primarySaturation)%, @(_primaryLightness)%)"></div>
                                </div>

                                <div class="space-y-1">
                                    <div class="flex justify-between text-xs text-muted">
                                        <span>Hue</span>
                                        <span>@_primaryHue°</span>
                                    </div>
                                    <input type="range" min="0" max="360" value="@_primaryHue"
                                           class="w-full accent-primary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                           @oninput="OnPrimaryHueChange"/>
                                </div>

                                <div class="space-y-1">
                                    <div class="flex justify-between text-xs text-muted">
                                        <span>Saturation</span>
                                        <span>@_primarySaturation%</span>
                                    </div>
                                    <input type="range" min="0" max="100" value="@_primarySaturation"
                                           class="w-full accent-primary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                           @oninput="OnPrimarySaturationChange"/>
                                </div>

                                <div class="space-y-1">
                                    <div class="flex justify-between text-xs text-muted">
                                        <span>Lightness</span>
                                        <span>@_primaryLightness%</span>
                                    </div>
                                    <input type="range" min="20" max="80" value="@_primaryLightness"
                                           class="w-full accent-primary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                           @oninput="OnPrimaryLightnessChange"/>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Secondary Color (Hidden for Minimal) -->
                @if (_preset != "minimal")
                {
                    <div class="space-y-2 pt-4 border-t border-divider">
                        <label class="text-xs font-semibold text-muted uppercase tracking-wider">Secondary Color</label>
                        <div class="space-y-3">
                            <select
                                class="w-full bg-input-bg border border-input-border rounded px-2 py-1.5 text-sm text-foreground focus:border-input-border-focus focus:outline-none"
                                value="@_secondaryPalette" @onchange="OnSecondaryChange">
                                <option value="custom" selected="@(_secondaryPalette == "custom")">Custom</option>
                                @foreach (var palette in AvailablePalettes)
                                {
                                    <option value="@palette"
                                            selected="@(_secondaryPalette == palette)">@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(palette)</option>
                                }
                            </select>

                            @if (_secondaryPalette == "custom")
                            {
                                <div class="space-y-2 pt-2 border-t border-divider">
                                    <div class="flex items-center gap-2">
                                        <input type="text" 
                                               value="@SecondaryHex" 
                                               @onchange="OnSecondaryHexChange"
                                               maxlength="7"
                                               placeholder="#000000"
                                               class="w-20 bg-input-bg border border-input-border rounded px-2 py-1 text-xs text-foreground font-mono focus:border-input-border-focus focus:outline-none"/>
                                        <div class="w-10 h-6 rounded border border-line"
                                             style="background: hsl(@_secondaryHue, @(_secondarySaturation)%, @(_secondaryLightness)%)"></div>
                                    </div>

                                    <div class="space-y-1">
                                        <div class="flex justify-between text-xs text-muted">
                                            <span>Hue</span>
                                            <span>@_secondaryHue°</span>
                                        </div>
                                        <input type="range" min="0" max="360" value="@_secondaryHue"
                                               class="w-full accent-secondary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                               @oninput="OnSecondaryHueChange"/>
                                    </div>

                                    <div class="space-y-1">
                                        <div class="flex justify-between text-xs text-muted">
                                            <span>Saturation</span>
                                            <span>@_secondarySaturation%</span>
                                        </div>
                                        <input type="range" min="0" max="100" value="@_secondarySaturation"
                                               class="w-full accent-secondary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                               @oninput="OnSecondarySaturationChange"/>
                                    </div>

                                    <div class="space-y-1">
                                        <div class="flex justify-between text-xs text-muted">
                                            <span>Lightness</span>
                                            <span>@_secondaryLightness%</span>
                                        </div>
                                        <input type="range" min="20" max="80" value="@_secondaryLightness"
                                               class="w-full accent-secondary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                               @oninput="OnSecondaryLightnessChange"/>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Divider -->
                <div class="border-t border-divider"></div>

                <!-- Reset -->
                <button
                    class="w-full px-3 py-2 text-xs font-medium rounded-md text-subtle hover:text-foreground hover:bg-surface-hover transition-colors"
                    @onclick="ResetToDefaults">
                    Reset to Defaults
                </button>
            }
        </div>

        <!-- Click-outside overlay -->
        <div class="fixed inset-0 z-40 bg-transparent" @onclick="ToggleDropdown"></div>
    }
</div>
