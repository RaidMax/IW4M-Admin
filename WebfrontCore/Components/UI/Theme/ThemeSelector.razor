@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="relative">
    <!-- Theme Toggle Button -->
    <button class="p-2 text-secondary hover:text-foreground hover:bg-surface-hover rounded-lg transition-colors"
            @onclick="ToggleDropdown" 
            @onclick:stopPropagation
            title="Theme Settings">
        <i class="ph ph-palette text-xl"></i>
    </button>

    @if (_isOpen)
    {
        <!-- Dropdown Panel -->
        <div class="absolute right-0 mt-2 w-80 bg-surface border border-line rounded-lg shadow-xl z-50 p-4 space-y-4 max-h-[80vh] overflow-y-auto">
            <!-- Preset Selection -->
            <div class="space-y-2">
                <label class="text-xs font-semibold text-muted uppercase tracking-wider">Theme Preset</label>
                <div class="flex gap-2">
                    <button class="flex-1 px-3 py-2 text-xs font-medium rounded-md transition-colors @GetPresetButtonClass("minimal")"
                            @onclick="@(() => SetPreset("minimal"))">
                        Minimal
                    </button>
                    <button class="flex-1 px-3 py-2 text-xs font-medium rounded-md transition-colors @GetPresetButtonClass("balanced")"
                            @onclick="@(() => SetPreset("balanced"))">
                        Balanced
                    </button>
                    <button class="flex-1 px-3 py-2 text-xs font-medium rounded-md transition-colors @GetPresetButtonClass("high-contrast")"
                            @onclick="@(() => SetPreset("high-contrast"))">
                        Contrast
                    </button>
                </div>
            </div>

            <!-- Primary Color -->
            <div class="space-y-2">
                <label class="text-xs font-semibold text-muted uppercase tracking-wider">Primary Color</label>
                <div class="space-y-3">
                    <select class="w-full bg-input-bg border border-input-border rounded px-2 py-1.5 text-sm text-foreground focus:border-input-border-focus focus:outline-none capitalize"
                            value="@_primaryPalette" @onchange="OnPrimaryChange">
                        <option value="custom" selected="@(_primaryPalette == "custom")">Custom</option>
                        @foreach (var palette in AvailablePalettes)
                        {
                            <option value="@palette" selected="@(_primaryPalette == palette)">@palette</option>
                        }
                    </select>

                    @if (_primaryPalette == "custom")
                    {
                        <div class="space-y-2 pt-2 border-t border-divider">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-subtle">Preview</span>
                                <div class="w-16 h-6 rounded border border-line" style="background: hsl(@_primaryHue, @(_primarySaturation)%, @(_primaryLightness)%)"></div>
                            </div>
                            
                            <div class="space-y-1">
                                <div class="flex justify-between text-xs text-muted">
                                    <span>Hue</span>
                                    <span>@_primaryHue°</span>
                                </div>
                                <input type="range" min="0" max="360" value="@_primaryHue" 
                                       class="w-full accent-primary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                       @oninput="OnPrimaryHueChange" />
                            </div>
                            
                            <div class="space-y-1">
                                <div class="flex justify-between text-xs text-muted">
                                    <span>Saturation</span>
                                    <span>@_primarySaturation%</span>
                                </div>
                                <input type="range" min="0" max="100" value="@_primarySaturation" 
                                       class="w-full accent-primary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                       @oninput="OnPrimarySaturationChange" />
                            </div>
                            
                            <div class="space-y-1">
                                <div class="flex justify-between text-xs text-muted">
                                    <span>Lightness</span>
                                    <span>@_primaryLightness%</span>
                                </div>
                                <input type="range" min="20" max="80" value="@_primaryLightness" 
                                       class="w-full accent-primary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                       @oninput="OnPrimaryLightnessChange" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Secondary Color (Hidden for Minimal) -->
            @if (_preset != "minimal")
            {
                <div class="space-y-2 pt-4 border-t border-divider">
                    <label class="text-xs font-semibold text-muted uppercase tracking-wider">Secondary Color</label>
                    <div class="space-y-3">
                        <select class="w-full bg-input-bg border border-input-border rounded px-2 py-1.5 text-sm text-foreground focus:border-input-border-focus focus:outline-none capitalize"
                                value="@_secondaryPalette" @onchange="OnSecondaryChange">
                            <option value="custom" selected="@(_secondaryPalette == "custom")">Custom</option>
                            @foreach (var palette in AvailablePalettes)
                            {
                                <option value="@palette" selected="@(_secondaryPalette == palette)">@palette</option>
                            }
                        </select>

                        @if (_secondaryPalette == "custom")
                        {
                            <div class="space-y-2 pt-2 border-t border-divider">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-subtle">Preview</span>
                                    <div class="w-16 h-6 rounded border border-line" style="background: hsl(@_secondaryHue, @(_secondarySaturation)%, @(_secondaryLightness)%)"></div>
                                </div>

                                <div class="space-y-1">
                                    <div class="flex justify-between text-xs text-muted">
                                        <span>Hue</span>
                                        <span>@_secondaryHue°</span>
                                    </div>
                                    <input type="range" min="0" max="360" value="@_secondaryHue" 
                                           class="w-full accent-secondary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                           @oninput="OnSecondaryHueChange" />
                                </div>

                                <div class="space-y-1">
                                    <div class="flex justify-between text-xs text-muted">
                                        <span>Saturation</span>
                                        <span>@_secondarySaturation%</span>
                                    </div>
                                    <input type="range" min="0" max="100" value="@_secondarySaturation" 
                                           class="w-full accent-secondary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                           @oninput="OnSecondarySaturationChange" />
                                </div>

                                <div class="space-y-1">
                                    <div class="flex justify-between text-xs text-muted">
                                        <span>Lightness</span>
                                        <span>@_secondaryLightness%</span>
                                    </div>
                                    <input type="range" min="20" max="80" value="@_secondaryLightness" 
                                           class="w-full accent-secondary h-1.5 bg-input-bg rounded-lg appearance-none cursor-pointer"
                                           @oninput="OnSecondaryLightnessChange" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Divider -->
            <div class="border-t border-divider"></div>

            <!-- Reset -->
            <button class="w-full px-3 py-2 text-xs font-medium rounded-md text-subtle hover:text-foreground hover:bg-surface-hover transition-colors"
                    @onclick="ResetToDefaults">
                Reset to Defaults
            </button>
        </div>
        
        <!-- Click-outside overlay -->
        <div class="fixed inset-0 z-40 bg-transparent" @onclick="ToggleDropdown"></div>
    }
</div>

@code {
    private bool _isOpen;
    private string _preset = "minimal";
    
    // Primary State
    private string _primaryPalette = "blue";
    private int _primaryHue = 217;
    private int _primarySaturation = 91;
    private int _primaryLightness = 60;
    
    // Secondary State
    private string _secondaryPalette = "purple";
    private int _secondaryHue = 271;
    private int _secondarySaturation = 91;
    private int _secondaryLightness = 65;

    private static readonly string[] AvailablePalettes = new[]
    {
        "blue", "sky", "cyan", "teal", "emerald", "green", "lime", "yellow",
        "amber", "orange", "red", "rose", "pink", "fuchsia", "purple", "violet",
        "indigo", "slate", "gray", "zinc", "neutral", "stone"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadFromStorage();
            await ApplyTheme();
            NavigationManager.LocationChanged += OnLocationChanged;
            StateHasChanged();
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try
        {
            await ApplyTheme();
        }
        catch { /* ignore during dispose */ }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void ToggleDropdown() => _isOpen = !_isOpen;

    private string GetPresetButtonClass(string preset) =>
        _preset == preset
            ? "bg-action-primary text-foreground"
            : "bg-action-secondary text-foreground hover:bg-action-secondary-hover";

    private async Task SetPreset(string preset)
    {
        _preset = preset;
        StateHasChanged();
        await ApplyTheme();
    }

    private async Task OnPrimaryChange(ChangeEventArgs e)
    {
        _primaryPalette = e.Value?.ToString() ?? "blue";
        await ApplyTheme();
    }

    private async Task OnSecondaryChange(ChangeEventArgs e)
    {
        _secondaryPalette = e.Value?.ToString() ?? "purple";
        await ApplyTheme();
    }

    // HSL Handlers
    private async Task OnPrimaryHueChange(ChangeEventArgs e) 
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) { _primaryHue = v; await ApplyTheme(); }
    }
    private async Task OnPrimarySaturationChange(ChangeEventArgs e) 
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) { _primarySaturation = v; await ApplyTheme(); }
    }
    private async Task OnPrimaryLightnessChange(ChangeEventArgs e) 
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) { _primaryLightness = v; await ApplyTheme(); }
    }

    private async Task OnSecondaryHueChange(ChangeEventArgs e) 
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) { _secondaryHue = v; await ApplyTheme(); }
    }
    private async Task OnSecondarySaturationChange(ChangeEventArgs e) 
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) { _secondarySaturation = v; await ApplyTheme(); }
    }
    private async Task OnSecondaryLightnessChange(ChangeEventArgs e) 
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) { _secondaryLightness = v; await ApplyTheme(); }
    }

    private async Task ResetToDefaults()
    {
        _preset = "minimal";
        _primaryPalette = "blue";
        _secondaryPalette = "purple";
        
        _primaryHue = 217;
        _primarySaturation = 91;
        _primaryLightness = 60;
        
        _secondaryHue = 271;
        _secondarySaturation = 91;
        _secondaryLightness = 65;
        
        await ApplyTheme();
    }

    private async Task ApplyTheme()
    {
        try
        {
            var settings = new
            {
                preset = _preset,
                primaryColorMode = _primaryPalette == "custom" ? 0 : 1,
                primaryPalette = _primaryPalette,
                primaryHue = _primaryHue,
                primarySaturation = _primarySaturation,
                primaryLightness = _primaryLightness,
                secondaryColorMode = _secondaryPalette == "custom" ? 0 : 1,
                secondaryPalette = _secondaryPalette,
                secondaryHue = _secondaryHue,
                secondarySaturation = _secondarySaturation,
                secondaryLightness = _secondaryLightness
            };

            // Save FIRST so MutationObserver reads the new value
            await JSRuntime.InvokeVoidAsync("themeManager.save", settings);
            await JSRuntime.InvokeVoidAsync("themeManager.apply", settings);
        }
        catch
        {
            // Silently fail during prerendering
        }
    }

    private async Task LoadFromStorage()
    {
        try
        {
            var settings = await JSRuntime.InvokeAsync<ThemeSettings>("themeManager.load");
            if (settings != null)
            {
                _preset = settings.Preset ?? "minimal";
                _primaryPalette = settings.PrimaryColorMode == 0 ? "custom" : (settings.PrimaryPalette ?? "blue");
                _primaryHue = settings.PrimaryHue;
                _primarySaturation = settings.PrimarySaturation;
                _primaryLightness = settings.PrimaryLightness;
                
                _secondaryPalette = settings.SecondaryColorMode == 0 ? "custom" : (settings.SecondaryPalette ?? "purple");
                _secondaryHue = settings.SecondaryHue;
                _secondarySaturation = settings.SecondarySaturation;
                _secondaryLightness = settings.SecondaryLightness;
            }
        }
        catch
        {
            // Use defaults
        }
    }
    
    private class ThemeSettings 
    {
        [System.Text.Json.Serialization.JsonPropertyName("preset")]
        public string? Preset { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("primaryColorMode")]
        public int PrimaryColorMode { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("primaryPalette")]
        public string? PrimaryPalette { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("primaryHue")]
        public int PrimaryHue { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("primarySaturation")]
        public int PrimarySaturation { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("primaryLightness")]
        public int PrimaryLightness { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("secondaryColorMode")]
        public int SecondaryColorMode { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("secondaryPalette")]
        public string? SecondaryPalette { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("secondaryHue")]
        public int SecondaryHue { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("secondarySaturation")]
        public int SecondarySaturation { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("secondaryLightness")]
        public int SecondaryLightness { get; set; }
    }
}
