{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "libraries": [
    {
      "library": "jquery@3.3.1",
      "destination": "wwwroot/lib/jquery/"
    },
    {
      "library": "popper.js@1.14.7",
      "destination": "wwwroot/lib/popper.js/"
    },
    {
      "library": "moment-timezone@0.5.26",
      "destination": "wwwroot/lib/moment-timezone/"
    },
    {
      "library": "moment@2.24.0",
      "destination": "wwwroot/lib/moment.js/"
    },
    {
      "library": "chart.js@2.9.4",
      "destination": "wwwroot/lib/chart.js"
    },
    {
      "library": "vanillajs-datepicker@1.2.0",
      "destination": "wwwroot/lib/vanillajs-datepicker"
    },
    {
      "provider": "unpkg",
      "library": "@phosphor-icons/web@2.1.1",
      "destination": "wwwroot/lib/phosphor-icons",
      "files": [
        "src/regular/style.css",
        "src/regular/Phosphor.woff2",
        "src/regular/Phosphor.woff",
        "src/regular/Phosphor.ttf",
        "src/bold/style.css",
        "src/bold/Phosphor-Bold.woff2",
        "src/bold/Phosphor-Bold.woff",
        "src/bold/Phosphor-Bold.ttf",
        "src/fill/style.css",
        "src/fill/Phosphor-Fill.woff2",
        "src/fill/Phosphor-Fill.woff",
        "src/fill/Phosphor-Fill.ttf"
      ]
    }
  ]
}
